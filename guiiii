        if not keyCode then
            return "none"
        end
        return keyCode.Name
    end

    function stopKeybindListening()
        if not keybindListening then
            return
        end
        keybindListening = false
        endKeyCapture()
        if keybindListenConn then
            keybindListenConn:Disconnect()
            keybindListenConn = nil
        end
        if keybindListeningBtn then
            local rowData
            for _, data in pairs(keybindRows) do
                if data.keybindBtn == keybindListeningBtn then
                    rowData = data
                    break
                end
            end
            if rowData then
                rowData.keybindLabel.Text = getKeyDisplayName(S.keybinds[rowData.registryName])
                rowData.keybindBg.BorderColor3 = Color3.fromRGB(60, 60, 60)
                rowData.keybindLabel.TextColor3 = Color3.new(1, 1, 1)
            end
            keybindListeningBtn = nil
        end
    end

    searchBarBg = Instance.new("Frame")
    searchBarBg.Size = UDim2.new(1, 0, 0, 32)
    searchBarBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    searchBarBg.BorderSizePixel = 1
    searchBarBg.BorderColor3 = Color3.fromRGB(50, 50, 50)
    searchBarBg.LayoutOrder = 0
    searchBarBg.Parent = elementsList
    Instance.new("UICorner", searchBarBg).CornerRadius = UDim.new(0, 6)

    searchBox = Instance.new("TextBox")
    searchBox.Size = UDim2.new(1, -20, 1, 0)
    searchBox.Position = UDim2.new(0, 10, 0, 0)
    searchBox.BackgroundTransparency = 1
    searchBox.TextColor3 = Color3.new(1, 1, 1)
