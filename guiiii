function solveProjectileTravel(origin, speed, targetPosition, gravityMagnitude, allowDirectFallback)
    if typeof(origin) ~= "Vector3" or typeof(targetPosition) ~= "Vector3" then
        return nil, nil
    end
    local projectileSpeed = tonumber(speed)
    if not projectileSpeed or projectileSpeed <= 0 then
        return nil, nil
    end
    local displacement = targetPosition - origin
    local horizontalDisplacement = Vector3.new(displacement.X, 0, displacement.Z)
    local horizontalDistance = horizontalDisplacement.Magnitude
    local distance = displacement.Magnitude
    if distance <= 0.001 then
        return Vector3.new(0, 1, 0) * projectileSpeed, 0
    end
    local gravity = math.max(tonumber(gravityMagnitude) or 0, 0)
    if gravity <= 0.001 then
        local directTime = distance / projectileSpeed
        return displacement.Unit * projectileSpeed, directTime
    end
    local speedSquared = projectileSpeed * projectileSpeed
    local y = displacement.Y
    local discriminant = speedSquared * speedSquared
        - gravity * (gravity * horizontalDistance * horizontalDistance + 2 * y * speedSquared)
    if discriminant < 0 then
        if allowDirectFallback == false then
            return nil, nil
        end
        local fallbackTime = distance / projectileSpeed
        return displacement.Unit * projectileSpeed, fallbackTime
    end
    local root = math.sqrt(discriminant)
    local lowArcTimeSquared = (speedSquared - gravity * y - root) / (gravity * gravity * 0.5)
    local highArcTimeSquared = (speedSquared - gravity * y + root) / (gravity * gravity * 0.5)
    local travelTime = lowArcTimeSquared > 0 and math.sqrt(lowArcTimeSquared)
        or (highArcTimeSquared > 0 and math.sqrt(highArcTimeSquared) or nil)
    if not travelTime or travelTime <= 0 then
        return nil, nil
    end
    local horizontalVelocity = horizontalDistance > 0.001 and (horizontalDisplacement / travelTime) or Vector3.zero
    local verticalVelocity = (y + 0.5 * gravity * travelTime * travelTime) / travelTime
    local solvedVelocity = Vector3.new(horizontalVelocity.X, verticalVelocity, horizontalVelocity.Z)
    if solvedVelocity.Magnitude <= 0.001 then
        return displacement.Unit * projectileSpeed, distance / projectileSpeed
    end
    return solvedVelocity.Unit * projectileSpeed, travelTime
end
function solveOldProjectileTravel(origin, speed, targetPosition, gravityMagnitude)
