	end)
	pcall(function()
		rootPart.RotVelocity = Vector3.zero
	end)
	pcall(function()
		rootPart.AssemblyLinearVelocity = velocity
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end)
	return ok
end
-- West X underground replacement.
-- Keep the public function names, but route underground movement through the
-- recovered West X-style crouch/collision/root-CFrame travel path.
local westXUndergroundSignalCache = {
	crouch = nil,
	sprint = nil,
	collision = nil,
	welds = nil,
}
local westXEndingOreHold = false
local WESTX_SIGNAL_REFRESH_INTERVAL = 0.75
local WESTX_COLLISION_REFRESH_INTERVAL = 1.25

local function westXIsAnyClass(instance, classNames)
	if not instance then
		return false
	end
	for _, className in ipairs(classNames) do
		if instance:IsA(className) then
			return true
		end
	end
	return false
end

local function westXFindNamedInstance(root, names, classNames)
	if not root then
		return nil
	end
	for _, name in ipairs(names) do
		local found = root:FindFirstChild(name, true)
		if found and (not classNames or westXIsAnyClass(found, classNames)) then
			return found
		end
	end
	return nil
end

local function westXFireSignal(signal, enabled)
	if not signal then
		return false
	end
	if signal:IsA("BoolValue") then
		signal.Value = enabled == true
		return true
	end
	local ok = false
	if signal:IsA("RemoteEvent") then
		ok = pcall(function()
			signal:FireServer(enabled == true)
		end)
	elseif signal:IsA("RemoteFunction") then
		ok = pcall(function()
			signal:InvokeServer(enabled == true)
		end)
	elseif signal:IsA("BindableEvent") then
		ok = pcall(function()
			signal:Fire(enabled == true)
		end)
	elseif signal:IsA("BindableFunction") then
		ok = pcall(function()
			signal:Invoke(enabled == true)
		end)
	end
	return ok
end

local function westXGetSignalRoots(character)
	local roots = {}
	if character then
		table.insert(roots, character)
	end
	table.insert(roots, ReplicatedStorage)
	table.insert(roots, workspace)
	if LocalPlayer then
		table.insert(roots, LocalPlayer)
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			table.insert(roots, playerGui)
		end
	end
	return roots
end

local function westXFindSignals(character, cacheKey, names)
	if not westXUndergroundSignalCache[cacheKey] or #westXUndergroundSignalCache[cacheKey] == 0 then
		local signals = {}
		for _, root in ipairs(westXGetSignalRoots(character)) do
			local signal = westXFindNamedInstance(root, names, {
				"RemoteEvent",
				"RemoteFunction",
				"BindableEvent",
				"BindableFunction",
				"BoolValue",
			})
			if signal then
				table.insert(signals, signal)
			end
		end
		westXUndergroundSignalCache[cacheKey] = signals
	end
	return westXUndergroundSignalCache[cacheKey]
end

local function westXSetRecoveredSignals(character, cacheKey, names, enabled)
	local fired = false
	for _, signal in ipairs(westXFindSignals(character, cacheKey, names)) do
		fired = westXFireSignal(signal, enabled) or fired
	end
	return fired
end

local function westXSetCrouched(character, enabled)
	return westXSetRecoveredSignals(character, "crouch", {
		"IsCrouchButtonDown",
		"SetCrouched",
		"Crouched",
		"IsCrouched",
	}, enabled)
end

local function westXSetSprinting(character, enabled)
	return westXSetRecoveredSignals(character, "sprint", {
		"IsSprintButtonDown",
		"SetSprinting",
		"Sprinting",
		"IsSprinting",
	}, enabled)
end

local function westXSetCollisionModel(character, enabled)
	return westXSetRecoveredSignals(character, "collision", {
		"ToggleCollisionModel",
		"SetCollisionModel",
	}, enabled)
end

local function westXSetWeldsActive(character, enabled)
	return westXSetRecoveredSignals(character, "welds", {
		"ToggleWeldsActive",
