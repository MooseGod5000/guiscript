function getUndergroundReferenceY(pathPosition)
	if typeof(pathPosition) ~= "Vector3" then
		return nil
	end

	local referenceY = pathPosition.Y
	local rayParams = RaycastParams.new()
	rayParams.CollisionGroup = "PlayerCharacters"
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.RespectCanCollide = true
	rayParams.IgnoreWater = true
	local filter = {}
	local ignoreFolder = workspace:FindFirstChild("Ignore")
	if ignoreFolder then
		table.insert(filter, ignoreFolder)
	end
	local entitiesFolder = workspace:FindFirstChild("WORKSPACE_Entities")
	if entitiesFolder then
		table.insert(filter, entitiesFolder)
	end
	local character = cachedCharacter or getCustomCharacter() or (localPlayer and localPlayer.Character)
	if character then
		table.insert(filter, character)
	end
	if #filter > 0 then
		rayParams.FilterDescendantsInstances = filter
	end

	local rayResult = workspace:Raycast(pathPosition + Vector3.new(0, 8, 0), Vector3.new(0, -20, 0), rayParams)
	if rayResult and rayResult.Position and math.abs(rayResult.Position.Y - pathPosition.Y) <= 4.5 then
		referenceY = rayResult.Position.Y
	end

	return referenceY
end

function getUndergroundRootClearance(character)
	local resolvedCharacter = character or cachedCharacter or getCustomCharacter() or (localPlayer and localPlayer.Character)
	local rootPart = getRootPart(resolvedCharacter)
	local humanoid = getHumanoid(resolvedCharacter)
	local rootHalfHeight = rootPart and (rootPart.Size.Y * 0.5) or 1
	local hipHeight = humanoid and humanoid.HipHeight or 2
	return math.max(2.25, math.min(4.5, rootHalfHeight + hipHeight))
end

function getUndergroundGoalPosition(pathPosition, character)
	if typeof(pathPosition) ~= "Vector3" then
		return nil
	end

	local referenceY = getUndergroundReferenceY(pathPosition) or pathPosition.Y
	local depth = getUndergroundDepthOffset()
	local rootClearance = getUndergroundRootClearance(character)
	local rootY = referenceY + rootClearance - depth
	local lowestAcceptedRootY = referenceY - math.max(0.35, math.min(6, depth))
	if rootY < lowestAcceptedRootY then
		rootY = lowestAcceptedRootY
	end
	return Vector3.new(pathPosition.X, rootY, pathPosition.Z)
end

function getUndergroundBaseRotation(rootPart)
	local travelState = getUndergroundTravelState()
	if travelState and typeof(travelState.baseRotation) == "CFrame" then
		return travelState.baseRotation
	end

	local oreHoldState = getUndergroundOreHoldState()
	if oreHoldState and typeof(oreHoldState.baseRotation) == "CFrame" then
		return oreHoldState.baseRotation
	end

	if rootPart then
		return rootPart.CFrame - rootPart.Position
	end

	return CFrame.new()
end

function getUndergroundTravelRotation(rootPart)
	local baseRotation = getUndergroundBaseRotation(rootPart)
	return baseRotation * CFrame.Angles(math.rad(90), 0, 0) * CFrame.Angles(0, math.rad(getUndergroundAngle()), 0)
end

function getUndergroundGoalCFrame(position, rootPart)
	return CFrame.new(position) * getUndergroundTravelRotation(rootPart)
end

function getUndergroundPathReachDistance()
	return math.max(4.75, WAYPOINT_REACH_DISTANCE * 0.85)
end

function getUndergroundVerticalReachDistance(wantedRange)
	local baseRange = math.max(0.2, tonumber(wantedRange) or getUndergroundPathReachDistance())
	return math.max(3.25, math.min(6.25, baseRange + 0.9 + getUndergroundDepthOffset() * 0.5))
end

function getUndergroundPathPlaybackDistance(rootPart, pathPosition, wantedRange)
	if not rootPart then
		return math.huge
	end
	local goalPosition = getUndergroundGoalPosition(pathPosition, rootPart.Parent)
	if not goalPosition then
		return math.huge
	end
	local delta = goalPosition - rootPart.Position
	local flatDistance = Vector3.new(delta.X, 0, delta.Z).Magnitude
	local verticalDistance = math.abs(delta.Y)
	local verticalReach = getUndergroundVerticalReachDistance(wantedRange)
	if flatDistance <= (tonumber(wantedRange) or getUndergroundPathReachDistance()) and verticalDistance <= verticalReach then
		return math.min(delta.Magnitude, flatDistance)
	end
	return math.max(flatDistance, verticalDistance)
end

