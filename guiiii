function getDiscordAutomineFlagWebhookDedupeKey(flagType, flagContext)
	local normalizedFlagType = string.lower(tostring(flagType or "flag"))
	local context = type(flagContext) == "table" and flagContext or {}
	local keyName = ""
	if normalizedFlagType == "player" then
		local detectedPlayer = context.detectedPlayer or context.player
		keyName = tostring((detectedPlayer and (detectedPlayer.UserId or detectedPlayer.Name)) or context.detectedPlayerName or context.playerName or "")
	elseif normalizedFlagType == "ore_purity" then
		keyName = tostring(context.pathName or context.key or "")
	elseif normalizedFlagType == "staff" or normalizedFlagType == "staff_alt" or normalizedFlagType == "followed" or normalizedFlagType == "follow_warning" then
		local staffPlayer = context.staffPlayer or context.player
		keyName = tostring((staffPlayer and (staffPlayer.UserId or staffPlayer.Name)) or context.staffUser or context.staffName or "")
	else
		keyName = tostring(context.key or context.reason or "")
	end
	if keyName == "" then
		keyName = "_global"
	end
	return normalizedFlagType .. ":" .. keyName
end

function shouldSendDiscordAutomineFlagWebhook(flagType, flagContext)
	automineWebhookState = type(automineWebhookState) == "table" and automineWebhookState or {}
	local sentAtByKey = type(automineWebhookState.flagLastSentAt) == "table" and automineWebhookState.flagLastSentAt or {}
	automineWebhookState.flagLastSentAt = sentAtByKey
	runtimeEnv.__FOB_AUTOMINE_WEBHOOK_STATE = automineWebhookState

	local key = getDiscordAutomineFlagWebhookDedupeKey(flagType, flagContext)
	local now = os.clock()
	local cooldown = math.max(0, tonumber(AUTOMINE_FLAG_WEBHOOK_COOLDOWN_SECONDS) or 60)
	local lastSentAt = tonumber(sentAtByKey[key]) or 0
	if cooldown > 0 and (now - lastSentAt) < cooldown then
		return false
	end
	sentAtByKey[key] = now
	return true
end

function truncateDiscordAutomineEmbedText(value, limit)
	local text = tostring(value or "")
	local maxLength = math.max(1, tonumber(limit) or 1024)
	if #text > maxLength then
		text = string.sub(text, 1, math.max(1, maxLength - 3)) .. "..."
	end
	if text == "" then
		return " "
	end
	return text
end

function buildDiscordAutomineEmbedFields(lines)
	local fields = {}
	if type(lines) ~= "table" then
		return fields
	end
	for _, item in ipairs(lines) do
		if #fields >= 25 then
			break
		end
		if type(item) == "table" then
			local name = truncateDiscordAutomineEmbedText(item.name or item[1] or "Info", 256)
			local value = truncateDiscordAutomineEmbedText(item.value or item[2] or "", 1024)
			table.insert(fields, {
				name = name,
				value = value,
				inline = item.inline == true,
			})
		else
			local text = tostring(item or "")
			if text ~= "" then
				local name, value = string.match(text, "^([^:]+):%s*(.*)$")
				if not name then
					name = "Info"
					value = text
				end
				table.insert(fields, {
					name = truncateDiscordAutomineEmbedText(name, 256),
					value = truncateDiscordAutomineEmbedText(value, 1024),
					inline = #tostring(value or "") <= 48,
				})
			end
		end
	end
	return fields
end

function postDiscordAutomineWebhook(titleText, lines, options)
	if not isDiscordAutomineWebhookTrackingEnabled() then
		return false, "disabled"
	end
	local requestFunction = getHttpRequestFunction()
	if type(requestFunction) ~= "function" then
		return false, "request unavailable"
	end

	local embedOptions = type(options) == "table" and options or {}
	local fields = buildDiscordAutomineEmbedFields(lines)
	local description = tostring(embedOptions.description or "")
	if #fields == 0 and description == "" and tostring(titleText or "") == "" then
		return false, "empty payload"
	end
	local embed = {
		title = truncateDiscordAutomineEmbedText(titleText or "AutoMine", 256),
		color = tonumber(embedOptions.color) or 3447003,
		timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
	}
	local footerText = tostring(embedOptions.footer or "")
	if footerText ~= "" then
		embed.footer = {
			text = truncateDiscordAutomineEmbedText(footerText, 2048),
		}
	end
	if description ~= "" then
		embed.description = truncateDiscordAutomineEmbedText(description, 4096)
	end
	if #fields > 0 then
		embed.fields = fields
	end

	local okRequest, response = pcall(requestFunction, {
		Url = getDiscordAutomineWebhookUrl(),
		Method = "POST",
		Headers = {
			["Content-Type"] = "application/json",
		},
		Body = HttpService:JSONEncode({
			username = tostring(embedOptions.username or "AutoMine"),
			embeds = { embed },
			allowed_mentions = {
				parse = {},
			},
		}),
	})
	if not okRequest then
		pushDebug("discord webhook error: " .. tostring(response))
		return false, tostring(response)
	end

	local statusCode = tonumber(response and (response.StatusCode or response.Status or response.status_code)) or 0
	local success = response and response.Success
	if success == nil then
		success = statusCode == 0 or (statusCode >= 200 and statusCode < 300)
	elseif success == false and statusCode >= 200 and statusCode < 300 then
		success = true
	end
	if not success then
		pushDebug("discord webhook failed: " .. tostring(statusCode))
		return false, tostring(statusCode)
	end
	return true, response
end

function sendDiscordAutomineSellWebhook(soldLootValue)
	local soldAmount = math.max(0, math.floor((tonumber(soldLootValue) or 0) + 0.5))
	local totalEarned = addAutomineWebhookEarnedForCurrentUrl(soldAmount)
	local accountEarned = addAutomineWebhookAccountEarnedForCurrentUrl(soldAmount)
	if not (isDiscordAutomineWebhookTrackingEnabled() and isDiscordAutomineWebhookTrackOptionEnabled("Track earnings")) then
		return false
	end
	local now = os.clock()
	local serverStartedAt = tonumber(automineWebhookServerStartedAt) or now
	local serverElapsed = math.max(0, now - serverStartedAt)
	automineWebhookState = type(automineWebhookState) == "table" and automineWebhookState or {}
	local previousSellAt = tonumber(automineWebhookState.lastSellAt)
	local sellCycleElapsed = previousSellAt and math.max(1, now - previousSellAt) or math.max(1, serverElapsed)
	automineWebhookState.lastSellAt = now
	runtimeEnv.__FOB_AUTOMINE_WEBHOOK_STATE = automineWebhookState
	return postDiscordAutomineWebhook("AutoMine Sell", {
		{name = "Sold", value = "$" .. formatMoneyAmount(soldAmount), inline = true},
		{name = "Total earned", value = "$" .. formatMoneyAmount(totalEarned), inline = true},
		{name = "Account earned", value = "$" .. formatMoneyAmount(accountEarned), inline = true},
		{name = "Per hour", value = formatAutomineWebhookHourlyRate(soldAmount, sellCycleElapsed), inline = true},
		{name = "Cycle time", value = formatAutomineWebhookElapsed(sellCycleElapsed), inline = true},
		{name = "Server elapsed", value = formatAutomineWebhookElapsed(serverElapsed), inline = true},
		{name = "Player", value = formatDiscordAutominePlayerIdentity(localPlayer), inline = true},
	}, {
		color = 3066993,
	})
end

function sendDiscordAutomineFlagWebhook(flagType, detailText, flagContext)
	if not (isDiscordAutomineWebhookTrackingEnabled() and isDiscordAutomineWebhookTrackOptionEnabled("Track flags")) then
		return false
	end
	if not shouldSendDiscordAutomineFlagWebhook(flagType, flagContext) then
		return false, "cooldown"
	end
	local prettyFlagType = tostring(flagType or "flag")
	prettyFlagType = prettyFlagType:gsub("_", " ")
