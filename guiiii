	return string.format([[
pcall(function()
    local scriptPath = %q
    local retryAttempts = %d
    local retryDelay = %s
    local webhookTotalEarned = %s
    local runtimeEnv = _G
    do
        local okEnv, queuedEnv = pcall(function()
            return type(getgenv) == "function" and getgenv() or nil
        end)
        if okEnv and type(queuedEnv) == "table" then
            runtimeEnv = queuedEnv
        end
    end
    runtimeEnv.__FOB_AUTOMINE_WEBHOOK_STATE = runtimeEnv.__FOB_AUTOMINE_WEBHOOK_STATE or {}
    runtimeEnv.__FOB_AUTOMINE_WEBHOOK_STATE.totalEarned = math.max(tonumber(runtimeEnv.__FOB_AUTOMINE_WEBHOOK_STATE.totalEarned) or 0, webhookTotalEarned)

    local function createLoader()
        if type(loadfile) == "function" then
            local okLoader, loader = pcall(loadfile, scriptPath)
            if okLoader and type(loader) == "function" then
                return true, loader
            end
        end

        if type(readfile) == "function" and type(loadstring) == "function" then
            local okRead, source = pcall(readfile, scriptPath)
            if okRead and type(source) == "string" and source ~= "" then
                local okChunk, chunk = pcall(loadstring, source)
                if okChunk and type(chunk) == "function" then
                    return true, chunk
                end
            end
        end

        return false
    end

    local function tryLaunch()
        local okLoader, loader = createLoader()
        if not okLoader or type(loader) ~= "function" then
            return false
        end
        local okRun = pcall(loader)
        return okRun == true
    end

    pcall(function()
        if not game:IsLoaded() then
            game.Loaded:Wait()
        end
    end)

    for _ = 1, retryAttempts do
        if tryLaunch() then
            return
        end
        task.wait(retryDelay)
    end

    if not (type(runtimeEnv) == "table" and runtimeEnv.__WestwareAutomineOnlyPanicCleanup == true) then
        warn("[FOB] teleport bootstrap failed for " .. tostring(scriptPath))
    end
end)
]], scriptFilePath, TELEPORT_QUEUE_RETRY_ATTEMPTS, tostring(TELEPORT_QUEUE_RETRY_DELAY), tostring(queuedWebhookTotalEarned))
