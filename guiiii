function waitForPathBearPreventionSafetyAtOre(character, activeToken)
	if not (isPathBearPreventionEnabled() and autoMineEnabled and activeToken == autoMineToken) then
		return false
	end

	local result = updatePathBearPreventionScan(character, true)
	local dangerousBear = result and result.dangerousBear
	if not dangerousBear then
		return false
	end

	pushDebugRateLimited(
		"bear_prevention_wait_start",
		"bear prevention: waiting for " .. getPathBearEntryLabel(dangerousBear),
		1.2
	)

	while autoMineEnabled and activeToken == autoMineToken and isPathBearPreventionEnabled() and pathState.playbackActive do
		holdPathBearPreventionPosition(character)
		result = updatePathBearPreventionScan(character, true)
		local unsafeBear = result and result.unsafeBear
		if not unsafeBear then
			pushDebugRateLimited("bear_prevention_safe", "bear prevention: bear anger safe, resuming path", 1.2)
			return true
		end

		setStatus(
			"Waiting for " .. getPathBearEntryLabel(unsafeBear) .. " to calm down",
			Color3.fromRGB(255, 190, 120)
		)
		setLastMoveCommand(Vector3.zero, "BearPreventionWait")
		task.wait(BEAR_PREVENTION_WAIT_STEP or 0.1)
	end

	return true
end

function ensurePathBearPreventionLoop()
	if type(pathState) ~= "table" or pathState.bearPreventionLoopRunning == true then
		return
	end

	pathState.bearPreventionLoopRunning = true
	task.spawn(function()
		while not destroyed and isSessionActive() and type(pathState) == "table" and isPathBearPreventionEnabled() do
			local ok, err = pcall(function()
				updatePathBearPreventionScan(cachedCharacter, false)
			end)
			if not ok and type(pushDebugRateLimited) == "function" then
				pushDebugRateLimited("bear_prevention_scan_error", "bear prevention scan failed: " .. tostring(err), 3)
			end
			task.wait(BEAR_PREVENTION_SCAN_INTERVAL or 0.15)
		end

		if type(pathState) == "table" then
			pathState.bearPreventionLoopRunning = false
		end
		if not (type(pathState) == "table" and isPathBearPreventionEnabled()) then
			clearPathBearPreventionVisuals()
		end
	end)
end

local function shouldPathHopOnDeath()
	return isPathHopOnDeathEnabled()
		and (
			pathState.playbackActive
			or pathState.farmPathsEnabled
			or pathState.alwaysPlayEnabled
			or pathState.resumePathPlaybackPending
			or (autoMineEnabled and activeFarmMode == "path")
		)
end

local function shouldSuppressPathDeathHop()
	if serverHopInProgress or serverHopTaskQueued then
		return true, "server hop pending"
	end
	if pathState.spawnPlaybackPending
		or pathState.spawnPlaybackAwaitingRespawn
		or type(pathState.spawnPlaybackReadyPathName) == "string" then
		return true, "path respawn pending"
	end
	if type(isOnPathSpawnSelectorScreen) == "function" and isOnPathSpawnSelectorScreen() then
		return true, "spawn selector"
	end
	return false, nil
end

local function isPathDeathHopAliveReady()
	local suppressed = shouldSuppressPathDeathHop()
	if suppressed then
		return false
	end

	local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	if isTable(playerCharacter) then
		local isDead = rawget(playerCharacter, "IsDead")
		if isDead == nil then
			isDead = playerCharacter.IsDead
		end
		if isDead == false then
			return true
		end
	end

	local replicatedState = resolveGlobalReplicatedState(false) or resolveGlobalReplicatedState(true)
	if isTable(replicatedState) then
		local state = rawget(replicatedState, "State") or replicatedState.State
		if isTable(state) then
			local health = tonumber(rawget(state, "Health") or state.Health)
			if health and health > 0 then
				return true
			end
		end
	end

	local character = getCustomCharacter()
	local humanoid = getHumanoid(character)
	return humanoid ~= nil and humanoid.Health > 0
end

local function armPathDeathHopIfAlive()
	if not isPathDeathHopAliveReady() then
		return false
	end
	if not pathDeathHopArmed then
		pushDebugRateLimited("path_death_hop_armed", "hop-on-death armed after alive state", 2)
	end
	pathDeathHopArmed = true
	pathDeathHopCustomDead = false
	return true
end

local function isPathDeathGuiVisible()
	local playerGui = localPlayer and (localPlayer:FindFirstChildOfClass("PlayerGui") or localPlayer:FindFirstChild("PlayerGui"))
	if not playerGui then
		return false, nil
	end

	local deathLabel = playerGui:FindFirstChild("DeathLabel", true)
	if deathLabel and isPathSpawnSelectorGuiObjectVisible(deathLabel) then
		return true, "DeathLabel"
	end

	local deathUi = playerGui:FindFirstChild("DeathUI", true)
	if deathUi and isPathSpawnSelectorGuiObjectVisible(deathUi) then
		return true, "DeathUI"
	end

	return false, nil
end

local function getPathCustomDeathSignal()
	local suppressed, suppressReason = shouldSuppressPathDeathHop()
	if suppressed then
		return false, suppressReason
	end

	if armPathDeathHopIfAlive() then
		return false, nil
	end

	local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	local hasExplicitPlayerCharacterDeathState = false
	if isTable(playerCharacter) then
		local isDead = rawget(playerCharacter, "IsDead")
		if isDead == nil then
			isDead = playerCharacter.IsDead
		end
		if isDead ~= nil then
			hasExplicitPlayerCharacterDeathState = true
		end
		if isDead == true then
			return true, "PlayerCharacter.IsDead"
		end
	end

	local deathGuiVisible, deathGuiReason = isPathDeathGuiVisible()
	if deathGuiVisible then
		return true, deathGuiReason
	end

	local replicatedState = resolveGlobalReplicatedState(false) or resolveGlobalReplicatedState(true)
	if isTable(replicatedState) then
		local state = rawget(replicatedState, "State") or replicatedState.State
		if isTable(state) then
			local deadState = rawget(state, "Dead")
			if deadState == nil then
				deadState = state.Dead
			end
			if deadState == true then
				return true, "ReplicatedState.Dead"
			end

			local health = tonumber(rawget(state, "Health") or state.Health)
			if health and health <= 0 and not hasExplicitPlayerCharacterDeathState then
				return true, "ReplicatedState.Health"
			end
		end
	end

	return false, nil
end

