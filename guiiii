function applyMolotovTeleportPulse(forceFullScan)
    if not S.molotovTpEnabled then
        return false
    end
    local destCFrame, targetFound = getTwwMolotovTargetCFrame()
    if not (targetFound and destCFrame) then
        return false
    end
    local moved = false
    local seen = {}
    local now = os.clock()
    local trackedEntries = getMolotovTrackedThrowEntries()
    local hasTrackedEntry = false
    for entry, expiresAt in pairs(trackedEntries) do
        if not isTable(entry) or (tonumber(expiresAt) or 0) <= now then
            trackedEntries[entry] = nil
        else
            hasTrackedEntry = true
            moved = applyMolotovTeleportToEntry(entry, destCFrame) or moved
        end
    end
    if not (forceFullScan or hasTrackedEntry or (tonumber(S._molotovThrowTpUntil) or 0) > now) then
        return moved
    end
    local function tryCandidate(instance)
        local model = getMolotovProjectileModel(instance)
        if model and not seen[model] then
            seen[model] = true
            moved = applyMolotovTeleportToModel(model, destCFrame) or moved
        end
    end
    local function scanChildren(container)
        if not container then
            return
        end
        for _, child in ipairs(container:GetChildren()) do
            tryCandidate(child)
        end
    end
    local function scanDescendants(container)
        if not container then
            return
        end
        for _, descendant in ipairs(container:GetDescendants()) do
            tryCandidate(descendant)
        end
    end
    local ignoreFolder = workspace:FindFirstChild("Ignore")
    scanChildren(ignoreFolder)
    local playersFolder = getTwwEntityPlayersFolder()
    local localModel = playersFolder and playersFolder:FindFirstChild(localPlayer and localPlayer.Name or "")
    scanChildren(localModel)
    if forceFullScan or (now - (tonumber(S._molotovLastFullScanAt) or 0)) >= 0.25 then
        S._molotovLastFullScanAt = now
        scanDescendants(ignoreFolder)
        scanDescendants(localModel)
    end
    return moved
end
