function toggleHoveredMolotovPlayerMark()
    if destroyed or not isSessionActive() or not S.molotovMarkPlayersEnabled then
        return
    end

    local mouse = localPlayer and localPlayer:GetMouse()
    local hoveredPlayer = getTwwPlayerFromTarget(mouse and mouse.Target)
    if not hoveredPlayer or hoveredPlayer == localPlayer then
        return
    end

    local livePlayer = getAliveTwwTargetData(hoveredPlayer.Name)
    if not livePlayer then
        spawnNotification("That player is not alive right now.", "warning", true)
        return
    end

    local order = getMolotovMarkedPlayers()
    local existingIndex = table.find(order, hoveredPlayer.Name)
    if existingIndex then
        table.remove(order, existingIndex)
        destroyMolotovMarkVisual(hoveredPlayer.Name)
        refreshMolotovMarkVisuals()
        spawnNotification("Removed " .. hoveredPlayer.Name .. " from the molotov mark list.", "info", true)
        return
    end

    table.insert(order, hoveredPlayer.Name)
    refreshMolotovMarkVisuals()
    spawnNotification("Marked " .. hoveredPlayer.Name .. " as molotov target #" .. tostring(#order) .. ".", "success", true)
end

local function getTwwMolotovTargetData()
    local targetName = getPriorityMolotovTargetName()
    local player, character, rootPart = getAliveTwwTargetData(targetName)
