		local embeddedFallbackPath = tostring(TELEPORT_SCRIPT_EMBEDDED_FALLBACK_PATH or "")
		local okEmbedded, embeddedExists = pcall(isfileFunction, embeddedFallbackPath)
		if okEmbedded and embeddedExists and embeddedFallbackPath ~= "" then
			runtimeEnv.__FOB_LAST_SCRIPT_FILE_PATH = embeddedFallbackPath
			return embeddedFallbackPath
		end
	end
	if type(isfileFunction) ~= "function" or type(readfileFunction) ~= "function" then
		return nil
	end
	local filePath = string.format(
		"%s\\%s_%s.txt",
		TELEPORT_SCRIPT_STORAGE_FOLDER,
		TELEPORT_SCRIPT_PATH_FILE_PREFIX,
		sanitizePathStorageKey(getStorageId())
	)
	local okRead, storedPath = pcall(function()
		if not isfileFunction(filePath) then
			return nil
		end
		return readfileFunction(filePath)
	end)
	if okRead and type(storedPath) == "string" then
		storedPath = string.gsub(storedPath, "^%s+", "")
		storedPath = string.gsub(storedPath, "%s+$", "")
		if storedPath ~= "" then
			runtimeEnv.__FOB_LAST_SCRIPT_FILE_PATH = storedPath
			return storedPath
		end
	end
