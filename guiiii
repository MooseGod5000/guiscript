    if not spec then
        sleepSharedEspCategory(categoryKey)
        return
    end
    methods = methods or getSharedEspMethods(categoryKey) or {}
    local showText = methods.Text == true
    local showBox = methods.Box == true
    local showTracer = methods.Tracer == true
    local showFigure = methods.Figure == true
    local showHighlight = methods.Highlight == true
    if not (showText or showBox or showTracer or showFigure or showHighlight) then
        sleepSharedEspCategory(categoryKey)
        return
    end
    local tracerStart = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y - 24)
    if localRoot then
        local localProjected, localVisible = camera:WorldToViewportPoint(localRoot.Position)
        if localVisible then
            tracerStart = Vector2.new(localProjected.X, localProjected.Y)
        end
    end
    local activeTargets = {}
    for _, target in ipairs(getEspTargetsForCategory(categoryKey)) do
        local targetKey = target.key
        local model = target.model
        local rootPart = target.rootPart or getEspRootPart(model)
        if targetKey ~= nil and typeof(model) == "Instance" and model.Parent and rootPart and rootPart.Parent then
            local renderModel = getSharedEspRenderModel(target, model) or model
            activeTargets[targetKey] = true
            local entry = getSharedEspEntry(categoryKey, targetKey)
            prepareSharedEspEntryForRender(entry, showHighlight)
            local color = target.color or spec.color
            local rootScreen, rootVisible = camera:WorldToViewportPoint(rootPart.Position)
            local labelPart = (typeof(renderModel) == "Instance" and renderModel:FindFirstChild("Head", true))
                or (typeof(model) == "Instance" and model:FindFirstChild("Head", true))
                or rootPart
            if typeof(labelPart) ~= "Instance" or not labelPart:IsA("BasePart") then
                labelPart = rootPart
            end
            local labelScreen, labelVisible = camera:WorldToViewportPoint(labelPart.Position + Vector3.new(0, 0.85, 0))
            local distance = getEspTargetDistance(rootPart, localRoot)
            if showText and entry.text and labelVisible then
                entry.text.Text = string.format("%s [%d studs]", target.label, distance)
                entry.text.Position = Vector2.new(labelScreen.X, labelScreen.Y)
                entry.text.Color = color
                entry.text.Visible = true
            end
            if showBox and entry.box then
                local minX, minY, maxX, maxY = getModelScreenBounds(camera, renderModel)
                if minX and maxX and maxX > minX and maxY > minY then
                    entry.box.Position = Vector2.new(minX, minY)
                    entry.box.Size = Vector2.new(maxX - minX, maxY - minY)
                    entry.box.Color = color
                    entry.box.Visible = true
                end
            end
            if showTracer and entry.tracer and rootVisible then
                entry.tracer.From = tracerStart
                entry.tracer.To = Vector2.new(rootScreen.X, rootScreen.Y)
                entry.tracer.Color = color
                entry.tracer.Visible = true
            end
            if showFigure and type(entry.figureLines) == "table" then
                local segments = getSharedEspFigureSegments(renderModel)
                for index, line in ipairs(entry.figureLines) do
                    local segment = segments[index]
                    if line and segment then
                        local pointA, visibleA = camera:WorldToViewportPoint(segment[1])
                        local pointB, visibleB = camera:WorldToViewportPoint(segment[2])
                        if visibleA and visibleB then
                            line.From = Vector2.new(pointA.X, pointA.Y)
                            line.To = Vector2.new(pointB.X, pointB.Y)
                            line.Color = color
                            line.Visible = true
                        else
                            line.Visible = false
                        end
                    elseif line then
                        line.Visible = false
                    end
                end
            end
            if showHighlight then
                local highlight = ensureSharedEspHighlight(entry)
                local highlightAdornee = getSharedEspHighlightAdornee(renderModel, rootPart)
                if highlightAdornee then
                    highlight.Adornee = highlightAdornee
                    highlight.FillColor = color
                    highlight.OutlineColor = color
                    pcall(function()
                        highlight.Parent = highlightAdornee
                    end)
                    highlight.Enabled = true
                else
                    highlight.Adornee = nil
                    highlight.Enabled = false
                end
            elseif entry.highlight then
                entry.highlight.Adornee = nil
                entry.highlight.Enabled = false
                pcall(function()
                    entry.highlight.Parent = nil
                end)
            end
        end
    end
    local entries = espState.entries[categoryKey]
    local inactiveEntries = {}
    for targetKey, entry in pairs(entries) do
        if not activeTargets[targetKey] then
            table.insert(inactiveEntries, {targetKey, entry})
        end
    end
    for _, data in ipairs(inactiveEntries) do
        releaseSharedEspEntry(categoryKey, data[1], data[2])
    end
end
function updateSharedEsp()
