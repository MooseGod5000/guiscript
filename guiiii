local function resolveMolotovUtils(forceRefresh)
    local globalModule = type(getAutoMineGlobalModule) == "function" and getAutoMineGlobalModule(forceRefresh) or nil
    if not isTable(globalModule) then
        globalModule = rawget(_G, "__AutoMineGlobalModule")
    end
    if not isTable(globalModule) then
        return nil
    end

    local utils = rawget(globalModule, "Utils") or globalModule.Utils
    if not isTable(utils) and type(globalModule.LoadModule) == "function" then
        local okLoad, loadedUtils = pcall(function()
            return globalModule:LoadModule("Utils")
        end)
        if okLoad and isTable(loadedUtils) then
            utils = loadedUtils
            globalModule.Utils = loadedUtils
        end
    end
    if isTable(utils) and type(utils.GetMouseHit) == "function" then
        return utils
    end
    return nil
end

local function getMolotovProjectileModel(instance)
    local current = instance
    while current and current ~= workspace do
        if current:IsA("Model") and string.find(safeLower(current.Name), "molotov", 1, true) ~= nil then
            return current
        end
        current = current.Parent
    end
    return nil
end

local function isMolotovProjectileModel(model)
    if not (model and model:IsA("Model") and string.find(safeLower(model.Name), "molotov", 1, true) ~= nil) then
        return false
    end

    local root = getTwwModelRoot(model)
    if not (root and root:IsA("BasePart") and root:IsDescendantOf(workspace)) then
        return false
    end

    local ignoreFolder = workspace:FindFirstChild("Ignore")
    if ignoreFolder and model:IsDescendantOf(ignoreFolder) then
        return true
    end

    local okCanCollide, canCollide = pcall(function()
        return root.CanCollide
    end)
    return okCanCollide and canCollide == true
end

local function applyMolotovTeleportToModel(model, destCFrame)
    if not (S.molotovTpEnabled and typeof(destCFrame) == "CFrame" and isMolotovProjectileModel(model)) then
        return false
    end

    local root = getTwwModelRoot(model)
    if not root then
        return false
    end

    local dropVelocity = tostring(S.molotovStyle or "Blatant") == "Silent"
        and Vector3.new(0, -95, 0)
        or Vector3.new(0, -165, 0)

    local ok = pcall(function()
        model:PivotTo(destCFrame)
        for _, descendant in ipairs(model:GetDescendants()) do
            if descendant:IsA("BasePart") then
                descendant.CanTouch = true
                descendant.CanQuery = true
                descendant.AssemblyLinearVelocity = dropVelocity
                descendant.AssemblyAngularVelocity = Vector3.zero
            end
        end
        root.CanCollide = true
        root.Velocity = dropVelocity
        root.AssemblyLinearVelocity = dropVelocity
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    return ok == true
end

function applyMolotovTeleportPulse(forceFullScan)
    if not S.molotovTpEnabled then
        return false
    end

    local destCFrame, targetFound = getTwwMolotovTargetCFrame()
    if not (targetFound and destCFrame) then
        return false
    end

    local moved = false
    local seen = {}

    local function tryCandidate(instance)
        local model = getMolotovProjectileModel(instance)
        if model and not seen[model] then
            seen[model] = true
            moved = applyMolotovTeleportToModel(model, destCFrame) or moved
        end
    end

    local function scanChildren(container)
        if not container then
            return
        end
        for _, child in ipairs(container:GetChildren()) do
            tryCandidate(child)
        end
    end

    local function scanDescendants(container)
        if not container then
            return
        end
        for _, descendant in ipairs(container:GetDescendants()) do
            tryCandidate(descendant)
        end
    end

    local ignoreFolder = workspace:FindFirstChild("Ignore")
    scanChildren(ignoreFolder)

    local playersFolder = getTwwEntityPlayersFolder()
    local localModel = playersFolder and playersFolder:FindFirstChild(localPlayer and localPlayer.Name or "")
    scanDescendants(localModel)

    local now = os.clock()
    local throwWindowActive = (tonumber(S._molotovThrowTpUntil) or 0) > now
    local shouldFullScan = forceFullScan
        or throwWindowActive
        or (tostring(S.molotovStyle or "Blatant") ~= "Silent" and (now - (tonumber(S._molotovLastFullScanAt) or 0)) >= 0.25)
    if shouldFullScan then
        S._molotovLastFullScanAt = now
        scanDescendants(workspace)
    end

    return moved
end

local function noteMolotovThrowWindow()
    if not S.molotovTpEnabled then
        return
    end

    local now = os.clock()
    S._molotovThrowTpUntil = math.max(tonumber(S._molotovThrowTpUntil) or 0, now + 2.25)
    if S._molotovThrowPulseActive then
        return
    end

    S._molotovThrowPulseActive = true
    task.spawn(function()
        while S.molotovTpEnabled and (tonumber(S._molotovThrowTpUntil) or 0) > os.clock() do
            applyMolotovTeleportPulse(true)
            task.wait(0.025)
        end
        S._molotovThrowPulseActive = false
    end)
end

function noteMolotovNetworkFire(remoteName, packedArgs)
