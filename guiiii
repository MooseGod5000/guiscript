	targetTable[key] = nextValue
	if type(afterChanged) == "function" then
		afterChanged(nextValue)
	end
	schedulePersist()
	if debugLabel then
		pushDebug(debugLabel .. ": " .. (nextValue and "on" or "off"))
	end
	return true, nextValue
end

