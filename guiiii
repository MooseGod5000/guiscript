   local autofarmHeader = createKeybindSectionHeader("AUTOFARM", elementsList)
   table.insert(allKbElements, {element = autofarmHeader, names = {}})

   -- Gather all autofarm entries
   local allAutofarmEntries = {}
   for _, regEntry in ipairs(_buttonRegistry) do
       if regEntry.tab == "AUTOFARM" and regEntry.type ~= "slider" then
           table.insert(allAutofarmEntries, regEntry)
       end
   end

   -- Track which entries have been placed in a sub-section
   local placedAutofarm = {}

   for _, subSection in ipairs(kbAutofarmSections) do
       local subEntries = {}
       for _, regEntry in ipairs(allAutofarmEntries) do
           if subSection.filter(regEntry) and not placedAutofarm[regEntry.name] then
               table.insert(subEntries, regEntry)
               placedAutofarm[regEntry.name] = true
           end
       end
       if #subEntries > 0 then
           -- Sub-section header (slightly different style)
           local subHeader = Instance.new("TextLabel")
           subHeader.Size = UDim2.new(1, 0, 0, 24)
           subHeader.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
           subHeader.BorderSizePixel = 0
           subHeader.TextColor3 = Color3.fromRGB(180, 180, 180)
