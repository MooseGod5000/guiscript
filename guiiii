    elseif S.fastProjectileEnabled and targetInfo and appliedSilentAim and trackedFastProjectileEntry and packedArgs[3] ~= nil then
        scheduleFastProjectileFinalEvent(targetInfo, trackedFastProjectileEntry, packedArgs[3])
    end
    if targetInfo and appliedSilentAim then
