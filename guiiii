		originPosition = originRoot
	elseif originRoot then
		originPosition = originRoot.Position
	end
	if typeof(originPosition) ~= "Vector3" then
		return nil
	end
	local range = tonumber(HORSE_FLING_TARGET_RANGE) or 10
	local bestRoot = nil
	local bestCharacter = nil
	local bestPlayer = nil
	local bestDistance = range
	local seenCharacters = {}
	local function considerCharacter(character)
		if typeof(character) ~= "Instance" or seenCharacters[character] then
			return
		end
		seenCharacters[character] = true
		local targetRoot = getHorseFlingRootFromCharacter(character)
		if not targetRoot then
			return
		end
		local distance = (originPosition - targetRoot.Position).Magnitude
		if distance < bestDistance then
			bestDistance = distance
			bestRoot = targetRoot
			bestCharacter = character
			bestPlayer = _Players:FindFirstChild(tostring(character.Name or ""))
		end
	end
	local playersFolder = getTwwEntityPlayersFolder()
	if not playersFolder then
		return nil
	end
	for _, character in ipairs(playersFolder:GetChildren()) do
		considerCharacter(character)
	end
	return bestRoot, bestDistance, bestCharacter, bestPlayer
end
