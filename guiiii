		return false
	end

	local hook = {
		originalKnockOut = originalKnockOut,
	}
	hook.knockOutWrapper = function(self, ...)
		if playerState.horseAntiRagdollEnabled or playerState.horseOrbitEnabled then
			clearHorseRagdollState(isTable(self) and self or ridingAnimal)
			return nil
		end
		return hook.originalKnockOut(self, ...)
	end

	pcall(function()
		ridingAnimal.KnockOut = hook.knockOutWrapper
	end)
	hooks[ridingAnimal] = hook
	clearHorseRagdollState(ridingAnimal)
	return true
end

function restoreHorseAntiRagdollHooks()
	local connection = playerState.horseAntiRagdollConnection
	if connection then
		pcall(function()
			connection:Disconnect()
		end)
	end
	playerState.horseAntiRagdollConnection = nil

	local hooks = playerState.horseAntiRagdollHooks
	if type(hooks) == "table" then
		for ridingAnimal, hook in pairs(hooks) do
			if isTable(ridingAnimal) and isTable(hook) then
				pcall(function()
					if ridingAnimal.KnockOut == hook.knockOutWrapper then
						ridingAnimal.KnockOut = hook.originalKnockOut
					end
				end)
			end
		end
	end
	playerState.horseAntiRagdollHooks = {}
end

function ensureHorseAntiRagdollHooks()
	if not playerState.horseAntiRagdollEnabled then
		return
	end

	installHorseAntiRagdollHook(resolveRidingAnimal(false) or resolveRidingAnimal(true))

	if playerState.horseAntiRagdollConnection then
		return
	end

	playerState.horseAntiRagdollConnection = _RunService.Heartbeat:Connect(function()
		if not isSessionActive() or not playerState.horseAntiRagdollEnabled then
			restoreHorseAntiRagdollHooks()
			return
		end
		installHorseAntiRagdollHook(resolveRidingAnimal(false) or resolveRidingAnimal(true))
	end)
end

