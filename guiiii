		return math.max(1.8, math.min(3.0, baseRange + 1.15))
	end
	return math.max(1.15, math.min(2.4, baseRange + 0.75))
end

function getCFramePathPlaybackDistance(character, rootPart, pathPosition, flyOffset, wantedRange)
	if typeof(pathPosition) ~= "Vector3" then
		return math.huge
	end

	local activeRootPart = rootPart or getRootPart(character)
	if not activeRootPart then
		return math.huge
	end

	local goalPosition = getCFramePathFollowGoalPosition(character, activeRootPart, pathPosition, flyOffset) or pathPosition
	local delta = goalPosition - activeRootPart.Position
	local flatDistance = Vector3.new(delta.X, 0, delta.Z).Magnitude
	local verticalDistance = math.abs(delta.Y)
	local verticalOverage = math.max(0, verticalDistance - getCFramePathVerticalReachDistance(wantedRange))
	return math.max(flatDistance, verticalOverage)
end

function getCFrameFlatPathFollowClearance(character, rootPart)
	local liveClearance = getCharacterGroundClearance(character, rootPart)
	return math.clamp(liveClearance, 1.85, math.max(2.45, TWEEN_GROUND_CLEARANCE - 0.7))
end

function getCFramePathFollowBaseY(character, rootPart, pathPosition)
	if typeof(pathPosition) ~= "Vector3" then
		return rootPart and rootPart.Position.Y or 0
	end

	local clearanceOffset = getCFrameFlatPathFollowClearance(character, rootPart)
	local groundedTarget = getGroundAlignedPathPosition(pathPosition, character)
	if not groundedTarget then
		return pathPosition.Y + clearanceOffset
	end

	local stayGrounded = type(isPathStayGroundedEnabled) ~= "function" or isPathStayGroundedEnabled()
	if not stayGrounded and groundedTarget.Y > (pathPosition.Y + CFRAME_PATH_MAX_GROUND_ABOVE_NODE) then
		return pathPosition.Y + clearanceOffset
	end

	local groundedRootY = groundedTarget.Y + clearanceOffset
	if stayGrounded then
		return groundedRootY
	end

	local liftedPathOffset = math.max(0, pathPosition.Y - groundedTarget.Y)
	return groundedRootY + liftedPathOffset
end

function getCFramePathFollowGoalPosition(character, rootPart, pathPosition, flyOffset)
	if typeof(pathPosition) ~= "Vector3" then
		return nil
	end

	local goalY = getCFramePathFollowBaseY(character, rootPart, pathPosition) + (tonumber(flyOffset) or 0)
	return Vector3.new(pathPosition.X, goalY, pathPosition.Z)
end

function getCFramePathDescentGuardY(character, rootPart, xzPosition, flyOffset)
	if typeof(xzPosition) ~= "Vector3" then
		return nil
	end

	local activeRoot = rootPart or getRootPart(character)
	if not activeRoot then
		return nil
	end

	local ignoreInstances = {}
	local recordedPathFolder = type(getRecordedPathFolder) == "function" and getRecordedPathFolder() or workspace:FindFirstChild(RECORDED_PATH_FOLDER_NAME)
	if recordedPathFolder then
		table.insert(ignoreInstances, recordedPathFolder)
	end
	local visualizerFolder = type(getVisualizerFolder) == "function" and getVisualizerFolder() or workspace:FindFirstChild(VISUALIZER_FOLDER_NAME)
	if visualizerFolder then
		table.insert(ignoreInstances, visualizerFolder)
	end
	local avoiderVisualizerFolder = workspace:FindFirstChild(PLAYER_AVOIDER_VISUALIZER_FOLDER_NAME)
	if avoiderVisualizerFolder then
		table.insert(ignoreInstances, avoiderVisualizerFolder)
	end
	if character then
		table.insert(ignoreInstances, character)
	end

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = ignoreInstances

	local scanOrigin = Vector3.new(xzPosition.X, activeRoot.Position.Y + CFRAME_PATH_DESCENT_GUARD_UP, xzPosition.Z)
	local scanDistance = math.max(CFRAME_PATH_DESCENT_GUARD_DOWN, (tonumber(flyOffset) or 0) + TWEEN_GROUND_CLEARANCE + 8)
	local ray = workspace:Raycast(scanOrigin, Vector3.new(0, -scanDistance, 0), raycastParams)
	if not ray or not ray.Position or (ray.Normal and ray.Normal.Y < 0.25) then
		return nil
	end

	if ray.Position.Y > activeRoot.Position.Y + 0.35 then
		return nil
	end

	return ray.Position.Y + getCFrameFlatPathFollowClearance(character, activeRoot) + (tonumber(flyOffset) or 0)
end

function restoreMineAura()
	for part, original in pairs(auraOriginalParts) do
		if part and part.Parent then
			pcall(function()
				part.Size = original.Size
			end)
		end
		auraOriginalParts[part] = nil
	end
end

function applyMineAuraToPickaxe(pickaxe)
	if not mineAuraEnabled or not pickaxe then
		return
	end

	for _, descendant in ipairs(pickaxe:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local partName = safeLower(descendant.Name)
			if string.find(partName, "hitbox", 1, true) ~= nil then
				if not auraOriginalParts[descendant] then
					auraOriginalParts[descendant] = {
						Size = descendant.Size,
					}
				end

				pcall(function()
					local baseSize = auraOriginalParts[descendant].Size
					descendant.Size = Vector3.new(
						baseSize.X * MINE_AURA_MULTIPLIER,
						baseSize.Y * MINE_AURA_MULTIPLIER,
						baseSize.Z * MINE_AURA_MULTIPLIER
					)
				end)
			end
		end
	end
end

function pushDebug(text)
	local line = tostring(text)
	if #line > 360 then
		line = string.sub(line, 1, 357) .. "..."
	end
	if debugLines[1] == line then
		return
	end

	warn("[AutoMine] " .. line)

	table.insert(debugLines, 1, line)
	while #debugLines > 3 do
		table.remove(debugLines)
	end

	if debugLabel then
		pcall(function()
			debugLabel.Text = table.concat(debugLines, "\n")
		end)
	end
end

