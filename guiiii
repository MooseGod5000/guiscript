function recordSmartStaffAvoidedPlayer(player, options)
	if not (isPathSmartStaffDetectionEnabled() and player and player ~= localPlayer) then
		return false
	end

	local userId = tonumber(player.UserId)
	if not userId then
		return false
	end

	local recordOptions = type(options) == "table" and options or {}
	local memory = loadSmartStaffMemory()
	local previousEntry = normalizeSmartStaffMemoryEntry(memory[tostring(userId)])
	if previousEntry
		and tostring(previousEntry.serverId or "") == tostring(game.JobId or "")
		and (os.time() - (tonumber(previousEntry.loggedAt) or 0)) < 15 then
		if recordOptions.forceKickOnFollow == true and previousEntry.forceKickOnFollow ~= true then
			previousEntry.forceKickOnFollow = true
			previousEntry.reason = tostring(recordOptions.reason or "staff_hop")
			previousEntry.staffRank = tostring(recordOptions.staffRank or previousEntry.staffRank or "")
			memory[tostring(userId)] = previousEntry
			S._smartStaffMemory = memory
			saveSmartStaffMemory()
		end
		return true
	end
	local entry = {
		userId = userId,
		name = tostring(player.Name or ""),
		displayName = tostring(player.DisplayName or ""),
		serverId = tostring(game.JobId or ""),
		placeId = game.PlaceId,
		loggedAt = os.time(),
		reason = tostring(recordOptions.reason or "player_avoider"),
		followWarningCount = previousEntry and previousEntry.followWarningCount or 0,
		followWarningServerId = previousEntry and previousEntry.followWarningServerId or "",
		followWarningAt = previousEntry and previousEntry.followWarningAt or 0,
		forceKickOnFollow = recordOptions.forceKickOnFollow == true or (previousEntry and previousEntry.forceKickOnFollow == true) or false,
		staffRank = tostring(recordOptions.staffRank or (previousEntry and previousEntry.staffRank) or ""),
	}
	memory[tostring(userId)] = entry
	S._smartStaffMemory = memory
	saveSmartStaffMemory()
	pushDebugRateLimited(
		"smart_staff_memory_" .. tostring(userId),
		"smart staff memory: logged " .. tostring(player.Name or userId) .. " for 2h",
		8
	)
	return true
end

function getSmartStaffFollowEntry(player)
	if not (isPathSmartStaffDetectionEnabled() and player and player ~= localPlayer) then
		return nil
	end

	local userId = tonumber(player.UserId)
	if not userId then
		return nil
	end

	local memory = loadSmartStaffMemory()
	local entry = normalizeSmartStaffMemoryEntry(memory[tostring(userId)])
	if not entry then
		return nil
	end
	if tostring(entry.serverId or "") == tostring(game.JobId or "") then
		return nil
	end
	if (os.time() - (tonumber(entry.loggedAt) or 0)) > (tonumber(SMART_STAFF_MEMORY_SECONDS) or 7200) then
		memory[tostring(userId)] = nil
		saveSmartStaffMemory()
		return nil
	end
	return entry
end

function kickForSmartStaffDetection(reason, flagType, detailText, flagContext)
	if S._smartStaffKickQueued then
		return true
	end
	S._smartStaffKickQueued = true
	local kickReason = tostring(reason or "Smart staff detection")
	task.spawn(function()
		pcall(sendDiscordAutomineFlagWebhook, flagType or "staff_alt", detailText or kickReason, flagContext)
		task.wait(0.18)
		pcall(function()
			localPlayer:Kick(kickReason)
		end)
	end)
	return true
end

function warnForSmartStaffFollow(player, followedEntry)
	if not (player and followedEntry) then
		return false
	end
	local userId = tonumber(player.UserId)
	if not userId then
		return false
	end
	local currentServerId = tostring(game.JobId or "")
	if tostring(followedEntry.followWarningServerId or "") == currentServerId and (tonumber(followedEntry.followWarningCount) or 0) >= 1 then
		return false
	end

	local memory = loadSmartStaffMemory()
	local entry = normalizeSmartStaffMemoryEntry(memory[tostring(userId)]) or followedEntry
	entry.followWarningCount = math.max(1, (tonumber(entry.followWarningCount) or 0) + 1)
	entry.followWarningServerId = currentServerId
	entry.followWarningAt = os.time()
	memory[tostring(userId)] = entry
	S._smartStaffMemory = memory
	saveSmartStaffMemory()

	local detail = "Previously avoided player joined this server after you. Warning 1/2; kick on the next followed server."
	pcall(sendDiscordAutomineFlagWebhook, "follow_warning", detail, {
		player = player,
		detectedPlayer = player,
		staffPlayer = player,
		previousServerId = tostring(entry.serverId or ""),
		currentServerId = currentServerId,
		loggedAt = tonumber(entry.loggedAt) or 0,
		followWarnings = entry.followWarningCount,
	})
	spawnNotification("FOLLOW WARNING: " .. tostring(player.Name) .. " joined after you. Kick next time.", "warning", true, 5)
	pushDebugRateLimited(
		"smart_staff_follow_warning_" .. tostring(userId),
		"smart staff follow warning: " .. tostring(player.Name or userId) .. " joined after you once",
		8
	)
	return true
end

function checkSmartStaffDetectionPlayer(player, joinedAfterLocal)
	if not (isPathSmartStaffDetectionEnabled() and player and player ~= localPlayer) then
		return false
	end

	local accountAge = tonumber(player.AccountAge)
	if accountAge and accountAge < SMART_STAFF_DETECTION_ACCOUNT_AGE_DAYS then
		local detail = string.format("Under-%d-day account detected in server.", SMART_STAFF_DETECTION_ACCOUNT_AGE_DAYS)
		return kickForSmartStaffDetection(
			"Staff alt detected: " .. tostring(player.Name),
			"staff_alt",
			detail,
			{
				player = player,
				detectedPlayer = player,
				staffPlayer = player,
				accountAge = accountAge,
				currentServerId = tostring(game.JobId or ""),
			}
		)
	end

	if joinedAfterLocal == true then
		local followedEntry = getSmartStaffFollowEntry(player)
		if followedEntry then
			local currentServerId = tostring(game.JobId or "")
			local warningCount = tonumber(followedEntry.followWarningCount) or 0
			local warningServerId = tostring(followedEntry.followWarningServerId or "")
			if followedEntry.forceKickOnFollow == true or (warningCount >= 1 and warningServerId ~= currentServerId) then
				local detail = followedEntry.forceKickOnFollow == true
					and "Previously detected staff joined this server after a staff hop."
					or "Previously avoided player followed into more than one server."
				return kickForSmartStaffDetection(
					SMART_STAFF_KICK_REASON_FOLLOWED,
					"followed",
					detail,
					{
						player = player,
						detectedPlayer = player,
						staffPlayer = player,
						previousServerId = tostring(followedEntry.serverId or ""),
						currentServerId = currentServerId,
						loggedAt = tonumber(followedEntry.loggedAt) or 0,
						followWarnings = warningCount,
						staffRank = followedEntry.staffRank,
					}
				)
			end
			warnForSmartStaffFollow(player, followedEntry)
			return false
		end
	end

	return false
end

function scanCurrentSmartStaffDetection(mode)
	if not isPathSmartStaffDetectionEnabled() then
		return false
	end
	loadSmartStaffMemory()
	for _, player in ipairs(_Players:GetPlayers()) do
		if player ~= localPlayer and checkSmartStaffDetectionPlayer(player, false) then
			return true
		end
	end
	return false
end

function evaluateTwwStaffPlayer(player)
    if not player or player == localPlayer then
        return false
    end

    local cached = S._staffCache[player.UserId]
    if cached ~= nil then
        return cached
    end

    local roleName = nil
    local okRole = pcall(function()
        roleName = player:GetRoleInGroup(S._staffGroupId)
    end)

    if okRole and roleName and S._staffRoles[roleName] then
        cached = {
            roleName = roleName,
        }
    else
        cached = false
    end

    S._staffCache[player.UserId] = cached
    return cached
end

function checkTwwStaffPlayer(player)
    if not player or player == localPlayer then
        return
    end

    task.spawn(function()
        if S._smartStaffKickQueued then
            return
        end
        local staffData = evaluateTwwStaffPlayer(player)
        if not staffData then
            return
        end

        if S.staffNotifyEnabled then
            spawnNotification("STAFF ALERT: " .. player.Name .. " (" .. tostring(staffData.roleName or "Staff") .. ") is in your server.", "warning", true)
        end
        if pathState and pathState.staffHopEnabled then
            recordSmartStaffAvoidedPlayer(player, {
                reason = "staff_hop",
                forceKickOnFollow = true,
                staffRank = staffData.roleName,
            })
            local resumeSlotIndex = getPathCycleRestartSlotIndex()
            if requestPathServerHop("Staff detected, hopping servers...", resumeSlotIndex, true, "staff", {
                staffPlayer = player,
                staffRank = staffData.roleName,
                staffData = staffData,
            }) then
                return
            end
        end
        if S.staffKickEnabled then
            localPlayer:Kick("Staff detected in your server: " .. player.Name .. " (" .. tostring(staffData.roleName or "Staff") .. ")")
        end
    end)
end

function scanCurrentTwwStaff(mode)
    if S._smartStaffKickQueued then
        return
    end
    for _, player in ipairs(_Players:GetPlayers()) do
        if S._smartStaffKickQueued then
            return
        end
        if player ~= localPlayer then
            local staffData = evaluateTwwStaffPlayer(player)
            if staffData then
                if mode == "notify" then
                    spawnNotification("STAFF ALERT: " .. player.Name .. " (" .. tostring(staffData.roleName or "Staff") .. ") is in your server.", "warning", true)
                    if pathState and pathState.staffHopEnabled then
                        recordSmartStaffAvoidedPlayer(player, {
                            reason = "staff_hop",
                            forceKickOnFollow = true,
                            staffRank = staffData.roleName,
                        })
                        local resumeSlotIndex = getPathCycleRestartSlotIndex()
                        if requestPathServerHop("Staff detected, hopping servers...", resumeSlotIndex, true, "staff", {
                            staffPlayer = player,
                            staffRank = staffData.roleName,
                            staffData = staffData,
                        }) then
                            return
                        end
                    end
                elseif mode == "kick" then
                    localPlayer:Kick("Staff detected in your server: " .. player.Name .. " (" .. tostring(staffData.roleName or "Staff") .. ")")
                    return
                end
            end
        end
    end
end

