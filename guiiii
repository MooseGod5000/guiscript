local function getPathHopOnDeathHumanoid()
	local playersFolder = getTwwEntityPlayersFolder()
	local worldCharacter = playersFolder and playersFolder:FindFirstChild(localPlayer.Name) or getWorldCharacterForPlayer(localPlayer)
	if worldCharacter then
		local worldHumanoid = worldCharacter:FindFirstChild("Humanoid") or worldCharacter:FindFirstChildOfClass("Humanoid")
		if worldHumanoid then
			return worldHumanoid, worldCharacter
		end
		if playersFolder and worldCharacter.Parent == playersFolder then
			return nil, worldCharacter
		end
	end

	local customCharacter = getCustomCharacter()
	if customCharacter then
		local customHumanoid = customCharacter:FindFirstChild("Humanoid") or customCharacter:FindFirstChildOfClass("Humanoid")
		if customHumanoid then
			return customHumanoid, customCharacter
		end
	end

	local defaultCharacter = localPlayer and localPlayer.Character
	if defaultCharacter then
		return getHumanoid(defaultCharacter), defaultCharacter
	end

	return nil, nil
end

local function handlePathHopOnDeathTriggered()
	local suppressed = shouldSuppressPathDeathHop()
	if not shouldPathHopOnDeath() or suppressed or serverHopInProgress or serverHopTaskQueued then
		return
	end
	if not pathDeathHopArmed then
		pushDebugRateLimited("path_death_hop_unarmed", "death signal ignored before in-world alive state", 3)
		return
	end
	local now = os.clock()
	if (now - (tonumber(lastPathDeathHopAt) or 0)) < 2 then
		return
	end
	lastPathDeathHopAt = now
	requestPathServerHop("Character died, hopping servers...", getPathCycleRestartSlotIndex(), true, "death")
end

local function pollPathCustomDeathHop()
	if not shouldPathHopOnDeath() then
		pathDeathHopCustomDead = false
		pathDeathHopArmed = false
		return false
	end

	local suppressed, suppressReason = shouldSuppressPathDeathHop()
	if suppressed then
		pathDeathHopCustomDead = false
		pushDebugRateLimited("path_death_hop_suppressed", "hop-on-death suppressed on " .. tostring(suppressReason or "spawn state"), 5)
		return false
	end

	local isDead, reason = getPathCustomDeathSignal()
	if not isDead then
		pathDeathHopCustomDead = false
		return false
	end

	if not pathDeathHopCustomDead then
		pathDeathHopCustomDead = true
		if pathDeathHopArmed then
			pushDebugRateLimited("path_death_hop_detected", "death detected via " .. tostring(reason or "custom character state"), 1)
			handlePathHopOnDeathTriggered()
		else
			pushDebugRateLimited("path_death_hop_unarmed", "death signal ignored before in-world alive state: " .. tostring(reason or "custom character state"), 5)
		end
	end
	return true
end

function refreshPathDeathHopConnection()
	if not shouldPathHopOnDeath() then
		disconnectPathDeathHopConnection()
		pathDeathHopArmed = false
		return
	end

	if pollPathCustomDeathHop() then
		disconnectPathDeathHopConnection()
		pathDeathHopCustomDead = true
		return
	end

	local humanoid, ownerCharacter = getPathHopOnDeathHumanoid()
	if not humanoid or humanoid.Health <= 0 then
		disconnectPathDeathHopConnection()
		return
	end
	armPathDeathHopIfAlive()

	if humanoid == pathDeathHopHumanoid and pathDeathHopDiedConnection then
		return
	end

	disconnectPathDeathHopConnection()
	pathDeathHopHumanoid = humanoid
	pathDeathHopBoundName = ownerCharacter and ownerCharacter:GetFullName() or humanoid:GetFullName()
	pathDeathHopDiedConnection = humanoid.Died:Connect(function()
		if humanoid ~= pathDeathHopHumanoid then
			return
		end
		if shouldSuppressPathDeathHop() or not pathDeathHopArmed then
			pushDebugRateLimited("path_death_hop_unarmed", "humanoid death ignored before in-world alive state", 3)
			return
		end
		handlePathHopOnDeathTriggered()
	end)
end

