	end

	playerState.horseOrbitConnection = _RunService.RenderStepped:Connect(function(dt)
		if not isSessionActive() or not playerState.horseOrbitEnabled then
			restoreHorseOrbitHooks()
			return
		end
		applyHorseOrbitPulse(dt)
	end)
end

