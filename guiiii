function setPlayerEspMethodEnabled(methodName, isEnabled)
    local nextMethods = clonePlayerEspMethods(S.playerEspMethods)
    nextMethods[tostring(methodName)] = isEnabled == true
    S.playerEspMethods = clonePlayerEspMethods(nextMethods)
end

function togglePlayerEspMethod(methodName)
    local methodKey = tostring(methodName or "")
    if methodKey == "" then
        return
    end

    local nextValue = not isPlayerEspMethodEnabled(methodKey)
    local enabledCount = 0
    if nextValue == false then
        for _, otherMethod in ipairs(PLAYER_ESP_METHOD_ORDER) do
            if otherMethod ~= methodKey and isPlayerEspMethodEnabled(otherMethod) then
                enabledCount = enabledCount + 1
            end
        end
        if enabledCount == 0 then
            nextValue = true
        end
    end

    setPlayerEspMethodEnabled(methodKey, nextValue)
end

function getPlayerEspMethodLabel()
    local enabledMethods = {}
    for _, methodName in ipairs(PLAYER_ESP_METHOD_ORDER) do
        if isPlayerEspMethodEnabled(methodName) then
            table.insert(enabledMethods, methodName)
        end
    end

    if #enabledMethods == 0 then
        return "Text"
    end
    if #enabledMethods == 1 then
        return enabledMethods[1]
    end

    return enabledMethods[1] .. " +" .. tostring(#enabledMethods - 1)
end

