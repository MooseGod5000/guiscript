			return root.Position + (right * centered * 2.2) + (forward * math.sin(phase) * 2.5) + Vector3.new(0, 2.5 + math.sin(phase * 1.7) * 2, 0)
		elseif S.moneyBagDanceMode == "Figure8" then
			return root.Position + Vector3.new(math.sin(phase) * 7, 4, math.sin(phase * 2) * 4)
		elseif S.moneyBagDanceMode == "Bounce" then
			return root.Position + Vector3.new(math.cos(phase) * 6, 3.5 + math.abs(math.sin(now * 3 + index)) * 4, math.sin(phase) * 6)
