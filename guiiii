    if spreadAngle <= 0 then
        return forward
    end
    local rngSeed = tonumber(seed) or 0
    local randomObject = Random.new(rngSeed)
    local randomized = (
        CFrame.new(Vector3.new(), forward)
        * CFrame.Angles(0, 0, randomObject:NextNumber(0, 2 * math.pi))
        * CFrame.Angles(math.acos(randomObject:NextNumber(math.cos(spreadAngle), 1)), 0, 0)
    ).LookVector
