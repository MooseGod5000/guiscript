function togglePathPlayerAvoiderMethod(methodName)
	local candidate = tostring(methodName or "")
	local methodKey = nil
	for _, knownMethod in ipairs(PATH_PLAYER_AVOIDER_METHOD_ORDER) do
		if string.lower(candidate) == string.lower(knownMethod) then
			methodKey = knownMethod
			break
		end
	end
	if not methodKey then
		return
	end

	local nextMethods = getPathPlayerAvoiderMethods()
	local nextValue = not (nextMethods[methodKey] == true)
	if nextValue == false then
		local enabledCount = 0
		for _, otherMethod in ipairs(PATH_PLAYER_AVOIDER_METHOD_ORDER) do
			if otherMethod ~= methodKey and nextMethods[otherMethod] == true then
				enabledCount = enabledCount + 1
			end
		end
		if enabledCount == 0 then
			nextValue = true
		end
	end
	nextMethods[methodKey] = nextValue
	setPathPlayerAvoiderMethods(nextMethods)
end

