	end
	if type(getCanPlace) ~= "function" then
		return nil
	end
	local okPlace, placementCFrame = pcall(getCanPlace, placeModule)
	if okPlace and typeof(placementCFrame) == "CFrame" then
		placeableMiscApplyPreview(placeModule, placementCFrame)
		return placementCFrame
	end
	return nil
end
function placeableMiscGetBypassPlacementCFrame(placeModule)
