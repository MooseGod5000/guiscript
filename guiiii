local function createToggleRow(name, parentList, getStateFn, onClickFn)
    local row, icon, label, topLine, bottomLine, diamond = createRow(name)
    row.Parent = parentList
    local updateVis = applyHoverState(row, icon, label, topLine, bottomLine, diamond, true, getStateFn)
    local toggleAnimating = false
    local toggleAnimToken = 0

    local textContainer = Instance.new("Frame")
    textContainer.Size = UDim2.new(0, 50, 1, 0)
    textContainer.Position = UDim2.new(1, -65, 0, 0)
    textContainer.BackgroundTransparency = 1
    textContainer.ClipsDescendants = true
    textContainer.Parent = row

    local offLabel = Instance.new("TextLabel")
    offLabel.Size = UDim2.new(1, 0, 1, 0)
    offLabel.BackgroundTransparency = 1
    offLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
    offLabel.Text = "OFF"
    offLabel.Font = Enum.Font.GothamMedium
    offLabel.TextSize = 13
    offLabel.TextXAlignment = Enum.TextXAlignment.Right
    offLabel.Parent = textContainer

    local onLabel = Instance.new("TextLabel")
    onLabel.Size = UDim2.new(1, 0, 1, 0)
    onLabel.Position = UDim2.new(1, 0, 0, 0)
    onLabel.BackgroundTransparency = 1
    onLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    onLabel.Text = "ON"
    onLabel.Font = Enum.Font.GothamMedium
    onLabel.TextSize = 13
    onLabel.TextXAlignment = Enum.TextXAlignment.Right
    onLabel.Parent = textContainer

    local function syncLabels(forceInstant)
        if toggleAnimating and not forceInstant then
            updateVis(false)
            return
        end
        if getStateFn() then
            offLabel.Position = UDim2.new(-1, 0, 0, 0)
            onLabel.Position = UDim2.new(0, 0, 0, 0)
        else
            offLabel.Position = UDim2.new(0, 0, 0, 0)
            onLabel.Position = UDim2.new(1, 0, 0, 0)
        end
        updateVis(false)
    end

    syncLabels()
    registerUiSync(_allToggleSyncs, syncLabels)

    if _currentRegistryTab then
        registerButtonEntry({
            name = name,
            tab = _currentRegistryTab,
            type = "toggle",
            getStateFn = getStateFn,
            onClickFn = onClickFn,
        })
    end

	row.MouseButton1Click:Connect(function()
		if destroyed then
			return
		end
		pcall(function()
			_UTILS._createParticleBurst(row)
		end)
		local clickOk, clickErr = xpcall(onClickFn, debug.traceback)
		if not clickOk then
			if type(pushDebug) == "function" then
				pushDebug(clickErr)
			end
			return
		end
		toggleAnimating = true
		toggleAnimToken = toggleAnimToken + 1
		local myAnimToken = toggleAnimToken
		local animOk, animErr = pcall(function()
			local slideInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			if getStateFn() then
				_TweenService:Create(offLabel, slideInfo, {Position = UDim2.new(-1, 0, 0, 0)}):Play()
				_TweenService:Create(onLabel, slideInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()
			else
				_TweenService:Create(offLabel, slideInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()
				_TweenService:Create(onLabel, slideInfo, {Position = UDim2.new(1, 0, 0, 0)}):Play()
			end
			updateVis(true)
		end)
		if not animOk then
			toggleAnimating = false
			task.defer(function()
				pcall(syncLabels, true)
				pcall(syncAllUi)
			end)
			if not (type(isUiInstanceAccessError) == "function" and isUiInstanceAccessError(animErr)) and type(pushDebug) == "function" then
				pushDebug(animErr)
			end
			return
		end
        task.defer(function()
            pcall(syncAllUi)
        end)
        task.delay(0.31, function()
            if destroyed or myAnimToken ~= toggleAnimToken then
                return
            end
            toggleAnimating = false
            pcall(syncLabels, true)
        end)
    end)

    return row, updateVis, syncLabels, label, offLabel, onLabel
end

