               local hum = char and char:FindFirstChild("Humanoid")
               if root and hum and hum.Health > 0 then
                   local bestGem = getBestGem()
                   if bestGem then
                       -- Enable noclip when we start collecting gems
                       if not tweenNoclipActive then
                           enableNoclip()
                           tweenNoclipActive = true
                       end
                       -- Constantly update position to follow the gem (e.g. falling from sky)
                       local gemPos = bestGem.CFrame + Vector3.new(0, 2, 0)
                       local dist = (root.Position - gemPos.Position).Magnitude
                       if dist > 1 then
                           -- Cancel old tween if gem changed or moved significantly
                           if activeTween then
                               activeTween:Cancel()
                               activeTween = nil
                           end
                           local tweenTime = math.clamp(dist / S.gemTweenSpeed, 0.05, 2)
                           activeTween = _TweenService:Create(root, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {
                               CFrame = gemPos
                           })
                           activeTween:Play()
                       end
                       lastGemTarget = bestGem
                   else
                       -- No gems left: disable noclip and teleport to demon safe spot
                       if activeTween then activeTween:Cancel() activeTween = nil end
                       lastGemTarget = nil
                       if tweenNoclipActive then
                           disableNoclip()
                           tweenNoclipActive = false
                           if root then
                               root.CFrame = _DEMON_SAFE_SPOT
                               breakVelocity(root)
                           end
                       end
                   end
               end
           else
               if activeTween then activeTween:Cancel() activeTween = nil end
               lastGemTarget = nil
               if tweenNoclipActive then
                   disableNoclip()
                   tweenNoclipActive = false
               end
           end
           task.wait(0.1)
       end
   end)
   -- ======= SMART BOT LOOP (reworked) ======= --
   -- Uses pathfinding with robust fallbacks: direct walk, short teleport hops, and
   -- CFrame-based movement when stuck. Re-paths frequently to track moving gems.
   task.spawn(function()
       local _DEMON_SAFE_SPOT_BOT = CFrame.new(-2044.74548, 499.961731, -1937.68774)
       local botConsecutiveFails = 0
       while true do
           if S.gemBotEnabled and not S.demonIsFollowing and not S.generalIsFollowing and not S.npcIsFollowing then
               local char = _Players.LocalPlayer.Character
               local root = char and char:FindFirstChild("HumanoidRootPart")
               local hum = char and char:FindFirstChildOfClass("Humanoid")
               if root and hum and hum.Health > 0 then
                   local currentTarget, isUnknown = getBestGem()
                   if currentTarget then
                       botConsecutiveFails = 0
                       local targetPos = currentTarget.Position
                       local dist = (root.Position - targetPos).Magnitude
                       -- Strategy 1: If very close, just walk directly
                       if dist < 8 then
                           hum:MoveTo(targetPos)
                           if targetPos.Y - root.Position.Y > 2 then hum.Jump = true end
                           task.wait(0.3)
                       else
                           -- Strategy 2: Try pathfinding first
                           local path = _PathfindingService:CreatePath({
                               AgentRadius = 2, AgentHeight = 5,
                               AgentCanJump = true, AgentCanClimb = true,
                               WaypointSpacing = 6,
                           })
                           local pathSuccess = pcall(function() path:ComputeAsync(root.Position, targetPos) end)
                           if pathSuccess and path.Status == Enum.PathStatus.Success then
                               local waypoints = path:GetWaypoints()
                               drawPath(waypoints, isUnknown)
                               local stuckTotal = 0
                               for i, waypoint in ipairs(waypoints) do
                                   -- Bail conditions
                                   if not S.gemBotEnabled then break end
                                   if not currentTarget or currentTarget.Parent == nil or currentTarget.Transparency == 1 then break end
                                   -- Re-check if a better (known) gem appeared
                                   local freshTarget, freshIsUnknown = getBestGem()
                                   if freshTarget ~= currentTarget then
                                       -- A closer gem appeared, break and re-target next loop
                                       if not isUnknown or (freshTarget and not freshIsUnknown) then break end
                                   end
                                   -- Pre-jump for height changes
                                   if waypoint.Action == Enum.PathWaypointAction.Jump then hum.Jump = true task.wait(0.05) end
                                   if i < #waypoints then
                                       local heightDiff = waypoints[i+1].Position.Y - root.Position.Y
                                       if heightDiff > 1.5 then hum.Jump = true task.wait(0.05) end
                                   end
                                   -- Move to waypoint
                                   hum:MoveTo(waypoint.Position)
                                   local timeStarted = tick()
                                   local lastPos = root.Position
                                   local waypointReached = false
                                   while S.gemBotEnabled and tick() - timeStarted < 1.5 do
                                       task.wait(0.05)
                                       local d = (root.Position - waypoint.Position).Magnitude
                                       if d < 4 then waypointReached = true break end
                                       local movedDist = (root.Position - lastPos).Magnitude
                                       if tick() - timeStarted > 0.4 and movedDist < 0.3 then
                                           -- Stuck: try jumping first
                                           hum.Jump = true
                                           stuckTotal = stuckTotal + 1
                                           if stuckTotal > 3 then
                                               -- Really stuck: short teleport hop toward waypoint
                                               local dir = (waypoint.Position - root.Position).Unit
                                               root.CFrame = CFrame.new(root.Position + dir * math.min(d, 10))
                                               stuckTotal = 0
                                               break
                                           end
                                       end
                                       lastPos = root.Position
                                   end
                                   if not waypointReached and (root.Position - waypoint.Position).Magnitude > 8 then break end
                               end
                           else
                               -- Strategy 3: Pathfinding failed — walk directly or hop
                               if currentTarget and currentTarget.Parent then
                                   if dist < 50 then
                                       -- Try direct walk with jumping
                                       hum:MoveTo(targetPos)
                                       if targetPos.Y - root.Position.Y > 1.5 then hum.Jump = true end
                                       local walkStart = tick()
                                       local walkStartPos = root.Position
                                       while S.gemBotEnabled and tick() - walkStart < 2 do
                                           task.wait(0.1)
                                           local moved = (root.Position - walkStartPos).Magnitude
                                           local remaining = (root.Position - targetPos).Magnitude
                                           if remaining < 4 then break end
                                           if tick() - walkStart > 0.5 and moved < 1 then
                                               -- Stuck: teleport hop toward gem
                                               local dir = (targetPos - root.Position).Unit
                                               root.CFrame = CFrame.new(root.Position + dir * math.min(remaining, 15))
                                               break
                                           end
                                       end
                                   else
                                       -- Too far for walking, teleport closer in hops
                                       local dir = (targetPos - root.Position).Unit
                                       root.CFrame = CFrame.new(root.Position + dir * 30)
                                       task.wait(0.2)
                                   end
                               end
                           end
                       end
                   else
                       -- No gems available: teleport to demon safe spot
                       botConsecutiveFails = botConsecutiveFails + 1
                       if botConsecutiveFails > 3 then
                           if root then
                               root.CFrame = _DEMON_SAFE_SPOT_BOT
                               breakVelocity(root)
                           end
                           botConsecutiveFails = 0
                       end
                   end
               end
           end
           pathVisualsFolder:ClearAllChildren()
           task.wait(0.15)
       end
   end)
   -- ======= DISCORD WEBHOOK GEM COLLECTION MONITOR ======= --
   -- Excluded gem IDs that should NOT trigger a webhook message even if targeted:
   local _webhookExcludedGemIds = {[1] = true, [51] = true, [39] = true} -- Red Diamond, Legendary Shard, Ice Gem
   task.spawn(function()
       local previousGems = {} -- {gemPart = gemId}
       while true do
           if S.psWebhookEnabled and S.psWebhookUrl ~= "" and _webhookValidated then
               local root = _Players.LocalPlayer.Character and _Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
               if root then
                   -- Build current gem snapshot from cache
                   local currentGems = {}
                   local gems = refreshGemCache()
                   for _, gemData in ipairs(gems) do
                       if gemData.part and gemData.part.Parent and gemData.part.Transparency < 1 then
                           currentGems[gemData.part] = gemData.id
                       end
                   end
                   -- Check which gems from previous snapshot are now gone (collected)
                   for gemPart, gemId in pairs(previousGems) do
                       if not currentGems[gemPart] then
                           -- This gem disappeared - check if player was close enough to have collected it
                           local wasNear = true -- assume collected since we were farming
                           local gemName = gemValues[gemId]
                           if gemName then
                               -- It's a known/targeted gem
                               if selectedGems[gemId] then
                                   _webhookStats.targetedGems[gemName] = (_webhookStats.targetedGems[gemName] or 0) + 1
                                   -- Check if this targeted gem should trigger a webhook send
                                   if not _webhookExcludedGemIds[gemId] then
                                       -- Send webhook message with all tracked stats
                                       local player = _Players.LocalPlayer
                                       local leaderstats = player and player:FindFirstChild("leaderstats")
                                       local goldVal = leaderstats and leaderstats:FindFirstChild("Gold")
                                       local xpVal = leaderstats and leaderstats:FindFirstChild("XP")
                                       local goldEarned = (goldVal and goldVal.Value or 0) - _webhookStats.goldStart
                                       local xpEarned = (xpVal and xpVal.Value or 0) - _webhookStats.xpStart
                                       -- Build targeted gems summary
                                       local gemLines = {}
                                       for gName, gCount in pairs(_webhookStats.targetedGems) do
                                           table.insert(gemLines, gName .. ": " .. gCount)
                                       end
                                       local gemSummary = #gemLines > 0 and table.concat(gemLines, ", ") or "None"
                                       -- Build the embed
                                       local embedFields = {
                                           {name = "Gold Earned", value = tostring(goldEarned), inline = true},
                                           {name = "XP Earned", value = tostring(xpEarned), inline = true},
                                           {name = "Generals Killed", value = tostring(_webhookStats.generalsKilled), inline = true},
                                           {name = "Demons Killed", value = tostring(_webhookStats.demonsKilled), inline = true},
                                           {name = "Unknown Gems Picked Up", value = tostring(_webhookStats.unknownGemsPickedUp), inline = true},
                                           {name = "Targeted Gems Picked Up", value = gemSummary, inline = false},
                                       }
                                       local payload = {
                                           embeds = {{
                                               title = "FOB Autofarm Stats",
                                               description = "Triggered by picking up: **" .. gemName .. "**",
                                               color = 3066993, -- green
                                               fields = embedFields,
                                               footer = {text = "Player: " .. player.Name},
                                               timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
                                           }}
                                       }
                                       task.spawn(function()
                                           sendDiscordWebhook(S.psWebhookUrl, payload)
                                       end)
                                       -- Reset stats after sending
                                       resetWebhookStats()
                                   end
                               else
                                   -- Known gem but not selected as target = unknown pickup
                                   _webhookStats.unknownGemsPickedUp = _webhookStats.unknownGemsPickedUp + 1
                               end
                           else
                               -- Truly unknown gem (not in gemValues table)
                               _webhookStats.unknownGemsPickedUp = _webhookStats.unknownGemsPickedUp + 1
                           end
                       end
                   end
                   previousGems = currentGems
               end
           else
               previousGems = {}
           end
           task.wait(0.5)
       end
   end)
end
