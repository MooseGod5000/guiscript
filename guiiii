STARTUP_GATE_MAX_WAIT_SECONDS = 45
STARTUP_GATE_GAME_LOADED_FALLBACK_SECONDS = 35
function startupWarn(message)
    if isEarlyPanicCleanupActive() then
        return
    end
    pcall(warn, "[Westware startup] " .. tostring(message))
end
function getStartupLoadingGate()
    local playerGui = localPlayer and localPlayer:FindFirstChild("PlayerGui")
    return playerGui and playerGui:FindFirstChild("LoadingGate") or nil
end
function isStartupLoadingGateDone(gate)
    if not gate then
        return false
    end
    if gate:GetAttribute("Loaded") == true or gate:GetAttribute("ClientGateResponded") == true then
        return true
    end
    local progress = tonumber(gate:GetAttribute("LoadingProgress"))
    return progress ~= nil and progress >= 100
end
function getStartupGlobalModule()
    local ok, globalModule = pcall(function()
        return rawget(_G, "Global")
    end)
    return ok and type(globalModule) == "table" and globalModule or nil
end
function waitForGameStartupBeforeHub()
    if not LOAD_AFTER_GAME_LOADING_SCREEN then
        return
    end
    local startedAt = os.clock()
    local maxWaitSeconds = STARTUP_GATE_MAX_WAIT_SECONDS
    local reportedLongWait = false
    while os.clock() - startedAt < maxWaitSeconds do
        local elapsed = os.clock() - startedAt
        local globalModule = getStartupGlobalModule()
        if globalModule then
            if globalModule.IsInitializing == true then
                if not reportedLongWait and elapsed >= STARTUP_GATE_GAME_LOADED_FALLBACK_SECONDS then
                    reportedLongWait = true
                    startupWarn("loading gate stayed on Global.IsInitializing; continuing soon if it does not finish")
                end
                task.wait(0.25)
                continue
            end
            if globalModule.IsInitialized == true then
                return
            end
        end
        local loadingGate = getStartupLoadingGate()
        if isStartupLoadingGateDone(loadingGate) and (not globalModule or globalModule.IsInitializing ~= true) then
            return
        end
        if not loadingGate and not globalModule and game:IsLoaded() and (os.clock() - startedAt) >= 2.5 then
            return
        end
        task.wait(0.25)
    end
    startupWarn("loading gate timed out after " .. tostring(maxWaitSeconds) .. "s; continuing")
end
