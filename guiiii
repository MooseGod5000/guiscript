function AutoMine.moveToOre(runtime, ore)
  setStatus(runtime, 'moving to ore')
  analysis_phase("movement controller", "Move toward waypoints/ore using fly, underground, mount, and lagback recovery paths.")
  analysis_evidence("L0199-L0210", "Move the player/horse/fly controller toward ore/path waypoints.", "Crouch_On_Ore | CFrame | LookVector | FindFirstChild")
  analysis_evidence("L0410-L0447", "Set character physics/state flags such as Anchored, PlatformStand, crouch, or ragdoll controls.", "Anchored | PlatformStand | CFrame | V3")
  analysis_evidence("L0486-L0552", "Move the player/horse/fly controller toward ore/path waypoints.", "Check_Server_Quality | Skip_Path_Instead | FindFirstChild | DepositInfo")
  analysis_evidence("L0564-L0566", "Inspect or control horse/mount state for traversal.", "Disconnect")
  local mode = Movement.chooseMode(runtime, ore)
  if mode == 'underground' then
    analysis_phase("underground stealth branch", "Apply hidden/crouched in-ground movement when configured or when nearby-player stealth logic chooses it.")
    analysis_evidence("L0023-L0025", "Set character physics/state flags such as Anchored, PlatformStand, crouch, or ragdoll controls.", "HipHeight | PlatformStand | Anchored")
    analysis_evidence("L0067-L0119", "Report status: Auto Mine | Missing Player Character; Auto Mine | Show Path; Auto Mine | Failed to spawn, cycling paths", "warn | Auto Mine | Missing Player Character | a | Hide_In_Ground")
    analysis_evidence("L0192-L0192", "Set character physics/state flags such as Anchored, PlatformStand, crouch, or ragdoll controls.", "IsDead")
    analysis_evidence("L0199-L0210", "Move the player/horse/fly controller toward ore/path waypoints.", "Crouch_On_Ore | CFrame | LookVector | FindFirstChild")
    return Movement.applyUnderground(runtime, ore)
  end
  HelperSemantics.noteMovement(runtime, mode)
  return analysis_move_to_ore(runtime, ore, mode)
end

function AutoMine.mineOre(runtime, ore)
  setStatus(runtime, 'mining ore')
  analysis_phase("mining and remote actions", "Trigger crouch/sprint/mining remotes, swing animation, hitbox work, and ore depletion checks.")
  analysis_evidence("L0334-L0370", "Invoke Roblox server remote(s), likely mining/combat/crouch action.", "next | GetChildren | IsCrouchButtonDown | FireServer")
  analysis_evidence("L0452-L0467", "Invoke Roblox server remote(s), likely mining/combat/crouch action.", "IsCrouchButtonDown | FireServer | Play_Dead | DepositInfo")
  analysis_evidence("L0477-L0480", "Perform pickaxe/swing/hitbox mining action.", "Hitbox | Fly_Y_Offset")
  analysis_evidence("L0831-L0957", "Move the player/horse/fly controller toward ore/path waypoints.", "IsDead | RS | RenderStepped | Connect")
  analysis_note('Mining interaction evidence includes equip/swing/crouch/sprint/remote-call neighborhoods.')
  if Settings.Crouch_On_Ore then
    analysis_note('Recovered branch crouches around ore interaction.')
  end
  if Settings.Do_Swing_Animation then
    analysis_note('Recovered branch preserves visible swing animation behavior.')
  end
  return analysis_mine_ore(runtime, ore)
end

function AutoMine.handleFailure(runtime, reason)
  runtime.retries = runtime.retries + 1
  analysis_phase("failure and retry exits", "Handle missing waypoints, dead character, low ore quality, lagback, stuck seller/path, and no-more-ore exits.")
  analysis_evidence("L0032-L0045", "Report status: Auto Mine | No Pick", "warn | Auto Mine | No Pick | WAIT | Data")
  analysis_evidence("L0067-L0119", "Report status: Auto Mine | Missing Player Character; Auto Mine | Show Path; Auto Mine | Failed to spawn, cycling paths", "warn | Auto Mine | Missing Player Character | a | Hide_In_Ground")
  analysis_evidence("L0395-L0405", "Wait, check elapsed time, or handle stuck/lagback retry timing.", "task | wait | os | clock")
  analysis_evidence("L0486-L0552", "Move the player/horse/fly controller toward ore/path waypoints.", "Check_Server_Quality | Skip_Path_Instead | FindFirstChild | DepositInfo")
  HelperSemantics.noteRetry(runtime, reason)
  if reason == 'death' and Settings.Retry_Path_On_Death then
    return analysis_retry_path(runtime, reason)
  end
  if reason == 'lagback' then
    runtime.lastLagbackAt = analysis_clock()
    return analysis_retry_path(runtime, reason)
  end
  if Settings.End then
    Settings.AutoMineEnabled = false
    return analysis_stop(runtime, reason)
  end
  return analysis_retry_or_stop(runtime, reason)
end

function AutoMine.runOnce(runtime)
  if not AutoMine.prepare(runtime) then
    return AutoMine.handleFailure(runtime, 'startup failed')
  end
  if not AutoMine.loadPath(runtime) then
    return AutoMine.handleFailure(runtime, 'missing path')
  end
  local ore, reason = AutoMine.selectOre(runtime)
  if not ore then
    return AutoMine.handleFailure(runtime, reason or 'no ore')
  end
  local moved = AutoMine.moveToOre(runtime, ore)
  if moved == false then
    return AutoMine.handleFailure(runtime, 'movement failed')
  end
  return AutoMine.mineOre(runtime, ore)
end

function AutoMine.loop()
  local runtime = Runtime
  while Settings.AutoMineEnabled and analysis_loop_tick(runtime) do
    AutoMine.runOnce(runtime)
  end
  setStatus(runtime, 'idle')
end

