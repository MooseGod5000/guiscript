local function hasMolotovTextHint(source)
    if not isTable(source) then
        return false
    end

    for _, key in ipairs({
        "Type",
        "Name",
        "DisplayName",
        "ItemType",
        "Model",
        "ModelName",
        "EquipmentType",
    }) do
        if string.find(safeLower(rawget(source, key) or source[key]), "molotov", 1, true) ~= nil then
            return true
        end
    end

    return false
end

function isMolotovItemTool(toolInfo)
    if not isTable(toolInfo) then
        return false
    end

    if rawget(toolInfo, "IsMolotov") == true or toolInfo.IsMolotov == true then
        return true
    end

    local isOfType = rawget(toolInfo, "IsOfType") or toolInfo.IsOfType
    if type(isOfType) == "function" then
        local okMatch, matches = pcall(function()
            return toolInfo:IsOfType("Molotov")
        end)
        if okMatch and matches == true then
            return true
        end
    end

    local sharedData = rawget(toolInfo, "SharedData") or toolInfo.SharedData
    if hasMolotovTextHint(sharedData) then
        return true
    end

    local itemData = type(getResolvedItemData) == "function" and getResolvedItemData(toolInfo) or nil
    if isTable(itemData) then
        local itemSharedData = rawget(itemData, "SharedData") or itemData.SharedData
        if hasMolotovTextHint(itemData) or hasMolotovTextHint(itemSharedData) then
            return true
        end
    end

    return hasMolotovTextHint(toolInfo)
end

