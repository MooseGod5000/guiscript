function formatNetworkFireError(remoteName, err)
	local message = tostring(err or "unknown")
	if #message > 180 then
		message = string.sub(message, 1, 177) .. "..."
	end
	return "network fire rejected: " .. tostring(remoteName or "unknown") .. " (" .. message .. ")"
end

function callOriginalNetworkFireServer(self, remoteName, packedArgs)
	local originalFireServer = playerState.originalNetworkFireServer
	if type(originalFireServer) ~= "function" then
		return nil
	end

	local ok, result = pcall(originalFireServer, self, remoteName, table.unpack(packedArgs, 1, packedArgs.n))
	if ok then
		return result
	end

	pushDebugRateLimited(
		"network_fire_reject_" .. tostring(remoteName or "unknown"),
		formatNetworkFireError(remoteName, result),
		4
	)
	return nil
end

