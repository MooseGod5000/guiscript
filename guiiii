			if typeof(point) == "Vector3" and (not lastStoredPoint or (point - lastStoredPoint).Magnitude > 0.05) then
				table.insert(entryPoints, point)
				lastStoredPoint = point
			end
		end
		if typeof(targetPosition) == "Vector3" then
			local lastEntryPoint = entryPoints[#entryPoints]
			if typeof(lastEntryPoint) ~= "Vector3" or (lastEntryPoint - targetPosition).Magnitude > 0.05 then
				table.insert(entryPoints, targetPosition)
