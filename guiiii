function moneyBagMiscHeartbeat(dt)
	if destroyed then
		if MONEY_BAG_MISC.heartbeatConnection then
			MONEY_BAG_MISC.heartbeatConnection:Disconnect()
			MONEY_BAG_MISC.heartbeatConnection = nil
		end
		return
	end
	moneyBagMiscApplyHiddenState()
	local flightEnabled = S.moneyBagFlightEnabled == true
	local animationEnabled = S.moneyBagAnimationEnabled == true
	if not flightEnabled then
		moneyBagMiscDestroyRootControl()
	end
	if not (flightEnabled or animationEnabled) then
		if MONEY_BAG_MISC.lastMotionHadEntries then
			for _, entry in ipairs(MONEY_BAG_MISC.selectedEntries) do
				moneyBagMiscSetEntryCollisionDisabled(entry, false)
			end
			MONEY_BAG_MISC.lastMotionHadEntries = false
		end
		return
	end
	local character = moneyBagMiscGetCharacter()
	local root = moneyBagMiscGetRoot(character)
	if not root then
		return
	end
	local ownedEntries = moneyBagMiscGetOwnedEntries()
	moneyBagMiscRefreshStatusLabels()
	if #ownedEntries <= 0 then
		return
	end
	MONEY_BAG_MISC.lastMotionHadEntries = true
	if flightEnabled then
		moneyBagMiscUpdateRootFlight(character, root)
	end
	local now = os.clock()
	for index, entry in ipairs(ownedEntries) do
		moneyBagMiscSetEntryCollisionDisabled(entry, true)
		if flightEnabled then
			local targetPosition = moneyBagMiscGetFlightTarget(entry, index, #ownedEntries, root)
			local inheritedVelocity = root.AssemblyLinearVelocity * 0.95
			moneyBagMiscDriveEntry(entry, targetPosition, 24, 170, inheritedVelocity, Vector3.new())
			moneyBagMiscApplyBagOrientation(entry.part, root)
		elseif animationEnabled then
			if S.moneyBagAnimationMode == "orbit" then
				entry.angle = (tonumber(entry.angle) or 0) + ((dt or 0) * 1.45)
				local spreadAngle = ((index - 1) / math.max(#ownedEntries, 1)) * math.pi * 2
				local angle = entry.angle + spreadAngle
				local bob = math.sin(entry.angle * 1.5) * 0.35
				local targetPosition = root.Position + Vector3.new(math.cos(angle) * 8, 2.5 + bob, math.sin(angle) * 8)
				moneyBagMiscDriveEntry(entry, targetPosition, 6.5, 78, Vector3.new(), Vector3.new(0, 4.5, 0))
			else
				local targetPosition = moneyBagMiscGetFormationTarget(S.moneyBagAnimationMode, index, #ownedEntries, root, now)
				local spinSign = index % 2 == 0 and 1 or -1
				moneyBagMiscDriveEntry(entry, targetPosition, 7, 88, root.AssemblyLinearVelocity * 0.25, Vector3.new(0, 5 * spinSign, 0))
			end
		end
	end
end
