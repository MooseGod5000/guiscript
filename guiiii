function isCactusNamedInstance(instance)
	if typeof(instance) ~= "Instance" then
		return false
	end

	local current = instance
	local depth = 0
	while current and current ~= workspace and depth < 8 do
		local loweredName = string.lower(tostring(current.Name or ""))
		if string.find(loweredName, "cactus", 1, true)
			or string.find(loweredName, "saguaro", 1, true)
			or string.find(loweredName, "sanpedro", 1, true) then
			return true
		end
		current = current.Parent
		depth = depth + 1
	end

	return false
end

