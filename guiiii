function getMovementModeLabel()
	if movementMode == "tween" then
		return "Tween"
	end
	if movementMode == "cframe" then
		return "CFrame"
	end
	if movementMode == "cframefly" then
		return "CFrame Fly"
	end
	if movementMode == "underground" then
		return "Controlled Underground"
	end
	return "Legit"
end

function normalizeMovementMode(value)
	if value == true then
		return "tween"
	end
	if value == false or value == nil then
		return "legit"
	end

	local loweredValue = safeLower(value):gsub("%s+", "")
	if loweredValue == "tween" or loweredValue == "cframe" or loweredValue == "cframefly" or loweredValue == "underground" then
		return loweredValue
	end
	if loweredValue == "fly" then
		return "cframefly"
	end

	return "legit"
end

function setMovementMode(nextMode, debugSource, skipPersistence)
	local nextValue = normalizeMovementMode(nextMode)
	S.movementMode = nextValue
	if movementMode == nextValue then
		refreshTweenButton()
		return
	end

	if isCFrameMovementMode(movementMode) or isCFrameMovementMode(nextValue) then
		endExperimentalCFrameTravel(cachedCharacter)
	end
	if isUndergroundMovementMode(movementMode) or isUndergroundMovementMode(nextValue) then
		endUndergroundTravel(cachedCharacter)
	end
	movementMode = nextValue
	tweenModeEnabled = nextValue == "tween"
	cancelActiveMoveTween()
	clearMovementKeys()
	setLastMoveCommand(Vector3.zero, nextValue == "cframefly" and "CFrameFlyIdle" or (nextValue == "cframe" and "CFrameIdle" or (nextValue == "underground" and "UndergroundIdle" or (tweenModeEnabled and "TweenIdle" or "LegitIdle"))))
	if autoMineEnabled then
		ensureAutoMineManualMovementLock(cachedCharacter, cachedHumanoid)
	end
	pushDebug("movement mode: " .. getMovementModeLabel() .. (debugSource and (" [" .. tostring(debugSource) .. "]") or ""))
	refreshTweenButton()
	if not skipPersistence then
		schedulePersist()
		if type(schedulePathSettingsPersist) == "function" then
			schedulePathSettingsPersist()
		end
	end
end

function setBooleanFlag(targetTable, key, isEnabled, debugLabel, afterChanged)
