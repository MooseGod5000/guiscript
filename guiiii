	local targetColor = opts.targetColor or Color3.fromRGB(110, 255, 140)
	local targetSize = opts.targetSize or Vector3.new(0.92, 0.92, 0.92)
	local previousPosition = nil
	for index, point in ipairs(points) do
		local markerColor = index == 1 and startColor or pointColor
		createPathMarker(point, markerColor)
		if previousPosition then
			createPathSegment(previousPosition, point, lineColor)
		end
		previousPosition = point
	end
