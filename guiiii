function attachFloatingDrag(frame, interact)
	local dragging = false
	local dragInput = nil
	local dragStart = nil
	local startPos = nil
	connectUiSignal(interact.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)
	connectUiSignal(_UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			dragInput = input
		end
	end)
	connectUiSignal(_UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	connectUiSignal(_RunService.RenderStepped, function(dt)
		if not frame.Visible or not dragging or not dragInput or not dragStart or not startPos then
			return
		end
		local delta = dragInput.Position - dragStart
		local destination = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
		frame.Position = frame.Position:Lerp(destination, math.min(dt * 20, 1))
	end)
