end

function destroyDynamiteMarkVisual(playerName)
    if type(S._dynamiteMarkVisuals) ~= "table" then
        S._dynamiteMarkVisuals = {}
        return
    end

    local visuals = S._dynamiteMarkVisuals[playerName]
    if not visuals then
        return
    end

    for _, instance in pairs(visuals) do
        if typeof(instance) == "Instance" then
            pcall(function()
                instance:Destroy()
            end)
        end
    end
    S._dynamiteMarkVisuals[playerName] = nil
