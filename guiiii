		return nil
	end
	local moveDirection = getHorseFlingFakeMoveDirection(rootPart)
	if moveDirection.Magnitude > 0 then
		local frameTime = tonumber(dt) or (1 / 60)
		playerState.horseFlingControlCurrentPos = playerState.horseFlingControlCurrentPos + (moveDirection * HORSE_FLING_FAKE_FLY_SPEED * frameTime)
	end
	local currentPosition = playerState.horseFlingControlCurrentPos
	local camera = workspace.CurrentCamera
	local lookVector = camera and camera.CFrame.LookVector or rootPart.CFrame.LookVector
	if lookVector.Magnitude <= 0.001 then
		lookVector = Vector3.new(0, 0, -1)
	end
	local playerBaseCFrame = CFrame.new(currentPosition, currentPosition + lookVector)
	local antiKickRotation = CFrame.Angles(0, tick() * HORSE_FLING_FAKE_CHARACTER_SPIN_SPEED, 0)
	detachHorseOrbitSeat(rootPart)
	setHorseFlingSeatPartsEnabled(ridingAnimal, false)
	pcall(function()
		rootPart.Anchored = true
		rootPart.CFrame = playerBaseCFrame * antiKickRotation
		rootPart.AssemblyLinearVelocity = Vector3.new(0, 0.05, 0)
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end)
	return currentPosition, playerBaseCFrame
end
function getPredictedHorseFlingTargetPosition(targetRoot, dt)
	if not targetRoot then
		return nil
	end
	local predictedPosition = targetRoot.Position
	local lastTarget = playerState.horseFlingLockedTarget
	local lastPosition = playerState.horseFlingLastTargetPos
	if lastTarget == targetRoot and typeof(lastPosition) == "Vector3" then
		local positionDelta = targetRoot.Position - lastPosition
		local movementVector = Vector3.new(positionDelta.X, 0, positionDelta.Z)
		if movementVector.Magnitude > 0.01 then
			local frameTime = tonumber(dt) or (1 / 60)
			predictedPosition = predictedPosition + ((movementVector / frameTime) * HORSE_FLING_PREDICTION_POWER)
		end
	end
	playerState.horseFlingLockedTarget = targetRoot
	playerState.horseFlingLastTargetPos = targetRoot.Position
	return predictedPosition
end
function getHorseOrbitIdleCFrame(rootPart, currentPosition, playerBaseCFrame)
	currentPosition = typeof(currentPosition) == "Vector3" and currentPosition or rootPart.Position
	local radius = tonumber(HORSE_ORBIT_RADIUS) or 0
	if radius > 0 then
		local timer = tick() * (tonumber(HORSE_ORBIT_ANGULAR_SPEED) or 15)
		local orbitOffset = Vector3.new(math.cos(timer) * radius, 0, math.sin(timer) * radius)
		return CFrame.new(currentPosition + orbitOffset, currentPosition)
	end
	local lookVector = playerBaseCFrame and playerBaseCFrame.LookVector or rootPart.CFrame.LookVector
	if lookVector.Magnitude <= 0.001 then
		lookVector = Vector3.new(0, 0, -1)
	end
	return CFrame.new(currentPosition, currentPosition + lookVector)
end
function applyHorseOrbitAnimalMotion(ridingAnimal, character, rootPart, dt)
