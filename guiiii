customCursorState = {
    enabled = false,
    preloaded = false,
    loopRunning = false,
    frameIndex = 1,
    currentFrames = nil,
    hoverTargets = {},
    connections = {},
    descendantConnections = {},
}

function isCustomCursorEnabled()
    return S.customCursorEnabled ~= false
end

function setCustomCursorHoverTarget(instance, isHovering)
    if type(customCursorState.hoverTargets) ~= "table" then
        customCursorState.hoverTargets = {}
    end
    if typeof(instance) ~= "Instance" then
        return
    end
    if isHovering and isCustomCursorEnabled() then
        customCursorState.hoverTargets[instance] = true
    else
        customCursorState.hoverTargets[instance] = nil
    end
end

function hasCustomCursorHoverTarget()
    if type(customCursorState.hoverTargets) ~= "table" then
        customCursorState.hoverTargets = {}
        return false
    end

    for instance in pairs(customCursorState.hoverTargets) do
        if typeof(instance) == "Instance" and instance.Parent then
            return true
        end
        customCursorState.hoverTargets[instance] = nil
    end
    return false
end

function isCustomCursorClickableInstance(instance)
    return typeof(instance) == "Instance" and (instance:IsA("ClickDetector") or instance:IsA("GuiButton"))
end

function disconnectCustomCursorClickable(instance)
    local connections = customCursorState.connections and customCursorState.connections[instance]
    if type(connections) == "table" then
        for _, connection in ipairs(connections) do
            if typeof(connection) == "RBXScriptConnection" then
                pcall(function()
                    connection:Disconnect()
                end)
            end
        end
    end
    if customCursorState.connections then
        customCursorState.connections[instance] = nil
    end
    setCustomCursorHoverTarget(instance, false)
end

function registerCustomCursorClickable(instance)
    if not isCustomCursorClickableInstance(instance) then
        return
    end
    if type(customCursorState.connections) ~= "table" then
        customCursorState.connections = {}
    end
    if customCursorState.connections[instance] then
        return
    end

    local connections = {}
    if instance:IsA("ClickDetector") then
        table.insert(connections, instance.MouseHoverEnter:Connect(function()
            setCustomCursorHoverTarget(instance, true)
        end))
        table.insert(connections, instance.MouseHoverLeave:Connect(function()
            setCustomCursorHoverTarget(instance, false)
        end))
    elseif instance:IsA("GuiButton") then
        table.insert(connections, instance.MouseEnter:Connect(function()
            setCustomCursorHoverTarget(instance, true)
        end))
        table.insert(connections, instance.MouseLeave:Connect(function()
            setCustomCursorHoverTarget(instance, false)
        end))
    end

    table.insert(connections, instance.AncestryChanged:Connect(function(_, parent)
        if not parent then
            disconnectCustomCursorClickable(instance)
        end
    end))
    customCursorState.connections[instance] = connections
end

function scanCustomCursorClickables(root)
    if typeof(root) ~= "Instance" then
        return
    end
    registerCustomCursorClickable(root)
    for _, descendant in ipairs(root:GetDescendants()) do
        registerCustomCursorClickable(descendant)
    end
end

function disconnectCustomCursorAll()
    if type(customCursorState.descendantConnections) == "table" then
        for _, connection in ipairs(customCursorState.descendantConnections) do
            if typeof(connection) == "RBXScriptConnection" then
                pcall(function()
                    connection:Disconnect()
                end)
            end
        end
    end
    customCursorState.descendantConnections = {}

    if type(customCursorState.connections) == "table" then
        local registeredInstances = {}
        for instance in pairs(customCursorState.connections) do
            table.insert(registeredInstances, instance)
        end
        for _, instance in ipairs(registeredInstances) do
            disconnectCustomCursorClickable(instance)
        end
    end
    customCursorState.connections = {}
    customCursorState.hoverTargets = {}
end

function preloadCustomCursorAssets()
    if customCursorState.preloaded then
        return
    end
    customCursorState.preloaded = true
    task.spawn(function()
        pcall(function()
            local contentProvider = game:GetService("ContentProvider")
            contentProvider:PreloadAsync(CUSTOM_CURSOR_NORMAL_FRAMES)
            contentProvider:PreloadAsync(CUSTOM_CURSOR_HOVER_FRAMES)
        end)
    end)
end

function ensureCustomCursorLoop()
    if customCursorState.loopRunning then
        return
    end

    customCursorState.loopRunning = true
    task.spawn(function()
        while not destroyed and isSessionActive() and customCursorState.enabled and isCustomCursorEnabled() do
            local frames = hasCustomCursorHoverTarget() and CUSTOM_CURSOR_HOVER_FRAMES or CUSTOM_CURSOR_NORMAL_FRAMES
            if customCursorState.currentFrames ~= frames then
                customCursorState.currentFrames = frames
                customCursorState.frameIndex = 1
            end

            local frameCount = #frames
            if frameCount > 0 then
                local frame = frames[customCursorState.frameIndex] or frames[1]
                pcall(function()
                    _UserInputService.MouseIcon = frame
                end)
                customCursorState.frameIndex = (customCursorState.frameIndex % frameCount) + 1
            end
            task.wait(0.1)
        end

        customCursorState.loopRunning = false
        if not (customCursorState.enabled and isCustomCursorEnabled()) then
            pcall(function()
                _UserInputService.MouseIcon = ""
            end)
        end
    end)
end

function applyCustomCursorState()
    if not isCustomCursorEnabled() then
        customCursorState.enabled = false
        disconnectCustomCursorAll()
        pcall(function()
            _UserInputService.MouseIcon = ""
        end)
        return
    end

    if customCursorState.enabled then
        ensureCustomCursorLoop()
        return
    end

    customCursorState.enabled = true
    preloadCustomCursorAssets()
    scanCustomCursorClickables(workspace)
    scanCustomCursorClickables(hubGui)

    customCursorState.descendantConnections = {
        workspace.DescendantAdded:Connect(function(descendant)
            if customCursorState.enabled and isCustomCursorEnabled() then
                registerCustomCursorClickable(descendant)
            end
        end),
        hubGui.DescendantAdded:Connect(function(descendant)
            if customCursorState.enabled and isCustomCursorEnabled() then
                registerCustomCursorClickable(descendant)
            end
        end),
    }
    ensureCustomCursorLoop()
end

function setCustomCursorEnabled(value, skipPersistence)
    local nextValue = value == true
    local wasEnabled = isCustomCursorEnabled()
    S.customCursorEnabled = nextValue
    applyCustomCursorState()
    if wasEnabled ~= nextValue and not skipPersistence then
        schedulePersist()
    end
end

