					"entry_compute_fail",
					"attempt=" .. tostring(attempts)
						.. " computed=" .. tostring(computed)
						.. " status=" .. tostring(path.Status)
						.. " root=" .. formatPathDebugVector3(rootPart.Position)
						.. " pathTarget=" .. formatPathDebugVector3(pathTarget)
						.. " final=" .. formatPathDebugVector3(targetPosition),
					1
				)
			end
			local isEntryPlaybackPath = pathState.playbackActive and pathState.entryPathingPending
			visualizePathPoints({ rootPart.Position, pathTarget }, targetPosition, isEntryPlaybackPath and {allowDuringPlayback = true, storeEntryPathPoints = true, startColor = PATH_VISUAL_PATHFINDER_COLOR, pointColor = PATH_VISUAL_PATHFINDER_COLOR, lineColor = PATH_VISUAL_PATHFINDER_COLOR, targetColor = PATH_VISUAL_PATHFINDER_COLOR, targetSize = Vector3.new(0.9, 0.9, 0.9),} or nil)
