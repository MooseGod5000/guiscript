						.. " waypoints=" .. tostring(#waypoints)
						.. " root=" .. formatPathDebugVector3(rootPart.Position)
						.. " pathTarget=" .. formatPathDebugVector3(pathTarget)
						.. " final=" .. formatPathDebugVector3(targetPosition),
					2
				)
			end
			local points = {}
			for _, waypoint in ipairs(waypoints) do
				table.insert(points, waypoint.Position)
			end
			local isEntryPlaybackPath = pathState.playbackActive and pathState.entryPathingPending
			visualizePathPoints(points, targetPosition, isEntryPlaybackPath and {allowDuringPlayback = true, storeEntryPathPoints = true, startColor = PATH_VISUAL_PATHFINDER_COLOR, pointColor = PATH_VISUAL_PATHFINDER_COLOR, lineColor = PATH_VISUAL_PATHFINDER_COLOR, targetColor = PATH_VISUAL_PATHFINDER_COLOR, targetSize = Vector3.new(0.9, 0.9, 0.9),} or nil)
			local progressed = false
			for _, waypoint in ipairs(waypoints) do
				if not autoMineEnabled or activeToken ~= autoMineToken then
					return false
				end
				if getPathArrivalDistance() <= wantedRange then
					return true
				end
				if waypoint.Action == Enum.PathWaypointAction.Jump then
					humanoid.Jump = true
				end
				local avoidanceHandled, avoidReason = processEntryPathAvoidance(waypoint.Position)
				if avoidanceHandled then
