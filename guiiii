pathManagerButtonsRefreshQueued = pathManagerButtonsRefreshQueued or false
pathManagerButtonsRefreshRetrying = pathManagerButtonsRefreshRetrying or false

function isUiInstanceAccessError(err)
	local message = tostring(err or "")
	return message:find("cannot access", 1, true) ~= nil
		or message:find("lacking capability", 1, true) ~= nil
end

function queuePathManagerButtonsRefresh()
	if pathManagerButtonsRefreshQueued or pathManagerButtonsRefreshRetrying then
		return
	end
	pathManagerButtonsRefreshQueued = true
	task.defer(function()
		pathManagerButtonsRefreshQueued = false
		pathManagerButtonsRefreshRetrying = true
		pcall(function()
			if type(refreshPathManagerButtons) == "function" then
				refreshPathManagerButtons()
			end
		end)
		pathManagerButtonsRefreshRetrying = false
	end)
end

function runPathManagerUiSync(syncFn, ...)
	if type(syncFn) == "function" then
		local ok, err = pcall(syncFn, ...)
		if not ok and isUiInstanceAccessError(err) then
			queuePathManagerButtonsRefresh()
		end
		return ok
	end
	return true
end

