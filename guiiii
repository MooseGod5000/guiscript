    searchBox.TextSize = 13
    searchBox.TextXAlignment = Enum.TextXAlignment.Left
    searchBox.ClearTextOnFocus = false
    searchBox.Parent = searchBarBg

    kbLayoutOrder = 0
    function nextKbOrder()
        kbLayoutOrder = kbLayoutOrder + 1
        return kbLayoutOrder
    end

    function createKeybindSectionHeader(text)
        local header = Instance.new("TextLabel")
        header.Size = UDim2.new(1, 0, 0, 28)
        header.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
        header.BorderSizePixel = 0
        header.TextColor3 = Color3.fromRGB(0, 150, 255)
        header.Text = "  " .. text
        header.Font = Enum.Font.GothamBold
        header.TextSize = 13
        header.TextXAlignment = Enum.TextXAlignment.Left
        header.LayoutOrder = nextKbOrder()
        header.Parent = elementsList
        Instance.new("UICorner", header).CornerRadius = UDim.new(0, 4)
        return header
    end

    function createKeybindRow(regEntry)
        local rowName = regEntry.name
        local rowKey = regEntry.tab .. ":" .. regEntry.name

        local row = Instance.new("TextButton")
        row.Name = "KB_" .. rowKey
        row.Size = UDim2.new(1, 0, 0, 38)
        row.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
        row.BorderSizePixel = 0
        row.Text = ""
        row.AutoButtonColor = false
        row.LayoutOrder = nextKbOrder()
        row.Parent = elementsList

        local diamond = Instance.new("Frame")
        diamond.Size = UDim2.new(0, 6, 0, 6)
