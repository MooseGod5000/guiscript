            for _, bulletId in ipairs(bulletIdList) do
                untrackFastProjectileBullet(bulletId)
            end
            return
        end
        local resolvedTarget = resolveOldProjectileTpTargetReference(network, targetInfo, targetPart, playerTarget, animalTarget, npcTarget)
        if resolvedTarget == nil then
            for _, bulletId in ipairs(bulletIdList) do
                untrackFastProjectileBullet(bulletId)
            end
            return
        end
        for _, bulletId in ipairs(bulletIdList) do
            if not isTrackedFastProjectileBullet(bulletId) then
                continue
            end
            pcall(
                fireServer,
                network,
                "ProjectileEvent",
                bulletId,
                getSyncedNetworkTime(),
                "Final",
                resolvedTarget,
                objectHit,
                frontNormal,
                directionObject,
                hitPosition,
                Vector3.FromNormalId(Enum.NormalId.Front),
                targetMaterialName
            )
            task.defer(function()
                pcall(fireServer, network, "RemoveProjectile", bulletId)
            end)
            untrackFastProjectileBullet(bulletId)
        end
    end)
end
function scheduleFastProjectileFinalEvent(targetInfo, projectileEntry, bulletIds)
