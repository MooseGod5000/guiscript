		local viewportFrame = container and container:FindFirstChild("ViewportFrame")
		visualName = getViewportFrameItemName(viewportFrame)
	end
	return {slotFrame = lastSlot, visualName = visualName, itemType = itemType, itemId = itemId, inventoryItem = inventoryItem, sharedItemData = sharedItemData, isLoot = isLoot, filledSlots = filledSlots, totalSlots = totalSlots,}, nil
end
