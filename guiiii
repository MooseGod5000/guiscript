end

function isDiscordAutomineWebhookUrlValid(value)
	local url = value
	if url == nil then
		url = getDiscordAutomineWebhookUrl()
	else
		url = string.match(tostring(url), "^%s*(.-)%s*$") or ""
	end
	if url == "" then
		return false
	end
	if string.match(url, "^https://discord%.com/api/webhooks/%d+/[%w%-%._~]+") then
		return true
	end
	if string.match(url, "^https://discordapp%.com/api/webhooks/%d+/[%w%-%._~]+") then
		return true
	end
	return false
end

