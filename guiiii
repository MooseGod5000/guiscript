function getMeleeAuraSwingCooldown(toolInfo, trackName)
    local animationData = getMeleeItemAnimationData(toolInfo, trackName)
    local speed = math.max(tonumber(isTable(animationData) and (rawget(animationData, "Speed") or animationData.Speed)) or 1.15, 0.05)
    local cooldown = tonumber(isTable(animationData) and (rawget(animationData, "Cooldown") or animationData.Cooldown)) or 0.3
    local length = nil
    local getTrack = isTable(toolInfo) and (rawget(toolInfo, "GetTrack") or toolInfo.GetTrack) or nil
    if type(getTrack) == "function" then
        local okTrack, track = pcall(getTrack, toolInfo, trackName)
        if okTrack and track then
            length = tonumber(track.Length)
        end
    end
    if not length or length <= 0 then
        local sharedData = isTable(toolInfo) and (rawget(toolInfo, "SharedData") or toolInfo.SharedData) or nil
        local globalModule = getWestwareGlobalModule(false) or getWestwareGlobalModule(true)
        local charRepUtils = isTable(globalModule) and (rawget(globalModule, "CharRepUtils") or globalModule.CharRepUtils) or nil
        local itemType = isTable(sharedData) and (rawget(sharedData, "ItemType") or sharedData.ItemType or rawget(sharedData, "Type") or sharedData.Type) or nil
        if isTable(charRepUtils) and type(charRepUtils.GetAnimationLength) == "function" and itemType then
            local okLength, animationLength = pcall(charRepUtils.GetAnimationLength, charRepUtils, "." .. tostring(trackName), itemType)
            if okLength and type(animationLength) == "number" and animationLength > 0 then
                length = animationLength
            end
        end
    end
    local totalCooldown = ((tonumber(length) or 0) / speed) + cooldown
    if totalCooldown <= 0 then
        totalCooldown = MELEE_AURA_FALLBACK_COOLDOWN
    end
    return math.clamp(totalCooldown, MELEE_AURA_MIN_COOLDOWN, MELEE_AURA_MAX_COOLDOWN)
