function getPickaxeTierFromText(value)
	if type(value) ~= "string" then
		return nil
	end

	local normalized = safeLower(value):gsub("[^%w]", "")
	if normalized == "" then
		return nil
	end

	local tier = tonumber(string.match(normalized, "tier(%d+)pickaxe")) or tonumber(string.match(normalized, "tier(%d+)"))
	if tier then
		return math.clamp(math.floor(tier), 1, 9)
	end
	if string.find(normalized, "basicpickaxe", 1, true) or string.find(normalized, "basepickaxe", 1, true) then
		return 0
	end

	return nil
end

function getPickaxeTierFromItem(item, playerItems)
	item = getResolvedItemData(item)
	if not isTable(item) then
		return nil
	end

	local textKeys = {
		"Type",
		"Id",
		"Name",
		"DisplayName",
		"ItemType",
		"VariantOf",
		"Model",
		"ModelName",
		"WorldModel",
		"WorldModelName",
		"ViewModel",
		"ViewModelName",
	}

	local function scanSource(source)
		if not isTable(source) then
			return nil
		end

		local hasPickaxeText = false
		for _, key in ipairs(textKeys) do
			local textValue = rawget(source, key) or source[key]
			if type(textValue) == "string" and string.find(safeLower(textValue), "pickaxe", 1, true) then
				hasPickaxeText = true
			end
			local tier = getPickaxeTierFromText(textValue)
			if tier ~= nil then
				return tier
			end
		end

		local explicitTier = tonumber(rawget(source, "PickaxeTier") or source.PickaxeTier)
		if explicitTier then
			return math.clamp(math.floor(explicitTier), 0, 9)
		end

		local genericTier = tonumber(rawget(source, "Tier") or source.Tier)
		if genericTier and hasPickaxeText then
			return math.clamp(math.floor(genericTier), 0, 9)
		end

		return nil
	end

	return scanSource(item) or scanSource(resolveSharedItemData(playerItems, item))
end

function getInventoryItemKey(item)
	if not isTable(item) then
		return nil
	end
	return rawget(item, "Id") or item.Id or rawget(item, "UUID") or item.UUID or rawget(item, "Guid") or item.Guid
end

function collectOwnedPickaxeProgressionItems(playerData, playerItems)
	local results = {}
	local seen = {}
	local function pushItem(item, source)
		item = getResolvedItemData(item)
		if not isTable(item) then
			return
		end

		local tier = getPickaxeTierFromItem(item, playerItems)
		if tier == nil then
			return
		end

		local itemKey = getInventoryItemKey(item) or tostring(item)
		if seen[itemKey] then
			return
		end
		seen[itemKey] = true
		table.insert(results, {
			item = item,
			tier = tier,
			source = source or "inventory",
			itemId = getInventoryItemKey(item),
			itemType = rawget(item, "Type") or item.Type,
		})
	end

	local inventoryContainer = getResolvedInventoryContainer(playerData)
	local items = isTable(inventoryContainer) and (rawget(inventoryContainer, "Items") or inventoryContainer.Items) or nil
	if isTable(items) then
		for _, inventoryItem in pairs(items) do
			pushItem(inventoryItem, "inventory")
		end
	end

	local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	local loadoutItem = findPickaxeLoadoutItem(playerData, playerCharacter, playerItems)
	pushItem(loadoutItem, "loadout")

	local character = cachedCharacter or getCustomCharacter()
	for _, model in ipairs({
		getEquippedPickaxe(character),
		getStoredPickaxe(character),
		getBackpackPickaxeTool(),
	}) do
		if model then
			local tier = getPickaxeTierFromText(model.Name)
			if tier ~= nil then
				table.insert(results, {
					item = nil,
					tier = tier,
					source = "model",
					itemId = nil,
					itemType = model.Name,
				})
			end
		end
	end

	return results
end

function getPickaxeProgressionOwnedSummary(playerData, playerItems)
	local ownedItems = collectOwnedPickaxeProgressionItems(playerData, playerItems)
	local bestEntry = nil
	for _, entry in ipairs(ownedItems) do
		if not bestEntry or entry.tier > bestEntry.tier then
			bestEntry = entry
		end
	end

	return {
		items = ownedItems,
		bestEntry = bestEntry,
		bestTier = bestEntry and bestEntry.tier or 0,
	}
end

function findLowerPickaxeProgressionInventoryItem(playerData, playerItems, targetTier)
	local inventoryContainer = getResolvedInventoryContainer(playerData)
	local items = isTable(inventoryContainer) and (rawget(inventoryContainer, "Items") or inventoryContainer.Items) or nil
	if not isTable(items) then
		return nil
	end

	local bestLower = nil
	for _, inventoryItem in pairs(items) do
		local tier = getPickaxeTierFromItem(inventoryItem, playerItems)
		if tier ~= nil and tier < targetTier and (not bestLower or tier > bestLower.tier) then
			bestLower = {
				item = getResolvedItemData(inventoryItem),
				tier = tier,
				itemId = getInventoryItemKey(getResolvedItemData(inventoryItem)),
				itemType = rawget(getResolvedItemData(inventoryItem), "Type") or getResolvedItemData(inventoryItem).Type,
			}
		end
	end

	return bestLower
end

function getMiningProgressionData()
	local progressionInfo = resolveSharedProgressionInfo(false) or resolveSharedProgressionInfo(true)
	local skills = isTable(progressionInfo) and (rawget(progressionInfo, "Skills") or progressionInfo.Skills) or nil
	local loadedSkills = isTable(skills) and (rawget(skills, "Loaded") or skills.Loaded) or nil
	if isTable(loadedSkills) then
		for _, skillData in pairs(loadedSkills) do
			local metadata = isTable(skillData) and (rawget(skillData, "Metadata") or skillData.Metadata) or nil
			local info = isTable(metadata) and (rawget(metadata, "Info") or metadata.Info) or nil
			if isTable(info) and tostring(rawget(info, "Name") or info.Name) == "Mining" then
				return skillData
			end
		end
	end

	local fallbackMilestones = {}
	for _, milestone in ipairs(PICKAXE_PROGRESSION_MILESTONES) do
		fallbackMilestones[milestone.level] = {
			Items = { milestone.itemType },
		}
	end
	return {
		Metadata = {
			Info = { Name = "Mining" },
			Configuration = { MaxLevel = 100 },
		},
		Milestones = fallbackMilestones,
	}
end

