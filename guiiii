   -- ======= TAB REORDERING (hold to drag) ======= --
   do
       local isDraggingTab = false
       local draggedEntry = nil
       local dragOffset = 0
       local holdThreshold = 0.3
       local function setupTabDrag(entry)
           local btn = entry.btn
           local holding = false
           local holdConn = nil
           btn.InputBegan:Connect(function(input)
               if not S.creatorModeEnabled then return end
               if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                   holding = true
                   local startTime = tick()
                   holdConn = _RunService.Heartbeat:Connect(function()
                       if holding and tick() - startTime >= holdThreshold and not isDraggingTab then
                           isDraggingTab = true
                           draggedEntry = entry
                           dragOffset = input.Position.Y - btn.AbsolutePosition.Y
                           btn.ZIndex = 10
                           _TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(50, 40, 20)}):Play()
                           if holdConn then holdConn:Disconnect() holdConn = nil end
                       end
                   end)
               end
           end)
           btn.InputEnded:Connect(function(input)
               if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                   holding = false
                   if holdConn then holdConn:Disconnect() holdConn = nil end
                   if isDraggingTab and draggedEntry == entry then
                       isDraggingTab = false
                       btn.ZIndex = 2
                       local currentY = btn.Position.Y.Offset
                       local targetSlot = math.clamp(math.floor((currentY - _TAB_START_Y + _TAB_SPACING / 2) / _TAB_SPACING) + 1, 1, #_sidebarEntries)
                       local currentSlot = 1
                       for i, e in ipairs(_sidebarEntries) do
                           if e == entry then currentSlot = i break end
                       end
                       table.remove(_sidebarEntries, currentSlot)
                       table.insert(_sidebarEntries, targetSlot, entry)
                       refreshSidebarPositions()
                       draggedEntry = nil
                   end
               end
           end)
       end
       for _, entry in ipairs(_sidebarEntries) do
           setupTabDrag(entry)
       end
       -- Also apply to future custom tabs via a hook
       local origCreateCustomTab = createCustomTab
       createCustomTab = function()
           origCreateCustomTab()
           local lastEntry = _sidebarEntries[#_sidebarEntries]
           if lastEntry and lastEntry.isCustom then
               setupTabDrag(lastEntry)
           end
       end
       -- Global mouse move for tab dragging
       _UserInputService.InputChanged:Connect(function(input)
           if isDraggingTab and draggedEntry and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
               local mouseY = input.Position.Y
               local sidebarAbsY = sidebarScroll.AbsolutePosition.Y
               local newY = mouseY - sidebarAbsY - dragOffset
               newY = math.clamp(newY, _TAB_START_Y, _TAB_START_Y + (#_sidebarEntries - 1) * _TAB_SPACING)
               draggedEntry.btn.Position = UDim2.new(0, 0, 0, newY)
           end
       end)
   end
   -- ======= BUTTON REORDERING (hold to drag within tabs) ======= --
   setupRowDrag = function(row, scrollList)
       local holding = false
       local holdConn = nil
       row.InputBegan:Connect(function(input)
           if not S.creatorModeEnabled then return end
           if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
           holding = true
           local startTime = tick()
           holdConn = _RunService.Heartbeat:Connect(function()
               if holding and tick() - startTime >= _rowDragHoldThreshold and not _isDraggingRow then
                   _isDraggingRow = true
                   _draggedRow = row
                   _dragScrollList = scrollList
                   row.ZIndex = 20
                   _TweenService:Create(row, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(50, 40, 20)}):Play()
                   if holdConn then holdConn:Disconnect() holdConn = nil end
               end
           end)
       end)
       row.InputEnded:Connect(function(input)
           if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
           holding = false
           if holdConn then holdConn:Disconnect() holdConn = nil end
           if _isDraggingRow and _draggedRow == row then
               _isDraggingRow = false
               row.ZIndex = 1
               _TweenService:Create(row, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(24, 24, 24)}):Play()
               _draggedRow = nil
               _dragScrollList = nil
           end
       end)
   end
   -- Apply to all existing rows in all tabs
   for _, contentArea in pairs(tabContents) do
       for _, desc in pairs(contentArea:GetDescendants()) do
           if desc:IsA("ScrollingFrame") then
               for _, child in pairs(desc:GetChildren()) do
                   if child:IsA("TextButton") then
                       setupRowDrag(child, desc)
                   end
               end
           end
       end
   end
   -- Monitor mouse for row reordering
   _UserInputService.InputChanged:Connect(function(input)
       if _isDraggingRow and _draggedRow and _dragScrollList and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
           local mouseY = input.Position.Y
           local listAbsY = _dragScrollList.AbsolutePosition.Y
           local relY = mouseY - listAbsY + _dragScrollList.CanvasPosition.Y
           local slot = math.max(0, math.floor(relY / 46))
           local rows = {}
           for _, child in pairs(_dragScrollList:GetChildren()) do
               if child:IsA("TextButton") then
                   table.insert(rows, child)
               end
           end
           table.sort(rows, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
           local currentIdx = 1
           for i, r in ipairs(rows) do
               if r == _draggedRow then currentIdx = i break end
           end
           local targetIdx = math.clamp(slot + 1, 1, #rows)
           if targetIdx ~= currentIdx then
               local tempOrder = _draggedRow.LayoutOrder
               _draggedRow.LayoutOrder = rows[targetIdx].LayoutOrder
               rows[targetIdx].LayoutOrder = tempOrder
           end
       end
   end)
end
