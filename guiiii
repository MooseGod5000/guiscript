function addCorner(instance, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = instance
	return corner
end

function addStroke(instance, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness or 1
	stroke.Transparency = transparency or 0
	stroke.Parent = instance
	return stroke
end

function colorDistance(colorA, colorB)
	return math.abs(colorA.R - colorB.R) + math.abs(colorA.G - colorB.G) + math.abs(colorA.B - colorB.B)
end

function splitFobButtonText(rawText)
	local textValue = tostring(rawText or "")
	local leftText, rightText = string.match(textValue, "^(.-)%s+|%s+(.+)$")
	if leftText and rightText then
		return leftText, rightText
	end

	leftText, rightText = string.match(textValue, "^(.-):%s*(.+)$")
	if leftText and rightText and #rightText <= 22 then
		return leftText, rightText
	end

	return textValue, nil
end

function getFobValueColor(valueText)
	local loweredValue = string.lower(tostring(valueText or ""))
	if loweredValue == "" then
		return UI_COLORS.muted
	end
	if loweredValue == "on" or loweredValue == "working" then
		return UI_COLORS.success
	end
	if loweredValue == "off" or loweredValue == "none" then
		return UI_COLORS.muted
	end
	if loweredValue == "tween" then
		return UI_COLORS.accent
	end
	if loweredValue == "cframe" then
		return UI_COLORS.warning
	end
	if loweredValue == "cframefly" or loweredValue == "cframe fly" then
		return UI_COLORS.warning
	end
	if loweredValue == "underground" then
		return Color3.fromRGB(185, 120, 255)
	end
	if loweredValue == "legit" then
		return UI_COLORS.text
	end
	return UI_COLORS.text
end

function refreshFobButtonChrome(button)
	local chrome = button:FindFirstChild("FobChrome")
	if not chrome then
		return
	end

	local titleLabel = chrome:FindFirstChild("MainLabel")
	local valueLabel = chrome:FindFirstChild("ValueLabel")
	local icon = chrome:FindFirstChild("Icon")
	local diamond = chrome:FindFirstChild("Diamond")
	local topLine = chrome:FindFirstChild("TopLine")
	local bottomLine = chrome:FindFirstChild("BottomLine")
	if not (titleLabel and valueLabel and icon and diamond and topLine and bottomLine) then
		return
	end

	local titleText, valueText = splitFobButtonText(button.Text)
	local hovering = button:GetAttribute("FobHovering") == true
	local isRaised = colorDistance(button.BackgroundColor3, UI_COLORS.surface) > 0.03
	local isHot = hovering or isRaised

	titleLabel.Text = titleText
	titleLabel.TextColor3 = isHot and Color3.new(1, 1, 1) or UI_COLORS.muted
	valueLabel.Text = valueText or ""
	valueLabel.Visible = valueText ~= nil and valueText ~= ""
	valueLabel.TextColor3 = getFobValueColor(valueText)
	icon.BackgroundColor3 = isHot and Color3.new(1, 1, 1) or UI_COLORS.accent
	diamond.Visible = isHot
	topLine.Size = isHot and UDim2.new(1, 0, 0, 2) or UDim2.new(0, 0, 0, 2)
	bottomLine.Size = isHot and UDim2.new(1, 0, 0, 2) or UDim2.new(0, 0, 0, 2)
end

