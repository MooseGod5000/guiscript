    local includeNPCs = isPriorityEnabledFn("NPCs")
    local includeEntities = isPriorityEnabledFn("Entities")
    if not includePlayers and not includeNPCs and not includeEntities then
        includePlayers = true
    end
    if includePlayers then
        for _, player in ipairs(_Players:GetPlayers()) do
            if player ~= localPlayer then
                local _, character = getAliveTwwTargetData(player)
                appendSilentAimTarget(groupedTargets.Players, seenTargets, "Players", character, player, nil, options)
            end
        end
    end
    local entitiesFolder = (includeNPCs or includeEntities) and workspace:FindFirstChild("WORKSPACE_Entities") or nil
