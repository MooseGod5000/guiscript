function appendVisibilitySpecs(target, rows, predicate, visibleHeight)
    target = target or {}
    for _, row in ipairs(rows or {}) do
        if row then
            table.insert(target, {row, predicate, visibleHeight})
        end
    end
    return target
end
function createVisibilitySync(syncFns, visibilitySpecs, beforeSync)
    return function()
        if type(beforeSync) == "function" then
            pcall(beforeSync)
        end
        for _, syncFn in pairs(syncFns or {}) do
            if type(syncFn) == "function" then
                pcall(syncFn)
            end
        end
        for _, spec in ipairs(visibilitySpecs or {}) do
            local row, predicate, visibleHeight = spec[1], spec[2], spec[3]
            if row then
                local visible = type(predicate) == "function" and predicate() or predicate ~= false
                row.Visible = visible
                if visible and type(visibleHeight) == "number" then
                    row.Size = UDim2.new(row.Size.X.Scale, row.Size.X.Offset, 0, visibleHeight)
                end
            end
        end
    end
end
function registerAndRunUiSync(syncFn)
