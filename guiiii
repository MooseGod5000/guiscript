	local ok = pcall(function()
		rootPart.Velocity = velocity
	end)
	pcall(function()
		rootPart.AssemblyLinearVelocity = velocity
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end)
	return ok
end

function setUndergroundCharacterCollisionEnabled(character, isEnabled)
	if not character then
		return false
	end

	local state = getUndergroundTravelState()
	if isEnabled == false then
		local savedParts = state.collisionParts
		if type(savedParts) ~= "table" then
			savedParts = {}
			state.collisionParts = savedParts
		end
		local changed = false
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart") then
				if savedParts[descendant] == nil then
					savedParts[descendant] = descendant.CanCollide
				end
				pcall(function()
					descendant.CanCollide = false
				end)
				changed = true
			end
		end
		return changed
	end

	local savedParts = state.collisionParts
	if type(savedParts) ~= "table" then
		return false
	end
	for part, canCollide in pairs(savedParts) do
		if typeof(part) == "Instance" and part:IsA("BasePart") then
			pcall(function()
				part.CanCollide = canCollide == true
			end)
		end
	end
	state.collisionParts = nil
	return true
end

function getUndergroundPreservedPlatform(state, clientPlatforms, character)
	if type(state) ~= "table" then
		return nil
	end

	local preservedPlatform = state.preservedPlatform or state.initialPlatform
	if preservedPlatform then
		return preservedPlatform
	end

	local repChar = state.repChar or resolveLocalRepChar(false) or resolveLocalRepChar(true)
	if isTable(repChar) then
		state.repChar = repChar
		preservedPlatform = rawget(repChar, "CurrentPlatform") or repChar.CurrentPlatform
		if preservedPlatform then
			state.preservedPlatform = preservedPlatform
			state.initialPlatform = preservedPlatform
			return preservedPlatform
		end
	end

	if isTable(clientPlatforms) and typeof(character) == "Instance" then
		local getRagdollPlatform = rawget(clientPlatforms, "GetRagdollPlatform") or clientPlatforms.GetRagdollPlatform
		if type(getRagdollPlatform) == "function" then
			local okPlatform, ragdollPlatform = pcall(getRagdollPlatform, clientPlatforms, character)
			if okPlatform and ragdollPlatform then
				state.preservedPlatform = ragdollPlatform
				state.initialPlatform = ragdollPlatform
				return ragdollPlatform
			end
		end
	end

	return nil
end

function reassertUndergroundPlatformTarget(character, preservedPlatform)
	if not (character and preservedPlatform) then
		return false
	end

	local state = getUndergroundTravelState()
	local clientPlatforms = state.clientPlatforms or ensureUndergroundPlatformHook()
	local repChar = state.repChar or resolveLocalRepChar(false) or resolveLocalRepChar(true)
	state.clientPlatforms = clientPlatforms
	state.repChar = repChar
	state.preservedPlatform = preservedPlatform
	state.initialPlatform = state.initialPlatform or preservedPlatform

	local changed = false
	if isTable(clientPlatforms) then
		local addAnchorableRagdoll = rawget(clientPlatforms, "AddAnchorableRagdoll") or clientPlatforms.AddAnchorableRagdoll
		if type(addAnchorableRagdoll) == "function" then
			changed = pcall(addAnchorableRagdoll, clientPlatforms, character, preservedPlatform) and true or changed
		end
	end

	if isTable(repChar) then
		pcall(function()
			repChar.CurrentPlatform = preservedPlatform
			repChar.FloorPlatform = preservedPlatform
			repChar.LastFloorPlatform = preservedPlatform
			repChar.LastFloorPart = nil
			repChar.LastWasGrounded = true
		end)
		changed = true
	end

	return changed
end

function applyUndergroundForcedCFrameGoal(character, goalCFrame)
	if not (character and typeof(goalCFrame) == "CFrame") then
		return false
	end

	local state = getUndergroundTravelState()
	local repChar = state.repChar or resolveLocalRepChar(false) or resolveLocalRepChar(true)
	local rootPart = getRootPart(character)
	local moved = false
	state.pendingGoalCFrame = goalCFrame

	if isTable(repChar) then
		state.repChar = repChar
		local preservedPlatform = state.preservedPlatform or state.initialPlatform
		if preservedPlatform then
			pcall(function()
				repChar.CurrentPlatform = preservedPlatform
				repChar.FloorPlatform = preservedPlatform
				repChar.LastFloorPlatform = preservedPlatform
				repChar.LastFloorPart = nil
				repChar.LastWasGrounded = true
			end)
			state.usedPinnedPlatform = true
		end
		pcall(function()
			repChar.LocalForceCFrame = goalCFrame
		end)
		state.usedLocalForceCFrame = true
		moved = true
	end

	if rootPart then
		if state.originalRootAnchored == nil then
			state.originalRootAnchored = rootPart.Anchored
		end
		state.forceRootPart = rootPart
		local bodyDelta = nil
		pcall(function()
			bodyDelta = goalCFrame * rootPart.CFrame:Inverse()
		end)
		if typeof(bodyDelta) == "CFrame" and character then
			for _, descendant in ipairs(character:GetDescendants()) do
				if descendant:IsA("BasePart") and descendant ~= rootPart then
					pcall(function()
						descendant.CFrame = bodyDelta * descendant.CFrame
						descendant.Velocity = Vector3.zero
						descendant.RotVelocity = Vector3.zero
						descendant.AssemblyLinearVelocity = Vector3.zero
						descendant.AssemblyAngularVelocity = Vector3.zero
					end)
				end
			end
		end
		local okMove = pcall(function()
			rootPart.CFrame = goalCFrame
			rootPart.Anchored = true
			rootPart.Velocity = Vector3.zero
			rootPart.RotVelocity = Vector3.zero
		end)
		pcall(function()
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
		end)
		moved = okMove or moved
	end

	local preservedPlatform = getUndergroundPreservedPlatform(state, state.clientPlatforms or ensureUndergroundPlatformHook(), character)
	if preservedPlatform then
		reassertUndergroundPlatformTarget(character, preservedPlatform)
	end

	return moved
end

function ensureUndergroundBodyFreeze(character, rootPart, flatDirection)
	if not rootPart then
		return false
	end

	local state = getUndergroundTravelState()
	local playerCharacter = state.playerCharacter or resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	local repChar = state.repChar or resolveLocalRepChar(false) or resolveLocalRepChar(true)
	local clientPlatforms = state.clientPlatforms or ensureUndergroundPlatformHook()
	state.playerCharacter = playerCharacter
	state.repChar = repChar
	state.clientPlatforms = clientPlatforms

	if isTable(playerCharacter) and not state.playerFaceMouseDisabled then
		local faceMouse = rawget(playerCharacter, "FaceMouse") or playerCharacter.FaceMouse
		state.originalPlayerFacingMouse = rawget(playerCharacter, "FacingMouse") ~= false
		if type(faceMouse) == "function" then
			state.playerFaceMouseDisabled = pcall(faceMouse, playerCharacter, false) and true or false
		else
			pcall(function()
				playerCharacter.FacingMouse = false
			end)
			state.playerFaceMouseDisabled = true
		end
	end

	if isTable(repChar) and not state.faceMouseDisabled then
		state.faceMouseDisabled = setExperimentalRepFaceMouseDisabled(repChar, true) and true or false
	end
	if isTable(repChar) and state.usedLocalRepCharRagdollFlag then
		pcall(function()
			repChar.IsRagdolled = true
		end)
	end
	local preservedPlatform = getUndergroundPreservedPlatform(state, clientPlatforms, character)
	if preservedPlatform then
		reassertUndergroundPlatformTarget(character, preservedPlatform)
	elseif isTable(repChar) then
		pcall(function()
			repChar.LastFloorPart = nil
			repChar.LastWasGrounded = false
		end)
	end

	local humanoid = getHumanoid(character)
	if humanoid and state.freezeHumanoid ~= humanoid then
		state.freezeHumanoid = humanoid
		state.originalAutoRotate = humanoid.AutoRotate
		state.originalPlatformStand = humanoid.PlatformStand
		pcall(function()
			state.originalEvaluateStateMachine = humanoid.EvaluateStateMachine
		end)
	end
	if humanoid then
		pcall(function()
			local usePlatformStand = state.useControlledRagdoll == true
			humanoid.AutoRotate = false
			humanoid.PlatformStand = usePlatformStand
			humanoid.Jump = false
			if not usePlatformStand then
				local normalTravelState = Enum.HumanoidStateType.RunningNoPhysics or Enum.HumanoidStateType.Running
				if normalTravelState then
					humanoid:ChangeState(normalTravelState)
				end
			end
			if state.originalEvaluateStateMachine ~= nil then
				humanoid.EvaluateStateMachine = false
			end
			humanoid:Move(Vector3.zero)
		end)
	end
	setUndergroundCharacterCollisionEnabled(character, false)
	if type(ensurePlayerStateNetworkHook) == "function" then
		ensurePlayerStateNetworkHook()
	end
	if type(ensureSafeTeleportHooks) == "function" then
		ensureSafeTeleportHooks()
	end

	if typeof(state.baseRotation) ~= "CFrame" then
		state.baseRotation = rootPart.CFrame - rootPart.Position
	end
	state.lockedRotation = getUndergroundTravelRotation(rootPart)

	if state.originalRootAnchored == nil then
		state.originalRootAnchored = rootPart.Anchored
	end
	state.forceRootPart = rootPart
	pcall(function()
		rootPart.Anchored = true
		rootPart.Velocity = Vector3.zero
		rootPart.RotVelocity = Vector3.zero
	end)
	pcall(function()
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end)

	local gyro = state.bodyGyro
	if not gyro or gyro.Parent ~= rootPart then
		if gyro then
			pcall(function()
				gyro:Destroy()
			end)
		end
		gyro = Instance.new("BodyGyro")
		gyro.Name = "AutoMineUndergroundFreeze"
		gyro.MaxTorque = Vector3.new(9e8, 9e8, 9e8)
		gyro.P = 60000
		gyro.D = 1600
		gyro.Parent = rootPart
		state.bodyGyro = gyro
	end

	pcall(function()
		gyro.CFrame = CFrame.new(rootPart.Position) * state.lockedRotation
		rootPart.AssemblyAngularVelocity = Vector3.zero
		rootPart.RotVelocity = Vector3.zero
	end)

	return true
end

function endUndergroundOreHold(character)
	local state = getUndergroundOreHoldState()
	if not state.active and not state.character then
		return
	end

	local activeCharacter = character or state.character
	local repChar = state.repChar or resolveLocalRepChar(false)
	local playerCharacter = state.playerCharacter or resolvePlayerCharacterModule(false)
	local humanoid = state.humanoid or getHumanoid(activeCharacter)
	local rootPart = getRootPart(activeCharacter)

	if state.bodyGyro then
		pcall(function()
			state.bodyGyro:Destroy()
		end)
	end

	if isTable(repChar) and state.faceMouseDisabled then
		setExperimentalRepFaceMouseDisabled(repChar, false)
	end

	if isTable(playerCharacter) and state.playerFaceMouseDisabled then
		local faceMouse = rawget(playerCharacter, "FaceMouse") or playerCharacter.FaceMouse
		if type(faceMouse) == "function" then
			pcall(faceMouse, playerCharacter, state.originalPlayerFacingMouse ~= false)
		else
			pcall(function()
				playerCharacter.FacingMouse = state.originalPlayerFacingMouse ~= false
			end)
		end
	end

	if state.freezeHumanoid and state.originalAutoRotate ~= nil then
		pcall(function()
			state.freezeHumanoid.AutoRotate = state.originalAutoRotate
		end)
	end
	if state.freezeHumanoid and state.originalPlatformStand ~= nil then
		pcall(function()
			state.freezeHumanoid.PlatformStand = state.originalPlatformStand
		end)
	end
	if state.freezeHumanoid and state.originalEvaluateStateMachine ~= nil then
		pcall(function()
			state.freezeHumanoid.EvaluateStateMachine = state.originalEvaluateStateMachine
		end)
	end

	if rootPart then
		setUndergroundRootVelocity(rootPart, Vector3.zero)
	end
	local forceRootPart = rootPart or state.forceRootPart
	if forceRootPart and state.originalRootAnchored ~= nil then
		pcall(function()
			forceRootPart.Anchored = state.originalRootAnchored
		end)
	end
	setUndergroundCharacterCollisionEnabled(activeCharacter, true)

	playerState.undergroundOreHold = {}
	if type(ensurePlayerStateNetworkHook) == "function" then
		ensurePlayerStateNetworkHook()
	end
	if type(ensureSafeTeleportHooks) == "function" and (playerState.safeTeleportEnabled or playerState.noRagdollEnabled) then
		ensureSafeTeleportHooks()
	elseif type(restoreSafeTeleportHooks) == "function" then
		restoreSafeTeleportHooks()
	end
end

function beginUndergroundOreHold(character, targetPosition)
	if not (character and isUndergroundMovementMode(movementMode)) then
		return false
	end

	local holdState = getUndergroundOreHoldState()
	local travelState = getUndergroundTravelState()
	local preservedBaseRotation = typeof(travelState.baseRotation) == "CFrame" and travelState.baseRotation or nil
	if travelState.active then
		endUndergroundTravel(character)
	end

	local rootPart = getRootPart(character)
	if not rootPart then
		return false
	end

	local targetReferencePosition = typeof(targetPosition) == "Vector3" and targetPosition or rootPart.Position
	local goalPosition = getUndergroundGoalPosition(targetReferencePosition, character) or targetReferencePosition
	local goalCFrame = getUndergroundGoalCFrame(goalPosition, rootPart)
	local humanoid = getHumanoid(character)
	local repChar = resolveLocalRepChar(false) or resolveLocalRepChar(true)
	local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)

	holdState.active = true
	holdState.character = character
	holdState.humanoid = humanoid
	holdState.repChar = repChar
	holdState.playerCharacter = playerCharacter
	holdState.targetReferencePosition = targetReferencePosition
	holdState.goalPosition = goalPosition
	holdState.baseRotation = preservedBaseRotation or holdState.baseRotation or (rootPart.CFrame - rootPart.Position)
	holdState.lockedRotation = getUndergroundTravelRotation(rootPart)

	if isTable(playerCharacter) and not holdState.playerFaceMouseDisabled then
		local faceMouse = rawget(playerCharacter, "FaceMouse") or playerCharacter.FaceMouse
		holdState.originalPlayerFacingMouse = rawget(playerCharacter, "FacingMouse") ~= false
		if type(faceMouse) == "function" then
			holdState.playerFaceMouseDisabled = pcall(faceMouse, playerCharacter, false) and true or false
		else
			pcall(function()
				playerCharacter.FacingMouse = false
			end)
			holdState.playerFaceMouseDisabled = true
		end
	end

	if isTable(repChar) and not holdState.faceMouseDisabled then
		holdState.faceMouseDisabled = setExperimentalRepFaceMouseDisabled(repChar, true) and true or false
	end

	if humanoid and holdState.freezeHumanoid ~= humanoid then
		holdState.freezeHumanoid = humanoid
		holdState.originalAutoRotate = humanoid.AutoRotate
		holdState.originalPlatformStand = humanoid.PlatformStand
		pcall(function()
			holdState.originalEvaluateStateMachine = humanoid.EvaluateStateMachine
		end)
	end
	if humanoid then
		pcall(function()
			humanoid.AutoRotate = false
			humanoid.PlatformStand = true
			humanoid.Jump = false
			if holdState.originalEvaluateStateMachine ~= nil then
				humanoid.EvaluateStateMachine = false
			end
			humanoid:Move(Vector3.zero)
		end)
	end
	setUndergroundCharacterCollisionEnabled(character, false)

	if holdState.originalRootAnchored == nil then
		holdState.originalRootAnchored = rootPart.Anchored
	end
	holdState.forceRootPart = rootPart

	local gyro = holdState.bodyGyro
	if not gyro or gyro.Parent ~= rootPart then
		if gyro then
			pcall(function()
				gyro:Destroy()
			end)
		end
		gyro = Instance.new("BodyGyro")
		gyro.Name = "AutoMineUndergroundOreHold"
		gyro.MaxTorque = Vector3.new(9e8, 9e8, 9e8)
		gyro.P = 60000
		gyro.D = 1600
		gyro.Parent = rootPart
		holdState.bodyGyro = gyro
	end

	pcall(function()
		local bodyDelta = goalCFrame * rootPart.CFrame:Inverse()
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant ~= rootPart then
				descendant.CFrame = bodyDelta * descendant.CFrame
				descendant.Velocity = Vector3.zero
				descendant.RotVelocity = Vector3.zero
				descendant.AssemblyLinearVelocity = Vector3.zero
				descendant.AssemblyAngularVelocity = Vector3.zero
			end
		end
		rootPart.CFrame = goalCFrame
		rootPart.Anchored = true
		rootPart.Velocity = Vector3.zero
		rootPart.RotVelocity = Vector3.zero
	end)
	pcall(function()
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end)
	pcall(function()
		gyro.CFrame = goalCFrame
	end)

	if type(ensurePlayerStateNetworkHook) == "function" then
		ensurePlayerStateNetworkHook()
	end
	if type(ensureSafeTeleportHooks) == "function" then
		ensureSafeTeleportHooks()
	end

	return true
end

function syncUndergroundOrientationState(character)
	if not isUndergroundMovementMode(movementMode) then
		return false
	end

	local activeCharacter = character or cachedCharacter
	local travelState = getUndergroundTravelState()
	if travelState.active and typeof(activeCharacter) == "Instance" then
		local rootPart = getRootPart(activeCharacter)
		if rootPart then
			travelState.lockedRotation = getUndergroundTravelRotation(rootPart)
			if travelState.bodyGyro then
				pcall(function()
					travelState.bodyGyro.CFrame = CFrame.new(rootPart.Position) * travelState.lockedRotation
				end)
			end
			if travelState.forceRootPart == rootPart then
				local goalCFrame = getUndergroundGoalCFrame(rootPart.Position, rootPart)
				pcall(function()
					rootPart.CFrame = goalCFrame
				end)
			end
		end
	end

	local oreHoldState = getUndergroundOreHoldState()
	if oreHoldState.active and typeof(oreHoldState.character) == "Instance" then
		local oreCharacter = character or oreHoldState.character
		local targetReferencePosition = oreHoldState.targetReferencePosition or oreHoldState.goalPosition
		if typeof(targetReferencePosition) == "Vector3" then
			beginUndergroundOreHold(oreCharacter, targetReferencePosition)
			return true
		end
	end

	return true
end

function beginControlledUndergroundTravel(character)
	if not (character and isUndergroundMovementMode(movementMode)) then
		return false
	end

	if isUndergroundOreHoldActive() then
		endUndergroundOreHold(character)
	end

	local state = getUndergroundTravelState()
	if state.active and state.character == character then
		ensureUndergroundPreReplicateHook()
		return true
	end
	if state.active then
		endUndergroundTravel(state.character or character)
		state = getUndergroundTravelState()
	end

	local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	local repChar = resolveLocalRepChar(false) or resolveLocalRepChar(true)
	local humanoid = getHumanoid(character)
	local ragdolls = ensureExperimentalSoftRagdollBypass() or resolveRagdollsModule(false) or resolveRagdollsModule(true)
	local clientPlatforms = ensureUndergroundPlatformHook()
	local useControlledRagdoll = true

	state.active = true
	state.character = character
	state.playerCharacter = playerCharacter
	state.repChar = repChar
	state.humanoid = humanoid
	state.ragdolls = ragdolls
	state.clientPlatforms = clientPlatforms
	state.initialPlatform = (isTable(repChar) and (rawget(repChar, "CurrentPlatform") or repChar.CurrentPlatform)) or nil
	state.preservedPlatform = state.initialPlatform
	state.useControlledRagdoll = useControlledRagdoll
	local startRootPart = getRootPart(character)
	state.baseRotation = startRootPart and (startRootPart.CFrame - startRootPart.Position) or nil
	ensureUndergroundPreReplicateHook()

	if isTable(playerCharacter) and type(rawget(playerCharacter, "OnControlLost") or playerCharacter.OnControlLost) == "function" then
		local okControlLost = pcall(playerCharacter.OnControlLost, playerCharacter)
		state.usedControlLost = okControlLost and true or false
	end

	if useControlledRagdoll and isTable(repChar) then
		if state.originalRepCharIsRagdolled == nil then
			state.originalRepCharIsRagdolled = rawget(repChar, "IsRagdolled")
			if state.originalRepCharIsRagdolled == nil then
				state.originalRepCharIsRagdolled = repChar.IsRagdolled
			end
		end
		pcall(function()
			repChar.IsRagdolled = true
		end)
		state.usedLocalRepCharRagdollFlag = true
	end

	if useControlledRagdoll and isTable(playerCharacter) then
		local ragdollMethod = rawget(playerCharacter, "Ragdoll") or playerCharacter.Ragdoll
		if type(ragdollMethod) == "function" then
			local okServerRagdoll = pcall(ragdollMethod, playerCharacter, nil, true)
			state.usedServerRagdoll = okServerRagdoll and true or false
			state.usedSoftSelfRagdoll = okServerRagdoll and true or false
		end
		if not state.usedSoftSelfRagdoll then
			local toggleSelfRagdoll = rawget(playerCharacter, "ToggleSelfRagdoll") or playerCharacter.ToggleSelfRagdoll
			if type(toggleSelfRagdoll) == "function" then
				local okSoftRagdoll = pcall(toggleSelfRagdoll, playerCharacter, true)
				state.usedSoftSelfRagdoll = okSoftRagdoll and true or false
			end
		end
	end

	if useControlledRagdoll and isTable(ragdolls) then
		local controlRagdoll = rawget(ragdolls, "ControlRagdoll") or ragdolls.ControlRagdoll
		if type(controlRagdoll) == "function" then
			local okControlled = pcall(controlRagdoll, ragdolls, character)
			local isControllingRagdoll = rawget(ragdolls, "IsControllingRagdoll") or ragdolls.IsControllingRagdoll
			local reallyControlled = false
			if okControlled and type(isControllingRagdoll) == "function" then
				local okCheck, checkResult = pcall(isControllingRagdoll, ragdolls, character)
				reallyControlled = okCheck and checkResult == true
			end
			state.usedControlledRagdoll = reallyControlled
		end
	end
	if useControlledRagdoll and isTable(repChar) and type(rawget(repChar, "ControlRagdoll") or repChar.ControlRagdoll) == "function" then
		local okRepControlled = pcall(repChar.ControlRagdoll, repChar)
		state.usedRepCharControlledRagdoll = okRepControlled and true or false
	end

	if humanoid then
		pcall(function()
			if type(humanoid.UnequipTools) == "function" then
				humanoid:UnequipTools()
			end
			humanoid.Jump = false
			humanoid:Move(Vector3.zero)
		end)
	end

	if isTable(playerCharacter) and not state.usedControlLost then
		if type(rawget(playerCharacter, "EquipItem") or playerCharacter.EquipItem) == "function" then
			pcall(playerCharacter.EquipItem, playerCharacter, nil, true)
		end
		if type(rawget(playerCharacter, "StopAllTracks") or playerCharacter.StopAllTracks) == "function" then
			pcall(playerCharacter.StopAllTracks, playerCharacter)
		end
	end

	local rootPart = getRootPart(character)
	if rootPart then
		ensureUndergroundBodyFreeze(character, rootPart, Vector3.new(0, 0, -1))
	end
	local preservedPlatform = getUndergroundPreservedPlatform(state, clientPlatforms, character)
	if preservedPlatform then
		reassertUndergroundPlatformTarget(character, preservedPlatform)
	end

	return true
end

function endUndergroundTravel(character)
	local state = getUndergroundTravelState()
	local oreHoldState = playerState.undergroundOreHold
	if (not state.active and not state.playerCharacter and not state.usedControlledRagdoll and not state.usedSoftSelfRagdoll)
		and type(oreHoldState) == "table"
		and oreHoldState.active == true then
		endUndergroundOreHold(character)
		return
	end
	if not state.active and not state.playerCharacter and not state.usedControlledRagdoll and not state.usedSoftSelfRagdoll then
		return
	end

	local activeCharacter = character or state.character
	local playerCharacter = state.playerCharacter or resolvePlayerCharacterModule(false)
	local repChar = state.repChar or resolveLocalRepChar(false)
	local ragdolls = state.ragdolls or resolveRagdollsModule(false) or resolveRagdollsModule(true)
	local humanoid = state.humanoid or getHumanoid(activeCharacter)
	local network = resolveGlobalNetwork(false) or resolveGlobalNetwork(true)
	local rootPart = getRootPart(activeCharacter)

	state.ending = true

	if state.bodyGyro then
		pcall(function()
			state.bodyGyro:Destroy()
		end)
	end

	if isTable(repChar) and state.usedLocalForceCFrame then
		pcall(function()
			repChar.LocalForceCFrame = nil
		end)
	end

	if isTable(repChar) and state.faceMouseDisabled then
		setExperimentalRepFaceMouseDisabled(repChar, false)
	end

	if isTable(playerCharacter) and state.playerFaceMouseDisabled then
		local faceMouse = rawget(playerCharacter, "FaceMouse") or playerCharacter.FaceMouse
		if type(faceMouse) == "function" then
			pcall(faceMouse, playerCharacter, state.originalPlayerFacingMouse ~= false)
		else
			pcall(function()
				playerCharacter.FacingMouse = state.originalPlayerFacingMouse ~= false
			end)
		end
	end

	if isTable(ragdolls) and state.usedControlledRagdoll then
		local uncontrolRagdoll = rawget(ragdolls, "UncontrolRagdoll") or ragdolls.UncontrolRagdoll
		if type(uncontrolRagdoll) == "function" then
			pcall(uncontrolRagdoll, ragdolls, character or state.character)
		end
	end
	if isTable(repChar) and state.usedRepCharControlledRagdoll and type(rawget(repChar, "UncontrolRagdoll") or repChar.UncontrolRagdoll) == "function" then
		pcall(repChar.UncontrolRagdoll, repChar)
	end
	if isTable(repChar) and state.usedLocalRepCharRagdollFlag then
		local restoreIsRagdolled = state.originalRepCharIsRagdolled == true
		pcall(function()
			repChar.IsRagdolled = restoreIsRagdolled
		end)
	end

	if isTable(playerCharacter) and humanoid and humanoid.Health > 0 then
		if state.usedSoftSelfRagdoll and type(rawget(playerCharacter, "ToggleSelfRagdoll") or playerCharacter.ToggleSelfRagdoll) == "function" then
			pcall(playerCharacter.ToggleSelfRagdoll, playerCharacter, false)
		end
		if state.usedControlLost and type(rawget(playerCharacter, "GainControl") or playerCharacter.GainControl) == "function" then
			pcall(playerCharacter.GainControl, playerCharacter)
		end
	end

	if humanoid then
		pcall(function()
			humanoid.Jump = false
			humanoid:Move(Vector3.zero)
		end)
	end

	if state.usedServerRagdoll and humanoid and humanoid.Health > 0 and network and type(network.InvokeServer) == "function" then
		pcall(function()
			network:InvokeServer("AttemptGetUp")
		end)
	end

	if state.freezeHumanoid and state.originalAutoRotate ~= nil then
		pcall(function()
			state.freezeHumanoid.AutoRotate = state.originalAutoRotate
		end)
	end
	if state.freezeHumanoid and state.originalPlatformStand ~= nil then
		pcall(function()
			state.freezeHumanoid.PlatformStand = state.originalPlatformStand
		end)
	end
	if state.freezeHumanoid and state.originalEvaluateStateMachine ~= nil then
		pcall(function()
			state.freezeHumanoid.EvaluateStateMachine = state.originalEvaluateStateMachine
		end)
	end

	if rootPart then
		setUndergroundRootVelocity(rootPart, Vector3.zero)
	end
	local forceRootPart = rootPart or state.forceRootPart
	if forceRootPart and state.originalRootAnchored ~= nil then
		pcall(function()
			forceRootPart.Anchored = state.originalRootAnchored
		end)
	end
	setUndergroundCharacterCollisionEnabled(character or state.character, true)

	playerState.undergroundTravel = {}
	restoreUndergroundPreReplicateHook()
	restoreUndergroundPlatformHook()
	if type(ensurePlayerStateNetworkHook) == "function" then
		ensurePlayerStateNetworkHook()
	end
	if type(ensureSafeTeleportHooks) == "function" and (playerState.safeTeleportEnabled or playerState.noRagdollEnabled) then
		ensureSafeTeleportHooks()
	elseif type(restoreSafeTeleportHooks) == "function" then
		restoreSafeTeleportHooks()
	end
end

function ensureControlledUndergroundState(character, flatDirection)
	if not beginControlledUndergroundTravel(character) then
		return false
	end

	local rootPart = getRootPart(character)
	if not rootPart then
		return false
	end

	local state = getUndergroundTravelState()
	local direction = typeof(flatDirection) == "Vector3" and Vector3.new(flatDirection.X, 0, flatDirection.Z) or Vector3.new(0, 0, -1)
	if direction.Magnitude <= 0.001 then
		direction = Vector3.new(0, 0, -1)
	else
		direction = direction.Unit
	end
	ensureUndergroundBodyFreeze(character, rootPart, direction)
	local preservedPlatform = getUndergroundPreservedPlatform(state, state.clientPlatforms or ensureUndergroundPlatformHook(), character)
	if preservedPlatform then
		reassertUndergroundPlatformTarget(character, preservedPlatform)
	end
	return true
end

function undergroundCharacterTowards(character, targetPosition, activeToken, timeout, arriveDistance, movementOptions)
	local rootPart = getRootPart(character)
	if not rootPart or typeof(targetPosition) ~= "Vector3" then
		return false
	end

	clearMovementKeys()
	cancelActiveMoveTween()

	local wantedDistance = math.max(0.3, tonumber(arriveDistance) or getUndergroundPathReachDistance())
	local startedAt = os.clock()
	local lastStepAt = startedAt
	local travelTimeout = timeout or getDirectPathTravelTimeout(character, targetPosition, 0.45)
	local lastFlatDistance = nil
	local undergroundSnapCount = 0
	local useFlatPathFollow = type(movementOptions) == "table" and movementOptions.flatPathFollow == true

	while autoMineEnabled and activeToken == autoMineToken do
		rootPart = getRootPart(character)
		if not rootPart then
			return false
		end

		local goalPosition = getUndergroundGoalPosition(targetPosition, character)
		if not goalPosition then
			return false
		end

		local delta = goalPosition - rootPart.Position
		local flatDelta = Vector3.new(delta.X, 0, delta.Z)
		local flatDistance = flatDelta.Magnitude
		local verticalDistance = math.abs(delta.Y)
		local verticalReach = getUndergroundVerticalReachDistance(wantedDistance)
		if delta.Magnitude <= wantedDistance or (flatDistance <= wantedDistance and verticalDistance <= verticalReach) then
			setUndergroundRootVelocity(rootPart, Vector3.zero)
			ensureControlledUndergroundState(character, flatDistance > 0.001 and flatDelta.Unit or lastMoveCommand)
			setLastMoveCommand(Vector3.zero, "UndergroundArrived")
			return true
		end

		local flatDirection = flatDistance > 0.001 and flatDelta.Unit or lastMoveCommand
		if typeof(flatDirection) ~= "Vector3" or flatDirection.Magnitude < 0.001 then
			flatDirection = Vector3.new(0, 0, -1)
		else
			flatDirection = Vector3.new(flatDirection.X, 0, flatDirection.Z).Unit
		end

		if useFlatPathFollow then
			local avoidanceHandled, avoidReason = processPathPlayerAvoidance(
				character,
				targetPosition,
				activeToken,
				flatDirection,
				getHumanoid(character)
			)
			if avoidanceHandled then
				if avoidReason == "hop" then
					return false, "hop"
				end
				lastStepAt = os.clock()
				task.wait(0.05)
				continue
			end
		end

		ensureControlledUndergroundState(character, flatDirection)

		local now = os.clock()
		local stepTime = math.clamp(now - lastStepAt, 1 / 240, 0.08)
		lastStepAt = now
		local speed = getEffectiveUndergroundSpeed()
		local slowDownDistance = math.max(wantedDistance + 1.2, speed * 0.11)
		local speedScale = math.clamp(flatDistance / slowDownDistance, 0.28, 1)
		local stepDistance = math.clamp(speed * stepTime, 0.02, 8.0)
		local horizontalStep = math.min(stepDistance * speedScale, flatDistance)
		local nextFlatPosition = rootPart.Position
		if horizontalStep > 0.001 then
			nextFlatPosition = rootPart.Position + (flatDirection * horizontalStep)
		end
		local verticalStep = math.max(0.75, math.min((stepDistance * 1.6) + (math.abs(getUndergroundDepthOffset()) * 0.12), 8.5))
		local stepReference = Vector3.new(nextFlatPosition.X, targetPosition.Y, nextFlatPosition.Z)
		local stepGoal = getUndergroundGoalPosition(stepReference, character) or goalPosition
		local nextY = rootPart.Position.Y + math.clamp(stepGoal.Y - rootPart.Position.Y, -verticalStep, verticalStep)
		local stepTarget = Vector3.new(nextFlatPosition.X, nextY, nextFlatPosition.Z)
		local goalCFrame = getUndergroundGoalCFrame(stepTarget, rootPart)
		local stepStartPosition = rootPart.Position
		local stepStartFlatDistance = flatDistance

		setLastMoveCommand(flatDirection, "Underground")
		local forcedGoalApplied = applyUndergroundForcedCFrameGoal(character, goalCFrame)
		if not forcedGoalApplied then
			local horizontalVelocity = flatDirection * (speed * speedScale)
			local verticalVelocity = math.clamp(delta.Y * 5.5, -speed, speed)
			setUndergroundRootVelocity(rootPart, Vector3.new(horizontalVelocity.X, verticalVelocity, horizontalVelocity.Z))
		end

		if (now - startedAt) >= travelTimeout then
			break
		end

		RunService.Heartbeat:Wait()
		local liveRootPart = getRootPart(character)
		if not liveRootPart then
			return false
		end
		local liveGoal = getUndergroundGoalPosition(targetPosition, character)
		if liveGoal then
			local liveFlatPosition = Vector3.new(liveRootPart.Position.X, 0, liveRootPart.Position.Z)
			local liveGoalFlatPosition = Vector3.new(liveGoal.X, 0, liveGoal.Z)
			local stepStartFlatPosition = Vector3.new(stepStartPosition.X, 0, stepStartPosition.Z)
			local expectedStepFlatPosition = Vector3.new(stepTarget.X, 0, stepTarget.Z)
			local liveFlatDistance = (liveGoalFlatPosition - liveFlatPosition).Magnitude
			local actualStepFlatDelta = liveFlatPosition - stepStartFlatPosition
			local movedOppositeDirection = actualStepFlatDelta.Magnitude > 0.75
				and actualStepFlatDelta.Unit:Dot(flatDirection) < -0.45
			local stepDeviation = (liveFlatPosition - expectedStepFlatPosition).Magnitude
			local deviatedFromStep = stepDeviation > RUBBERBAND_STEP_DEVIATION_DISTANCE
			local snappedBackwards = liveFlatDistance > (stepStartFlatDistance + RUBBERBAND_BACKTRACK_DISTANCE)
				or (lastFlatDistance and liveFlatDistance > (lastFlatDistance + RUBBERBAND_BACKTRACK_DISTANCE))
			local verticalSnapThreshold = math.max(1.2, math.min(2.6, 0.95 + (math.abs(getUndergroundDepthOffset()) * 0.3)))
			local snappedUpFromUnderground = forcedGoalApplied and (liveRootPart.Position.Y - stepTarget.Y) > verticalSnapThreshold
			local platformDropped = false
			local state = getUndergroundTravelState()
			local repChar = state.repChar or resolveLocalRepChar(false)
			local currentPlatform = nil
			if isTable(repChar) then
				state.repChar = repChar
				local preservedPlatform = state.preservedPlatform or state.initialPlatform
				currentPlatform = rawget(repChar, "CurrentPlatform") or repChar.CurrentPlatform
				platformDropped = preservedPlatform ~= nil and currentPlatform == nil
			end
			if snappedBackwards or (deviatedFromStep and movedOppositeDirection) or snappedUpFromUnderground or platformDropped then
				setUndergroundRootVelocity(liveRootPart, Vector3.zero)
				applyUndergroundForcedCFrameGoal(character, goalCFrame)
				local preservedPlatform = state.preservedPlatform or state.initialPlatform
				if preservedPlatform then
					reassertUndergroundPlatformTarget(character, preservedPlatform)
				end
				undergroundSnapCount += (platformDropped and 2 or 1)
				local snapReasons = {}
				if snappedBackwards then
					table.insert(snapReasons, "back")
				end
				if deviatedFromStep and movedOppositeDirection then
					table.insert(snapReasons, "opposite")
				elseif deviatedFromStep then
					table.insert(snapReasons, "step")
				end
				if snappedUpFromUnderground then
					table.insert(snapReasons, "vertical")
				end
				if platformDropped then
					table.insert(snapReasons, "platform")
				end
				if #snapReasons <= 0 then
					table.insert(snapReasons, "snap")
				end
				local humanoidStateName = "nil"
				local humanoid = getHumanoid(character)
				if humanoid then
					pcall(function()
						local humanoidState = humanoid:GetState()
						humanoidStateName = humanoidState and humanoidState.Name or tostring(humanoidState)
					end)
				end
				local platformText = "nil"
				if currentPlatform ~= nil then
					local platformId = nil
					if isTable(currentPlatform) then
						platformId = rawget(currentPlatform, "Id") or currentPlatform.Id
					end
					platformText = platformId and tostring(platformId) or "set"
				end
				local repText = "rep=nil"
				if isTable(repChar) then
					repText = "rep=" .. tostring(repChar.IsReplicated)
						.. " rag=" .. tostring(repChar.IsRagdolled)
						.. " ctrl=" .. tostring(repChar.ControllingRagdoll)
						.. " force=" .. tostring(repChar.LocalForceCFrame ~= nil)
				end
				local referenceY = getUndergroundReferenceY(targetPosition) or targetPosition.Y
				local rootClearance = getUndergroundRootClearance(character)
				pushDebugRateLimited(
					"underground_rubberband",
					string.format(
						"underground rubberband [%s]: flat %.1f -> %.1f dev %.1f y %+0.1f depth %.1f clear %.1f refY %.1f state=%s plat=%s %s hook=%s root=%s step=%s goal=%s",
						table.concat(snapReasons, "+"),
						tonumber(lastFlatDistance or stepStartFlatDistance) or 0,
						liveFlatDistance,
						stepDeviation,
						liveRootPart.Position.Y - stepTarget.Y,
						getUndergroundDepthOffset(),
						rootClearance,
						referenceY,
						humanoidStateName,
						platformText,
						repText,
						tostring(playerState.undergroundPreReplicateConnection ~= nil),
						formatPathDebugVector3(liveRootPart.Position),
						formatPathDebugVector3(stepTarget),
						formatPathDebugVector3(liveGoal)
					),
					0.8
				)
				local severeFlatSnap = liveFlatDistance > (stepStartFlatDistance + math.max(12, RUBBERBAND_BACKTRACK_DISTANCE * 2.5))
					or (lastFlatDistance and liveFlatDistance > (lastFlatDistance + math.max(12, RUBBERBAND_BACKTRACK_DISTANCE * 2.5)))
				local severeStepSnap = stepDeviation > math.max(14, RUBBERBAND_STEP_DEVIATION_DISTANCE * 2.5)
				if severeFlatSnap or severeStepSnap or platformDropped or undergroundSnapCount >= 3 then
					if type(notifyRubberBandDetected) == "function" then
						notifyRubberBandDetected()
					end
					return false, "rubberband"
				end
				task.wait(0.03)
				continue
			end
			undergroundSnapCount = math.max(0, undergroundSnapCount - 1)
			lastFlatDistance = liveFlatDistance
		end
	end

	rootPart = getRootPart(character)
	if rootPart then
		setUndergroundRootVelocity(rootPart, Vector3.zero)
		local goalPosition = getUndergroundGoalPosition(targetPosition, character)
		if goalPosition then
			local delta = goalPosition - rootPart.Position
			local flatDistance = Vector3.new(delta.X, 0, delta.Z).Magnitude
			local finishSlack = math.max(0.35, wantedDistance * 0.45)
			return delta.Magnitude <= (wantedDistance + finishSlack)
				or (flatDistance <= (wantedDistance + finishSlack) and math.abs(delta.Y) <= (getUndergroundVerticalReachDistance(wantedDistance) + finishSlack))
		end
	end
	return false
end

function moveTowardsPosition(character, humanoid, targetPosition, activeToken, timeout)
	if movementMode == "tween" then
		return tweenCharacterTowards(character, targetPosition, activeToken, timeout)
	end
	if isCFrameMovementMode(movementMode) then
		return cframeCharacterTowards(character, targetPosition, activeToken, timeout, nil, getCFrameMovementOptions({
			useUndergroundOffset = false,
		}))
	end
	if isUndergroundMovementMode(movementMode) then
		return undergroundCharacterTowards(character, targetPosition, activeToken, timeout, nil, {
			flatPathFollow = false,
		})
	end

	return walkHumanoidTowards(character, humanoid, targetPosition, activeToken, timeout)
end

function getSegmentedPathTarget(currentPosition, finalTarget, maxDistance)
	local delta = finalTarget - currentPosition
	local distance = delta.Magnitude
	if distance <= (maxDistance or PATH_SEGMENT_DISTANCE) then
		return finalTarget
	end

	local direction = delta.Unit
	return currentPosition + (direction * (maxDistance or PATH_SEGMENT_DISTANCE))
end

function getDirectPathTravelTimeout(character, targetPosition, minimumTime)
	local rootPart = getRootPart(character)
	if not rootPart or not targetPosition then
		return math.max(tonumber(minimumTime) or 0.35, MOVE_TIMEOUT)
	end

	local flatDistance = (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(targetPosition.X, 0, targetPosition.Z)).Magnitude
	local travelSpeed = isCFrameMovementMode(movementMode) and getEffectiveCFrameSpeed()
		or (isUndergroundMovementMode(movementMode) and getEffectiveUndergroundSpeed())
		or math.max(clampTweenSpeed(tweenMoveSpeed, "tween"), 1)
	return math.max(tonumber(minimumTime) or 0.35, (flatDistance / travelSpeed) + 0.4)
end

function moveTowardsRecordedPathNode(character, humanoid, targetPosition, activeToken)
	if not targetPosition then
		return false
	end

	local rootPart = getRootPart(character)
	if not rootPart or not autoMineEnabled or activeToken ~= autoMineToken then
		return false
	end

	local pathReachDistance = isCFrameMovementMode(movementMode)
		and getCFramePathReachDistance()
		or (isUndergroundMovementMode(movementMode) and getUndergroundPathReachDistance())
		or math.max(1.8, WAYPOINT_REACH_DISTANCE * 0.6)
	local cframePathMode = isCFrameMovementMode(movementMode)
	local undergroundPathMode = isUndergroundMovementMode(movementMode)
	local flyPathOffset = movementMode == "cframefly" and getCFrameFlyOffset() or 0
	local cframeGoalPosition = cframePathMode and getCFramePathFollowGoalPosition(character, rootPart, targetPosition, flyPathOffset) or nil
	local undergroundGoalPosition = undergroundPathMode and getUndergroundGoalPosition(targetPosition, character) or nil
	local arrivalTargetPosition = cframeGoalPosition or undergroundGoalPosition or targetPosition
	local arrivalDelta = arrivalTargetPosition - rootPart.Position
	local flatDelta = Vector3.new(arrivalDelta.X, 0, arrivalDelta.Z)
	local flatDistance = flatDelta.Magnitude
	local verticalDistance = math.abs(arrivalDelta.Y)
	local pathVerticalReachDistance = cframePathMode
		and getCFramePathVerticalReachDistance(pathReachDistance)
		or (undergroundPathMode and getUndergroundVerticalReachDistance(pathReachDistance))
		or math.huge
	if flatDistance <= pathReachDistance and verticalDistance <= pathVerticalReachDistance then
		cancelActiveMoveTween()
		clearMovementKeys()
		setLastMoveCommand(Vector3.zero, "PathArrived")
		return true
	end

	if cframePathMode then
		clearMovementKeys()
		cancelActiveMoveTween()
		local goalDirection = flatDelta.Magnitude > 0.001 and flatDelta.Unit or Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z)
		if goalDirection.Magnitude < 0.001 then
			goalDirection = Vector3.new(0, 0, -1)
		end
		setLastMoveCommand(goalDirection, movementMode == "cframefly" and "PathCFrameFly" or "PathCFrame")
		return cframeCharacterTowards(
			character,
			targetPosition,
			activeToken,
			getDirectPathTravelTimeout(character, targetPosition, 0.45),
			pathReachDistance,
			getCFrameMovementOptions({
				flatPathFollow = true,
				useUndergroundOffset = false,
			})
		)
	end
	if undergroundPathMode then
		clearMovementKeys()
		cancelActiveMoveTween()
		local goalDirection = flatDelta.Magnitude > 0.001 and flatDelta.Unit or lastMoveCommand
		if typeof(goalDirection) ~= "Vector3" or goalDirection.Magnitude < 0.001 then
			goalDirection = Vector3.new(0, 0, -1)
		end
		setLastMoveCommand(goalDirection, "PathUnderground")
		return undergroundCharacterTowards(
			character,
			targetPosition,
			activeToken,
			getDirectPathTravelTimeout(character, targetPosition, 0.45),
			pathReachDistance,
			{
				flatPathFollow = true,
			}
		)
	end

	local groundedTarget = getGroundAlignedPathPosition(targetPosition, character) or targetPosition
	local currentGroundPoint = getCharacterGroundPoint(character, rootPart)
	if currentGroundPoint then
		currentGroundPoint = Vector3.new(rootPart.Position.X, currentGroundPoint.Y, rootPart.Position.Z)
	else
		currentGroundPoint = Vector3.new(rootPart.Position.X, groundedTarget.Y, rootPart.Position.Z)
	end

	local segmentGroundTarget = getSegmentedPathTarget(
		currentGroundPoint,
		groundedTarget,
		math.max(pathReachDistance + 0.9, PATH_RECORD_NODE_SPACING * 0.45)
	)
	local goalDirection = flatDelta.Magnitude > 0.001 and flatDelta.Unit or Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z)
	if goalDirection.Magnitude < 0.001 then
		goalDirection = Vector3.new(0, 0, -1)
	end

	local pathGroundClearance = math.max(2.05, math.min(getCharacterGroundClearance(character, rootPart) + 0.12, 3.1))
	local goalY = math.max(segmentGroundTarget.Y + pathGroundClearance, rootPart.Position.Y - 0.4)

	local goalPosition = Vector3.new(
		segmentGroundTarget.X,
		goalY,
		segmentGroundTarget.Z
	)

	clearMovementKeys()
	cancelActiveMoveTween()
	setLastMoveCommand(goalDirection, isCFrameMovementMode(movementMode) and "PathCFrame" or "PathTween")

	local moveDistance = (goalPosition - rootPart.Position).Magnitude
	local moveTime = math.clamp(moveDistance / math.max(clampTweenSpeed(tweenMoveSpeed, "tween"), 10), 0.05, 0.18)
	local tween = TweenService:Create(
		rootPart,
		TweenInfo.new(moveTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{ CFrame = CFrame.lookAt(goalPosition, goalPosition + goalDirection) }
	)
	activeMoveTween = tween

	local connection = nil
	connection = tween.Completed:Connect(function()
		if connection then
			connection:Disconnect()
		end
		if activeMoveTween == tween then
			activeMoveTween = nil
		end
	end)

	tween:Play()
	return true
end

function moveCharacterNearPosition(character, humanoid, targetPosition, arriveRange, activeToken)
	if not targetPosition then
		return false
	end

	local wantedRange = arriveRange or WAYPOINT_REACH_DISTANCE
	local useEntryPathfinding = pathState
		and pathState.playbackActive == true
		and pathState.entryPathingPending == true
	if isCFrameMovementMode(movementMode) and not useEntryPathfinding then
		return cframeCharacterTowards(
			character,
			targetPosition,
			activeToken,
			getDirectPathTravelTimeout(character, targetPosition, 0.5),
			wantedRange,
			getCFrameMovementOptions({
				useUndergroundOffset = false,
			})
		)
	end
	if isUndergroundMovementMode(movementMode) and not useEntryPathfinding then
		return undergroundCharacterTowards(
			character,
			targetPosition,
			activeToken,
			getDirectPathTravelTimeout(character, targetPosition, 0.5),
			wantedRange,
			{
				flatPathFollow = false,
			}
		)
	end
	local function getPathArrivalDistance()
		local rootPart = getRootPart(character)
		if not rootPart then
			return math.huge
		end
		if isUndergroundMovementMode(movementMode) then
			local goalPosition = getUndergroundGoalPosition(targetPosition, character)
			if goalPosition then
				return getUndergroundPathPlaybackDistance(rootPart, targetPosition, wantedRange)
			end
		end
		return (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(targetPosition.X, 0, targetPosition.Z)).Magnitude
	end

	if getPathArrivalDistance() <= wantedRange then
		return true
	end

	local rootPart = getRootPart(character)
	if not rootPart then
		return false
	end
	if useEntryPathfinding then
		pushPathDebugRateLimited(
			"entry_move_start",
			"node=" .. tostring(pathState.playbackNodeIndex)
				.. " dist=" .. getPathDebugDistanceText(rootPart.Position, targetPosition)
				.. " range=" .. string.format("%.2f", tonumber(wantedRange) or 0)
				.. " root=" .. formatPathDebugVector3(rootPart.Position)
				.. " target=" .. formatPathDebugVector3(targetPosition)
				.. " rejected=" .. tostring(countPathDebugRejectedEntryNodes()),
			1.5
		)
	end

	local computedPathReachDistance = isCFrameMovementMode(movementMode)
		and getCFrameComputedPathReachDistance(wantedRange)
		or (isUndergroundMovementMode(movementMode) and getUndergroundPathReachDistance())
		or WAYPOINT_REACH_DISTANCE
	local function getComputedPathPointDistance(point)
		local activeRootPart = getRootPart(character)
		if not activeRootPart or typeof(point) ~= "Vector3" then
			return math.huge
		end
		local flatRootPosition = Vector3.new(activeRootPart.Position.X, 0, activeRootPart.Position.Z)
		local flatPointPosition = Vector3.new(point.X, 0, point.Z)
		return (flatRootPosition - flatPointPosition).Magnitude
	end

	local function moveAlongComputedPathPoint(point)
		if isCFrameMovementMode(movementMode) then
			return cframeCharacterTowards(
				character,
				point,
				activeToken,
				getDirectPathTravelTimeout(character, point, 0.45),
				computedPathReachDistance,
				getCFrameMovementOptions({
					flatPathFollow = true,
					useUndergroundOffset = false,
				})
			)
		end
		if isUndergroundMovementMode(movementMode) then
			return undergroundCharacterTowards(
				character,
				point,
				activeToken,
				getDirectPathTravelTimeout(character, point, 0.45),
				computedPathReachDistance,
				{
					flatPathFollow = true,
				}
			)
		end
		return moveTowardsPosition(character, humanoid, point, activeToken, MOVE_TIMEOUT)
	end

	local function processEntryPathAvoidance(point)
		if not (pathState.playbackActive == true and pathState.entryPathingPending == true and typeof(point) == "Vector3") then
			return false
		end
		local activeRootPart = getRootPart(character)
		local forwardDirection = nil
		if activeRootPart then
			local flatDelta = Vector3.new(point.X - activeRootPart.Position.X, 0, point.Z - activeRootPart.Position.Z)
			if flatDelta.Magnitude > 0.001 then
				forwardDirection = flatDelta.Unit
			end
		end
		return processPathPlayerAvoidance(character, point, activeToken, forwardDirection, humanoid, nil)
	end

	local attempts = 0
	local lastMoveReason = nil
	while autoMineEnabled and activeToken == autoMineToken and attempts < PATH_REPLAN_ATTEMPTS do
		attempts += 1

		if getPathArrivalDistance() <= wantedRange then
			return true
		end

		rootPart = getRootPart(character)
		if not rootPart then
			return false
		end

		local pathTarget = getSegmentedPathTarget(rootPart.Position, targetPosition, PATH_SEGMENT_DISTANCE)
		local usingSegmentTarget = (pathTarget - targetPosition).Magnitude > 1
		local path = PathfindingService:CreatePath({
			AgentCanJump = true,
			WaypointSpacing = PATH_WAYPOINT_SPACING,
		})

		local computed = pcall(function()
			path:ComputeAsync(rootPart.Position, pathTarget)
		end)

		if computed and path.Status == Enum.PathStatus.Success then
			local waypoints = path:GetWaypoints()
			if useEntryPathfinding then
				pushPathDebugRateLimited(
					"entry_path_ok",
					"attempt=" .. tostring(attempts)
						.. " waypoints=" .. tostring(#waypoints)
						.. " root=" .. formatPathDebugVector3(rootPart.Position)
						.. " pathTarget=" .. formatPathDebugVector3(pathTarget)
						.. " final=" .. formatPathDebugVector3(targetPosition),
					2
				)
			end
			local points = {}
			for _, waypoint in ipairs(waypoints) do
				table.insert(points, waypoint.Position)
			end
			local isEntryPlaybackPath = pathState.playbackActive and pathState.entryPathingPending
			visualizePathPoints(points, targetPosition, isEntryPlaybackPath and {
				allowDuringPlayback = true,
				storeEntryPathPoints = true,
				startColor = PATH_VISUAL_PATHFINDER_COLOR,
				pointColor = PATH_VISUAL_PATHFINDER_COLOR,
				lineColor = PATH_VISUAL_PATHFINDER_COLOR,
				targetColor = PATH_VISUAL_PATHFINDER_COLOR,
				targetSize = Vector3.new(0.9, 0.9, 0.9),
			} or nil)

			local progressed = false
			for _, waypoint in ipairs(waypoints) do
				if not autoMineEnabled or activeToken ~= autoMineToken then
					return false
				end

				if getPathArrivalDistance() <= wantedRange then
					return true
				end

				if waypoint.Action == Enum.PathWaypointAction.Jump then
					humanoid.Jump = true
				end

				local avoidanceHandled, avoidReason = processEntryPathAvoidance(waypoint.Position)
				if avoidanceHandled then
					if avoidReason == "hop" then
						return false, "hop"
					end
					progressed = true
					break
				end

				local reached, moveReason = moveAlongComputedPathPoint(waypoint.Position)
				if reached then
					progressed = true
				else
					lastMoveReason = moveReason
					if useEntryPathfinding then
						pushPathDebugRateLimited(
							"entry_waypoint_fail",
							"attempt=" .. tostring(attempts)
								.. " reason=" .. tostring(moveReason or "none")
								.. " root=" .. getPathDebugRootPositionText(character)
								.. " waypoint=" .. formatPathDebugVector3(waypoint.Position)
								.. " final=" .. formatPathDebugVector3(targetPosition),
							0.8
						)
					end
					if moveReason == "rubberband" then
						return false, moveReason
					end
					break
				end
			end

			if autoMineEnabled and activeToken == autoMineToken and getComputedPathPointDistance(pathTarget) > computedPathReachDistance then
				local avoidanceHandled, avoidReason = processEntryPathAvoidance(pathTarget)
				if avoidanceHandled then
					if avoidReason == "hop" then
						return false, "hop"
					end
					progressed = true
					task.wait(0.05)
					continue
				end
				local reachedSegmentTarget, segmentMoveReason = moveAlongComputedPathPoint(pathTarget)
				if reachedSegmentTarget then
					progressed = true
				else
					lastMoveReason = segmentMoveReason
					if useEntryPathfinding then
						pushPathDebugRateLimited(
							"entry_segment_fail",
							"attempt=" .. tostring(attempts)
								.. " reason=" .. tostring(segmentMoveReason or "none")
								.. " root=" .. getPathDebugRootPositionText(character)
								.. " pathTarget=" .. formatPathDebugVector3(pathTarget)
								.. " final=" .. formatPathDebugVector3(targetPosition),
							0.8
						)
					end
					if segmentMoveReason == "rubberband" then
						return false, segmentMoveReason
					end
					break
				end
			end

			if progressed and usingSegmentTarget then
				pushDebugRateLimited("path_segment_progress", "pathing seller in segments", 2)
			elseif progressed then
				task.wait(0.05)
			else
				pushDebugRateLimited("path_segment_stall", "path segment stalled", 1.5)
				if useEntryPathfinding then
					pushPathDebugRateLimited(
						"entry_stall",
						"attempt=" .. tostring(attempts)
							.. " status=Success waypoints=" .. tostring(#waypoints)
							.. " root=" .. getPathDebugRootPositionText(character)
							.. " target=" .. formatPathDebugVector3(targetPosition),
						1
					)
				end
			end
		else
			if useEntryPathfinding then
				pushPathDebugRateLimited(
					"entry_compute_fail",
					"attempt=" .. tostring(attempts)
						.. " computed=" .. tostring(computed)
						.. " status=" .. tostring(path.Status)
						.. " root=" .. formatPathDebugVector3(rootPart.Position)
						.. " pathTarget=" .. formatPathDebugVector3(pathTarget)
						.. " final=" .. formatPathDebugVector3(targetPosition),
					1
				)
			end
			local isEntryPlaybackPath = pathState.playbackActive and pathState.entryPathingPending
			visualizePathPoints({ rootPart.Position, pathTarget }, targetPosition, isEntryPlaybackPath and {
				allowDuringPlayback = true,
				storeEntryPathPoints = true,
				startColor = PATH_VISUAL_PATHFINDER_COLOR,
				pointColor = PATH_VISUAL_PATHFINDER_COLOR,
				lineColor = PATH_VISUAL_PATHFINDER_COLOR,
				targetColor = PATH_VISUAL_PATHFINDER_COLOR,
				targetSize = Vector3.new(0.9, 0.9, 0.9),
			} or nil)

			local fallbackTarget = pathTarget
			local avoidanceHandled, avoidReason = processEntryPathAvoidance(fallbackTarget)
			if avoidanceHandled then
				if avoidReason == "hop" then
					return false, "hop"
				end
				task.wait(0.05)
				continue
			end
			if movementMode == "tween" then
				pushDebugRateLimited("tween_path_fallback", "tween fallback -> walk segment", 1.5)
				if not walkHumanoidTowards(character, humanoid, fallbackTarget, activeToken, MOVE_TIMEOUT) then
					break
				end
			else
				local reachedFallback, fallbackReason = moveAlongComputedPathPoint(fallbackTarget)
				if not reachedFallback then
					lastMoveReason = fallbackReason
					if useEntryPathfinding then
						pushPathDebugRateLimited(
							"entry_fallback_fail",
							"reason=" .. tostring(fallbackReason or "none")
								.. " root=" .. getPathDebugRootPositionText(character)
								.. " fallback=" .. formatPathDebugVector3(fallbackTarget)
								.. " final=" .. formatPathDebugVector3(targetPosition),
							0.8
						)
					end
					if fallbackReason == "rubberband" then
						return false, fallbackReason
					end
					break
				end
			end
		end
	end

	local arrived = getPathArrivalDistance() <= wantedRange
	if useEntryPathfinding and not arrived then
		pushPathDebugRateLimited(
			"entry_move_exit",
			"arrived=false reason=" .. tostring(lastMoveReason or "none")
				.. " dist=" .. string.format("%.1f", getPathArrivalDistance())
				.. " range=" .. string.format("%.2f", tonumber(wantedRange) or 0)
				.. " root=" .. getPathDebugRootPositionText(character)
				.. " target=" .. formatPathDebugVector3(targetPosition),
			0.8
		)
	end
	if not arrived and lastMoveReason then
		return false, lastMoveReason
	end
	return arrived
end

function moveCharacterNearOre(character, humanoid, oreDeposit, activeToken, arriveRange)
	local orePosition = getOrePosition(oreDeposit)
	if not orePosition then
		pushDebug("ore missing position")
		return false
	end

	local desiredRange = arriveRange or MINE_RANGE

	local function getOreApproachDistance()
		local rootPart = getRootPart(character)
		if not rootPart then
			return math.huge
		end
		if isCFrameMovementMode(movementMode) then
			return (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(orePosition.X, 0, orePosition.Z)).Magnitude
		end
		return (rootPart.Position - orePosition).Magnitude
	end

	if getOreApproachDistance() <= desiredRange then
		return true
	end

	local rootPart = getRootPart(character)
	if not rootPart then
		pushDebug("root part not found")
		return false
	end

	setStatus("Walking to " .. getOreDisplayName(oreDeposit), Color3.fromRGB(120, 190, 255))

	local movedNear = moveCharacterNearPosition(character, humanoid, orePosition, desiredRange, activeToken)
	if movedNear and getOreApproachDistance() <= desiredRange then
		return true
	end

	pushDebug(safeLower(getMovementModeLabel()) .. " move failed")
	return false
end

function tryAutoPickup(character, humanoid, activeToken, options)
	options = type(options) == "table" and options or nil
	if not autoPickupEnabled then
		return false
	end

	local pickupRange = math.max(0.5, tonumber(options and options.arriveRange) or PICKUP_RANGE)
	local pickupReachSlack = math.max(0.55, pickupRange * 0.18)
	local maxPickupDistance = tonumber(options and options.maxDistance) or AUTO_PICKUP_MAX_DISTANCE
	if maxPickupDistance < pickupRange then
		maxPickupDistance = pickupRange
	end
	local requireAlreadyInReach = options and options.requireAlreadyInReach == true
	local dropItem, distance = findNearestDroppedItem(character, maxPickupDistance)
	if not dropItem then
		return false
	end
	if requireAlreadyInReach and (not distance or distance > (pickupRange + pickupReachSlack)) then
		return false
	end

	local dropPart = getDroppedItemBasePart(dropItem)
	if not dropPart then
		return false
	end
	endExperimentalCFrameTravel(character)
	local network = resolveGlobalNetwork(false) or resolveGlobalNetwork(true)
	local actionGroupInstance, networkId = resolveDroppedPickupActionTarget(dropItem, dropPart)

	local dropName = getDropItemTypeName(dropItem)
	local dropLabel = getPickupLabel(dropName)
	pushDebug("pickup target: " .. dropLabel .. " (" .. tostring(math.floor((distance or 0) + 0.5)) .. ")")
	if dropName and AUTO_PICKUP_LABELS[dropName] then
		local fullForPickup, discardedForPickup = tryMakeRoomForDroppedPickup(character, activeToken, dropLabel)
		if fullForPickup then
			if not discardedForPickup then
				setStatus("Inventory full - discarding for " .. dropLabel, Color3.fromRGB(255, 190, 120))
				return true
			end
			if typeof(dropItem) ~= "Instance" or not dropItem.Parent or isDroppedItemDisabled(dropItem) or not dropPart.Parent then
				return true
			end
		end
	end
	setStatus("Picking up " .. dropLabel, Color3.fromRGB(165, 220, 140))

	local reached = true
	if requireAlreadyInReach then
		reached = getDistanceToPosition(character, dropPart.Position) <= (pickupRange + pickupReachSlack)
	else
		reached = moveCharacterNearPosition(character, humanoid, dropPart.Position, pickupRange, activeToken)
	end
	if not reached then
		pushDebug("pickup move failed")
		return false
	end

	if tryPickupDroppedItemViaNetwork(network, dropItem, dropPart, actionGroupInstance, networkId) then
		pushDebug("picked instantly: " .. dropLabel)
		return true
	end

	if tryPickupDroppedItemViaObjectAction(network, dropItem, dropPart, actionGroupInstance, networkId) then
		pushDebug("picked via object action: " .. dropLabel)
		return true
	end

	facePosition(character, dropPart.Position)
	clearMovementKeys()

	local startedAt = os.clock()
	setInteractKeyHeld(true)
	while autoMineEnabled and activeToken == autoMineToken and dropItem.Parent and (os.clock() - startedAt) < PICKUP_HOLD_SECONDS do
		task.wait(0.05)
	end
	setInteractKeyHeld(false)

	if dropItem.Parent then
		pushDebug("pickup timeout: " .. dropLabel)
	else
		pushDebug("picked: " .. dropLabel)
	end

	return true
end

function getSellTargetBasePart(instance)
	if typeof(instance) ~= "Instance" then
		return nil
	end

	if instance:IsA("Model") then
		return instance.PrimaryPart
			or instance:FindFirstChild("HumanoidRootPart")
			or instance:FindFirstChildWhichIsA("BasePart", true)
	end

	if instance:IsA("Attachment") and instance.Parent and instance.Parent:IsA("BasePart") then
		return instance.Parent
	end

	if instance:IsA("BillboardGui") or instance:IsA("SurfaceGui") then
		local adornee = instance.Adornee
		if adornee and adornee:IsA("BasePart") then
			return adornee
		end

		local parent = instance.Parent
		if parent and parent:IsA("BasePart") then
			return parent
		end
	end

	if instance:IsA("ProximityPrompt") or instance:IsA("ClickDetector") then
		local parent = instance.Parent
		if parent and parent:IsA("BasePart") then
			return parent
		end
	end

	if instance:IsA("BasePart") then
		return instance
	end

	local current = instance.Parent
	local depth = 0
	while current and depth < 8 do
		if current:IsA("BasePart") then
			return current
		end
		if current:IsA("Model") then
			local modelPart = current.PrimaryPart
				or current:FindFirstChild("HumanoidRootPart")
				or current:FindFirstChildWhichIsA("BasePart", true)
			if modelPart then
				return modelPart
			end
		end
		current = current.Parent
		depth += 1
	end

	return instance:FindFirstChildWhichIsA("BasePart", true)
end

function textMatchesAutoSellHints(text)
	if type(text) ~= "string" then
		return false
	end

	if AUTO_SELL_SHOP_TYPES[text] then
		return true
	end

	local loweredText = safeLower(text)
	for shopType in pairs(AUTO_SELL_SHOP_TYPES) do
		if string.find(loweredText, safeLower(shopType), 1, true) then
			return true
		end
	end

	for _, hint in ipairs(AUTO_SELL_SHOP_NAME_HINTS) do
		if string.find(loweredText, hint, 1, true) then
			return true
		end
	end

	return false
end

function getAutoSellMatchScore(instance)
	if typeof(instance) ~= "Instance" then
		return 100
	end

	local bestScore = 100
	local function considerText(text)
		if type(text) ~= "string" or text == "" then
			return
		end

		local lowered = safeLower(text)
		if string.find(lowered, "sell loot", 1, true) then
			bestScore = math.min(bestScore, 0)
		elseif AUTO_SELL_SHOP_TYPES[text] then
			bestScore = math.min(bestScore, 0)
		elseif textMatchesAutoSellHints(text) then
			bestScore = math.min(bestScore, 3)
		end
	end

	considerText(instance.Name)
	for _, attributeName in ipairs(AUTO_SELL_SHOP_ATTRIBUTE_NAMES) do
		considerText(instance:GetAttribute(attributeName))
	end
	for attributeName, attributeValue in pairs(instance:GetAttributes()) do
		considerText(attributeName)
		considerText(attributeValue)
	end

	if instance:IsA("ProximityPrompt") then
		considerText(instance.ActionText)
		considerText(instance.ObjectText)
		if safeLower(instance.ActionText) == "sell loot" then
			bestScore = math.min(bestScore, 0)
		end
	end

	for _, child in ipairs(instance:GetChildren()) do
		considerText(child.Name)
		if child:IsA("StringValue") or child:IsA("IntValue") then
			considerText(tostring(child.Value))
		end
	end

	return bestScore
end

function isSellPromptInstance(instance)
	return getAutoSellMatchScore(instance) <= 1
end

function instanceMatchesAutoSellShop(instance)
	if typeof(instance) ~= "Instance" then
		return false
	end

	local directName = instance.Name
	if textMatchesAutoSellHints(directName) then
		return true
	end

	for _, attributeName in ipairs(AUTO_SELL_SHOP_ATTRIBUTE_NAMES) do
		local attributeValue = instance:GetAttribute(attributeName)
		if textMatchesAutoSellHints(attributeValue) then
			return true
		end
	end

	for attributeName, attributeValue in pairs(instance:GetAttributes()) do
		if textMatchesAutoSellHints(attributeName) or textMatchesAutoSellHints(attributeValue) then
			return true
		end
	end

	if instance:IsA("ProximityPrompt") then
		if textMatchesAutoSellHints(instance.ActionText) or textMatchesAutoSellHints(instance.ObjectText) then
			return true
		end
	end

	for _, child in ipairs(instance:GetChildren()) do
		if textMatchesAutoSellHints(child.Name) then
			return true
		end

		if child:IsA("StringValue") or child:IsA("IntValue") then
			if textMatchesAutoSellHints(tostring(child.Value)) then
				return true
			end
		end
	end

	return false
end

function getAutoSellTargetCandidates(forceRefresh)
	local now = os.clock()
	if cachedAutoSellTargets and not forceRefresh then
		if #cachedAutoSellTargets > 0 then
			return cachedAutoSellTargets
		end

		if (now - lastAutoSellTargetScanAt) < 3 then
			return cachedAutoSellTargets
		end
	end

	lastAutoSellTargetScanAt = now
	local candidates = {}
	local seenParts = {}

	local function tryAddTarget(instance, basePart)
		if not basePart or not basePart.Parent or seenParts[basePart] then
			return
		end

		seenParts[basePart] = true
		table.insert(candidates, {
			part = basePart,
			instance = instance or basePart,
			score = getAutoSellMatchScore(instance or basePart),
		})
	end

	local configuredPart, configuredGui = getConfiguredGeneralShopTarget()
	tryAddTarget(configuredGui or configuredPart, configuredPart)

	local searchRoots = {
		workspace:FindFirstChild("WORKSPACE_Geometry"),
		getInteractablesFolder(),
		workspace:FindFirstChild("WORKSPACE_Entities"),
	}

	for _, searchRoot in ipairs(searchRoots) do
		if searchRoot then
			for _, descendant in ipairs(searchRoot:GetDescendants()) do
				local isSellUiOrPrompt = descendant:IsA("BillboardGui")
					or descendant:IsA("SurfaceGui")
					or descendant:IsA("ProximityPrompt")
					or descendant:IsA("ClickDetector")
				local isNamedSellActionGroup = AUTO_SELL_SHOP_TYPES[descendant.Name] == true
					or textMatchesAutoSellHints(descendant.Name)
				if isNamedSellActionGroup or (isSellUiOrPrompt and instanceMatchesAutoSellShop(descendant)) then
					tryAddTarget(descendant, getSellTargetBasePart(descendant))
				end
			end
		end
	end

	cachedAutoSellTargets = candidates
	return cachedAutoSellTargets
end

function getNodeDistanceToSellTarget(nodePosition, targetPart)
	if not nodePosition or not targetPart or not targetPart:IsA("BasePart") then
		return math.huge
	end

	local localPosition = targetPart.CFrame:PointToObjectSpace(nodePosition)
	local halfSize = targetPart.Size * 0.5
	return Vector3.new(
		math.max(math.abs(localPosition.X) - halfSize.X, 0),
		0,
		math.max(math.abs(localPosition.Z) - halfSize.Z, 0)
	).Magnitude
end

function getBestSellTargetForPath(pathData, preferredNodeIndex, forceRefresh)
	if type(pathData) ~= "table" then
		return nil, nil, nil, nil
	end

	local nodes = pathData.nodes or {}
	if #nodes == 0 then
		return nil, nil, nil, nil
	end

	local normalizedPreferredNodeIndex = normalizePathNodeIndex(preferredNodeIndex, #nodes)
	local candidates = getAutoSellTargetCandidates(forceRefresh)
	local bestPart = nil
	local bestInstance = nil
	local bestNodeIndex = nil
	local bestDistance = nil
	local bestScore = nil
	local bestMetric = nil

	for _, candidate in ipairs(candidates or {}) do
		local candidateNodeIndexes = {}
		if normalizedPreferredNodeIndex then
			if not isPathNodeDisconnected(pathData, normalizedPreferredNodeIndex) then
				candidateNodeIndexes[1] = normalizedPreferredNodeIndex
			end
		else
			for index = 1, #nodes do
				if not isPathNodeDisconnected(pathData, index) then
					candidateNodeIndexes[#candidateNodeIndexes + 1] = index
				end
			end
		end

		for _, nodeIndex in ipairs(candidateNodeIndexes) do
			local node = nodes[nodeIndex]
			local nodePosition = getPathNodePosition(node)
			local distance = nodePosition and getNodeDistanceToSellTarget(nodePosition, candidate.part) or math.huge
			if distance < math.huge then
				local metric = distance + ((candidate.score or 0) * 12)
				if not bestMetric
					or metric < bestMetric
					or (metric == bestMetric and distance < (bestDistance or math.huge))
				then
					bestMetric = metric
					bestDistance = distance
					bestScore = candidate.score
					bestNodeIndex = nodeIndex
					bestPart = candidate.part
					bestInstance = candidate.instance
				end
			end
		end
	end

	return bestPart, bestInstance, bestNodeIndex, bestDistance
end

function getPathSellTarget(pathData, forceRefresh)
	local manualSellNodeIndex = getManualPathSellNodeIndex(pathData)
	local sellerPart, sellerInstance, autoNodeIndex, autoDistance = getBestSellTargetForPath(pathData, manualSellNodeIndex, forceRefresh)
	if not sellerPart and not forceRefresh then
		sellerPart, sellerInstance, autoNodeIndex, autoDistance = getBestSellTargetForPath(pathData, manualSellNodeIndex, true)
	end

	if manualSellNodeIndex then
		return sellerPart, sellerInstance, manualSellNodeIndex, autoDistance
	end

	if autoNodeIndex and autoDistance and autoDistance <= PATH_RECORD_SELL_DISTANCE then
		return sellerPart, sellerInstance, autoNodeIndex, autoDistance
	end

	return sellerPart, sellerInstance, nil, autoDistance
end

function findNearestAutoSellTarget(character, forceRefresh)
	local rootPart = getRootPart(character)
	if not rootPart then
		return nil, nil, nil
	end

	local bestPart = nil
	local bestDistance = nil
	local bestInstance = nil
	local bestScore = nil
	local bestMetric = nil

	for _, candidate in ipairs(getAutoSellTargetCandidates(forceRefresh) or {}) do
		local distance = (rootPart.Position - candidate.part.Position).Magnitude
		local metric = distance + ((candidate.score or 0) * 12)
		if not bestMetric
			or metric < bestMetric
			or (metric == bestMetric and distance < (bestDistance or math.huge))
		then
			bestMetric = metric
			bestScore = candidate.score
			bestDistance = distance
			bestPart = candidate.part
			bestInstance = candidate.instance
		end
	end

	if not bestPart and not forceRefresh then
		return findNearestAutoSellTarget(character, true)
	end

	return bestPart, bestInstance, bestDistance
end

function pushNearbySellPromptHints(character)
	local rootPart = getRootPart(character)
	if not rootPart then
		return
	end

	local nearbyHints = {}
	local searchRoots = {
		getInteractablesFolder(),
		workspace:FindFirstChild("WORKSPACE_Entities"),
		workspace:FindFirstChild("WORKSPACE_Map"),
		workspace:FindFirstChild("Map"),
	}

	for _, searchRoot in ipairs(searchRoots) do
		if searchRoot then
			for _, descendant in ipairs(searchRoot:GetDescendants()) do
				if descendant:IsA("ProximityPrompt") then
					local actionText = tostring(descendant.ActionText or "")
					local objectText = tostring(descendant.ObjectText or "")
					if actionText ~= "" or objectText ~= "" then
						local basePart = getSellTargetBasePart(descendant)
						if basePart then
							local distance = (rootPart.Position - basePart.Position).Magnitude
							if distance <= 90 then
								table.insert(nearbyHints, {
									distance = distance,
									text = string.format("%s / %s", actionText, objectText),
									name = descendant:GetFullName(),
								})
							end
						end
					end
				end
			end
		end
	end

	table.sort(nearbyHints, function(left, right)
		return left.distance < right.distance
	end)

	for index = 1, math.min(#nearbyHints, 3) do
		local hint = nearbyHints[index]
		pushDebugRateLimited(
			"sell_prompt_hint_" .. tostring(index),
			string.format("sell prompt nearby: %d studs | %s | %s", math.floor(hint.distance + 0.5), hint.text, hint.name),
			6
		)
	end
end

function findSellPromptForTarget(targetInstance, targetPart)
	local candidates = {}
	local seen = {}

	local function tryAdd(instance)
		if typeof(instance) ~= "Instance" or seen[instance] then
			return
		end
		seen[instance] = true
		table.insert(candidates, instance)
	end

	local instanceCursor = targetInstance
	for _ = 1, 4 do
		if not instanceCursor then
			break
		end
		tryAdd(instanceCursor)
		instanceCursor = instanceCursor.Parent
	end

	if targetInstance then
		for _, descendant in ipairs(targetInstance:GetDescendants()) do
			tryAdd(descendant)
		end
	end

	if targetPart then
		tryAdd(targetPart)
		for _, descendant in ipairs(targetPart:GetDescendants()) do
			tryAdd(descendant)
		end
	end

	local bestPrompt = nil
	local bestScore = nil
	for _, candidate in ipairs(candidates) do
		if candidate:IsA("ProximityPrompt") then
			local score = getAutoSellMatchScore(candidate)
			if not bestScore or score < bestScore then
				bestScore = score
				bestPrompt = candidate
			end
		end
	end

	return bestPrompt
end

function getSellInteractKey(targetInstance, targetPart)
	local prompt = findSellPromptForTarget(targetInstance, targetPart)
	if prompt then
		local keyCode = prompt.KeyboardKeyCode
		if keyCode and keyCode ~= Enum.KeyCode.Unknown then
			pushDebugRateLimited("sell_prompt_key", "sell prompt key: " .. formatKeyCodeName(keyCode), 4)
			return keyCode, prompt
		end
	end

	return INTERACT_SECONDARY_KEY, prompt
end

function waitForSellInventoryDrop(filledBefore, timeoutSeconds, lootSummaryBefore)
	local timeoutAt = os.clock() + math.max(0.1, tonumber(timeoutSeconds) or 0.8)
	local latestFilled = filledBefore
	local latestLootSummary = nil

	while os.clock() < timeoutAt do
		latestLootSummary = getSellableLootSummary(false)
		if wasSellableLootReduced(lootSummaryBefore, latestLootSummary) then
			local summaryFilledSlots = tonumber(rawget(latestLootSummary, "filledSlots") or latestLootSummary.filledSlots)
			if summaryFilledSlots ~= nil then
				latestFilled = summaryFilledSlots
			else
				latestFilled = select(1, getInventorySlotCounts())
			end
			return true, latestFilled, latestLootSummary
		end

		latestFilled = select(1, getInventorySlotCounts())
		if latestFilled < filledBefore then
			return true, latestFilled, latestLootSummary
		end
		task.wait(0.05)
	end

	latestLootSummary = getSellableLootSummary(false)
	if wasSellableLootReduced(lootSummaryBefore, latestLootSummary) then
		local summaryFilledSlots = tonumber(rawget(latestLootSummary, "filledSlots") or latestLootSummary.filledSlots)
		if summaryFilledSlots ~= nil then
			latestFilled = summaryFilledSlots
		else
			latestFilled = select(1, getInventorySlotCounts())
		end
		return true, latestFilled, latestLootSummary
	end

	latestFilled = select(1, getInventorySlotCounts())
	return latestFilled < filledBefore, latestFilled, latestLootSummary
end

function tryFireSellPromptDirectly(prompt)
	if not (prompt and prompt:IsA("ProximityPrompt")) then
		return false
	end

	if type(fireproximityprompt) == "function" then
		for _, args in ipairs({
			{},
			{ 0 },
			{ 0, true },
			{ tonumber(prompt.HoldDuration) or 0, true },
		}) do
			local ok = pcall(function()
				fireproximityprompt(prompt, unpack(args))
			end)
			if ok then
				return true
			end
		end
	end

	local okBegin = pcall(function()
		prompt:InputHoldBegin()
	end)
	if okBegin then
		task.wait(math.max(0.05, tonumber(prompt.HoldDuration) or 0))
		pcall(function()
			prompt:InputHoldEnd()
		end)
		return true
	end

	return false
end

