local function isAnyClass(instance, classNames)
	if not instance then
		return false
	end
	for _, className in ipairs(classNames) do
		if instance:IsA(className) then
			return true
		end
	end
	return false
end

local function findNamedInstance(root, names, classNames)
	if not root then
		return nil
	end
	for _, name in ipairs(names) do
		local found = root:FindFirstChild(name, true)
		if found and (not classNames or isAnyClass(found, classNames)) then
			return found
		end
	end
	return nil
end

local function fireRecoveredSignal(signal, enabled)
	if not signal then
		return false
	end
	local ok = false
	if signal:IsA("BoolValue") then
		signal.Value = enabled == true
		return true
	end
	if signal:IsA("RemoteEvent") then
		ok = pcall(function()
			signal:FireServer(enabled == true)
		end)
	elseif signal:IsA("BindableEvent") then
		ok = pcall(function()
			signal:Fire(enabled == true)
		end)
	elseif signal:IsA("RemoteFunction") then
		ok = pcall(function()
			signal:InvokeServer(enabled == true)
		end)
	elseif signal:IsA("BindableFunction") then
		ok = pcall(function()
			signal:Invoke(enabled == true)
		end)
	end
	return ok
end

local function getSearchRoots(character)
	local roots = { ReplicatedStorage, workspace, LocalPlayer }
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui then
		table.insert(roots, playerGui)
	end
	if character then
		table.insert(roots, 1, character)
	end
	return roots
end

local function getPlayerNamedModel(container)
	if not container then
		return nil
	end
	local byName = container:FindFirstChild(LocalPlayer.Name)
	if byName and byName:IsA("Model") then
		return byName
	end
	local byUserId = container:FindFirstChild(tostring(LocalPlayer.UserId))
	if byUserId and byUserId:IsA("Model") then
		return byUserId
	end
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Model") then
			local owner = child:FindFirstChild("Owner")
			if owner and owner:IsA("ObjectValue") and owner.Value == LocalPlayer then
				return child
			end
			local userId = child:GetAttribute("UserId") or child:GetAttribute("OwnerUserId")
			if tostring(userId) == tostring(LocalPlayer.UserId) then
				return child
			end
			local ownerName = child:GetAttribute("Owner") or child:GetAttribute("PlayerName")
			if tostring(ownerName) == LocalPlayer.Name then
				return child
			end
		end
	end
	return nil
end

function Adapter.getCharacter()
	local explicit = LocalPlayer:FindFirstChild("PlayerCharacter")
	if explicit then
		if explicit:IsA("ObjectValue") and explicit.Value and explicit.Value:IsA("Model") then
			return explicit.Value, "LocalPlayer.PlayerCharacter"
		end
		if explicit:IsA("Model") then
			return explicit, "LocalPlayer.PlayerCharacter"
		end
	end

	local entities = workspace:FindFirstChild("WORKSPACE_Entities")
	if entities then
		local playersFolder = entities:FindFirstChild("Players")
		local replicated = getPlayerNamedModel(playersFolder)
		if replicated then
			return replicated, "workspace.WORKSPACE_Entities.Players"
		end
	end

	local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	return character, "LocalPlayer.Character"
end

function Adapter.getHumanoid(character)
	return character and character:FindFirstChildOfClass("Humanoid")
end

function Adapter.getRoot(character)
	if not character then
		return nil
	end
	if character:IsA("BasePart") then
		return character
	end
	if character.PrimaryPart then
		return character.PrimaryPart
	end
	return character:FindFirstChild("RootPart", true)
		or character:FindFirstChild("HumanoidRootPart", true)
		or character:FindFirstChild("LowerTorso", true)
		or character:FindFirstChildWhichIsA("BasePart", true)
end

local function isTable(value)
	return type(value) == "table"
end

local function tableField(source, key)
	if not isTable(source) then
		return nil
	end
	local ok, value = pcall(function()
		local rawValue = rawget(source, key)
		if rawValue ~= nil then
			return rawValue
		end
		return source[key]
	end)
	return ok and value or nil
end

local function addRuntimeTable(list, seen, candidate)
	if isTable(candidate) and not seen[candidate] then
		seen[candidate] = true
		table.insert(list, candidate)
	end
end

local function getRuntimeTables()
	local tables = {}
	local seen = {}
	addRuntimeTable(tables, seen, _G)
	if isTable(shared) then
		addRuntimeTable(tables, seen, shared)
	end
	for _, rootTable in ipairs({ _G, isTable(shared) and shared or nil }) do
		for _, key in ipairs({
			"__AutoMineGlobalModule",
			"__WesternGlobalModule",
			"GlobalModule",
			"globalModule",
			"MainModule",
			"mainModule",
			"Modules",
			"modules",
		}) do
			addRuntimeTable(tables, seen, tableField(rootTable, key))
		end
	end
	return tables
end

local function tryLoadRuntimeModule(owner, moduleName)
	local loadModule = tableField(owner, "LoadModule")
	if type(loadModule) ~= "function" then
		return nil
	end
	local ok, result = pcall(loadModule, owner, moduleName)
	if ok and isTable(result) then
		return result
	end
	ok, result = pcall(loadModule, moduleName)
	if ok and isTable(result) then
		return result
	end
	return nil
end

function Adapter.resolveRepCharAssist(state)
	if Settings.Underground_RepChar_Assist == false then
		return nil, nil
	end
	state = isTable(state) and state or {}
	if isTable(state.repChar) or isTable(state.playerCharacter) then
		return state.repChar, state.playerCharacter
	end

	local repChar
	local playerCharacter

	local function adoptRepChar(candidate)
		if isTable(candidate) and not repChar then
			repChar = candidate
		end
	end

	local function adoptPlayerCharacter(candidate)
		if not isTable(candidate) then
			return
		end
		playerCharacter = playerCharacter or candidate
		adoptRepChar(tableField(candidate, "RepChar"))
		adoptRepChar(tableField(candidate, "LocalRepChar"))
	end

	local function adoptRepCharHandler(candidate)
		if not isTable(candidate) then
			return
		end
		adoptRepChar(tableField(candidate, "LocalRepChar"))
		local getRepChar = tableField(candidate, "GetRepChar")
		if type(getRepChar) == "function" then
			local ok, result = pcall(getRepChar, candidate, LocalPlayer)
			if ok then
				adoptRepChar(result)
			else
				ok, result = pcall(getRepChar, LocalPlayer)
				if ok then
					adoptRepChar(result)
				end
			end
		end
	end

	for _, rootTable in ipairs(getRuntimeTables()) do
		adoptPlayerCharacter(tableField(rootTable, "PlayerCharacter"))
		adoptPlayerCharacter(tableField(rootTable, "playerCharacter"))
		adoptPlayerCharacter(tableField(rootTable, "plrCharacter"))
		adoptRepCharHandler(tableField(rootTable, "RepCharHandler"))
		adoptRepCharHandler(tableField(rootTable, "repCharHandler"))
		adoptRepChar(tableField(rootTable, "LocalRepChar"))
		adoptRepChar(tableField(rootTable, "RepChar"))

		adoptPlayerCharacter(tryLoadRuntimeModule(rootTable, "PlayerCharacter"))
		adoptRepCharHandler(tryLoadRuntimeModule(rootTable, "RepCharHandler"))

		if repChar and playerCharacter then
			break
		end
	end

	state.repChar = repChar
	state.playerCharacter = playerCharacter
	return repChar, playerCharacter
end

function Adapter.repCharAssistActive(state)
	if Settings.Underground_RepChar_Assist == false then
		return false
	end
	local repChar = isTable(state) and state.repChar or nil
	if not isTable(repChar) then
		repChar = Adapter.resolveRepCharAssist(state)
	end
	return isTable(repChar)
end

function Adapter.clearRepCharPlatform(state)
	local repChar = isTable(state) and state.repChar or nil
	if not isTable(repChar) then
		return false
	end
	pcall(function()
		repChar.CurrentPlatform = nil
		repChar.FloorPlatform = nil
		repChar.LastFloorPlatform = nil
		repChar.LastFloorPart = nil
		repChar.LastWasGrounded = false
	end)
	return true
end

function Adapter.setRepCharFaceMouseDisabled(state, disabled)
	if Settings.Underground_RepChar_Assist == false or not isTable(state) then
		return false
	end
	local _, playerCharacter = Adapter.resolveRepCharAssist(state)
	if not isTable(playerCharacter) then
		return false
	end

	local faceMouse = tableField(playerCharacter, "FaceMouse")
	if disabled then
		if state.originalPlayerFacingMouse == nil then
			local facing = tableField(playerCharacter, "FacingMouse")
			state.originalPlayerFacingMouse = facing ~= false
		end
		state.playerFaceMouseDisabled = true
		if type(faceMouse) == "function" then
			local ok = pcall(faceMouse, playerCharacter, false)
			if ok then
				return true
			end
		end
		return pcall(function()
			playerCharacter.FacingMouse = false
		end)
	end

	if not state.playerFaceMouseDisabled then
		return false
	end
	local restoreFacing = state.originalPlayerFacingMouse ~= false
	state.playerFaceMouseDisabled = nil
	state.originalPlayerFacingMouse = nil
	if type(faceMouse) == "function" then
		local ok = pcall(faceMouse, playerCharacter, restoreFacing)
		if ok then
			return true
		end
	end
	return pcall(function()
		playerCharacter.FacingMouse = restoreFacing
	end)
end

function Adapter.setRootVelocity(root, velocity)
	if not (root and root:IsA("BasePart")) then
		return
	end
	velocity = typeof(velocity) == "Vector3" and velocity or Vector3.zero
	pcall(function()
		root.Velocity = velocity
		root.RotVelocity = Vector3.zero
	end)
	pcall(function()
		root.AssemblyLinearVelocity = velocity
		root.AssemblyAngularVelocity = Vector3.zero
	end)
end

function Adapter.ensureUndergroundGyro(state, root, cframe)
	if not (isTable(state) and root and root:IsA("BasePart") and typeof(cframe) == "CFrame") then
		return false
	end
	local gyro = state.bodyGyro
	if not gyro or gyro.Parent ~= root then
		if gyro then
			pcall(function()
				gyro:Destroy()
			end)
		end
		gyro = Instance.new("BodyGyro")
		gyro.Name = "WesternUndergroundRepCharAssist"
		gyro.MaxTorque = Vector3.new(9e8, 9e8, 9e8)
		gyro.P = 60000
		gyro.D = 1600
		gyro.Parent = root
		state.bodyGyro = gyro
	end
	pcall(function()
		gyro.CFrame = cframe
	end)
	return true
end

function Adapter.releaseRepCharAssist(state)
	if not isTable(state) then
		return
	end
	local repChar = state.repChar
	if isTable(repChar) and state.usedLocalForceCFrame then
		pcall(function()
			repChar.LocalForceCFrame = nil
		end)
	end
	Adapter.setRepCharFaceMouseDisabled(state, false)
	if state.bodyGyro then
		pcall(function()
			state.bodyGyro:Destroy()
		end)
	end
	state.bodyGyro = nil
	state.repChar = nil
	state.playerCharacter = nil
	state.usedLocalForceCFrame = nil
	state.playerFaceMouseDisabled = nil
	state.originalPlayerFacingMouse = nil
end

function Adapter.findRecoveredSignals(character, names)
	local signals = {}
	for _, root in ipairs(getSearchRoots(character)) do
		local signal = findNamedInstance(root, names, {
			"RemoteEvent",
			"RemoteFunction",
			"BindableEvent",
			"BindableFunction",
			"BoolValue",
		})
		if signal then
			table.insert(signals, signal)
		end
	end
	return signals
end

function Adapter.setCustomCrouch(character, enabled)
	if not adapterCache.crouchSignals or #adapterCache.crouchSignals == 0 then
		adapterCache.crouchSignals = Adapter.findRecoveredSignals(character, {
			"IsCrouchButtonDown",
			"SetCrouched",
			"Crouched",
			"IsCrouched",
		})
	end

	local fired = false
	for _, signal in ipairs(adapterCache.crouchSignals) do
		fired = fireRecoveredSignal(signal, enabled) or fired
	end
	return fired
end

