function tryPathServerHop(reasonText, resumeSlotIndex, forceHop, flagReason, flagContext)
	if (not forceHop and not serverHopEnabled) or serverHopInProgress then
		serverHopTaskQueued = false
		return false
	end

	local normalizedResumeSlotIndex = normalizePathSlotIndex(resumeSlotIndex)
	serverHopTaskQueued = false
	serverHopInProgress = true
	serverHopRateLimitedUntil = 0
	prepareForPathServerHop(cachedCharacter, "ServerHop")
	setStatus("Finding a smaller server...", Color3.fromRGB(120, 190, 255))
	setServerHopStatus(tostring(reasonText or "Finding a smaller public server..."), Color3.fromRGB(120, 190, 255))
	if normalizedResumeSlotIndex then
		setPathSequenceStartSlotIndex(normalizedResumeSlotIndex)
		setPathResumePlaybackPending(true, true)
	else
		setPathResumePlaybackPending(false, true)
	end
	if type(refreshServerHopDisplay) == "function" then
		refreshServerHopDisplay()
	end

	local queuedOk, queueStatus = queueCurrentScriptForServerHop()
	if not queuedOk then
		pushDebug("server hop queue: " .. tostring(queueStatus))
		pushDebug("server hop will rely on auto-execute or rerunning the script")
	end

	local targetServer, findErr = findSmallServerHopTarget()
	if not targetServer then
		if isServerHopRateLimitError(findErr) then
			local remaining = math.ceil(setServerHopRateLimitCooldown())
			setServerHopStatus("Low-server lookup rate-limited; retrying in " .. tostring(remaining) .. "s", Color3.fromRGB(255, 190, 120))
			pushDebugRateLimited("server_hop_429", "server hop low-server lookup rate-limited; waiting before retry", 5)
			serverHopInProgress = false
			serverHopTaskQueued = true
			while serverHopTaskQueued and not serverHopInProgress and getServerHopRateLimitRemaining() > 0 do
				task.wait(math.min(1, getServerHopRateLimitRemaining()))
			end
			if serverHopTaskQueued and not serverHopInProgress then
				return tryPathServerHop(reasonText, resumeSlotIndex, forceHop, flagReason, flagContext)
			end
			return false
		end
		serverHopInProgress = false
		serverHopTaskQueued = false
		pathState.playerAvoiderHopQueued = false
		if normalizedResumeSlotIndex then
			setPathResumePlaybackPending(false, true)
		end
		setServerHopStatus("Hop failed: " .. tostring(findErr), Color3.fromRGB(255, 190, 120))
		pushDebug("server hop failed: " .. tostring(findErr))
		if type(refreshServerHopDisplay) == "function" then
			refreshServerHopDisplay()
		end
		return false
	end

	if flagReason then
		pcall(sendDiscordAutomineFlagWebhook, flagReason, reasonText, flagContext)
	end

	local playersNow = tonumber(targetServer.playing) or 0
	local maxPlayers = tonumber(targetServer.maxPlayers) or 0
	pushDebug(string.format("server hop target: %s (%d/%d)", tostring(targetServer.id), playersNow, maxPlayers))
	setStatus(string.format("Server hopping (%d/%d)", playersNow, maxPlayers), Color3.fromRGB(120, 190, 255))
	setServerHopStatus(string.format("Joining a %d / %d server...", playersNow, maxPlayers), Color3.fromRGB(120, 190, 255))

	-- Run teleport asynchronously to prevent game freeze
	local teleportSuccess = false
	local teleportErrMsg = nil
	local hopCompleted = false

	task.spawn(function()
		local teleported, err = teleportToServerInstance(targetServer.id)
		if teleported then
			teleportSuccess = true
		else
			teleportErrMsg = err
		end
		hopCompleted = true
	end)

	-- Wait for teleport with timeout
	local timeout = 8
	local startWait = os.clock()
	while not hopCompleted and (os.clock() - startWait) < timeout do
		task.wait(0.1)
	end

	if not teleportSuccess then
		local errMsg = teleportErrMsg or "timeout"
		if not hopCompleted then
			setServerHopStatus("Hop request still pending...", Color3.fromRGB(255, 190, 120))
			pushDebug("server hop teleport still pending; not starting another teleport")
			if type(refreshServerHopDisplay) == "function" then
				refreshServerHopDisplay()
			end
			return true
		end
		serverHopInProgress = false
		serverHopTaskQueued = false
		pathState.playerAvoiderHopQueued = false
		if normalizedResumeSlotIndex then
			setPathResumePlaybackPending(false, true)
		end
		setServerHopStatus("Hop failed: " .. tostring(errMsg), Color3.fromRGB(255, 190, 120))
		pushDebug("server hop teleport failed: " .. tostring(errMsg))
		if type(refreshServerHopDisplay) == "function" then
			refreshServerHopDisplay()
		end
		return false
	end

	if type(refreshServerHopDisplay) == "function" then
		refreshServerHopDisplay()
	end

	return true
end

function remoteMatchesKeywords(remote, keywords)
	local name = safeLower(remote.Name)
	for _, keyword in ipairs(keywords) do
		if string.find(name, safeLower(keyword), 1, true) ~= nil then
			return true
		end
	end
	return false
end

function findRemote(roots, keywords)
	for _, root in ipairs(roots) do
		if root then
			for _, descendant in ipairs(root:GetDescendants()) do
				if (
					descendant:IsA("RemoteEvent")
					or descendant:IsA("RemoteFunction")
					or descendant:IsA("BindableEvent")
					or descendant:IsA("BindableFunction")
				) and remoteMatchesKeywords(descendant, keywords) then
					return descendant
				end
			end
		end
	end

	return nil
end

function findRemotes(roots, keywords, maxCount)
	local results = {}
	local seen = {}

	for _, root in ipairs(roots) do
		if root then
			for _, descendant in ipairs(root:GetDescendants()) do
				local isRemote = descendant:IsA("RemoteEvent")
					or descendant:IsA("RemoteFunction")
					or descendant:IsA("BindableEvent")
					or descendant:IsA("BindableFunction")

				if isRemote and not seen[descendant] and remoteMatchesKeywords(descendant, keywords) then
					seen[descendant] = true
					table.insert(results, descendant)
					if maxCount and #results >= maxCount then
						return results
					end
				end
			end
		end
	end

	return results
end

function getEquipRemote(forceRefresh)
	if cachedEquipRemote and cachedEquipRemote.Parent then
		return cachedEquipRemote
	end

	local now = os.clock()
	if not forceRefresh and (now - lastEquipRemoteScanAt) < RESCAN_INTERVAL then
		return nil
	end

