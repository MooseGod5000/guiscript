		info.button.BackgroundColor3 = selected and Theme.Accent or Theme.Background
		info.button.BackgroundTransparency = selected and 0.45 or 1
		info.button.TextColor3 = Theme.Text
		if info.left then
			info.left.BackgroundColor3 = Theme.BorderDark
		end
		if info.right then
			info.right.BackgroundColor3 = Theme.BorderDark
		end
	end
