function bindKeyCaptureControl(keyBoxBg, keyLabel, keyButton, accentColor, getKeyLabelFn, setKeyFn, helpText, afterSetFn)
    local listening = false
    local listenConnection = nil
    local function stopListening(resetText)
        if not listening then
            return
        end
        listening = false
        endKeyCapture()
        if listenConnection then
            listenConnection:Disconnect()
            listenConnection = nil
        end
        keyBoxBg.BorderColor3 = UI_STYLE.color.valueBorder
        keyLabel.TextColor3 = UI_STYLE.color.white
        if resetText then
            keyLabel.Text = getKeyLabelFn()
        end
    end
    connectUiSignal(keyButton.MouseButton1Click, function()
        if destroyed then
            return
        end
        _UTILS._createParticleBurst(keyBoxBg)
        if listening then
            stopListening(true)
            return
        end
        listening = true
        beginKeyCapture()
        keyLabel.Text = ". . ."
        keyBoxBg.BorderColor3 = accentColor
        keyLabel.TextColor3 = accentColor
        if helpText then
            spawnNotification(helpText, "info", true)
        end
        listenConnection = connectUiSignal(_UserInputService.InputBegan, function(input, gameProcessed)
            if destroyed or not listening or gameProcessed then
                return
            end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then
                return
            end
            if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                stopListening(true)
                return
            end
            if input.KeyCode == Enum.KeyCode.Delete then
                setKeyFn(nil)
                stopListening(true)
                if afterSetFn then
                    afterSetFn()
                end
                return
            end
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                setKeyFn(input.KeyCode)
                stopListening(true)
                if afterSetFn then
                    afterSetFn()
                end
            end
        end)
    end)
    return function()
