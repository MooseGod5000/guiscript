function applyWorkingPathDisconnectSelection(nodeIndex)
	local nodeCount = #(pathState.workingPath.nodes or {})
	local normalizedNodeIndex = normalizePathNodeIndex(nodeIndex, nodeCount)
	if not normalizedNodeIndex then
		return false
	end

	local disconnectAfterNodeIndex = getPathDisconnectAfterNodeIndex(pathState.workingPath)
	local reconnectNodeIndex = getPathReconnectNodeIndex(pathState.workingPath)
	pathState.selectedNodeIndex = normalizedNodeIndex
	pathState.draggingNodeIndex = nil
	pathState.draggingNodeAxis = nil
	pathState.dragLastPointerPosition = nil

	if disconnectAfterNodeIndex then
		if normalizedNodeIndex == disconnectAfterNodeIndex or normalizedNodeIndex == disconnectAfterNodeIndex + 1 then
			pathState.workingPath.disconnectAfterNodeIndex = nil
			pathState.workingPath.reconnectNodeIndex = nil
			setPathEditorStatus("Path reconnected normally.", UI_COLORS.success)
		elseif normalizedNodeIndex < disconnectAfterNodeIndex then
			if normalizedNodeIndex >= nodeCount then
				setPathEditorStatus("Pick a node that has another node after it.", UI_COLORS.warning)
				return false
			end
			pathState.workingPath.disconnectAfterNodeIndex = normalizedNodeIndex
			pathState.workingPath.reconnectNodeIndex = nil
			setPathEditorStatus("Disconnected after node #" .. tostring(normalizedNodeIndex) .. ".", UI_COLORS.warning)
		elseif normalizedNodeIndex > disconnectAfterNodeIndex then
			pathState.workingPath.reconnectNodeIndex = normalizedNodeIndex
			reconnectNodeIndex = getPathReconnectNodeIndex(pathState.workingPath)
			if reconnectNodeIndex then
				setPathEditorStatus("Wired node #" .. tostring(disconnectAfterNodeIndex) .. " to node #" .. tostring(reconnectNodeIndex) .. ".", UI_COLORS.success)
			else
				pathState.workingPath.disconnectAfterNodeIndex = nil
				pathState.workingPath.reconnectNodeIndex = nil
				setPathEditorStatus("Path reconnected normally.", UI_COLORS.success)
			end
		end
	else
		if normalizedNodeIndex >= nodeCount then
			setPathEditorStatus("Pick a node that has another node after it.", UI_COLORS.warning)
			return false
		end
		pathState.workingPath.disconnectAfterNodeIndex = normalizedNodeIndex
		pathState.workingPath.reconnectNodeIndex = nil
		setPathEditorStatus("Disconnected node #" .. tostring(normalizedNodeIndex) .. " from node #" .. tostring(normalizedNodeIndex + 1) .. ".", UI_COLORS.warning)
	end

	sanitizePathDisconnectState(pathState.workingPath)
	refreshPathVisuals()
	refreshPathEditorButtons()
	return true
end

function saveWorkingPath(pathName)
	local trimmedName = string.gsub(tostring(pathName or ""), "^%s+", "")
	trimmedName = string.gsub(trimmedName, "%s+$", "")
	if trimmedName == "" then
		setPathEditorStatus("Enter a path name before saving.", UI_COLORS.warning)
		return false
	end

	if #pathState.workingPath.nodes == 0 then
		setPathEditorStatus("You need at least one node before saving.", UI_COLORS.warning)
		return false
	end
	if not getWorkingPathSpawnName() then
		setPathEditorStatus("Pick a spawn before saving this path.", UI_COLORS.warning)
		return false
	end

	sanitizePathDisconnectState(pathState.workingPath)
	pathState.paths[trimmedName] = clonePathData(pathState.workingPath)
	setPathSlotSelection(pathState.focusedPathSlotIndex, trimmedName, {syncSelectedPath = true})
	setPathDeleteConfirmSlot(nil)
	pathState.pendingPathNameCapture = false
	pathUi.editorNameBox.Visible = false
	pathUi.editorSaveConfirmButton.Visible = false
	pathUi.editorNameBox.Text = trimmedName
	savePathsToStorage(true)
	refreshPathManagerButtons()
	safeUpdateAutofarmLayout()
	setPathEditorStatus("Saved path: " .. trimmedName, UI_COLORS.success)
	return true
end

function updateWorkingPath()
	local selectedPathName = tostring(pathState.selectedPathName or "")
	if selectedPathName == "" or not pathState.paths[selectedPathName] then
		setPathEditorStatus("Pick a saved path before updating.", UI_COLORS.warning)
