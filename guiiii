    gunFeatureState.renderConnection = _RunService.RenderStepped:Connect(function(dt)
        if destroyed or not isSessionActive() or not hasGunAimVisualsEnabled() then
            clearGunAimDrawings()
            return
        end
        visualAccumulator = visualAccumulator + (tonumber(dt) or 0.016)
        if visualAccumulator < GUN_AIM_VISUAL_RENDER_INTERVAL then
            return
        end
        visualAccumulator = 0
        updateGunAimVisuals()
    end)
