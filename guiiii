    for _, root in ipairs(roots) do
        local existing = root and root:FindFirstChild("FOBAutomineOnlyRoot")
        if existing then
            pcall(function()
                existing:Destroy()
            end)
        end
        local overlay = root and root:FindFirstChild("FobAutomineOnlyFpsPingOverlay")
        if overlay then
            pcall(function()
                overlay:Destroy()
            end)
        end
        local legacyAutoMine = root and root:FindFirstChild("WildWestAutoMineGui")
        if legacyAutoMine then
            pcall(function()
                legacyAutoMine:Destroy()
            end)
        end
        if root then
            for _, child in ipairs(root:GetChildren()) do
                if child:IsA("ScreenGui") and child.Name:match("^AutomineDropdownGui_") then
                    pcall(function()
                        child:Destroy()
                    end)
                end
            end
        end
    end
    for _, folderName in ipairs({"AutoMineRecordedPathViz", "AutoMinePathViz", "AutoMinePathAvoiderViz", "AutoMineBearPreventionViz"}) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            pcall(function()
                folder:Destroy()
            end)
        end
    end
end
