        _TweenService:Create(circleGlow, TweenInfo.new(0.4), {Transparency = 0.3}):Play()
        _TweenService:Create(iconImage, TweenInfo.new(0.4), {ImageTransparency = 0}):Play()
        typeTitleLabel.TextTransparency = 0
        titleLabel.TextTransparency = 0
        task.spawn(function()
            _UTILS._animateNotifText(typeTitleLabel, typeConfig.title)
        end)
        task.spawn(function()
            _UTILS._animateNotifText(titleLabel, message)
        end)
        _TweenService:Create(timerBar, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
        task.wait(0.3)
        if not timerBar.Parent or dismissing then
            return
        end
        timerStarted = true
        updateTimerBar()
        timerConnection = _RunService.Heartbeat:Connect(function(dt)
            if destroyed or dismissing or not notifContainer.Parent then
                stopTimerLoop()
                return
            end
            if type(messageUpdater) == "function" then
                local okText, updatedMessage = pcall(messageUpdater)
                if okText then
                    updatedMessage = tostring(updatedMessage or message)
                    if updatedMessage ~= message then
                        message = updatedMessage
                        titleLabel.Text = updatedMessage
                    end
                end
            end
            if not timerStarted or hoverPaused then
                return
            end
            timerRemaining = math.max(0, timerRemaining - dt)
            updateTimerBar()
            if timerRemaining <= 0 then
                task.spawn(dismissNotification)
            end
        end)
    end)
end

SMART_STAFF_DETECTION_ACCOUNT_AGE_DAYS = 7
SMART_STAFF_MEMORY_SECONDS = 2 * 60 * 60
SMART_STAFF_KICK_REASON_FOLLOWED = "Your account is being followed"

function getSmartStaffStorageKey(value)
	local text = tostring(value or "default")
	text = string.gsub(text, "[^%w%-%_%.]", "_")
	if text == "" then
		text = "default"
	end
	return text
end

function getSmartStaffMemoryFilePath()
	local folder = tostring(PATH_STORAGE_FOLDER or "Inf Automine paths")
	local deviceKey = "default"
	if type(getStorageId) == "function" then
		local okId, storageId = pcall(getStorageId)
		if okId and storageId ~= nil then
			deviceKey = tostring(storageId)
		end
	end
	return folder .. "\\__smart_staff_memory_" .. getSmartStaffStorageKey(deviceKey) .. ".json"
end

function normalizeSmartStaffMemoryEntry(entry)
	if type(entry) ~= "table" then
		return nil
	end

	local userId = tonumber(entry.userId or entry.UserId)
	if not userId then
		return nil
	end

	local loggedAt = tonumber(entry.loggedAt or entry.time or entry.timestamp)
	if not loggedAt then
		return nil
	end

	return {
		userId = userId,
		name = tostring(entry.name or entry.Name or ""),
		displayName = tostring(entry.displayName or entry.DisplayName or ""),
		serverId = tostring(entry.serverId or entry.jobId or ""),
		placeId = tonumber(entry.placeId) or game.PlaceId,
		loggedAt = loggedAt,
		reason = tostring(entry.reason or "player_avoider"),
		followWarningCount = math.max(0, math.floor((tonumber(entry.followWarningCount or entry.followWarnings) or 0) + 0.5)),
		followWarningServerId = tostring(entry.followWarningServerId or entry.warningServerId or ""),
		followWarningAt = tonumber(entry.followWarningAt or entry.warningAt) or 0,
		forceKickOnFollow = entry.forceKickOnFollow == true or entry.immediateKickOnFollow == true,
		staffRank = tostring(entry.staffRank or entry.roleName or ""),
	}
end

function pruneSmartStaffMemory(memory)
	local activeMemory = type(memory) == "table" and memory or {}
	local now = os.time()
	local ttl = math.max(60, tonumber(SMART_STAFF_MEMORY_SECONDS) or 7200)
	for key, entry in pairs(activeMemory) do
		local normalized = normalizeSmartStaffMemoryEntry(entry)
		if not normalized or (now - normalized.loggedAt) > ttl then
			activeMemory[key] = nil
		else
			activeMemory[key] = normalized
		end
	end
	return activeMemory
end

function loadSmartStaffMemory()
	if S._smartStaffMemoryLoaded then
		return pruneSmartStaffMemory(S._smartStaffMemory)
	end

	local memory = type(runtimeEnv.__FOB_SMART_STAFF_MEMORY) == "table" and runtimeEnv.__FOB_SMART_STAFF_MEMORY or {}
	if type(isfile) == "function" and type(readfile) == "function" then
		local filePath = getSmartStaffMemoryFilePath()
		local okExists, exists = pcall(isfile, filePath)
		if okExists and exists then
			local okRead, raw = pcall(readfile, filePath)
			if okRead and type(raw) == "string" and raw ~= "" then
				local okDecode, decoded = pcall(function()
					return _HttpService:JSONDecode(raw)
				end)
				if okDecode and type(decoded) == "table" then
					for key, entry in pairs(decoded) do
						memory[tostring(key)] = entry
					end
				end
			end
		end
	end

	S._smartStaffMemory = pruneSmartStaffMemory(memory)
	S._smartStaffMemoryLoaded = true
	runtimeEnv.__FOB_SMART_STAFF_MEMORY = S._smartStaffMemory
	return S._smartStaffMemory
end

function saveSmartStaffMemory()
	local memory = pruneSmartStaffMemory(S._smartStaffMemory)
	S._smartStaffMemory = memory
	runtimeEnv.__FOB_SMART_STAFF_MEMORY = memory
	if type(writefile) ~= "function" then
		return false
	end
	local folder = tostring(PATH_STORAGE_FOLDER or "Inf Automine paths")
	if type(makefolder) == "function" then
		pcall(makefolder, folder)
	end
	return pcall(function()
		writefile(getSmartStaffMemoryFilePath(), _HttpService:JSONEncode(memory))
	end)
end

function isPathSmartStaffDetectionEnabled()
