function enforceExperimentalCFrameFreezeState(character)
	local activeCharacter = character or getExperimentalTravelCharacter()
	if not activeCharacter then
		return false
	end

	local state = getExperimentalCFrameTravelState()
	local repChar = state.repChar or resolveLocalRepChar(false)
	local rootPart = getRootPart(activeCharacter)
	local changed = false

	if isTable(repChar) then
		state.repChar = repChar
		changed = true
	end

	if rootPart then
		if state.originalRootAnchored == nil then
			state.originalRootAnchored = rootPart.Anchored
		end
		pcall(function()
			rootPart.Anchored = true
			rootPart.Velocity = Vector3.zero
			rootPart.RotVelocity = Vector3.zero
		end)
		pcall(function()
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
		end)
		changed = true
	end

	return changed
end

function resolveLocalRepChar(forceRefresh)
	local handler = resolveSafeTeleportHandler(forceRefresh)
	if isTable(handler) then
		local repChar = rawget(handler, "LocalRepChar") or handler.LocalRepChar
		if isTable(repChar) then
			return repChar
		end
		local getRepChar = rawget(handler, "GetRepChar") or handler.GetRepChar
		if type(getRepChar) == "function" and localPlayer then
			local okGet, result = pcall(getRepChar, handler, localPlayer)
			if okGet and isTable(result) then
				return result
			end
		end
	end

	local playerCharacter = resolvePlayerCharacterModule(forceRefresh)
	if isTable(playerCharacter) then
		local repChar = rawget(playerCharacter, "RepChar") or playerCharacter.RepChar
		if isTable(repChar) then
			return repChar
		end
	end

	local globalModule = getAutoMineGlobalModule(forceRefresh)
	if isTable(globalModule) then
		local handlerFromGlobal = rawget(globalModule, "RepCharHandler") or globalModule.RepCharHandler
		if isTable(handlerFromGlobal) then
			local repChar = rawget(handlerFromGlobal, "LocalRepChar") or handlerFromGlobal.LocalRepChar
			if isTable(repChar) then
				return repChar
			end
			local getRepChar = rawget(handlerFromGlobal, "GetRepChar") or handlerFromGlobal.GetRepChar
			if type(getRepChar) == "function" and localPlayer then
				local okGet, result = pcall(getRepChar, handlerFromGlobal, localPlayer)
				if okGet and isTable(result) then
					return result
				end
			end
		end
	end

	return nil
end

