    if not (targetPart and targetPart:IsA("BasePart") and targetPart.Parent) then
        return false
    end
    if targetPart.Name == "HumanoidRootPart" and targetInfo.kind == "Players" then
        return false
    end
    local hitPosition = targetPart.Position
    local toTarget = hitPosition - originPosition
    if toTarget.Magnitude <= 0.001 then
        toTarget = Vector3.new(0, 0, -1)
    end
    local direction = toTarget.Unit
    local normal = -direction
    local objectHit = targetPart.CFrame:PointToObjectSpace(hitPosition)
    local resolvedTarget, hitPartName = getMeleeAuraTargetReference(targetInfo)
    if resolvedTarget == nil then
        return false
    end
    local kind = targetInfo.kind == "Players" and "Player"
        or (targetInfo.kind == "NPCs" and "NPC" or "Animal")
    return callToolNetworkActivate(
        toolInfo,
        "Melee",
        timestamp,
        trackName,
        kind,
        resolvedTarget,
        hitPartName,
        hitPosition,
        objectHit,
        normal,
        direction
    )
end
function sendMeleeAuraHitsForSwing(toolInfo, targets, fallbackOriginPosition, range, trackName)
    local originPart = getMeleeAuraOriginPart(toolInfo)
    local originPosition = originPart and originPart:IsA("BasePart") and originPart.Position or fallbackOriginPosition
    if typeof(originPosition) ~= "Vector3" then
        return 0
    end
    local sentHits = 0
    for _, targetInfo in ipairs(targets) do
        local targetPart = targetInfo and targetInfo.part
        if targetPart and targetPart.Parent and (targetPart.Position - originPosition).Magnitude <= (range + 1.5) then
            local hitTimestamp = getSyncedNetworkTime()
            if hitTimestamp ~= 0 and sendMeleeAuraHit(toolInfo, targetInfo, originPosition, hitTimestamp, trackName) then
                sentHits += 1
            end
        end
    end
    return sentHits
end
function getMeleeAuraTargetsInRange(originPosition, range)
    local targetsByPriority = getMeleeAuraTargetsByPriority()
    local selectedTargets = {}
    for _, priorityName in ipairs(getMeleeAuraPriorityOrder()) do
        local targets = targetsByPriority[priorityName]
        if type(targets) == "table" then
            table.sort(targets, function(left, right)
                local leftDistance = left and left.position and (left.position - originPosition).Magnitude or math.huge
                local rightDistance = right and right.position and (right.position - originPosition).Magnitude or math.huge
                return leftDistance < rightDistance
            end)
            for _, targetInfo in ipairs(targets) do
                local targetPart = targetInfo and targetInfo.part
                if targetPart and targetPart.Parent then
                    local targetPosition = targetPart.Position
                    local distance = (targetPosition - originPosition).Magnitude
                    if distance <= range then
                        targetInfo.position = targetPosition
                        targetInfo.distance = distance
                        table.insert(selectedTargets, targetInfo)
                        if #selectedTargets >= MELEE_AURA_MAX_TARGETS_PER_SWING then
                            return selectedTargets
                        end
                    end
                end
            end
            if #selectedTargets > 0 then
                return selectedTargets
            end
        end
    end
    return selectedTargets
end
function beginMeleeAuraSwing(toolInfo, timestamp, trackName, cooldown)
    local swing = rawget(toolInfo, "Swing") or toolInfo.Swing
    if type(swing) ~= "function" then
        return false, timestamp, trackName
    end
    local beforeTimestamp = rawget(toolInfo, "LastSwingTimestamp") or toolInfo.LastSwingTimestamp
    local oldActivated = rawget(toolInfo, "IsActivated")
    local oldSecondary = rawget(toolInfo, "IsActivatedSecondary")
    if oldActivated == nil then
        oldActivated = toolInfo.IsActivated
    end
    if oldSecondary == nil then
        oldSecondary = toolInfo.IsActivatedSecondary
    end
    toolInfo.IsActivated = true
    toolInfo.IsActivatedSecondary = false
    local okSwing = pcall(swing, toolInfo)
    toolInfo.IsActivated = oldActivated
    toolInfo.IsActivatedSecondary = oldSecondary
    local afterTimestamp = rawget(toolInfo, "LastSwingTimestamp") or toolInfo.LastSwingTimestamp
    local afterTrack = rawget(toolInfo, "LastSwingTrack") or toolInfo.LastSwingTrack
    if not okSwing or afterTimestamp == beforeTimestamp then
        return false, timestamp, trackName
    end
    if getMeleeSwingMode() == "Silent swing" then
        local stopTrack = rawget(toolInfo, "StopTrack") or toolInfo.StopTrack
        if type(stopTrack) == "function" and type(afterTrack) == "string" then
            task.defer(function()
                pcall(stopTrack, toolInfo, afterTrack)
            end)
        end
    end
    return true, afterTimestamp or timestamp, afterTrack or trackName
end
function runMeleeAuraPulse()
    if not S.meleeAuraEnabled then
        return
    end
    local meleeItem = getCurrentEquippedMeleeItem(false) or getCurrentEquippedMeleeItem(true)
    if not isMeleeItemTool(meleeItem) then
        return
    end
    local originPart = getMeleeAuraOriginPart(meleeItem)
    if not originPart or not originPart:IsA("BasePart") then
        return
    end
    local now = os.clock()
    local trackName = chooseMeleeAuraTrack(meleeItem)
    local cooldown = getMeleeAuraSwingCooldown(meleeItem, trackName)
    local nextCanSwing = tonumber(rawget(meleeItem, "NextCanSwing") or meleeItem.NextCanSwing)
    if nextCanSwing and now < nextCanSwing then
        return
    end
    if (now - (tonumber(meleeAuraState.lastSwingAt) or 0)) < cooldown then
        return
    end
    local range = getMeleeAuraRange()
    local originPosition = originPart.Position
    local targets = getMeleeAuraTargetsInRange(originPosition, range)
    if #targets == 0 then
        return
    end
    local timestamp = getSyncedNetworkTime()
    if timestamp == 0 then
        timestamp = now
    end
    local swingStarted, swingTimestamp, swingTrack = beginMeleeAuraSwing(meleeItem, timestamp, trackName, cooldown)
    if not swingStarted then
        return
    end
    meleeAuraState.lastSwingAt = now
    if getMeleeSwingMode() == "Real swing" then
        return
    end
    local damageDelay = getMeleeAuraDamageDelay(meleeItem, swingTrack)
    if damageDelay > 0 then
        task.delay(damageDelay, function()
            if S.meleeAuraEnabled then
                sendMeleeAuraHitsForSwing(meleeItem, targets, originPosition, range, swingTrack)
            end
        end)
    else
        sendMeleeAuraHitsForSwing(meleeItem, targets, originPosition, range, swingTrack)
    end
end
