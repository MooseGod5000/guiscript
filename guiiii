function initConfigSettingsSection(elementsList)
    local cfgOpenLabel = nil
    local syncConfigRows = nil

    local function getConfigOptionNames()
        local options = {"None", CONFIG_SYSTEM.AUTOSAVE_NAME}
        for _, cfgName in ipairs(listConfigs()) do
            if cfgName ~= CONFIG_SYSTEM.AUTOSAVE_NAME then
                table.insert(options, cfgName)
            end
        end
        return options
    end

    local function getConfigSelectionLabel()
        return getSelectedConfigName() or "None"
    end

    local function syncConfigSelectionLabel()
        if cfgOpenLabel then
            cfgOpenLabel.Text = "≡ " .. getConfigSelectionLabel()
        end
    end

    local function persistConfigSelection()
        if storageEnabled then
            storageLoaded = savePersistentState() or storageLoaded
        end
        refreshDashboard()
    end

    local function setSelectedConfigName(name)
        local trimmed = trimConfigName(name)
        if trimmed == "" or trimmed == "None" then
            CONFIG_SYSTEM.selectedConfigName = nil
        else
            CONFIG_SYSTEM.selectedConfigName = trimmed
        end
        if getSelectedConfigName() == CONFIG_SYSTEM.AUTOSAVE_NAME then
            saveConfigState(CONFIG_SYSTEM.AUTOSAVE_NAME)
        end
        persistConfigSelection()
        syncConfigSelectionLabel()
        if syncConfigRows then
            syncConfigRows()
        end
    end

    local function loadSelectedConfig()
        local selectedName = getSelectedConfigName()
        if not selectedName then
            spawnNotification("No config selected.", "error", true)
            return false
        end
        if not loadConfigState(selectedName, true) then
            if selectedName == CONFIG_SYSTEM.AUTOSAVE_NAME then
                spawnNotification("No autosave from last session was found.", "warning", true)
            else
                spawnNotification("Could not load config: " .. selectedName, "error", true)
            end
            return false
        end
        CONFIG_SYSTEM.runtimeConfigLoaded = true
        applyStoredStateToRuntime()
        ensurePlayerFeatureHooks()
        syncAllUi()
        if selectedName == CONFIG_SYSTEM.AUTOSAVE_NAME then
            spawnNotification("Autosave from last session loaded.", "success", true)
        else
            spawnNotification("Loaded config: " .. selectedName, "success", true)
        end
        return true
    end

    local function updateSelectedConfig()
        local selectedName = getSelectedConfigName()
        if not selectedName then
