function roundClampedNumber(value, minValue, maxValue, decimals)
    local num = tonumber(value)
    if not num then
        return nil
    end
    decimals = math.max(0, math.floor(tonumber(decimals) or 0))
    if decimals > 0 then
        local scale = 10 ^ decimals
        num = math.floor((num * scale) + 0.5) / scale
    else
        num = math.floor(num + 0.5)
    end
    return math.clamp(num, minValue, maxValue)
end
function makeNumberNormalizer(minValue, maxValue, decimals)
    return function(value)
        return roundClampedNumber(value, minValue, maxValue, decimals)
    end
end
function serializeClonedValue(value) return automineCloneDefaultValue(value) end
function serializeBooleanValue(value) return value == true end
function applyTypedSetting(spec, value)
    if spec.valueType and type(value) ~= spec.valueType then
        return
    end
    if spec.nonEmpty and value == "" then
        return
    end
    local nextValue = spec.normalize and spec.normalize(value) or value
    if nextValue ~= nil then
        S[spec.key] = nextValue
    end
end
