function tryPathTimePassServerHop(allowIdlePathState)
	if not (isPathHopTimePassEnabled() and isPathTimePassHopContextActive(allowIdlePathState)) then
		return false
	end
	if shouldDelayPathHopForSell() then
		setStatus("Waiting for sell before hopping", Color3.fromRGB(232, 184, 96))
		return false
	end

	local hopMinutes = getPathHopTimePassMinutes()
	local elapsedSeconds = os.clock() - (tonumber(automineWebhookServerStartedAt) or os.clock())
	if elapsedSeconds < (hopMinutes * 60) then
		return false
	end

	local now = os.clock()
	if serverHopInProgress or serverHopTaskQueued or (now - lastPathTimePassHopAttemptAt) < 10 then
		return false
	end

	lastPathTimePassHopAttemptAt = now
	local requested = requestPathServerHop(
		string.format("Server time reached %d minute%s, hopping servers...", hopMinutes, hopMinutes == 1 and "" or "s"),
		getPathCycleRestartSlotIndex(),
		true,
		"time limit"
	)
	if not requested then
		lastPathTimePassHopAttemptAt = 0
	end
	return requested
end

function tryPathOrePurityServerHop(pathData, pathName, sourceLabel)
	if not isPathOrePurityHopEnabled() then
		return false
	end
	if shouldDelayPathHopForSell() then
		setStatus("Waiting for sell before purity hop", Color3.fromRGB(232, 184, 96))
		return false
	end

	local report = buildPathOrePurityReport(pathData)
	if not report then
		return false
	end

	local thresholdPercent = getPathOrePurityHopPercent()
	if (tonumber(report.missingPercent) or 0) < thresholdPercent then
		return false
	end

	local now = os.clock()
	if serverHopInProgress or serverHopTaskQueued or (now - lastPathOrePurityHopAttemptAt) < 10 then
		return false
	end

	lastPathOrePurityHopAttemptAt = now
	local roundedMissingPercent = math.floor((tonumber(report.missingPercent) or 0) + 0.5)
	local reasonText = string.format(
		"Ore purity %d%% missing (threshold %d%%), hopping servers...",
		roundedMissingPercent,
		thresholdPercent
	)
	setStatus(reasonText, Color3.fromRGB(255, 170, 80))
	local requested = requestPathServerHop(reasonText, getPathCycleRestartSlotIndex(), true, "ore_purity", {
		pathName = pathName or pathState.playbackPathName,
		source = sourceLabel,
		missingPercent = report.missingPercent,
		thresholdPercent = thresholdPercent,
		totalRemaining = report.totalRemaining,
		totalMax = report.totalMax,
		totalMissing = report.totalMissing,
		checkedDeposits = report.checkedDeposits,
		missingDeposits = report.missingDeposits,
		unresolvedDeposits = report.unresolvedDeposits,
	})
	if not requested then
		lastPathOrePurityHopAttemptAt = 0
	end
	return requested
end

