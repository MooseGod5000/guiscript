                for npcModel, npcObject in pairs(npcMap) do
                    if isTable(npcObject) then
                        local model = typeof(npcModel) == "Instance" and npcModel or nil
                        appendSilentAimTarget(groupedTargets.NPCs, seenTargets, "NPCs", model, nil, npcObject, options)
                    end
                end
            end
            local npcList = rawget(clientNPCs, "NPCs") or clientNPCs.NPCs
            if isTable(npcList) then
                for _, npcObject in pairs(npcList) do
                    if isTable(npcObject) then
                        appendSilentAimTarget(groupedTargets.NPCs, seenTargets, "NPCs", nil, nil, npcObject, options)
                    end
                end
            end
        end
        local npcsFolder = entitiesFolder and entitiesFolder:FindFirstChild("NPCs")
        if npcsFolder then
            for _, model in ipairs(npcsFolder:GetChildren()) do
                appendSilentAimTarget(groupedTargets.NPCs, seenTargets, "NPCs", model, nil, nil, options)
            end
        end
    end
    if includeEntities then
        local wildLife = resolveSilentAimWildLife(false) or resolveSilentAimWildLife(true)
        if isTable(wildLife) then
            local getWildLife = rawget(wildLife, "GetWildLife") or wildLife.GetWildLife
            if type(getWildLife) == "function" then
                local okWildLife, wildLifeObjects = pcall(getWildLife, wildLife)
                if okWildLife and isTable(wildLifeObjects) then
                    for animalModel, animalObject in pairs(wildLifeObjects) do
                        appendSilentAimTarget(groupedTargets.Entities, seenTargets, "Entities", animalModel, nil, animalObject, options)
                    end
                end
            end
        end
        local animalsFolder = entitiesFolder and entitiesFolder:FindFirstChild("Animals")
        if animalsFolder then
            for _, model in ipairs(animalsFolder:GetChildren()) do
                appendSilentAimTarget(groupedTargets.Entities, seenTargets, "Entities", model, nil, nil, options)
            end
        end
    end
    return groupedTargets
end
