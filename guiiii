    end
    return DEFAULTS.undergroundRollTrack or "FrontRollNew"
end

local function normalizePathPlayerAvoiderMethod(value)
    local candidate = tostring(value or DEFAULTS.pathPlayerAvoiderMethod)
    for _, methodName in ipairs(PATH_PLAYER_AVOIDER_METHOD_ORDER) do
        if string.lower(candidate) == string.lower(methodName) then
            return methodName
        end
    end
    return DEFAULTS.pathPlayerAvoiderMethod
end

local function clonePathPlayerAvoiderMethods(source, fallbackMethod)
    local cloned = {}
    for _, methodName in ipairs(PATH_PLAYER_AVOIDER_METHOD_ORDER) do
        cloned[methodName] = false
    end

    if type(source) == "table" then
        for key, value in pairs(source) do
            local methodName = nil
            if type(key) == "number" and type(value) == "string" then
                methodName = normalizePathPlayerAvoiderMethod(value)
                cloned[methodName] = true
            elseif type(key) == "string" then
                methodName = normalizePathPlayerAvoiderMethod(key)
                if string.lower(methodName) == string.lower(key) then
                    cloned[methodName] = value == true
                end
            end
        end
    elseif type(source) == "string" then
        cloned[normalizePathPlayerAvoiderMethod(source)] = true
    end

    local hasEnabledMethod = false
    for _, methodName in ipairs(PATH_PLAYER_AVOIDER_METHOD_ORDER) do
        if cloned[methodName] == true then
            hasEnabledMethod = true
            break
        end
    end
    if not hasEnabledMethod then
        cloned[normalizePathPlayerAvoiderMethod(fallbackMethod or DEFAULTS.pathPlayerAvoiderMethod)] = true
    end

    return cloned
end

local function normalizePathPlayerAvoiderAction(value)
    local candidate = tostring(value or DEFAULTS.pathPlayerAvoiderAction)
    for _, actionName in ipairs(PATH_PLAYER_AVOIDER_ACTION_ORDER) do
        if string.lower(candidate) == string.lower(actionName) then
            return actionName
        end
    end
    return DEFAULTS.pathPlayerAvoiderAction
end

