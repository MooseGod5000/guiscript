local function _extractTabIconAssetId(value)
    if type(value) ~= "string" or value == "" then
        return nil
    end
    return value:match("^rbxassetid://(%d+)$") or value:match("asset/(%d+)") or value:match("(%d+)")
end

local function _normalizeTabIconAsset(value)
    local id = _extractTabIconAssetId(value)
    if not id then
        return nil
    end
    return string.format("rbxthumb://type=Asset&id=%s&w=150&h=150", id)
end

