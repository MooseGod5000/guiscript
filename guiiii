		return false
	end
	local pathReachDistance = isCFrameMovementMode(movementMode)
		and getCFramePathReachDistance()
		or (isUndergroundMovementMode(movementMode) and getUndergroundPathReachDistance())
		or math.max(1.8, WAYPOINT_REACH_DISTANCE * 0.6)
