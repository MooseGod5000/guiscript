		originPosition = originRoot
	elseif originRoot then
		originPosition = originRoot.Position
	end
	if typeof(originPosition) ~= "Vector3" then
		return nil
	end
	local range = tonumber(HORSE_FLING_TARGET_RANGE) or 10
	local bestRoot = nil
