function buildPathMineNodeLookup(pathData)
	local lookup = {}
	local nodeCount = #(pathData and pathData.nodes or {})
	for _, oreTarget in ipairs(pathData and pathData.ores or {}) do
		local nodeIndex = normalizePathNodeIndex(oreTarget.nodeIndex, nodeCount)
		if nodeIndex then
			lookup[nodeIndex] = true
		end
	end
	return lookup
end

function getPathNodeVisualColor(nodeIndex, selectedNodeIndex, playbackNodeIndex, sellNodeIndex, mineNodeLookup, disconnectedNodeLookup)
	if nodeIndex == selectedNodeIndex then
		return PATH_VISUAL_SELECTED_NODE_COLOR
	end
	if playbackNodeIndex and nodeIndex == playbackNodeIndex then
		return PATH_VISUAL_PLAYBACK_NODE_COLOR
	end
	if nodeIndex == sellNodeIndex then
		return PATH_VISUAL_SELL_NODE_COLOR
	end
	if mineNodeLookup and mineNodeLookup[nodeIndex] then
		return PATH_VISUAL_MINE_NODE_COLOR
	end
	if disconnectedNodeLookup and disconnectedNodeLookup[nodeIndex] then
		return PATH_VISUAL_DISCONNECTED_COLOR
	end
	return PATH_VISUAL_NODE_COLOR
end

function clonePathData(pathData)
	local cloned = {
		nodes = {},
		ores = {},
		manualSellNodeIndex = getManualPathSellNodeIndex(pathData),
		disconnectAfterNodeIndex = getPathDisconnectAfterNodeIndex(pathData),
		reconnectNodeIndex = getPathReconnectNodeIndex(pathData),
		spawnName = normalizePathSpawnName(pathData and pathData.spawnName),
	}

	for _, node in ipairs(pathData and pathData.nodes or {}) do
		local nodePosition = getPathNodePosition(node)
		if nodePosition then
			table.insert(cloned.nodes, {
				position = nodePosition,
			})
		end
	end

	for _, ore in ipairs(pathData and pathData.ores or {}) do
		table.insert(cloned.ores, {
			groupName = ore.groupName,
			position = ore.position,
			nodeIndex = ore.nodeIndex,
		})
	end

	sanitizePathDisconnectState(cloned)
	return cloned
end

function getClosestPathNodeIndex(position, nodes)
	local bestIndex = nil
	local bestDistance = nil

	for index, node in ipairs(nodes or pathState.workingPath.nodes) do
		local nodePosition = getPathNodePosition(node)
		if nodePosition then
			local distance = (nodePosition - position).Magnitude
			if not bestDistance or distance < bestDistance then
				bestDistance = distance
				bestIndex = index
			end
		end
	end

	return bestIndex, bestDistance or math.huge
end

