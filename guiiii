        local targetParts = getFastProjectileHitPartList(targetInfo, targetPart)
        for _, bulletId in ipairs(bulletIdList or {}) do
            local projectile = getLocalProjectileById(bulletId)
            local aligned, hitPosition, hitTime, hitNormal, hitPart = getProjectileTargetPathAlignment(projectile, targetParts, tolerance)
            if aligned then
                return projectile, hitPosition, bulletId, hitTime, hitNormal, hitPart
            end
        end
        if os.clock() - startedAt >= (tonumber(maxWait) or TP_PROJECTILE_MAX_EXTRA_WAIT) then
            break
        end
        task.wait(TP_PROJECTILE_ALIGNMENT_INTERVAL)
    end
    return nil, nil, nil, nil, nil, nil
end
