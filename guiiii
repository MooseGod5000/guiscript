	}, enabled)
end

local function westXGetPlayerModel(container)
	if not container or not LocalPlayer then
		return nil
	end
	local byName = container:FindFirstChild(LocalPlayer.Name)
	if byName and byName:IsA("Model") then
		return byName
	end
	local byUserId = container:FindFirstChild(tostring(LocalPlayer.UserId))
	if byUserId and byUserId:IsA("Model") then
		return byUserId
	end
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Model") then
			local owner = child:FindFirstChild("Owner")
			if owner and owner:IsA("ObjectValue") and owner.Value == LocalPlayer then
				return child
			end
			local userId = child:GetAttribute("UserId") or child:GetAttribute("OwnerUserId")
			if tostring(userId) == tostring(LocalPlayer.UserId) then
				return child
			end
			local ownerName = child:GetAttribute("Owner") or child:GetAttribute("PlayerName")
			if tostring(ownerName) == LocalPlayer.Name then
				return child
			end
		end
	end
	return nil
end

local function westXResolveCharacter(preferredCharacter)
	if preferredCharacter and preferredCharacter.Parent then
		return preferredCharacter, "provided"
	end
	if LocalPlayer then
		local explicit = LocalPlayer:FindFirstChild("PlayerCharacter")
		if explicit then
			if explicit:IsA("ObjectValue") and explicit.Value and explicit.Value:IsA("Model") then
				return explicit.Value, "LocalPlayer.PlayerCharacter"
			end
			if explicit:IsA("Model") then
				return explicit, "LocalPlayer.PlayerCharacter"
			end
		end
	end
	local entities = workspace:FindFirstChild("WORKSPACE_Entities")
	local playersFolder = entities and entities:FindFirstChild("Players")
	local replicated = westXGetPlayerModel(playersFolder)
	if replicated then
		return replicated, "workspace.WORKSPACE_Entities.Players"
	end
	local customCharacter = type(getCustomCharacter) == "function" and getCustomCharacter() or nil
	if customCharacter then
		return customCharacter, "getCustomCharacter"
	end
	local fallbackCharacter = LocalPlayer and LocalPlayer.Character or nil
	return fallbackCharacter, "LocalPlayer.Character"
end

local function westXGetRootPart(character)
	if not character then
		return nil
	end
	if character:IsA("BasePart") then
		return character
	end
	return character:FindFirstChild("RootPart", true)
		or character:FindFirstChild("HumanoidRootPart", true)
		or character.PrimaryPart
		or character:FindFirstChild("UpperTorso", true)
		or character:FindFirstChild("Torso", true)
		or character:FindFirstChild("LowerTorso", true)
		or character:FindFirstChildWhichIsA("BasePart", true)
end

local function westXGetHumanoid(character)
	return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local UNDERGROUND_LEFTFALL_TRACK_NAME = "LeftFall"
local UNDERGROUND_LEFTFALL_DIRECT_PATH = {"Resources", "Animations_New", "Player", "Movement", "Rolling", "LeftFall"}
local UNDERGROUND_LEFTFALL_RETRY_INTERVAL = 0.25

function isUndergroundLeftFallTestEnabled()
	return S and S.undergroundLeftFallTestEnabled == true
end

function getUndergroundDirectAnimationInstance(trackName)
	if trackName ~= UNDERGROUND_LEFTFALL_TRACK_NAME then
		return nil
	end
	local cache = rawget(_G, "__AutoMineUndergroundAnimationPathCache")
	if type(cache) ~= "table" then
		cache = {}
		_G.__AutoMineUndergroundAnimationPathCache = cache
	end
	local cached = cache[trackName]
	if typeof(cached) == "Instance" and cached.Parent then
		return cached
	end
	local current = ReplicatedStorage
	for _, childName in ipairs(UNDERGROUND_LEFTFALL_DIRECT_PATH) do
		current = current and current:FindFirstChild(childName)
		if not current then
			return nil
		end
	end
	cache[trackName] = current
	return current
end

function getUndergroundAnimationHandler(state, character)
	if type(state) ~= "table" then
		state = getUndergroundTravelState()
	end
	local playerCharacter = state.playerCharacter
	if not isTable(playerCharacter) and type(resolvePlayerCharacterModule) == "function" then
		playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	end
	if isTable(playerCharacter) then
		state.playerCharacter = playerCharacter
		local handler = rawget(playerCharacter, "AnimationHandler") or playerCharacter.AnimationHandler
		if isTable(handler) and type(rawget(handler, "PlayTrack") or handler.PlayTrack) == "function" then
			return handler, "PlayerCharacter"
		end
	end
	local repChar = state.repChar
	if not isTable(repChar) and type(resolveLocalRepChar) == "function" then
		repChar = resolveLocalRepChar(false) or resolveLocalRepChar(true)
	end
	if isTable(repChar) then
		state.repChar = repChar
		local handler = rawget(repChar, "AnimationHandler") or repChar.AnimationHandler
		if isTable(handler) and type(rawget(handler, "PlayTrack") or handler.PlayTrack) == "function" then
			return handler, "RepChar"
		end
	end
	return nil, "none"
end

function isUndergroundAnimationTrackPlaying(handler, trackName, track)
	local isTrackPlaying = isTable(handler) and (rawget(handler, "IsTrackPlaying") or handler.IsTrackPlaying) or nil
	if type(isTrackPlaying) == "function" then
		local okPlaying, playing = pcall(isTrackPlaying, handler, trackName)
		if okPlaying then
			return playing == true
		end
	end
	if track then
		local okTrackPlaying, trackPlaying = pcall(function()
			return track.IsPlaying == true
		end)
		if okTrackPlaying then
			return trackPlaying == true
		end
	end
	return false
end

local function getUndergroundHumanoidAnimator(character, humanoid)
	humanoid = humanoid or westXGetHumanoid(character) or (type(getHumanoid) == "function" and getHumanoid(character) or nil)
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		pcall(function()
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end)
	end
	return animator
end

function stopUndergroundTravelAnimations(state)
	if type(state) ~= "table" then
		return
	end
	local handler = state.undergroundAnimationHandler
	local tracks = state.undergroundAnimationTracks
	if type(tracks) == "table" then
		for trackName, track in pairs(tracks) do
			local stopped = false
			local stopTrack = isTable(handler) and (rawget(handler, "StopTrack") or handler.StopTrack) or nil
			if type(stopTrack) == "function" then
				stopped = pcall(stopTrack, handler, trackName, 0.12) and true or false
			end
			if not stopped and track ~= nil then
				local trackStop = nil
				pcall(function()
					trackStop = track.Stop
				end)
				if type(trackStop) == "function" then
					pcall(function()
						track:Stop(0.12)
					end)
				end
			end
		end
	end
	state.undergroundAnimationHandler = nil
	state.undergroundAnimationTracks = nil
	state.undergroundAnimationSource = nil
	state.undergroundLeftFallLastEnsureAt = nil
end

function getUndergroundTravelAnimationDebugText(character)
	local state = playerState and playerState.undergroundTravel
	if type(state) ~= "table" or (state.active ~= true and type(state.undergroundAnimationTracks) ~= "table") then
		state = playerState and playerState.undergroundOreHold
	end
	if type(state) ~= "table" or (state.active ~= true and type(state.undergroundAnimationTracks) ~= "table") then
		return "none"
	end
	if not isUndergroundLeftFallTestEnabled() and type(state.undergroundAnimationTracks) ~= "table" then
		return "none"
	end
	local handler = state.undergroundAnimationHandler or getUndergroundAnimationHandler(state, character)
	local track = state.undergroundAnimationTracks and state.undergroundAnimationTracks[UNDERGROUND_LEFTFALL_TRACK_NAME]
	if isUndergroundAnimationTrackPlaying(handler, UNDERGROUND_LEFTFALL_TRACK_NAME, track) then
		return tostring(state.undergroundAnimationSource or "LeftFall")
	end
	return "none"
end

function ensureUndergroundLeftFallTestAnimation(character, state, humanoid)
	if not isUndergroundLeftFallTestEnabled() then
		stopUndergroundTravelAnimations(state)
		return false
	end
	state = type(state) == "table" and state or getUndergroundTravelState()
	if type(state) ~= "table" or state.active ~= true then
		return false
	end
	local now = os.clock()
	if (now - (state.undergroundLeftFallLastEnsureAt or 0)) < UNDERGROUND_LEFTFALL_RETRY_INTERVAL then
		return true
	end
	state.undergroundLeftFallLastEnsureAt = now
	local handler, handlerSource = getUndergroundAnimationHandler(state, character)
	if handler then
		if state.undergroundAnimationHandler ~= handler then
			stopUndergroundTravelAnimations(state)
			state.undergroundAnimationHandler = handler
			state.undergroundAnimationTracks = {}
		end
		local track = state.undergroundAnimationTracks and state.undergroundAnimationTracks[UNDERGROUND_LEFTFALL_TRACK_NAME]
		if not isUndergroundAnimationTrackPlaying(handler, UNDERGROUND_LEFTFALL_TRACK_NAME, track) then
			local playTrack = rawget(handler, "PlayTrack") or handler.PlayTrack
			local okPlay, playedTrack = pcall(playTrack, handler, UNDERGROUND_LEFTFALL_TRACK_NAME, 0, math.huge, 100)
			if not okPlay then
				okPlay, playedTrack = pcall(playTrack, handler, UNDERGROUND_LEFTFALL_TRACK_NAME, 0.12, 1, 1)
			end
			if okPlay then
				state.undergroundAnimationTracks[UNDERGROUND_LEFTFALL_TRACK_NAME] = playedTrack or true
				state.undergroundAnimationSource = "LeftFall/" .. tostring(handlerSource)
				pushDebugRateLimited("underground_leftfall_test_play", "underground LeftFall test: AnimationHandler", 2)
				return true
			end
		else
			return true
		end
	end
	local animation = getUndergroundDirectAnimationInstance(UNDERGROUND_LEFTFALL_TRACK_NAME)
	local animator = animation and getUndergroundHumanoidAnimator(character, humanoid)
	if animator then
		state.undergroundAnimationTracks = state.undergroundAnimationTracks or {}
		local track = state.undergroundAnimationTracks[UNDERGROUND_LEFTFALL_TRACK_NAME]
		if not isUndergroundAnimationTrackPlaying(nil, UNDERGROUND_LEFTFALL_TRACK_NAME, track) then
			local okLoad, loadedTrack = pcall(function()
				return animator:LoadAnimation(animation)
			end)
			if okLoad and loadedTrack then
				pcall(function()
					loadedTrack.Looped = true
					loadedTrack.Priority = Enum.AnimationPriority.Action
					loadedTrack:Play(0.12, 1, 1)
				end)
				state.undergroundAnimationTracks[UNDERGROUND_LEFTFALL_TRACK_NAME] = loadedTrack
				state.undergroundAnimationSource = "LeftFall/Animator"
				pushDebugRateLimited("underground_leftfall_test_play", "underground LeftFall test: Animator", 2)
				return true
			end
		else
			return true
		end
	end
	pushDebugRateLimited("underground_leftfall_test_missing", "underground LeftFall test: no animation handler/path", 2)
	return false
end

local function westXSetRootVelocity(rootPart, velocity)
	if not rootPart then
		return
	end
	pcall(function()
		rootPart.Velocity = velocity
		rootPart.RotVelocity = Vector3.zero
	end)
	pcall(function()
		rootPart.AssemblyLinearVelocity = velocity
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end)
end

local function westXSetRootCFrame(character, rootPart, cframe)
	if character and character:IsA("Model") and character.PrimaryPart then
		local ok = pcall(function()
			character:SetPrimaryPartCFrame(cframe)
		end)
		if ok then
			return true
		end
	end
	if rootPart and rootPart:IsA("BasePart") then
		rootPart.CFrame = cframe
		return true
	end
	return false
end

local function westXRememberCollision(state, part, canCollide)
	if not part or not part:IsA("BasePart") then
		return
	end
	state.collisionLookup = state.collisionLookup or {}
	if state.collisionLookup[part] then
		part.CanCollide = canCollide
		return
	end
	state.collisionLookup[part] = true
	state.collisionRecords = state.collisionRecords or {}
	table.insert(state.collisionRecords, {
		part = part,
		canCollide = part.CanCollide,
	})
	part.CanCollide = canCollide
end

local function westXDisableCharacterCollision(state, character, rootPart)
	westXRememberCollision(state, rootPart, false)
	if character and character:IsA("Model") then
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart") then
				westXRememberCollision(state, descendant, false)
			end
		end
	end
end

local function westXRestoreCharacterCollision(state)
	for _, record in ipairs(state.collisionRecords or {}) do
		if record.part and record.part.Parent then
			pcall(function()
				record.part.CanCollide = record.canCollide == true
			end)
		end
	end
	state.collisionRecords = {}
	state.collisionLookup = {}
end

local function westXApplyUndergroundState(state, character, rootPart, humanoid, forceHeavy)
	local now = os.clock()
	local heavyStateChanged = state.westXApplied ~= true
		or state.westXCharacter ~= character
		or state.westXRootPart ~= rootPart
		or state.westXHumanoid ~= humanoid
	local shouldRefreshSignals = forceHeavy == true
		or heavyStateChanged
		or (now - (state.lastWestXSignalRefreshAt or 0)) >= WESTX_SIGNAL_REFRESH_INTERVAL
	local shouldRefreshCollision = forceHeavy == true
		or heavyStateChanged
		or (now - (state.lastWestXCollisionRefreshAt or 0)) >= WESTX_COLLISION_REFRESH_INTERVAL
	if humanoid and state.freezeHumanoid ~= humanoid then
		state.freezeHumanoid = humanoid
		state.originalPlatformStand = humanoid.PlatformStand
		state.originalAutoRotate = humanoid.AutoRotate
		state.originalHipHeight = humanoid.HipHeight
		pcall(function()
			state.originalSwimmingEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Swimming)
		end)
	end
	if humanoid then
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
		end)
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
		humanoid.Jump = false
		humanoid:Move(Vector3.zero)
	end
	if rootPart and state.forceRootPart ~= rootPart then
		state.forceRootPart = rootPart
		state.originalRootAnchored = rootPart.Anchored
		state.originalRootCanCollide = rootPart.CanCollide
	end
	if rootPart then
		rootPart.Anchored = true
		westXSetRootVelocity(rootPart, Vector3.zero)
	end
	if shouldRefreshSignals then
		westXSetCrouched(character, true)
		westXSetSprinting(character, false)
		westXSetCollisionModel(character, false)
		state.lastWestXSignalRefreshAt = now
	end
	if shouldRefreshCollision then
		westXDisableCharacterCollision(state, character, rootPart)
		state.lastWestXCollisionRefreshAt = now
	end
	if isUndergroundLeftFallTestEnabled() then
		ensureUndergroundLeftFallTestAnimation(character, state, humanoid)
	elseif type(state.undergroundAnimationTracks) == "table" then
		stopUndergroundTravelAnimations(state)
	end
	state.westXApplied = true
	state.westXCharacter = character
	state.westXRootPart = rootPart
	state.westXHumanoid = humanoid
end

local function westXRestoreUndergroundState(state, character)
	local activeCharacter = character or state.character
	local rootPart = westXGetRootPart(activeCharacter) or state.forceRootPart
	local humanoid = state.freezeHumanoid or westXGetHumanoid(activeCharacter)
	stopUndergroundTravelAnimations(state)
	westXRestoreCharacterCollision(state)
	westXSetCollisionModel(activeCharacter, true)
	westXSetWeldsActive(activeCharacter, true)
	westXSetCrouched(activeCharacter, false)
	westXSetSprinting(activeCharacter, false)
	if humanoid then
		if state.originalPlatformStand ~= nil then
			pcall(function()
				humanoid.PlatformStand = state.originalPlatformStand == true
			end)
		end
		if state.originalAutoRotate ~= nil then
			pcall(function()
				humanoid.AutoRotate = state.originalAutoRotate
			end)
		end
		if state.originalHipHeight ~= nil then
			pcall(function()
				humanoid.HipHeight = state.originalHipHeight
			end)
		end
		if state.originalSwimmingEnabled ~= nil then
			pcall(function()
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, state.originalSwimmingEnabled == true)
			end)
		end
		pcall(function()
			humanoid:Move(Vector3.zero)
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end)
	end
	if rootPart and rootPart.Parent then
		westXSetRootVelocity(rootPart, Vector3.zero)
		if state.originalRootAnchored ~= nil then
			pcall(function()
				rootPart.Anchored = state.originalRootAnchored == true
			end)
		end
		if state.originalRootCanCollide ~= nil then
			pcall(function()
				rootPart.CanCollide = state.originalRootCanCollide == true
			end)
		end
	end
	if state.bodyGyro then
		pcall(function()
			state.bodyGyro:Destroy()
		end)
	end
	if type(restoreUndergroundPreReplicateHook) == "function" then
		pcall(restoreUndergroundPreReplicateHook)
	end
	if type(restoreUndergroundPlatformHook) == "function" then
		pcall(restoreUndergroundPlatformHook)
	end
	state.westXApplied = nil
	state.westXCharacter = nil
	state.westXRootPart = nil
	state.westXHumanoid = nil
	state.lastWestXSignalRefreshAt = nil
	state.lastWestXCollisionRefreshAt = nil
end

local function westXGoalCFrame(position, rootPart, flatDirection)
	local direction = normalizeUndergroundFlatDirection(flatDirection)
		or normalizeUndergroundFlatDirection(lastMoveCommand)
		or (rootPart and normalizeUndergroundFlatDirection(rootPart.CFrame.LookVector))
		or Vector3.new(0, 0, -1)
	local lookAt = Vector3.new(position.X + direction.X, position.Y, position.Z + direction.Z)
	return CFrame.new(position, lookAt)
end

local function westXGetGoalPosition(targetPosition, character)
	if typeof(targetPosition) ~= "Vector3" then
		return nil
	end
	local goalPosition = getUndergroundGoalPosition(targetPosition, character)
	if goalPosition then
		return goalPosition
	end
	local depth = math.max(1, tonumber(getUndergroundDepthOffset()) or 1)
	return Vector3.new(targetPosition.X, targetPosition.Y - depth, targetPosition.Z)
end

function beginControlledUndergroundTravel(character)
	if not isUndergroundMovementMode(movementMode) then
		return false
	end
	local resolvedCharacter, characterSource = westXResolveCharacter(character)
	local rootPart = westXGetRootPart(resolvedCharacter)
	if not rootPart then
		return false
	end
	local state = getUndergroundTravelState()
	if state.active and state.character ~= resolvedCharacter then
		endUndergroundTravel(state.character)
		state = getUndergroundTravelState()
	end
	local firstEnter = state.active ~= true
	state.active = true
	state.source = "WestX"
	state.character = resolvedCharacter
	state.characterSource = characterSource
	state.humanoid = westXGetHumanoid(resolvedCharacter)
	state.undergroundFlatDirection = getUndergroundTravelDirection(rootPart, lastMoveCommand)
	if isUndergroundOreHoldActive() and not westXEndingOreHold then
		playerState.undergroundOreHold = {}
	end
	westXApplyUndergroundState(state, resolvedCharacter, rootPart, state.humanoid, firstEnter)
	if firstEnter then
		state.enteredAt = os.clock()
		task.wait(0.5)
	end
	return true
end

function endUndergroundTravel(character)
	local state = getUndergroundTravelState()
	local oreHoldState = getUndergroundOreHoldState()
	if not state.active and not oreHoldState.active then
		return
	end
	if oreHoldState.active then
		westXEndingOreHold = true
		playerState.undergroundOreHold = {}
		westXEndingOreHold = false
	end
	westXRestoreUndergroundState(state, character or state.character)
	playerState.undergroundTravel = {}
end

function endUndergroundOreHold(character)
	local state = getUndergroundOreHoldState()
	if not state.active then
		return
	end
	playerState.undergroundOreHold = {}
	if not autoMineEnabled or not isUndergroundMovementMode(movementMode) then
		endUndergroundTravel(character or state.character)
	end
end

function beginUndergroundOreHold(character, targetPosition)
	if not beginControlledUndergroundTravel(character) then
		return false
	end
	local resolvedCharacter = getUndergroundTravelState().character or character
	local rootPart = westXGetRootPart(resolvedCharacter)
	if not rootPart then
		return false
	end
	local referencePosition = typeof(targetPosition) == "Vector3" and targetPosition or rootPart.Position
	local goalPosition = westXGetGoalPosition(referencePosition, resolvedCharacter)
	if not goalPosition then
		return false
	end
	local flatDirection = normalizeUndergroundFlatDirection(referencePosition - rootPart.Position)
		or getUndergroundTravelDirection(rootPart)
	local goalCFrame = westXGoalCFrame(goalPosition, rootPart, flatDirection)
	local holdState = getUndergroundOreHoldState()
	holdState.active = true
	holdState.source = "WestX"
	holdState.character = resolvedCharacter
	holdState.targetReferencePosition = referencePosition
	holdState.goalPosition = goalPosition
	holdState.undergroundFlatDirection = flatDirection
	westXSetRootCFrame(resolvedCharacter, rootPart, goalCFrame)
	westXSetRootVelocity(rootPart, Vector3.zero)
	return true
end

function ensureControlledUndergroundState(character, flatDirection)
	if not beginControlledUndergroundTravel(character) then
		return false
	end
	local state = getUndergroundTravelState()
	local resolvedCharacter = state.character or character
	local rootPart = westXGetRootPart(resolvedCharacter)
	if not rootPart then
		return false
	end
	state.undergroundFlatDirection = normalizeUndergroundFlatDirection(flatDirection)
		or getUndergroundTravelDirection(rootPart, lastMoveCommand)
	return true
end

function syncUndergroundOrientationState(character)
	if not isUndergroundMovementMode(movementMode) then
		return false
	end
	local state = getUndergroundTravelState()
	if not state.active then
		return false
	end
	local activeCharacter = character or state.character
	local rootPart = westXGetRootPart(activeCharacter)
	if rootPart then
		local direction = state.undergroundFlatDirection or lastMoveCommand
		westXSetRootCFrame(activeCharacter, rootPart, westXGoalCFrame(rootPart.Position, rootPart, direction))
	end
	return true
end

function undergroundCharacterTowards(character, targetPosition, activeToken, timeout, arriveDistance, movementOptions)
	if typeof(targetPosition) ~= "Vector3" then
		return false
	end
	local resolvedCharacter = westXResolveCharacter(character)
	if not resolvedCharacter or not beginControlledUndergroundTravel(resolvedCharacter) then
		return false
	end
	local rootPart = westXGetRootPart(resolvedCharacter)
	if not rootPart then
		return false
	end
	clearMovementKeys()
	local wantedDistance = math.max(0.3, tonumber(arriveDistance) or getUndergroundPathReachDistance())
	local travelTimeout = timeout or getDirectPathTravelTimeout(resolvedCharacter, targetPosition, 0.45)
	local startedAt = os.clock()
	local lastStepAt = startedAt
	local lastPosition = rootPart.Position
	local lastProgressAt = startedAt
	local useFlatPathFollow = type(movementOptions) == "table" and movementOptions.flatPathFollow == true
	while autoMineEnabled and activeToken == autoMineToken and isUndergroundMovementMode(movementMode) do
		rootPart = westXGetRootPart(resolvedCharacter)
		if not rootPart then
			return false
		end
		local goalPosition = westXGetGoalPosition(targetPosition, resolvedCharacter)
		if not goalPosition then
			return false
		end
		local currentPosition = rootPart.Position
		local delta = goalPosition - currentPosition
		local flatDelta = Vector3.new(delta.X, 0, delta.Z)
		local flatDistance = flatDelta.Magnitude
		local verticalDistance = math.abs(delta.Y)
		local verticalReach = getUndergroundVerticalReachDistance(wantedDistance)
		if delta.Magnitude <= wantedDistance or (flatDistance <= wantedDistance and verticalDistance <= verticalReach) then
			local state = getUndergroundTravelState()
			state.pendingVelocity = Vector3.zero
			westXSetRootVelocity(rootPart, Vector3.zero)
			setLastMoveCommand(Vector3.zero, "WestXUndergroundArrived")
			return true
		end
		local flatDirection = flatDistance > 0.001 and flatDelta.Unit or normalizeUndergroundFlatDirection(lastMoveCommand)
		if typeof(flatDirection) ~= "Vector3" or flatDirection.Magnitude <= 0.001 then
			flatDirection = Vector3.new(0, 0, -1)
		end
		if useFlatPathFollow then
			local avoidanceHandled, avoidReason = processPathPlayerAvoidance(
				resolvedCharacter,
				targetPosition,
				activeToken,
				flatDirection,
				westXGetHumanoid(resolvedCharacter)
			)
			if avoidanceHandled then
				if avoidReason == "hop" then
					return false, "hop"
				end
				lastStepAt = os.clock()
				task.wait(0.05)
				continue
			end
		end
		ensureControlledUndergroundState(resolvedCharacter, flatDirection)
		local now = os.clock()
		local stepTime = math.clamp(now - lastStepAt, 1 / 240, 0.08)
		lastStepAt = now
		local speed = math.max(getEffectiveUndergroundSpeed(), 1)
		local stepDistance = math.min(delta.Magnitude, speed * stepTime)
		local nextPosition = currentPosition
		if stepDistance > 0.001 then
			nextPosition = currentPosition + (delta.Unit * stepDistance)
		end
		local goalCFrame = westXGoalCFrame(nextPosition, rootPart, flatDirection)
		setLastMoveCommand(flatDirection, "WestXUnderground")
		westXSetRootCFrame(resolvedCharacter, rootPart, goalCFrame)
		westXSetRootVelocity(rootPart, Vector3.zero)
		local movedDistance = (rootPart.Position - lastPosition).Magnitude
		local madeProgress = movedDistance >= 0.25 or flatDistance < wantedDistance + 1
		if madeProgress then
			lastPosition = rootPart.Position
			lastProgressAt = now
		elseif now - lastProgressAt > math.clamp(travelTimeout * 0.5, 1.5, 5) then
			return false, "stuck"
		end
		if now - startedAt >= travelTimeout then
			break
		end
		RunService.Heartbeat:Wait()
	end
	rootPart = westXGetRootPart(resolvedCharacter)
	if rootPart then
		local goalPosition = westXGetGoalPosition(targetPosition, resolvedCharacter)
		if goalPosition then
			local delta = goalPosition - rootPart.Position
			local flatDistance = Vector3.new(delta.X, 0, delta.Z).Magnitude
			local finishSlack = math.max(0.35, wantedDistance * 0.45)
			return delta.Magnitude <= (wantedDistance + finishSlack)
				or (flatDistance <= (wantedDistance + finishSlack) and math.abs(delta.Y) <= (getUndergroundVerticalReachDistance(wantedDistance) + finishSlack))
		end
	end
	return false
end

function moveTowardsPosition(character, humanoid, targetPosition, activeToken, timeout)
	if isUndergroundMovementMode(movementMode) then
		return undergroundCharacterTowards(character, targetPosition, activeToken, timeout, nil, {
			flatPathFollow = false,
		})
	end
	return cframeCharacterTowards(character, targetPosition, activeToken, timeout, nil, getCFrameMovementOptions({
		useUndergroundOffset = false,
	}))
end
function getSegmentedPathTarget(currentPosition, finalTarget, maxDistance)
	local delta = finalTarget - currentPosition
	local distance = delta.Magnitude
	if distance <= (maxDistance or PATH_SEGMENT_DISTANCE) then
		return finalTarget
	end
	local direction = delta.Unit
	return currentPosition + (direction * (maxDistance or PATH_SEGMENT_DISTANCE))
end
function getDirectPathTravelTimeout(character, targetPosition, minimumTime)
	local rootPart = getRootPart(character)
	if not rootPart or not targetPosition then
		return math.max(tonumber(minimumTime) or 0.35, MOVE_TIMEOUT)
	end
	local flatDistance = (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(targetPosition.X, 0, targetPosition.Z)).Magnitude
	local travelSpeed = isCFrameMovementMode(movementMode) and getEffectiveCFrameSpeed()
		or (isUndergroundMovementMode(movementMode) and getEffectiveUndergroundSpeed())
		or math.max(clampTweenSpeed(tweenMoveSpeed, "cframe"), 1)
	return math.max(tonumber(minimumTime) or 0.35, (flatDistance / travelSpeed) + 0.4)
end
function moveTowardsRecordedPathNode(character, humanoid, targetPosition, activeToken)
	if not targetPosition then
		return false
	end
