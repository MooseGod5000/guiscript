function callPickaxeProgressionOwnerMethod(owner, methodName, targetItem, inventoryContainerId, inventoryItemId)
	if not isTable(owner) then
		return false
	end
	local method = rawget(owner, methodName) or owner[methodName]
	if type(method) ~= "function" then
		return false
	end
	local attempts = {
		{ inventoryContainerId, inventoryItemId },
		{ inventoryItemId },
		{ targetItem },
		{ inventoryContainerId, targetItem },
		{},
	}
	for _, args in ipairs(attempts) do
		local okCall = pcall(function()
			return method(owner, table.unpack(args))
		end)
		if okCall and waitForInventoryPickaxeItemRemoved(targetItem, inventoryItemId, 0.45) then
			return true
		end
	end
	return false
end
function tryDiscardPickaxeProgressionInventoryItem(entry)
	local now = os.clock()
	if (now - (tonumber(pickaxeProgressionLastDiscardAt) or 0)) < PICKAXE_PROGRESSION_DISCARD_COOLDOWN then
		return false
	end
	local targetItem = isTable(entry) and entry.item or nil
	if not isTable(targetItem) then
		return false
	end
	local playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
	local playerItems = resolveSharedPlayerItems(false) or resolveSharedPlayerItems(true)
	local inventoryContainer = getResolvedInventoryContainer(playerData)
	if not (isTable(playerData) and isTable(inventoryContainer)) then
		return false
	end
	local inventoryItemId = getInventoryItemKey(targetItem)
	local inventoryContainerId = rawget(inventoryContainer, "Id") or inventoryContainer.Id
	local sharedItemData = resolveSharedItemData(playerItems, targetItem)
	local actionNames = collectInventoryDiscardActionNames(sharedItemData, false)
	local playerCharacterModule = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	if isPlayerCharacterItemSwitching(playerCharacterModule) then
		pausePickaxeProgressionMining(0.35)
		return false
	end
	local currentTier = getCurrentPickaxeProgressionTier(cachedCharacter, playerCharacterModule, playerItems)
	local entryTier = tonumber(entry.tier)
	if currentTier == nil or entryTier == nil or currentTier <= 0 or currentTier <= entryTier then
		return false
	end
	for _, fallbackName in ipairs({
		"DiscardItem",
		"DiscardInventoryItem",
		"DestroyInventoryItem",
		"RemoveInventoryItem",
		"DeleteInventoryItem",
		"DestroyItem",
		"RemoveItem",
	}) do
		table.insert(actionNames, fallbackName)
	end
	pickaxeProgressionLastDiscardAt = now
	for _, target in ipairs({
		{ owner = targetItem, names = actionNames },
		{ owner = inventoryContainer, names = actionNames },
		{ owner = playerData, names = actionNames },
	}) do
		for _, methodName in ipairs(collectKeywordMethodNames(target.owner, target.names)) do
			if callPickaxeProgressionOwnerMethod(target.owner, methodName, targetItem, inventoryContainerId, inventoryItemId) then
				return true
			end
		end
	end
	return false
end
function equipBestPickaxeProgressionItem(character, humanoid)
	cachedPickaxe = nil
	lastPickaxeEquipRequestAt = 0
	lastPickaxeEquipRequestId = nil
	lastPickaxeLoadoutRequestAt = 0
	lastPickaxeLoadoutRequestId = nil
	pausePickaxeProgressionMining(0.35)
	refreshCachedObjects(true)
	local activeCharacter = character or cachedCharacter
	local activeHumanoid = humanoid or cachedHumanoid
	local playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
	local playerItems = resolveSharedPlayerItems(false) or resolveSharedPlayerItems(true)
	local targetEntry = nil
	targetEntry = getBestPickaxeProgressionItemEntry(playerData, playerItems)
	local targetTier = targetEntry and targetEntry.tier or nil
	local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	if isTable(targetEntry) and isTable(targetEntry.item) and isTable(playerCharacter) then
		local currentTier = getCurrentPickaxeProgressionTier(activeCharacter, playerCharacter, playerItems)
		if not currentTier or not targetTier or currentTier < targetTier then
			local setLoadout = isTable(playerData) and (rawget(playerData, "SetLoadout") or playerData.SetLoadout) or nil
			local slotType = getPickaxeEquipmentType(targetEntry.item, playerItems, playerData, playerCharacter)
			local slotIndex = findPreferredLoadoutSlot(playerData, slotType, getInventoryItemKey(targetEntry.item))
			if type(setLoadout) == "function" and type(slotType) == "string" and slotType ~= "" and slotIndex ~= nil then
				pcall(setLoadout, playerData, slotType, slotIndex, targetEntry.item)
				task.wait(0.12)
			end
			local canSwitchToItem = rawget(playerCharacter, "CanSwitchToItem") or playerCharacter.CanSwitchToItem
			local equipItem = rawget(playerCharacter, "EquipItem") or playerCharacter.EquipItem
			local canSwitch = true
			if type(canSwitchToItem) == "function" then
				local okCanSwitch, result = pcall(canSwitchToItem, playerCharacter, targetEntry.item, true)
				canSwitch = not okCanSwitch or result ~= false
			end
			if canSwitch and type(equipItem) == "function" then
