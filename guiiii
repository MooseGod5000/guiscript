function setPathEditorIdleStatus()
	if not pathState.editorVisible then
		setPathEditorStatus("")
		return
	end
	if pathState.deleteMode then
		if pathState.deletePathAhead then
			setPathEditorStatus("Delete mode is on. Click a node to delete it and the route ahead of it.", UI_COLORS.warning)
		else
			setPathEditorStatus("Delete mode is on. Click a node to delete only that node.", UI_COLORS.warning)
		end
		return
	end
	if pathState.disconnectNodesMode then
		local disconnectAfterNodeIndex = getPathDisconnectAfterNodeIndex(pathState.workingPath)
		local reconnectNodeIndex = getPathReconnectNodeIndex(pathState.workingPath)
		if disconnectAfterNodeIndex and reconnectNodeIndex then
			setPathEditorStatus("Disconnect mode is on. Click another node to move the wire, or click the cut node to reconnect normally.", UI_COLORS.warning)
		elseif disconnectAfterNodeIndex then
			setPathEditorStatus("Disconnect mode is on. Nodes ahead are inactive; click a red node ahead to wire back to it.", UI_COLORS.warning)
		else
			setPathEditorStatus("Disconnect mode is on. Click a node to disconnect it from the next node.", UI_COLORS.warning)
		end
		return
	end
