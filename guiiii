	return fileName
end

function getAutomineWebhookMemoryKey(url)
	local text = string.match(tostring(url or getDiscordAutomineWebhookUrl() or ""), "^%s*(.-)%s*$") or ""
	local webhookId = string.match(text, "/api/webhooks/(%d+)/") or "webhook"
	local hash = 0
	for index = 1, #text do
		hash = ((hash * 131) + string.byte(text, index)) % 2147483647
	end
	return "w_" .. tostring(webhookId) .. "_" .. tostring(hash)
end

function getAutomineWebhookAccountMemoryKey(url, player)
	local accountPlayer = player or localPlayer
	local accountId = tostring((accountPlayer and accountPlayer.UserId) or "")
	if accountId == "" or accountId == "0" then
		accountId = tostring((accountPlayer and accountPlayer.Name) or "unknown")
	end
	accountId = string.gsub(accountId, "[^%w_%-]", "_")
	return getAutomineWebhookMemoryKey(url) .. "_account_" .. accountId
end

function loadAutomineWebhookTotals()
	local totals = {}
	if storageReadAvailable then
		local okRead, raw = pcall(function()
			local filePath = getAutomineWebhookTotalsFilePath()
			if not isfile(filePath) then
				return nil
			end
			return readfile(filePath)
		end)
		if okRead and type(raw) == "string" and raw ~= "" then
			local okDecode, decoded = pcall(function()
				return _HttpService:JSONDecode(raw)
			end)
			if okDecode and type(decoded) == "table" then
				for key, value in pairs(decoded) do
					if type(key) == "string" then
						totals[key] = math.max(0, math.floor((tonumber(value) or 0) + 0.5))
					end
				end
			end
		end
	end
	if next(totals) == nil and type(automineWebhookState) == "table" and type(automineWebhookState.webhookTotals) == "table" then
		for key, value in pairs(automineWebhookState.webhookTotals) do
			if type(key) == "string" then
				totals[key] = math.max(0, math.floor((tonumber(value) or 0) + 0.5))
			end
		end
	end
	automineWebhookState = type(automineWebhookState) == "table" and automineWebhookState or {}
	automineWebhookState.webhookTotals = totals
	runtimeEnv.__FOB_AUTOMINE_WEBHOOK_STATE = automineWebhookState
	return totals
end

function saveAutomineWebhookTotals(totals)
	automineWebhookState = type(automineWebhookState) == "table" and automineWebhookState or {}
	automineWebhookState.webhookTotals = type(totals) == "table" and totals or {}
	runtimeEnv.__FOB_AUTOMINE_WEBHOOK_STATE = automineWebhookState
	if not storageEnabled then
		return false
	end
	local ok = pcall(function()
		ensureConfigStorageFolder()
		writefile(getAutomineWebhookTotalsFilePath(), _HttpService:JSONEncode(automineWebhookState.webhookTotals))
	end)
	return ok
end

