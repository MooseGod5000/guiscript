	local disconnectAfterNodeIndex = getPathDisconnectAfterNodeIndex(pathState.workingPath)
	local reconnectNodeIndex = getPathReconnectNodeIndex(pathState.workingPath)
	pathState.selectedNodeIndex = normalizedNodeIndex
	pathState.draggingNodeIndex = nil
	pathState.draggingNodeAxis = nil
	pathState.dragLastPointerPosition = nil
	if disconnectAfterNodeIndex then
		if normalizedNodeIndex == disconnectAfterNodeIndex or normalizedNodeIndex == disconnectAfterNodeIndex + 1 then
			pathState.workingPath.disconnectAfterNodeIndex = nil
			pathState.workingPath.reconnectNodeIndex = nil
			setPathEditorStatus("Path reconnected normally.", UI_COLORS.success)
		elseif normalizedNodeIndex < disconnectAfterNodeIndex then
			if normalizedNodeIndex >= nodeCount then
				setPathEditorStatus("Pick a node that has another node after it.", UI_COLORS.warning)
				return false
