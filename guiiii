if game.GameId == 69356799 then
    print("Doctor Glitch's Immortal Script Activated! ESP for ALL, Teleport for the Chosen!")

    local gemvalues = {
        [1] = "Red Diamond",
        [33] = "Demonite",
        [32] = "Mithril",
        [34] = "Fury Stone",
        [35] = "Dragon Bone",
        [36] = "Spirit Shard",
        [39] = "Ice Gem",
        [42] = "Titan Core",
        [50] = "Storm Catalyst",
    }

    local player = game.Players.LocalPlayer
    local activeGems = {} -- To manage ESP and teleport targets

    -- Function to set up character references (re-runs after death!)
    local function setupCharacter()
        local char = player.Character
        if not char or not char:FindFirstChild("Humanoid") or not char:FindFirstChild("HumanoidRootPart") then
            char = player.CharacterAdded:Wait()
        end
        return char:WaitForChild("Humanoid"), char:WaitForChild("HumanoidRootPart")
    end

    local humanoid, rootPart = setupCharacter()

    -- Connect to CharacterAdded to re-establish references after death
    player.CharacterAdded:Connect(function(newChar)
        humanoid, rootPart = setupCharacter()
        print("Character Re-spawned! Re-establishing control...")
    end)

    while true do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("IntValue") and obj.Name == "GemType" then
                local gem = obj.Parent
                local gemValue = obj.Value
                local gemName = gemvalues[gemValue] -- Get name for known gems, will be nil for unknown ones

                -- --- ESP Section (FOR ALL GEMS) ---
                if gem.Transparency < 1 and gem.Parent and gem.Parent ~= nil then
                    if not gem:FindFirstChild("BillboardGui") then
                        local bill = Instance.new("BillboardGui", gem)
                        local tag = Instance.new("TextLabel", bill)

                        bill.Size = UDim2.new(1, 0, 1, 0)
                        bill.AlwaysOnTop = true
                        tag.Size = UDim2.new(1, 0, 1, 0)
                        tag.BackgroundTransparency = 1
                        tag.Text = gemName or ("Unknown: " .. tostring(gemValue)) -- Show "Unknown" for unlisted gems
                        tag.TextColor3 = gem.Color -- Your original gem color!
                        tag.TextSize = 15
                        tag.TextStrokeColor3 = Color3.fromRGB(255, 255, 255)
                        tag.TextStrokeTransparency = .4
                        -- Add to activeGems to manage its ESP lifecycle
                        activeGems[gem] = true
                    end
                else
                    -- If gem is no longer visible, remove its ESP tag and from activeGems
                    if activeGems[gem] then
                        if gem:FindFirstChild("BillboardGui") then
                            gem:FindFirstChild("BillboardGui"):Destroy()
                        end
                        activeGems[gem] = nil
                    end
                end

                -- --- Teleport Section (ONLY FOR LISTED GEMS) ---
                if gemvalues[gemValue] and gem.Transparency < 1 and gem.Parent and gem.Parent ~= nil then
                    -- Ensure we have valid character references before attempting to teleport
                    if rootPart and rootPart.Parent and humanoid and humanoid.Health > 0 then
                        rootPart.CFrame = CFrame.new(gem.Position + Vector3.new(0, 2, 0))
                        task.wait(0.01) -- A micro-delay after each potential teleport
                    end
                end
            end
        end

        -- Cleanup any remaining ESP tags for gems that abruptly vanished or weren't caught above
        for gemObject, _ in pairs(activeGems) do
            if not gemObject or gemObject.Parent == nil or gemObject.Transparency == 1 then
                if gemObject and gemObject:FindFirstChild("BillboardGui") then
                    gemObject:FindFirstChild("BillboardGui"):Destroy()
                end
                activeGems[gemObject] = nil
            end
        end

        task.wait(0.05) -- Main loop wait
    end
end
