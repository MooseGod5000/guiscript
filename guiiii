                       if eggCurrentTarget and (not eggCurrentTarget.Parent or not isTargetAlive(eggCurrentTarget)) then
                           spawnNotification("Egg target killed!")
                           eggCurrentTarget = nil
                           eggTweening = false
                           -- eggHoldCF stays as-is so character stays where they are
