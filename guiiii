			flingTargetRoot = nil
		end
	end
	if not hasFlingTarget then
		playerState.horseFlingLockedTarget = nil
		playerState.horseFlingLastTargetPos = nil
		targetCFrame = getHorseOrbitIdleCFrame(rootPart, controlPosition, playerBaseCFrame)
