			bestRoot = targetRoot
			bestCharacter = character
			bestPlayer = _Players:FindFirstChild(tostring(character.Name or ""))
		end
	end
	local playersFolder = getTwwEntityPlayersFolder()
	if not playersFolder then
		return nil
