	if not isHorseOrbitOwnedAnimal(ridingAnimal) then
		clearHorseOrbitClaimHighlight()
		setHorseOrbitHorseCollisionEnabled(ridingAnimal, true)
		setHorseFlingSeatPartsEnabled(ridingAnimal, true)
		setHorseOrbitLocalCharacterCollisionEnabled(character, true)
		restoreHorseFlingFakeControl()
		return false
	end
	updateHorseOrbitClaimHighlight(ridingAnimal)
	if playerState.horseOrbitLastAnimal ~= ridingAnimal then
		local delta = horseRoot.Position - rootPart.Position
		local flatDelta = Vector3.new(delta.X, 0, delta.Z)
		if flatDelta.Magnitude > 0.1 then
			playerState.horseOrbitAngle = math.atan2(flatDelta.Z, flatDelta.X)
		else
			playerState.horseOrbitAngle = 0
		end
		playerState.horseOrbitLastAnimal = ridingAnimal
		playerState.horseFlingLockedTarget = nil
		playerState.horseFlingLastTargetPos = nil
	end
	if not isHorseOrbitServerMounted(ridingAnimal) then
		setHorseOrbitHorseCollisionEnabled(ridingAnimal, true)
		setHorseFlingSeatPartsEnabled(ridingAnimal, true)
		setHorseOrbitLocalCharacterCollisionEnabled(character, true)
		restoreHorseFlingFakeControl()
