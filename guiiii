		updatePathPlayerAvoiderRadiusVisualization(rootPart.Position, character, finalResult)
	elseif shouldShowCorridorVisual and type(updatePathPlayerAvoiderCorridorVisualization) == "function" then
		local liveSegments = buildPathPlayerAvoiderSegments(rootPart.Position, currentTargetPosition)
		updatePathPlayerAvoiderCorridorVisualization(rootPart.Position, liveSegments, finalResult)
	elseif shouldShowRadiusVisual and type(updatePathPlayerAvoiderRadiusVisualization) == "function" then
		updatePathPlayerAvoiderRadiusVisualization(rootPart.Position, character, finalResult)
	elseif type(clearPathPlayerAvoiderCorridorVisualization) == "function" then
		clearPathPlayerAvoiderCorridorVisualization()
	end
	if finalResult then
		updatePathPlayerAvoiderVisual(finalResult.player, finalResult.character, finalResult.rootPart)
	else
		destroyPathPlayerAvoiderVisual()
		pathState.playerAvoiderBlockedPlayerName = nil
	end
