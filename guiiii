	return row
end

function runRecoveredAction(spec)
	local key = spec.key
	if key == "START" then
		startAutoMine()
		return
	end
	if key == "Mine" then
		task.spawn(runOnce)
		return
	end
	if key == "End" or key == "END" then
		stopAutoMine("Auto Mine stopped")
		return
	end
	if key == "Move" then
		Settings.Move = true
		task.spawn(runOnce)
		return
	end
	if key == "Sell" then
		Settings.Sell = true
		setStatus("Sell action marked; exact sell callback still needs deeper source recovery.")
		return
	end
	if key == "Update_Theme" then
		applyThemeFromSettings()
		if buildInterface then
			buildInterface()
		end
		setStatus("Updated theme on screen without saving it.")
		return
	end
	if key == "Load_Theme" then
		if Settings.Theme_Selected == "Recovered Kinetic" then
			Settings.Theme_Background = "20,20,20"
			Settings.Theme_Section_Background = "15,15,15"
			Settings.Theme_Dark_Borders = "15,15,15"
			Settings.Theme_Light_Borders = "255,255,255"
			Settings.Theme_Text_Color = "255,255,255"
			Settings.Theme_Accent = "25,255,25"
			Settings.Theme_Dark_Accent = "10,100,10"
		end
		applyThemeFromSettings()
		if buildInterface then
			buildInterface()
		end
		setStatus(("Loaded theme: %s"):format(tostring(Settings.Theme_Selected or "Default")))
		return
	end
	if key == "Delete_Theme" then
		setStatus(("Theme delete requested for %s. File-backed theme deletion is omitted in this clean LocalScript."):format(
			tostring(Settings.Theme_Selected or "Default")
		))
		return
	end
	if key == "Save_Theme" then
		Settings.Theme_Selected = tostring(Settings.Theme_Name or "Default")
		setStatus(("Theme saved in memory as %s. File-backed saving is omitted in this clean LocalScript."):format(
			Settings.Theme_Selected
		))
		return
	end
	if key and type(Settings[key]) == "boolean" then
		Settings[key] = not Settings[key]
		local widget = settingWidgets[key]
		if widget then
			widget.refresh()
		end
		setStatus(("Toggled %s = %s"):format(key, tostring(Settings[key])))
		return
	end
	setStatus(("Recovered button %s is visible; exact callback body is still pending."):format(spec.label or key or "action"))
end

