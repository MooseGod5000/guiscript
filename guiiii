function resolveWestwareLocalPlayer(timeoutSeconds)
    if _Players and _Players.LocalPlayer then
        return _Players.LocalPlayer
    end
    local deadline = os.clock() + (tonumber(timeoutSeconds) or 5)
    while _Players and not _Players.LocalPlayer and os.clock() < deadline do
        task.wait(0.1)
    end
    return _Players and _Players.LocalPlayer or nil
end
