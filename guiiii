	playerState.horseOrbitLastAnimal = nil
	playerState.horseOrbitWasActive = false
	restoreHorseOrbitUnmountHooks()
end

function ensureHorseOrbitHooks()
	if not playerState.horseOrbitEnabled then
		return
	end

	applyHorseOrbitPulse(1 / 60)

	if playerState.horseOrbitConnection then
