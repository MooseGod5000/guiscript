local function getTwwEntityPlayersFolder()
    local entities = workspace:FindFirstChild("WORKSPACE_Entities")
    return entities and entities:FindFirstChild("Players") or nil
end

local function getTwwModelRoot(model)
    if not model then
        return nil
    end
    return model:FindFirstChild("Body") or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

