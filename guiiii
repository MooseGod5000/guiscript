do
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local CONFIG = {
        ScanInterval = 2.5,
        KickDelay = 0.25,
        KickReason = "You were banned for: Cheating/exploiting",
        WarnInOutput = true,
        ConsoleName = "Westwareantispy",
        EnvLoggerCanaryKey = "__WestwareantispyEnvCanary",
        PanicFlagKey = "__WestwarePanicCleanup",
        MaxTableScanEntries = 600,
        MaxTableScanDepth = 3,
    }

    local kicked = false
    local envLoggerCanary = nil

    local function safeCall(callback)
        local ok, result = pcall(callback)
        if ok then
            return true, result
        end
        return false, nil
    end

    local function safeIndex(container, key)
        local ok, value = safeCall(function()
            return container[key]
        end)
        if ok then
            return value
        end
        return nil
    end

    local function isPanicCleanupActive()
        if safeIndex(_G, CONFIG.PanicFlagKey) == true then
            return true
        end
        if safeIndex(shared, CONFIG.PanicFlagKey) == true then
            return true
        end
        local okEnv, globalEnv = safeCall(function()
            return type(getgenv) == "function" and getgenv() or nil
        end)
        return okEnv and type(globalEnv) == "table" and safeIndex(globalEnv, CONFIG.PanicFlagKey) == true
    end

    local function flag(reason)
        if kicked or isPanicCleanupActive() then
            return
        end

        kicked = true
        if CONFIG.WarnInOutput and not isPanicCleanupActive() then
            pcall(warn, "[" .. CONFIG.ConsoleName .. "] " .. tostring(reason or "detected logger behavior"))
        end

        task.defer(function()
            task.wait(CONFIG.KickDelay)
            pcall(function()
                local player = LocalPlayer or Players.LocalPlayer
                if player then
                    player:Kick(CONFIG.KickReason)
                end
            end)
        end)
    end

    local function installEnvLoggerCanary(env)
        if envLoggerCanary ~= nil then
            return
        end

        local existing = safeIndex(_G, CONFIG.EnvLoggerCanaryKey)
        if type(existing) ~= "table" then
            existing = safeIndex(shared, CONFIG.EnvLoggerCanaryKey)
        end

        if type(existing) ~= "table" then
            local getgenvFn = safeIndex(env, "getgenv")
            if type(getgenvFn) == "function" then
                local ok, globalEnv = pcall(getgenvFn)
                if ok and type(globalEnv) == "table" then
                    existing = safeIndex(globalEnv, CONFIG.EnvLoggerCanaryKey)
                end
            end
        end

        if type(existing) == "table" then
            envLoggerCanary = existing
            return
        end

        local canary = {}
        local tripwireKey = {}
        local tripwireValue = {}

        setmetatable(tripwireKey, {
            __tostring = function()
                flag("environment logger stringified Westwareantispy canary key")
                return "__WestwareantispyTripKey"
            end,
            __metatable = "locked",
        })

        setmetatable(tripwireValue, {
            __tostring = function()
                flag("environment logger stringified Westwareantispy canary value")
                return "__WestwareantispyTripValue"
            end,
            __index = function()
                flag("environment logger indexed Westwareantispy canary value")
                return nil
            end,
            __metatable = "locked",
        })

        canary[tripwireKey] = tripwireValue
        canary.__WestwareantispyEnvCanaryMarker = "environment logger canary"

        setmetatable(canary, {
            __tostring = function()
                flag("environment logger stringified Westwareantispy canary")
                return "[WestwareantispyCanary]"
            end,
            __pairs = function()
                flag("environment logger iterated Westwareantispy canary")
                return next, {[tripwireKey] = tripwireValue}, nil
            end,
            __iter = function()
                flag("environment logger iterated Westwareantispy canary")
                return next, {[tripwireKey] = tripwireValue}, nil
            end,
            __index = function()
                flag("environment logger indexed Westwareantispy canary")
                return nil
            end,
            __metatable = "locked",
        })

        envLoggerCanary = canary

        pcall(function()
            _G[CONFIG.EnvLoggerCanaryKey] = canary
        end)

        pcall(function()
            shared[CONFIG.EnvLoggerCanaryKey] = canary
        end)

        local getgenvFn = safeIndex(env, "getgenv")
        if type(getgenvFn) == "function" then
            local ok, globalEnv = pcall(getgenvFn)
            if ok and type(globalEnv) == "table" then
                pcall(function()
                    globalEnv[CONFIG.EnvLoggerCanaryKey] = canary
                end)
            end
        end
    end

    local envOk, scriptEnvironment = safeCall(function()
        return getfenv(0)
    end)

    if envOk and type(scriptEnvironment) == "table" then
        installEnvLoggerCanary(scriptEnvironment)

        local monitoredGlobalNames = {
            "loadstring",
            "request",
            "http_request",
            "httprequest",
            "syn_request",
            "hookfunction",
            "hookfunc",
            "hookmetamethod",
            "replaceclosure",
        }

        local monitoredRequestTableNames = {
            "syn",
            "http",
            "fluxus",
            "krnl",
        }

        local monitoredRequestFieldNames = {
            "request",
            "http_request",
            "httprequest",
        }

        local monitoredSlots = {}

        local function addMonitoredSlot(label, owner, key)
            if type(owner) ~= "table" then
                return
            end

            table.insert(monitoredSlots, {
                label = label,
                owner = owner,
                key = key,
                baseline = safeIndex(owner, key),
            })
        end

        local function addMonitoredRoot(label, root)
            if type(root) ~= "table" then
                return
            end

            for _, name in ipairs(monitoredGlobalNames) do
                addMonitoredSlot(label, root, name)
            end

            for _, tableName in ipairs(monitoredRequestTableNames) do
                local requestTable = safeIndex(root, tableName)
                if type(requestTable) == "table" then
                    for _, fieldName in ipairs(monitoredRequestFieldNames) do
                        addMonitoredSlot(label .. "." .. tableName, requestTable, fieldName)
                    end
                end
            end
        end

        addMonitoredRoot("script env", scriptEnvironment)
        addMonitoredRoot("_G", _G)
        addMonitoredRoot("shared", shared)

        do
            local getgenvFn = safeIndex(scriptEnvironment, "getgenv")
            if type(getgenvFn) == "function" then
                local ok, env = pcall(getgenvFn)
                if ok and type(env) == "table" then
                    addMonitoredRoot("getgenv()", env)
                end
            end
        end

        local spyNameHints = {
            "simplespy",
            "remote spy",
            "remotespy",
            "http spy",
            "httpspy",
            "env spy",
            "envspy",
            "environment logger",
            "envlogger",
            "hydroxide",
        }

        local loggerApiSignatureKeys = {
            "CaptureEnv",
            "WatchEnv",
            "UnwatchEnv",
            "GetEnv",
            "GetLogs",
            "WrapRequest",
            "InstallHooks",
            "UninstallHooks",
            "LogHttpRequest",
            "LogHttpResponse",
            "LogHttpError",
            "SetBodyLogging",
            "ExportLogs",
            "CopyLogs",
            "SaveLogs",
            "StartCapture",
            "StopCapture",
        }

        local loggerActionWords = {
            "log",
            "logger",
            "spy",
            "capture",
            "dump",
            "webhook",
            "discord",
        }

        local loggerPathWords = {
            "log",
            "logger",
            "spy",
            "capture",
            "dump",
            "inspect",
            "hook",
            "request",
        }

        local protectedExposureMarkers = {
            "__westwareantispyenvcanary",
            "progression_path_loadstrings",
            "originalnetworkfireserver",
            "networkfireserverwrapper",
        }

        local function textOf(value)
            if type(value) == "string" then
                return string.lower(value)
            end

            if type(value) == "number" or type(value) == "boolean" then
                return string.lower(tostring(value))
            end

            return ""
        end

        local function containsAny(text, needles)
            for _, needle in ipairs(needles) do
                if string.find(text, needle, 1, true) then
                    return true
                end
            end

            return false
        end

        local function containsDiscordWebhook(text)
            return string.find(text, "discord.com/api/webhooks", 1, true) ~= nil
                or string.find(text, "discordapp.com/api/webhooks", 1, true) ~= nil
                or string.find(text, "canary.discord.com/api/webhooks", 1, true) ~= nil
                or string.find(text, "ptb.discord.com/api/webhooks", 1, true) ~= nil
        end

        local function inspectLoggerTableShape(label, container)
            if type(container) ~= "table" then
                return false
            end

            local hasHookStore = type(safeIndex(container, "hookOriginals")) == "table"
            local hasSpyState = safeIndex(container, "spyEnabled") ~= nil
                or safeIndex(container, "hooksEnabled") ~= nil
                or type(safeIndex(container, "spyCallTimes")) == "table"
                or type(safeIndex(container, "spyPropertyTimes")) == "table"

            if hasHookStore and hasSpyState then
                flag("table contains hook/logger state: " .. tostring(label))
                return true
            end

            local hasLogStore = type(safeIndex(container, "logs")) == "table"
                or type(safeIndex(container, "Logs")) == "table"
            local hasEnvStore = type(safeIndex(container, "env")) == "table"
                or type(safeIndex(container, "envIndex")) == "table"
            local hasRequestHookStore = type(safeIndex(container, "hooks")) == "table"
                or type(safeIndex(container, "wrappedFunctions")) == "table"
                or safeIndex(container, "hookCount") ~= nil

            if hasLogStore and hasEnvStore and hasRequestHookStore then
                flag("table contains env/request logger state: " .. tostring(label))
                return true
            end

            local signatureCount = 0
            local hasEnvCapture = false
            local hasRequestHook = false

            for _, key in ipairs(loggerApiSignatureKeys) do
                if safeIndex(container, key) ~= nil then
                    signatureCount += 1

                    if key == "CaptureEnv" or key == "WatchEnv" or key == "GetEnv" then
                        hasEnvCapture = true
                    elseif key == "WrapRequest" or key == "InstallHooks" or key == "LogHttpRequest" then
                        hasRequestHook = true
                    end
                end
            end

            if signatureCount >= 4 and hasEnvCapture and hasRequestHook then
                flag("table exposes env/request logger API: " .. tostring(label))
                return true
            end

            return false
        end

        local function inspectLoggerText(path, key, value)
            local keyText = string.lower(tostring(key))
            local valueText = textOf(value)
            local combined = keyText .. " " .. valueText

            if string.find(combined, string.lower(CONFIG.EnvLoggerCanaryKey), 1, true) then
                flag("logged Westwareantispy canary marker at " .. tostring(path) .. "." .. tostring(key))
                return true
            end

            local hasWebhookWords = string.find(combined, "discord", 1, true) ~= nil
                and string.find(combined, "webhook", 1, true) ~= nil

            if containsDiscordWebhook(combined) or hasWebhookWords then
                flag("Discord webhook logger marker at " .. tostring(path) .. "." .. tostring(key))
                return true
            end

            if string.find(combined, "loadstring", 1, true)
                and containsAny(combined, loggerActionWords)
            then
                flag("loadstring logger marker at " .. tostring(path) .. "." .. tostring(key))
                return true
            end

            if containsAny(combined, protectedExposureMarkers)
                and containsAny(string.lower(path), loggerPathWords)
            then
                flag("protected script exposure marker at " .. tostring(path) .. "." .. tostring(key))
                return true
            end

            for _, hint in ipairs(spyNameHints) do
                if string.find(combined, hint, 1, true) then
                    flag("spy/logger marker '" .. tostring(hint) .. "' at " .. tostring(path) .. "." .. tostring(key))
                    return true
                end
            end

            return false
        end

        local function scanTableForLoggerMarkers(label, root)
            if type(root) ~= "table" or root == envLoggerCanary then
                return
            end

            local seenTables = {}
            local scannedEntries = 0

            local function scan(container, path, depth)
                if kicked or type(container) ~= "table" or seenTables[container] then
                    return
                end

                seenTables[container] = true

                if inspectLoggerTableShape(path, container) then
                    return
                end

                pcall(function()
                    for key, value in pairs(container) do
                        scannedEntries += 1

                        if value ~= envLoggerCanary then
                            if inspectLoggerText(path, key, value) then
                                return
                            end

                            if depth < CONFIG.MaxTableScanDepth and type(value) == "table" then
                                scan(value, path .. "." .. tostring(key), depth + 1)
                            end
                        end

                        if kicked or scannedEntries >= CONFIG.MaxTableScanEntries then
                            return
                        end
                    end
                end)
            end

            scan(root, label, 0)
        end

        local function inspectGlobalLoggerMarkers()
            local roots = {}
            local seenRootTables = {}

            local function addRoot(label, container)
                if type(container) ~= "table" or seenRootTables[container] then
                    return
                end

                seenRootTables[container] = true
                table.insert(roots, {
                    label = label,
                    container = container,
                })
            end

            addRoot("_G", _G)
            addRoot("shared", shared)

            local getgenvFn = safeIndex(scriptEnvironment, "getgenv")
            if type(getgenvFn) == "function" then
                local ok, env = pcall(getgenvFn)
                if ok and type(env) == "table" then
                    addRoot("getgenv()", env)
                end
            end

            for _, root in ipairs(roots) do
                scanTableForLoggerMarkers(root.label, root.container)
                if kicked then
                    return
                end
            end
        end

        local function inspectMonitoredGlobalReplacement()
            for _, slot in ipairs(monitoredSlots) do
                local baseline = slot.baseline
                local current = safeIndex(slot.owner, slot.key)

                if baseline ~= nil and current ~= nil and current ~= baseline then
                    flag("monitored global replaced: " .. tostring(slot.label) .. "." .. tostring(slot.key))
                    return
                end

                if baseline == nil
                    and type(current) == "function"
                    and (slot.key == "loadstring" or string.find(slot.key, "request", 1, true))
                then
                    flag("monitored logging surface appeared: " .. tostring(slot.label) .. "." .. tostring(slot.key))
                    return
                end
            end
        end

        local function scanOnce()
            if kicked or isPanicCleanupActive() then
                return
            end

            inspectMonitoredGlobalReplacement()
            if kicked then
                return
            end

            inspectGlobalLoggerMarkers()
        end

        scanOnce()

        task.spawn(function()
            while not kicked and not isPanicCleanupActive() do
                task.wait(CONFIG.ScanInterval)
                scanOnce()
            end
        end)
    end
end

local __lastStartupDebug = {}
local function isEarlyPanicCleanupActive()
    local panicKey = "__WestwarePanicCleanup"
    local okGlobal, globalFlag = pcall(function()
        if type(_G) == "table" then
            return _G[panicKey]
        end
        return nil
    end)
    if okGlobal and globalFlag == true then
        return true
    end
    local okShared, sharedFlag = pcall(function()
        if type(shared) == "table" then
            return shared[panicKey]
        end
        return nil
    end)
    if okShared and sharedFlag == true then
        return true
    end
    local okEnv, globalEnv = pcall(function()
        return type(getgenv) == "function" and getgenv() or nil
    end)
    return okEnv and type(globalEnv) == "table" and globalEnv[panicKey] == true
end
function westwareStartupDebug(message)
    if isEarlyPanicCleanupActive() then
        return
    end
    local text = "[Westware startup] " .. tostring(message)
	if __lastStartupDebug[text] then return end
	__lastStartupDebug[text] = true
    pcall(print, text)
end
