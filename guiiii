function Adapter.setRootCFrame(character, root, cframe, state)
	if Adapter.repCharAssistActive(state) and typeof(cframe) == "CFrame" then
		local repChar = state.repChar
		Adapter.clearRepCharPlatform(state)
		if isTable(repChar) then
			pcall(function()
				repChar.LocalForceCFrame = cframe
			end)
			state.usedLocalForceCFrame = true
		end
		if root and root:IsA("BasePart") then
			local targetVelocity = typeof(state.pendingVelocity) == "Vector3" and state.pendingVelocity or Vector3.zero
			local ok = pcall(function()
				root.Anchored = false
				root.CFrame = cframe
			end)
			Adapter.setRootVelocity(root, targetVelocity)
			Adapter.ensureUndergroundGyro(state, root, cframe)
			return ok
		end
	end
	if character and character:IsA("Model") and character.PrimaryPart then
		local ok = pcall(function()
			character:SetPrimaryPartCFrame(cframe)
		end)
		if ok then
			return true
		end
	end
	if root and root:IsA("BasePart") then
		root.CFrame = cframe
		return true
	end
	return false
end

function Adapter.isOreName(name)
	local lower = string.lower(tostring(name))
	return string.find(lower, "ore", 1, true)
		or string.find(lower, "deposit", 1, true)
		or string.find(lower, "vein", 1, true)
		or string.find(lower, "node", 1, true)
end

function Adapter.getOrePosition(ore)
	if not ore then
		return nil
	end
	if ore:IsA("BasePart") then
		return ore.Position
	end
	if ore:IsA("Model") then
		local ok, pivot = pcall(function()
			return ore:GetPivot()
		end)
		if ok then
			return pivot.Position
		end
		local part = ore:FindFirstChildWhichIsA("BasePart", true)
		return part and part.Position or nil
	end
	return nil
end

function Adapter.getOreContainers()
	local containers = {}
	for _, name in ipairs({ "Ores", "Ore", "Deposits", "WORKSPACE_Entities", "Nodes" }) do
		local found = workspace:FindFirstChild(name)
		if found then
			table.insert(containers, found)
		end
	end
	return containers
end

function Adapter.getOreCandidates()
	local candidates = {}
	local containers = Adapter.getOreContainers()
	if #containers > 0 then
		for _, container in ipairs(containers) do
			for _, item in ipairs(container:GetDescendants()) do
				if (item:IsA("BasePart") or item:IsA("Model")) and Adapter.getOrePosition(item) then
					if Adapter.isOreName(item.Name) or Adapter.isOreName(item.Parent and item.Parent.Name or "") then
						table.insert(candidates, item)
					end
				end
			end
		end
	else
		local scanned = 0
		for _, item in ipairs(workspace:GetDescendants()) do
			if scanned >= 500 then
				break
			end
			scanned += 1
			if (item:IsA("BasePart") or item:IsA("Model")) and Adapter.isOreName(item.Name) and Adapter.getOrePosition(item) then
				table.insert(candidates, item)
			end
		end
	end
	return candidates
end

function Adapter.selectNearestOre()
	local character = Adapter.getCharacter()
	local root = Adapter.getRoot(character)
	if not root then
		return nil
	end

	local nearest = nil
	local nearestDistance = math.huge
	for _, ore in ipairs(Adapter.getOreCandidates()) do
		local position = Adapter.getOrePosition(ore)
		if position then
			local distance = (root.Position - position).Magnitude
			if distance < nearestDistance then
				nearest = ore
				nearestDistance = distance
			end
		end
	end
	return nearest, nearestDistance
end

function Adapter.applyCharacterAssists(character)
	local humanoid = Adapter.getHumanoid(character)
	if not humanoid then
		return
	end
	if Settings.Auto_Get_Up then
		humanoid.Sit = false
		humanoid.PlatformStand = false
	end
	if Settings.Jump then
		humanoid.Jump = true
	end
end

function Adapter.moveUndergroundTo(ore)
	local character, characterSource = Adapter.getCharacter()
	local root = Adapter.getRoot(character)
	local humanoid = Adapter.getHumanoid(character)
	local orePosition = Adapter.getOrePosition(ore)
	if not root or not orePosition then
		return false, "missing custom character root or ore position"
	end

	Adapter.applyCharacterAssists(character)

	local yOffset = safeNumber(Settings.Fly_Y_Offset_In_Ground, -8)
	if Settings.MoveFlyAbove then
		yOffset = math.abs(yOffset)
	end

	local target = Vector3.new(orePosition.X, orePosition.Y + yOffset, orePosition.Z)
	local timeout = math.clamp(safeNumber(Settings.Lag_Back_Wait, 8), 2, 30)
	local speed = math.max(4, safeNumber(Settings.Ragdoll_Fly_Speed_In_Ground, 18))
	local reachedDistance = math.max(4, math.min(safeNumber(Settings.Lag_Back_Threshold, 12), 12))
	local startedAt = os.clock()
	local lastPosition = root.Position
	local lastProgressAt = startedAt
	local originalAnchored = root.Anchored
	local originalRootCanCollide = root.CanCollide
	local originalPlatformStand
	local originalAutoRotate
	local originalHipHeight
	local originalSwimmingEnabled
	local changedCollisions = {}
	local changedCollisionLookup = {}
	local undergroundState = {
		character = character,
		root = root,
		humanoid = humanoid,
	}
	Adapter.resolveRepCharAssist(undergroundState)

	if humanoid then
		originalPlatformStand = humanoid.PlatformStand
		originalAutoRotate = humanoid.AutoRotate
		originalHipHeight = humanoid.HipHeight
		pcall(function()
			originalSwimmingEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Swimming)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
		end)
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
	end

	if Adapter.repCharAssistActive(undergroundState) then
		root.Anchored = false
		Adapter.setRootVelocity(root, Vector3.zero)
		Adapter.setRepCharFaceMouseDisabled(undergroundState, true)
	else
		root.Anchored = true
		Adapter.setRootVelocity(root, Vector3.zero)
	end
	Adapter.setCustomCrouch(character, Settings.Crouch_Under_Ground or Settings.Move_Under_Ground or Settings.Hide_In_Ground)
	Adapter.setCustomSprint(character, false)
	Adapter.setCollisionModel(character, false)

	local function setPartCanCollide(part, canCollide)
		if not part or not part:IsA("BasePart") or changedCollisionLookup[part] then
			return
		end
		changedCollisionLookup[part] = true
		table.insert(changedCollisions, { part = part, canCollide = part.CanCollide })
		part.CanCollide = canCollide
	end

	setPartCanCollide(root, false)
	if character and character:IsA("Model") then
		for _, descendant in ipairs(character:GetDescendants()) do
			setPartCanCollide(descendant, false)
		end
	end

	if Settings.Crouch_Under_Ground then
		task.wait(0.5)
	end

	local reached = false
	local stopReason = "timeout"
	local deltaTime = 1 / 60

	while (Settings.AutoMineEnabled or runningOnce) and os.clock() - startedAt < timeout do
		if not root.Parent then
			stopReason = "root lost"
			break
		end

		local current = root.Position
		local delta = target - current
		local distance = delta.Magnitude
		if distance <= reachedDistance then
			reached = true
			stopReason = "reached underground target"
			break
		end

		if (current - lastPosition).Magnitude >= 0.35 then
			lastPosition = current
			lastProgressAt = os.clock()
		elseif os.clock() - lastProgressAt > math.clamp(timeout * 0.5, 1.5, 5) then
			stopReason = "lagback/stuck while underground"
			break
		end

		local stepDistance = math.min(distance, speed * deltaTime)
		local nextPosition = current + delta.Unit * stepDistance
		local flatDelta = Vector3.new(delta.X, 0, delta.Z)
		local moveDirection
		if flatDelta.Magnitude > 0.001 then
			moveDirection = flatDelta.Unit
		else
			moveDirection = Vector3.zero
		end
		undergroundState.pendingMovementDirection = moveDirection
		undergroundState.pendingVelocity = moveDirection * speed
		if humanoid then
			pcall(function()
				humanoid.Jump = false
				humanoid:Move(moveDirection, false)
			end)
		end
		Adapter.clearRepCharPlatform(undergroundState)
		local lookAt = Vector3.new(target.X, nextPosition.Y, target.Z)
		if (lookAt - nextPosition).Magnitude < 0.01 then
			lookAt = nextPosition + root.CFrame.LookVector
		end
		local goalCFrame = CFrame.new(nextPosition, lookAt)
		Adapter.setRootCFrame(character, root, goalCFrame, undergroundState)
		if Adapter.repCharAssistActive(undergroundState) then
			Adapter.setRootVelocity(root, undergroundState.pendingVelocity)
		else
			Adapter.setRootVelocity(root, Vector3.zero)
		end
		deltaTime = RunService.Heartbeat:Wait()
	end

	Adapter.releaseRepCharAssist(undergroundState)
	for _, record in ipairs(changedCollisions) do
		if record.part and record.part.Parent then
			record.part.CanCollide = record.canCollide
		end
	end
	Adapter.setCollisionModel(character, true)
	Adapter.setWeldsActive(character, true)
	Adapter.setCustomCrouch(character, false)
	Adapter.setCustomSprint(character, false)
	if humanoid then
		pcall(function()
			humanoid:Move(Vector3.zero, false)
		end)
		humanoid.PlatformStand = originalPlatformStand == true
		if originalHipHeight ~= nil then
			humanoid.HipHeight = originalHipHeight
		end
		if originalAutoRotate ~= nil then
			humanoid.AutoRotate = originalAutoRotate
		end
		if originalSwimmingEnabled ~= nil then
			pcall(function()
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, originalSwimmingEnabled)
			end)
		end
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end)
	end
	if root.Parent then
		root.Anchored = originalAnchored
		root.CanCollide = originalRootCanCollide
	end

	local finalDistance = root.Parent and (root.Position - target).Magnitude or math.huge
	return reached or finalDistance <= reachedDistance,
		("%s via %s (%.1f studs)"):format(stopReason, tostring(characterSource or "character"), finalDistance)
end

function Adapter.moveToOre(ore)
	local character = Adapter.getCharacter()
	local humanoid = Adapter.getHumanoid(character)
	local root = Adapter.getRoot(character)
	local orePosition = Adapter.getOrePosition(ore)
	if Settings.Move_Under_Ground or Settings.Hide_In_Ground or Settings.Crouch_Under_Ground then
		return Adapter.moveUndergroundTo(ore)
	end
	if not humanoid or not root or not orePosition then
		return false, "missing character or ore position"
	end

	Adapter.applyCharacterAssists(character)

	local yOffset = safeNumber(Settings.Fly_Y_Offset, 4)
	if Settings.Move_Under_Ground or Settings.Hide_In_Ground then
		yOffset = safeNumber(Settings.Fly_Y_Offset_In_Ground, -8)
	end
	if Settings.MoveFlyAbove then
		yOffset = math.abs(yOffset)
	end

	local target = Vector3.new(orePosition.X, orePosition.Y + yOffset, orePosition.Z)
	local timeout = math.clamp(safeNumber(Settings.Lag_Back_Wait, 8), 2, 30)
	local reached = false
	local finished = false
	local connection = humanoid.MoveToFinished:Connect(function(ok)
		reached = ok
		finished = true
	end)

	humanoid:MoveTo(target)
	local startedAt = os.clock()
	while (Settings.AutoMineEnabled or runningOnce) and not finished and os.clock() - startedAt < timeout do
		RunService.Heartbeat:Wait()
	end

	connection:Disconnect()
	return reached or (root.Position - target).Magnitude <= 10, reached and "reached" or "timeout/near target"
end

function Adapter.fireMineHook(ore)
	local hook = ReplicatedStorage:FindFirstChild("WesternMineRequest")
		or ReplicatedStorage:FindFirstChild("MineOre")
		or ReplicatedStorage:FindFirstChild("OreRequest")

	if hook and hook:IsA("RemoteEvent") then
		hook:FireServer(ore, Settings)
		return true, "RemoteEvent fired: " .. hook.Name
	end
	if hook and hook:IsA("BindableEvent") then
		hook:Fire(ore, Settings)
		return true, "BindableEvent fired: " .. hook.Name
	end

	return false, "no ReplicatedStorage.WesternMineRequest/MineOre/OreRequest hook found"
end

local function runOnce()
	if runningOnce then
		return false
	end
	runningOnce = true

	setStatus("State: startup and prerequisites")
	local character = Adapter.getCharacter()
	if not character then
		setStatus("No character found")
		runningOnce = false
		return false
	end

	setStatus("State: path and ore selection")
	local ore, distance = Adapter.selectNearestOre()
	if not ore then
		setStatus("No ore/deposit candidate found")
		runningOnce = false
		return false
	end

	setStatus(("Ore selected: %s (%.1f studs)"):format(ore:GetFullName(), distance or 0))
	setStatus("State: movement controller")
	local moved, moveReason = Adapter.moveToOre(ore)
	setStatus("Move result: " .. tostring(moveReason))

	if moved or Settings.Mine then
		setStatus("State: mining and remote actions")
		local mined, mineReason = Adapter.fireMineHook(ore)
		setStatus(mined and mineReason or ("Mine hook skipped: " .. mineReason))
	else
		setStatus("State: failure and retry exits")
	end

	local idle = math.max(0.05, safeNumber(Settings["Waiting/Idle"], 0.2))
	task.wait(idle)
	runningOnce = false
	return true
end

local function stopAutoMine(reason)
	Settings.AutoMineEnabled = false
	if settingWidgets.AutoMineEnabled then
		settingWidgets.AutoMineEnabled.refresh()
	end
	setStatus(reason or "Auto Mine stopped")
end

local function startAutoMine()
	if Settings.AutoMineEnabled and loopThread then
		setStatus("Auto Mine already running")
		return
	end

	Settings.AutoMineEnabled = true
	if settingWidgets.AutoMineEnabled then
		settingWidgets.AutoMineEnabled.refresh()
	end

	setStatus("Auto Mine started")
	loopThread = task.spawn(function()
		while Settings.AutoMineEnabled do
			local ok, err = pcall(runOnce)
			if not ok then
				warn("[WesternClient] Auto Mine error:", err)
				if Settings.Disable_Errors then
					stopAutoMine("Auto Mine stopped after suppressed error")
				end
			end
			task.wait(math.max(0.05, safeNumber(Settings.Wait, 0.2)))
		end
		loopThread = nil
	end)
end

