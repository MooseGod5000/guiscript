function restoreUndergroundPreReplicateHook()
	local connection = playerState.undergroundPreReplicateConnection
	if connection and type(connection.Disconnect) == "function" then
		pcall(function()
			connection:Disconnect()
		end)
	elseif connection and type(connection.Destroy) == "function" then
		pcall(function()
			connection:Destroy()
		end)
	end
	playerState.undergroundPreReplicateConnection = nil
	playerState.undergroundPreReplicateOwner = nil
end

function ensureUndergroundPreReplicateHook()
	local state = getUndergroundTravelState()
	local globalModule = getAutoMineGlobalModule(true)
	if not isTable(globalModule) then
		return false
	end

	local bindToHeartbeat = rawget(globalModule, "BindToHeartbeat") or globalModule.BindToHeartbeat
	if type(bindToHeartbeat) ~= "function" then
		return false
	end

	if playerState.undergroundPreReplicateConnection and playerState.undergroundPreReplicateOwner == globalModule then
		return true
	end

	restoreUndergroundPreReplicateHook()
	local okBind, connection = pcall(function()
		return bindToHeartbeat(globalModule, "AutoMineUndergroundPreReplicate", 8000000000, function()
			local activeState = playerState.undergroundTravel
			if type(activeState) ~= "table" or activeState.active ~= true then
				restoreUndergroundPreReplicateHook()
				return
			end
			local character = activeState.character
			local goalCFrame = activeState.pendingGoalCFrame
			if typeof(character) ~= "Instance" or typeof(goalCFrame) ~= "CFrame" then
				return
			end
			local preservedPlatform = activeState.preservedPlatform or activeState.initialPlatform
			if preservedPlatform then
				reassertUndergroundPlatformTarget(character, preservedPlatform)
			end
			applyUndergroundForcedCFrameGoal(character, goalCFrame)
		end)
	end)
	if okBind and connection then
		playerState.undergroundPreReplicateConnection = connection
		playerState.undergroundPreReplicateOwner = globalModule
		state.usedPreReplicateHook = true
		if type(pushDebugRateLimited) == "function" then
			pushDebugRateLimited("underground_prerep_hook", "underground pre-replicate hook installed", 8)
		end
		return true
	end

	if type(pushDebugRateLimited) == "function" then
		pushDebugRateLimited("underground_prerep_hook_failed", "underground pre-replicate hook unavailable", 8)
	end
	return false
end

function setUndergroundRootVelocity(rootPart, velocity)
	if not rootPart or typeof(velocity) ~= "Vector3" then
