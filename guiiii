end

function getInstantRobActionText(groupKey, actionKey, actionData)
    local text = tostring(groupKey or "") .. " " .. tostring(actionKey or "")
    for _, key in ipairs({ "Description", "NetworkEvent", "Event", "Name", "ActionName" }) do
        local value = rawget(actionData, key)
        if value == nil then
            value = actionData[key]
        end
        if type(value) == "string" then
            text ..= " " .. value
        end
    end
    return string.lower(text)
end

function shouldInstantRobAction(groupKey, actionKey, actionData)
    if not isTable(actionData) then
        return false
    end
    local duration = rawget(actionData, "Duration")
    if duration == nil then
        duration = actionData.Duration
    end
    if type(duration) ~= "number" or duration <= 0 then
        return false
    end
    return string.find(getInstantRobActionText(groupKey, actionKey, actionData), "rob", 1, true) ~= nil
end

function forEachObjectActionDuration(actionTypes, callback)
    if not isTable(actionTypes) or type(callback) ~= "function" then
        return
    end

    for groupKey, groupData in pairs(actionTypes) do
        if isTable(groupData) then
            local directDuration = rawget(groupData, "Duration")
            if directDuration == nil then
                directDuration = groupData.Duration
            end
            if type(directDuration) == "number" then
                callback(groupKey, groupKey, groupData)
            end

            for actionKey, actionData in pairs(groupData) do
                if isTable(actionData) then
                    local duration = rawget(actionData, "Duration")
                    if duration == nil then
                        duration = actionData.Duration
                    end
                    if type(duration) == "number" then
                        callback(groupKey, actionKey, actionData)
                    end

                    for nestedKey, nestedAction in pairs(actionData) do
                        if isTable(nestedAction) then
                            local nestedDuration = rawget(nestedAction, "Duration")
                            if nestedDuration == nil then
                                nestedDuration = nestedAction.Duration
                            end
                            if type(nestedDuration) == "number" then
                                callback(groupKey, tostring(actionKey) .. "." .. tostring(nestedKey), nestedAction)
                            end
                        end
                    end
                end
            end
        end
    end
end

function applyInstantRobDurationOverride(actionData)
    if not isTable(actionData) then
        return false
    end

    local duration = rawget(actionData, "Duration")
    if duration == nil then
        duration = actionData.Duration
    end
    if type(duration) ~= "number" or duration <= 0 then
        return false
    end

    local overrides = gunFeatureState.instantRobDurationOverrides
    if type(overrides) ~= "table" then
        overrides = {}
        gunFeatureState.instantRobDurationOverrides = overrides
    end

    if overrides[actionData] == nil then
        overrides[actionData] = duration
    end
    if actionData.Duration ~= 0 then
        actionData.Duration = 0
    end
    return true
end

function ensureInstantRobHooks()
    if not S.instantRobEnabled then
        return
    end

    local playerActionTypes = resolvePlayerActionTypesModule(false) or resolvePlayerActionTypesModule(true)
    if not isTable(playerActionTypes) then
        return
    end

    local robAction = rawget(playerActionTypes, "Rob") or playerActionTypes.Rob
    applyInstantRobDurationOverride(robAction)

    forEachObjectActionDuration(playerActionTypes, function(groupKey, actionKey, actionData)
        if shouldInstantRobAction(groupKey, actionKey, actionData) then
            applyInstantRobDurationOverride(actionData)
        end
    end)
end

function restoreInstantRobHooks()
    local overrides = gunFeatureState.instantRobDurationOverrides
    if type(overrides) ~= "table" then
        gunFeatureState.instantRobDurationOverrides = {}
        return
    end

    for actionData, originalDuration in pairs(overrides) do
        if isTable(actionData) then
            pcall(function()
                actionData.Duration = originalDuration
            end)
        end
    end
    gunFeatureState.instantRobDurationOverrides = {}
end

