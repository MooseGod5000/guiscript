	local bestPlayer = nil
	local bestDistance = range
	local seenCharacters = {}
	local function considerCharacter(character)
		if typeof(character) ~= "Instance" or seenCharacters[character] then
			return
		end
		seenCharacters[character] = true
		local targetRoot = getHorseFlingRootFromCharacter(character)
		if not targetRoot then
