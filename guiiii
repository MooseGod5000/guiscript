                      if not npcSetupDone then
                          cleanupNpcFarm()
                          spawnNotification("NPC farm starting! Preparing...")
                          npcIsFollowing = true
                          task.wait(1)
                          if autoReorderNpcEnabled and autofarmNpcEnabled then
