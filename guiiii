-- When a bound key is pressed, trigger the corresponding button action
do
   _UserInputService.InputBegan:Connect(function(input, gameProcessed)
       if gameProcessed then return end
       if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
       local keyCode = input.KeyCode
       if keyCode == Enum.KeyCode.Unknown then return end
       for buttonName, boundKey in pairs(S.keybinds) do
           if boundKey == keyCode then
               -- Find the registry entry and trigger its action
               for _, regEntry in ipairs(_buttonRegistry) do
                   if regEntry.name == buttonName then
                       if regEntry.type == "toggle" and regEntry.onClickFn then
                           regEntry.onClickFn()
                           -- Sync toggle visuals
                           for _, syncFn in ipairs(_allToggleSyncs) do
                               pcall(syncFn)
                           end
                       elseif regEntry.type == "button" and regEntry.onClickFn then
                           regEntry.onClickFn()
                       elseif regEntry.type == "special" and regEntry.onClickFn then
                           regEntry.onClickFn()
                       end
                       break
                   end
               end
           end
       end
   end)
end
