function placeableMiscGetCharacterRoot()
	local playerCharacter = placeableMiscGetPlayerCharacter(false) or placeableMiscGetPlayerCharacter(true)
	local root = isTable(playerCharacter) and (rawget(playerCharacter, "RootPart") or playerCharacter.RootPart) or nil
	if root and root.Parent then
		return root
	end
	local character = (type(getCustomCharacter) == "function" and getCustomCharacter()) or (localPlayer and localPlayer.Character)
	if typeof(character) == "Instance" then
		return (type(getRootPart) == "function" and getRootPart(character))
			or character:FindFirstChild("HumanoidRootPart")
			or character.PrimaryPart
			or character:FindFirstChildWhichIsA("BasePart")
