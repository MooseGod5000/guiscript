      local function findOppositeGeneral()
          local root = _Players.LocalPlayer.Character and _Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
          if not root then return nil, nil end
          local unbreakable = workspace:FindFirstChild("Unbreakable")
          local chars = unbreakable and unbreakable:FindFirstChild("Characters")
          if not chars then return nil, nil end
          local humanGeneral = chars:FindFirstChild("Human") and chars.Human:FindFirstChild("Human General")
          local orcGeneral = chars:FindFirstChild("Orc") and chars.Orc:FindFirstChild("Orc General")
          local targetGeneral = nil
          local playerTeam = _Players.LocalPlayer.Team
          if playerTeam then
              local teamName = playerTeam.Name:lower()
              if teamName:find("human") then
                  targetGeneral = orcGeneral
              elseif teamName:find("orc") then
                  targetGeneral = humanGeneral
              end
          end
          if not targetGeneral then
              if humanGeneral and orcGeneral then
                  local hDist = humanGeneral.PrimaryPart and (root.Position - humanGeneral.PrimaryPart.Position).Magnitude or math.huge
                  local oDist = orcGeneral.PrimaryPart and (root.Position - orcGeneral.PrimaryPart.Position).Magnitude or math.huge
                  targetGeneral = hDist > oDist and humanGeneral or orcGeneral
              else
                  targetGeneral = humanGeneral or orcGeneral
              end
          end
          if not targetGeneral then return nil, nil end
          local targetPart = targetGeneral.PrimaryPart
          if not targetPart then
              for _, partName in ipairs({"HumanoidRootPart", "Torso", "LowerTorso", "UpperTorso", "Head"}) do
                  local found = targetGeneral:FindFirstChild(partName)
                  if found and found:IsA("BasePart") then targetPart = found break end
              end
          end
          return targetGeneral, targetPart
      end
      local function findDemon()
          local unbreakable = workspace:FindFirstChild("Unbreakable")
          local chars = unbreakable and unbreakable:FindFirstChild("Characters")
          if not chars then return nil, nil end
          local demonFolder = chars:FindFirstChild("Demon")
          if not demonFolder then return nil, nil end
          local demon = demonFolder:FindFirstChild("Giant Demon Spawn")
          if not demon then return nil, nil end
          local targetPart = demon.PrimaryPart
          if not targetPart then
              for _, partName in ipairs({"HumanoidRootPart", "Torso", "LowerTorso", "UpperTorso", "Head"}) do
                  local found = demon:FindFirstChild(partName)
                  if found and found:IsA("BasePart") then targetPart = found break end
              end
          end
          return demon, targetPart
      end
      local function isPlayerCharacter(model)
          for _, player in pairs(_Players:GetPlayers()) do
              if player.Character and player.Character == model then return true end
          end
          return false
      end
      local function findEnemyNpcs()
          local root = _Players.LocalPlayer.Character and _Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
          if not root then return {} end
          local unbreakable = workspace:FindFirstChild("Unbreakable")
          local chars = unbreakable and unbreakable:FindFirstChild("Characters")
          if not chars then return {} end
          local enemyTeamName = nil
          local playerTeam = _Players.LocalPlayer.Team
          if playerTeam then
              local teamName = playerTeam.Name:lower()
              if teamName:find("human") then enemyTeamName = "Orc"
              elseif teamName:find("orc") then enemyTeamName = "Human" end
          end
          local npcs = {}
          local searchFolders = {}
          if enemyTeamName then
              local folder = chars:FindFirstChild(enemyTeamName)
              if folder then table.insert(searchFolders, folder) end
          else
              for _, folder in pairs(chars:GetChildren()) do
                  if folder:IsA("Folder") or folder:IsA("Model") then
                      local folderName = folder.Name:lower()
                      if folderName ~= "demon" then table.insert(searchFolders, folder) end
                  end
              end
          end
          for _, folder in pairs(searchFolders) do
              for _, npc in pairs(folder:GetChildren()) do
                  if npc:IsA("Model") and not npc.Name:find("General") and not isPlayerCharacter(npc) then
                      local hum = npc:FindFirstChildOfClass("Humanoid")
                      if hum and hum.Health > 0 then
                          local part = npc.PrimaryPart
                          if not part then
                              for _, pn in ipairs({"HumanoidRootPart", "Torso", "LowerTorso", "UpperTorso", "Head"}) do
                                  local f = npc:FindFirstChild(pn)
                                  if f and f:IsA("BasePart") then part = f break end
                              end
                          end
                          if part then
                              table.insert(npcs, {model = npc, part = part, dist = (root.Position - part.Position).Magnitude})
                          end
                      end
                  end
              end
          end
          table.sort(npcs, function(a, b) return a.dist < b.dist end)
          return npcs
      end
