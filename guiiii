    for groupKey, groupData in pairs(actionTypes) do
        if isTable(groupData) then
            local directDuration = rawget(groupData, "Duration")
            if directDuration == nil then
                directDuration = groupData.Duration
            end
            if type(directDuration) == "number" then
                callback(groupKey, groupKey, groupData)
            end
            for actionKey, actionData in pairs(groupData) do
                if isTable(actionData) then
                    local duration = rawget(actionData, "Duration")
                    if duration == nil then
                        duration = actionData.Duration
                    end
                    if type(duration) == "number" then
                        callback(groupKey, actionKey, actionData)
                    end
                    for nestedKey, nestedAction in pairs(actionData) do
                        if isTable(nestedAction) then
                            local nestedDuration = rawget(nestedAction, "Duration")
                            if nestedDuration == nil then
                                nestedDuration = nestedAction.Duration
                            end
                            if type(nestedDuration) == "number" then
                                callback(groupKey, tostring(actionKey) .. "." .. tostring(nestedKey), nestedAction)
                            end
                        end
                    end
                end
            end
        end
    end
end
