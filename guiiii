function buildUiRows(parentList, specs, context)
    local built = {rows = {}, syncs = {}, updateFns = {}}
    context = context or {}
    for _, spec in ipairs(specs or {}) do
        local rowType = spec.type or "toggle"
        local row, syncFn, label, textBox
        if rowType == "toggle" then
            local createdRow, _, syncLabels, rowLabel = createToggleRow(spec.label, parentList, spec.get, spec.set or spec.onClick)
            row, syncFn, label = createdRow, syncLabels, rowLabel
        elseif rowType == "boundToggle" then
            local createdRow, _, syncLabels, rowLabel = createBoundToggleRow(spec.label, parentList, spec.state, spec.key, spec.set or spec.setter)
            row, syncFn, label = createdRow, syncLabels, rowLabel
        elseif rowType == "dropdown" then
            row, syncFn, label = createDropdownRow(spec.label, parentList, spec.options, spec.get, spec.set)
        elseif rowType == "stateDropdown" then
            row, syncFn, label = createStateDropdownRow(spec.label, parentList, spec.options, spec.state, spec.key, spec.set or spec.setter)
        elseif rowType == "multi" then
            row, syncFn, label = createMultiSelectDropdownRow(spec.label, parentList, spec.options, spec.get, spec.set or spec.toggle, spec.getLabel)
        elseif rowType == "slider" then
            local updateFn, currentFn, rowLabel
            row, updateFn, currentFn, rowLabel, textBox = createSliderRow(spec.label, parentList, spec.value, spec.set, spec.get, spec.min, spec.max, spec.opts)
            label = rowLabel
            local sliderId = spec.id or spec.key or spec.label
            built.updateFns[sliderId] = updateFn
            if spec.sync == true then
                syncFn = createSliderSync(updateFn, spec.get)
            end
        elseif rowType == "syncedSlider" then
            row, syncFn = createSyncedSliderRow(spec.label, parentList, spec.value, spec.set, spec.get, spec.min, spec.max, spec.opts)
        elseif rowType == "button" then
            row = createButtonRow(spec.label, parentList, spec.set or spec.onClick, spec.opts)
        elseif rowType == "input" then
            row = createInputRow(spec.label, parentList, spec.get, spec.set, spec.placeholder)
        elseif rowType == "keyToggle" then
            row, syncFn, label = createToggleKeybindRow(spec.label, parentList, spec.accent, spec.get, spec.set or spec.onClick, spec.getKeyName, spec.setKey, spec.help)
        elseif rowType == "keyCapture" then
            row = createKeyCaptureRow(spec.label, parentList, spec.accent, spec.get, spec.setKey, spec.help)
        end
        local id = spec.id or spec.key or spec.label
        if id then
            built.rows[id] = row
            built.syncs[id] = syncFn
        end
        if syncFn and spec.noSync ~= true then
            table.insert(built.syncs, syncFn)
        end
        if type(spec.assign) == "function" then
            spec.assign(row, syncFn, label, textBox, built, context)
        end
        if type(spec.afterCreate) == "function" then
            spec.afterCreate(row, syncFn, label, textBox, built, context)
        end
    end
    return built
end
