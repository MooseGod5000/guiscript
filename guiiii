            if descendant.Name == "InventoryUI" or descendant.Name == "ScrollingFrame" or descendant.Name == "SlotTemplate" or descendant == cachedInventorySlotsFrame then
                cachedInventorySlotsFrame = nil
                refreshAutoSellDisplay()
            end
        end)

        localPlayer.PlayerGui.DescendantRemoving:Connect(function(descendant)
            if descendant.Name == "InventoryUI" or descendant.Name == "ScrollingFrame" or descendant.Name == "SlotTemplate" or descendant == cachedInventorySlotsFrame then
                cachedInventorySlotsFrame = nil
            end
        end)
    end

    if localPlayer and localPlayer.CharacterAdded then
        localPlayer.CharacterAdded:Connect(function(character)
            cachedCharacter = character
            cachedHumanoid = getHumanoid(character)
            cachedPickaxe = findPickaxe(character)
            cachedInventorySlotsFrame = nil
            task.defer(function()
                task.wait(0.35)
                if type(refreshPathDeathHopConnection) == "function" then
                    refreshPathDeathHopConnection()
                end
            end)
            local shouldResumeSavedSpawn = false
            local pendingSpawnSlotIndex = normalizePathSlotIndex(pathState.spawnPlaybackPendingSlotIndex)
            if pathState.spawnPlaybackAwaitingRespawn and type(pathState.spawnPlaybackPendingPathName) == "string" and pendingSpawnSlotIndex then
                if pathSlotMatchesResolvedPathName(pendingSpawnSlotIndex, pathState.spawnPlaybackPendingPathName) then
                    shouldResumeSavedSpawn = markPathSpawnPlaybackReady(
                        pathState.spawnPlaybackPendingPathName,
                        pathState.spawnPlaybackPendingSpawnName,
                        pendingSpawnSlotIndex
                    )
                else
                    cancelPendingPathSpawnPlayback(true)
                end
            end
            if autoMineEnabled or hasPlayerStateFeatureHooksEnabled() or shouldResumeSavedSpawn or type(pathState.spawnPlaybackReadyPathName) == "string" then
                task.wait(1)
                if shouldResumeSavedSpawn or type(pathState.spawnPlaybackReadyPathName) == "string" then
                    activeFarmMode = "path"
                    local ok, started = xpcall(function()
                        return tryResumeReadyPathSpawnPlayback("respawn")
                    end, debug.traceback)
                    if not ok then
                        autoMineEnabled = false
                        activeFarmMode = nil
                        setStatus("Path start failed", Color3.fromRGB(255, 130, 130))
                        pushDebug(started)
                    elseif not started then
                        if not (autoMineEnabled and activeFarmMode == "path") then
                            autoMineEnabled = false
                            activeFarmMode = nil
                        end
                    end
                elseif autoMineEnabled then
                    startAutoMine()
                end
                if hasPlayerStateFeatureHooksEnabled() then
                    ensurePlayerFeatureHooks()
                    syncAllUi()
                end
            end
        end)
    else
        startupWarn("LocalPlayer CharacterAdded unavailable; skipping Roblox character respawn hook")
    end

    task.spawn(function()
        while task.wait(1) do
            if type(refreshPathDeathHopConnection) == "function" and (isPathHopOnDeathEnabled() or pathDeathHopDiedConnection) then
                pcall(refreshPathDeathHopConnection)
            end
        end
    end)

    pcall(function()
        game:GetService("TeleportService").TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
            if player ~= localPlayer then
                return
            end
            serverHopInProgress = false
            serverHopTaskQueued = false
            pathState.playerAvoiderHopQueued = false
            setPathResumePlaybackPending(false, true)
            setServerHopStatus(
                "Hop failed: " .. tostring(errorMessage or teleportResult or "unknown"),
                Color3.fromRGB(255, 190, 120)
            )
            pushDebug("server hop teleport init failed: " .. tostring(errorMessage or teleportResult or "unknown"))
            refreshServerHopDisplay()
        end)
    end)

    loadPathsFromStorage()
    if type(scanCurrentSmartStaffDetection) == "function" then
        scanCurrentSmartStaffDetection("startup")
    end
    if serverHopEnabled then
        setServerHopStatus("After a path sell, it will try to hop into a smaller public server.", Color3.fromRGB(176, 167, 150))
    else
        setServerHopStatus("Off. Path sells stay in the current server.", Color3.fromRGB(176, 167, 150))
    end
    setTweenSpeed(tweenMoveSpeed)
    setCFrameFlyOffset(cframeFlyOffset)
    setCFrameFlyAngle(cframeFlyAngle)
    setUndergroundDepthOffset(undergroundDepthOffset)
    setUndergroundAngle(undergroundAngle)
    if type(refreshPathDeathHopConnection) == "function" then
        refreshPathDeathHopConnection()
    end
    setAutofarmSubTab("AutofarmSettings")
    setOreDropdownOpen(false)
    setMovementModeDropdownOpen(false)
    setPickupWhitelistDropdownOpen(false)
    safeUpdateAutofarmLayout()
    refreshButton()
    refreshTweenButton()
    refreshAuraButton()
    refreshAutoPickupButton()
    refreshPickaxeProgressionDisplay()
    refreshAutoSellDisplay()
    refreshServerHopDisplay()
    refreshPickupWhitelistDisplay()
    refreshOreSelectionDisplay()
    refreshPathManagerButtons()
    refreshPathEditorButtons()
    refreshPathVisuals()
    pushDebug("automine tab loaded")

    task.defer(function()
        ensurePathPlaybackAutostart("autoload")
    end)

    task.spawn(function()
        while hubGui.Parent and not destroyed and isSessionActive() do
            if tryPathTimePassServerHop(true) then
                task.wait(1)
            else
                ensurePathPlaybackAutostart("watchdog")
                task.wait(2)
            end
        end
    end)

    task.spawn(function()
        while hubGui.Parent and not destroyed and isSessionActive() do
            local character = cachedCharacter or getCustomCharacter()
            local humanoid = cachedHumanoid or getHumanoid(character)
            local rootPart = getRootPart(character)
            local now = os.clock()
            local horizontalSpeed = 0
            local displacementSpeed = 0
            local anchored = "?"
            local stateName = "nil"
            local walkSpeed = 0
            local moveDirectionMagnitude = 0
            local targetDistance = -1
            local oreHealth = "nil"

            if rootPart then
                anchored = tostring(rootPart.Anchored)
                horizontalSpeed = math.floor(Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z).Magnitude * 10 + 0.5) / 10
                if lastRootSamplePosition and lastRootSampleAt > 0 then
                    local dt = now - lastRootSampleAt
                    if dt > 0 then
                        displacementSpeed = math.floor(((rootPart.Position - lastRootSamplePosition).Magnitude / dt) * 10 + 0.5) / 10
                    end
                end
                lastRootSamplePosition = rootPart.Position
                lastRootSampleAt = now
            else
                lastRootSamplePosition = nil
                lastRootSampleAt = 0
            end

            if humanoid then
                walkSpeed = humanoid.WalkSpeed
                moveDirectionMagnitude = math.floor(humanoid.MoveDirection.Magnitude * 100 + 0.5) / 100
                local ok, state = pcall(function()
                    return humanoid:GetState()
                end)
                if ok and state then
                    stateName = state.Name
                end
            end

            if character and currentTargetOre then
                targetDistance = math.floor(getDistanceToOre(character, currentTargetOre) * 10 + 0.5) / 10
                oreHealth = formatOreHealthText(currentTargetOre, false)
            end

            if movementDebugLabel then
                pcall(function()
                    movementDebugLabel.Text = table.concat({
                        string.format("mode=%s aura=%s pickup=%s path=%s range=%.0f sprint=%s infstam=%s safetp=%s ts=%.0f fly=%.0f angle=%.0f ug=%.1f/%.0f", getMovementModeLabel(), tostring(mineAuraEnabled), tostring(autoPickupEnabled), tostring(pathState.playbackActive), mineAuraEnabled and MINE_AURA_RANGE or MINE_RANGE, tostring(movementKeyState[Enum.KeyCode.LeftShift]), tostring(playerState.infiniteStaminaEnabled), tostring(playerState.safeTeleportEnabled), tweenMoveSpeed, getCFrameFlyOffset(), getCFrameFlyAngle(), getUndergroundDepthOffset(), getUndergroundAngle()),
                        string.format("state=%s anchored=%s", stateName, anchored),
                        string.format("walkspeed=%.2f movedir=%.2f", walkSpeed, moveDirectionMagnitude),
                        string.format("vel=%.1f studs/s delta=%.1f", horizontalSpeed, displacementSpeed),
                        string.format("cmd=%s %.2f, %.2f, %.2f", lastMoveCommandSource, lastMoveCommand.X, lastMoveCommand.Y, lastMoveCommand.Z),
                        string.format("targetDist=%s oreHp=%s", targetDistance >= 0 and tostring(targetDistance) or "nil", oreHealth),
                    }, "\n")
                end)
            end

            if pathState.recording and pathState.editorVisible and character then
                local currentRoot = getRootPart(character)
                local recordPosition = currentRoot and getPathRecordNodePlacementPosition(currentRoot.Position, character) or nil
                if recordPosition and (not pathState.lastRecordedNodePosition or (recordPosition - pathState.lastRecordedNodePosition).Magnitude >= PATH_RECORD_NODE_SPACING) then
                    addWorkingPathNode(recordPosition, true)
                end
            end

            refreshAutoSellDisplay()
            refreshPathEditorButtons()
            task.wait(0.1)
        end
	end)
end

