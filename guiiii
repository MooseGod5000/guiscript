function isLikelyWindowGlassPart(instance)
    if not (instance and instance:IsA("BasePart")) then
        return false
    end
    if instance.Material == Enum.Material.Glass then
        return true
    end
    local loweredName = safeLower(instance.Name)
    if string.find(loweredName, "glass", 1, true) or string.find(loweredName, "window", 1, true) then
        return true
    end
    local parent = instance.Parent
    while parent and parent ~= workspace do
        local loweredParentName = safeLower(parent.Name)
        if string.find(loweredParentName, "glass", 1, true) or string.find(loweredParentName, "window", 1, true) then
            return true
        end
        parent = parent.Parent
    end
    return false
end
function appendBreakWindowCandidate(list, seen, instance)
    if typeof(instance) ~= "Instance" then
        return
    end
    if instance:IsA("BasePart") then
        if not seen[instance] then
            seen[instance] = true
            table.insert(list, instance)
        end
        return
    end
    if instance:IsA("Model") or instance:IsA("Folder") then
        for _, descendant in ipairs(instance:GetDescendants()) do
            if descendant:IsA("BasePart") and not seen[descendant] then
                seen[descendant] = true
                table.insert(list, descendant)
            end
        end
    end
end
function collectBreakWindowCandidatesFromTable(source, list, seenInstances, seenTables, depth)
    if not isTable(source) or (depth or 0) > 4 or seenTables[source] then
        return
    end
    seenTables[source] = true
    for key, value in pairs(source) do
        appendBreakWindowCandidate(list, seenInstances, key)
        appendBreakWindowCandidate(list, seenInstances, value)
        if isTable(value) then
            collectBreakWindowCandidatesFromTable(value, list, seenInstances, seenTables, (depth or 0) + 1)
        end
    end
end
function collectBreakWindowCandidates(breakableGlass)
    local list = {}
