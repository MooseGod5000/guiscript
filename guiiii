    return nil
end

local function getTwwMolotovTargetCFrame()
    local _, _, rootPart = getTwwMolotovTargetData()
    if not rootPart then
        return nil, false
    end

    local targetPosition = rootPart.Position + Vector3.new(0, 2.75, 0)
    local lookDirection = rootPart.CFrame.LookVector
    if lookDirection.Magnitude < 0.001 then
        lookDirection = Vector3.new(0, 0, -1)
    end
    return CFrame.new(targetPosition, targetPosition + lookDirection.Unit), true
end

local function getMolotovSpectateTargetData()
    local _, character, rootPart = getTwwMolotovTargetData()
    if not character then
        return nil
    end
    local humanoid = character:FindFirstChild("Humanoid") or character:FindFirstChildOfClass("Humanoid")
    local focusPart = character:FindFirstChild("Head") or character:FindFirstChild("UpperTorso") or rootPart or getTwwModelRoot(character)
    return character, humanoid, rootPart or getTwwModelRoot(character), focusPart
end

local function restoreMolotovSpectateCamera()
    if not S._molotovSpectateCameraActive then
        return
    end
    if S._molotovSpectateRenderConnection then
        S._molotovSpectateRenderConnection:Disconnect()
        S._molotovSpectateRenderConnection = nil
    end
    local camera = workspace.CurrentCamera
    if camera then
        local localCharacter = localPlayer and localPlayer.Character
        local humanoid = localCharacter and localCharacter:FindFirstChildOfClass("Humanoid")
        local rootPart = type(getRootPart) == "function" and getRootPart(localCharacter) or nil
        pcall(function()
            camera.CameraType = S._molotovSpectatePreviousType or Enum.CameraType.Custom
            camera.CameraSubject = S._molotovSpectatePreviousSubject or humanoid or rootPart or camera.CameraSubject
            if typeof(S._molotovSpectatePreviousCFrame) == "CFrame" then
                camera.CFrame = S._molotovSpectatePreviousCFrame
            end
        end)
    end
    S._molotovSpectatePreviousType = nil
    S._molotovSpectatePreviousSubject = nil
    S._molotovSpectatePreviousCFrame = nil
    S._molotovSpectateCameraActive = false
end

local function updateMolotovSpectateCamera()
    if not S.molotovSpectateEnabled then
        restoreMolotovSpectateCamera()
        return
    end
    local camera = workspace.CurrentCamera
    if not camera then
        restoreMolotovSpectateCamera()
        return
    end
    if not S._molotovSpectateCameraActive then
        S._molotovSpectatePreviousType = camera.CameraType
        S._molotovSpectatePreviousSubject = camera.CameraSubject
        S._molotovSpectatePreviousCFrame = camera.CFrame
    end
    if not S._molotovSpectateRenderConnection then
        S._molotovSpectateRenderConnection = _RunService.RenderStepped:Connect(function()
            if destroyed or not isSessionActive() then
                restoreMolotovSpectateCamera()
                return
            end
            if not S.molotovSpectateEnabled then
                restoreMolotovSpectateCamera()
                return
            end
            local liveCharacter, _, liveRootPart, liveFocusPart = getMolotovSpectateTargetData()
            if not liveCharacter or not liveRootPart then
                return
            end
            local liveCamera = workspace.CurrentCamera
            if not liveCamera then
                return
            end
            local focusPosition = (liveFocusPart or liveRootPart).Position + Vector3.new(0, 0.35, 0)
            local lookBack = liveRootPart.CFrame.LookVector
            if lookBack.Magnitude < 0.001 then
                lookBack = Vector3.new(0, 0, -1)
            end
            local cameraPosition = focusPosition - (lookBack.Unit * 9) + Vector3.new(0, 3.2, 0)
            pcall(function()
                liveCamera.CameraType = Enum.CameraType.Scriptable
                liveCamera.CFrame = CFrame.lookAt(cameraPosition, focusPosition)
                liveCamera.Focus = CFrame.new(focusPosition)
            end)
        end)
    end
    S._molotovSpectateCameraActive = true
end

