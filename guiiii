function buildDiscordAutomineEmbedFields(lines)
	local fields = {}
	if type(lines) ~= "table" then
		return fields
	end
	for _, item in ipairs(lines) do
		if #fields >= 25 then
			break
		end
		if type(item) == "table" then
			local name = truncateDiscordAutomineEmbedText(item.name or item[1] or "Info", 256)
			local value = truncateDiscordAutomineEmbedText(item.value or item[2] or "", 1024)
			table.insert(fields, {name = name, value = value, inline = item.inline == true,})
		else
			local text = tostring(item or "")
			if text ~= "" then
				local name, value = string.match(text, "^([^:]+):%s*(.*)$")
				if not name then
					name = "Info"
					value = text
				end
				table.insert(fields, {name = truncateDiscordAutomineEmbedText(name, 256), value = truncateDiscordAutomineEmbedText(value, 1024), inline = #tostring(value or "") <= 48,})
			end
		end
	end
	return fields
end
