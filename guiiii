if not AUTOMINE_ONLY_MODE then
    ensureLegendaryAnimalWatcher()
    if S.vfxAuraEnabled == true and type(ensureVfxAuraHooks) == "function" then
        ensureVfxAuraHooks()
    end
    if hasPlayerStateFeatureHooksEnabled() then
        ensurePlayerFeatureHooks()
    end
end
