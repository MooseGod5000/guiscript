function getPointSegmentClosestPoint(point, segmentStart, segmentEnd)
    if typeof(point) ~= "Vector3" or typeof(segmentStart) ~= "Vector3" or typeof(segmentEnd) ~= "Vector3" then
        return nil, math.huge
    end
    local segment = segmentEnd - segmentStart
    local lengthSquared = segment:Dot(segment)
    if lengthSquared <= 0.0001 then
        return segmentStart, (point - segmentStart).Magnitude
    end
    local alpha = math.clamp((point - segmentStart):Dot(segment) / lengthSquared, 0, 1)
    local closest = segmentStart + segment * alpha
    return closest, (point - closest).Magnitude
end
function getProjectileSegmentHitTime(projectile, segmentStart, segmentEnd, hitPosition)
    if not isTable(projectile)
        or typeof(segmentStart) ~= "Vector3"
        or typeof(segmentEnd) ~= "Vector3"
        or typeof(hitPosition) ~= "Vector3" then
        return nil
    end
    local currentTime = tonumber(projectile.CurrentTime)
    local updateTime = tonumber(projectile.UpdateTime)
    if not currentTime or not updateTime or updateTime <= 0 then
        return currentTime
    end
    local segment = segmentEnd - segmentStart
    local lengthSquared = segment:Dot(segment)
    if lengthSquared <= 0.0001 then
        return currentTime
    end
    local alpha = math.clamp((hitPosition - segmentStart):Dot(segment) / lengthSquared, 0, 1)
    local hitTime = currentTime - updateTime + (updateTime * alpha)
    local startTime = tonumber(projectile.StartTime)
    if startTime then
        hitTime = math.max(hitTime, startTime)
    end
    return math.min(hitTime, currentTime)
end
