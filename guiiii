end
function tryAdvanceToNextPathSequence(sourceLabel)
	if shouldDelayPathHopForSell() then
		setStatus("Waiting for sell before hopping", Color3.fromRGB(232, 184, 96))
		return false
	end
	local nextSlotIndex = getNextPlayablePathSlotIndex(pathState.playbackSlotIndex)
	if not nextSlotIndex then
		if (pathState.playLoopEnabled or pathState.alwaysPlayEnabled or pathState.farmPathsEnabled) and serverHopEnabled then
			return requestPathServerHop("Finding a smaller public server for the next path cycle...", getPathCycleRestartSlotIndex(), false)
		end
		if pathState.farmPathsEnabled then
			nextSlotIndex = getPlayablePathSlotIndex(1)
		end
	end
	if not nextSlotIndex then
		return false
	end
	local nextPathName, nextPathData = resolvePathSlotPlaybackPath(nextSlotIndex, {notify = false, loadProgression = true})
	if type(nextPathName) ~= "string" or not isTable(nextPathData) then
		return false
	end
	local nextSpawnName = resolvePathSpawnOptionValue(nextPathData.spawnName)
	if nextSpawnName then
		task.defer(function()
			if autoMineEnabled and activeFarmMode == "path" then
				stopAutoMine()
			end
			activeFarmMode = "path"
			local ok, started = xpcall(function()
				return startPathPlaybackForSlot(nextSlotIndex, sourceLabel or "sequence")
			end, debug.traceback)
			if not ok then
				autoMineEnabled = false
				activeFarmMode = nil
				setStatus("Path start failed", Color3.fromRGB(255, 130, 130))
				pushDebug(started)
			elseif not started then
				autoMineEnabled = false
				activeFarmMode = nil
				setStatus("Next path could not start", Color3.fromRGB(255, 190, 120))
			end
			if type(refreshPathManagerButtons) == "function" then
				refreshPathManagerButtons()
			end
		end)
		return true
	end
	pathState.playbackSlotIndex = nextSlotIndex
	setFocusedPathSlotIndex(nextSlotIndex, true)
	if beginPathPlayback() then
		setStatus("Following path " .. tostring(pathState.playbackPathName), Color3.fromRGB(120, 190, 255))
		if type(refreshPathManagerButtons) == "function" then
			refreshPathManagerButtons()
		end
		return true
	end
	return false
end
function getCurrentPathPlaybackNode()
	local currentPath = pathState.currentPath
	if not currentPath or #currentPath.nodes == 0 then
		return nil
	end
	if pathState.playbackNodeIndex < 1 or pathState.playbackNodeIndex > #currentPath.nodes then
		return nil
	end
	return currentPath.nodes[pathState.playbackNodeIndex]
end
function advancePathPlaybackNode()
	local currentPath = pathState.currentPath
	if not currentPath or #currentPath.nodes == 0 then
		pathState.playbackNodeIndex = 1
		return
	end
	local nextNodeIndex = (tonumber(pathState.playbackNodeIndex) or 1) + 1
	local disconnectAfterNodeIndex = getPathDisconnectAfterNodeIndex(currentPath)
	if disconnectAfterNodeIndex and nextNodeIndex > disconnectAfterNodeIndex then
		local reconnectNodeIndex = getPathReconnectNodeIndex(currentPath)
		if reconnectNodeIndex and reconnectNodeIndex > nextNodeIndex then
			nextNodeIndex = reconnectNodeIndex
		elseif not reconnectNodeIndex then
			pathState.playbackActive = false
			return
		end
	end
	pathState.playbackNodeIndex = nextNodeIndex
	if pathState.playbackNodeIndex > #currentPath.nodes then
		local sellHoldNodeIndex = getPathPlaybackSellHoldNodeIndex()
		if sellHoldNodeIndex then
			pathState.playbackNodeIndex = sellHoldNodeIndex
			pathState.playbackActive = true
			setStatus("Waiting for sell before hopping", Color3.fromRGB(232, 184, 96))
			return
		end
		pathState.playbackActive = false
	end
end
function isPathPlaybackSellReady()
	local lootSummary = getSellableLootSummary(false)
	if isTable(lootSummary) then
		local filledSlots = tonumber(rawget(lootSummary, "filledSlots") or lootSummary.filledSlots) or 0
		local totalSlots = tonumber(rawget(lootSummary, "totalSlots") or lootSummary.totalSlots) or 0
		lastInventoryFilledSlots = filledSlots
		lastInventoryTotalSlots = totalSlots
		return (rawget(lootSummary, "hasLoot") or lootSummary.hasLoot) == true
	end
	local filledSlots, totalSlots = getInventorySlotCounts()
	lastInventoryFilledSlots = filledSlots
	lastInventoryTotalSlots = totalSlots
	return totalSlots <= 0 or filledSlots > 0
end
function getPlayablePathOreForNode(currentPath, nodeIndex, nodePosition)
	local bestOreTarget = nil
	local bestResolvedOre = nil
	local bestDistance = nil
	for _, oreTarget in ipairs(currentPath.ores or {}) do
		if (oreTarget.nodeIndex or 0) == nodeIndex then
			local resolvedOre = resolveSavedOreTarget(oreTarget)
			if resolvedOre then
				local orePosition = getOrePosition(resolvedOre)
				local oreRemaining = getOreRemainingValue(resolvedOre)
				if orePosition and oreRemaining and oreRemaining.Value > 0 then
					local distance = (orePosition - nodePosition).Magnitude
					if distance <= MINE_AURA_RANGE and (not bestDistance or distance < bestDistance) then
						bestDistance = distance
						bestOreTarget = oreTarget
						bestResolvedOre = resolvedOre
					end
				end
			end
		end
	end
	return bestOreTarget, bestResolvedOre
end
function chooseSafePathEntryNode(character)
	if not (pathState.entryPathingPending == true and pathState.entrySafeNodeChosen ~= true and pathState.currentPath) then
		return false
	end
	local rootPart = getRootPart(character)
	if not rootPart then
		return false
	end
	local nodeIndex, nodeDistance, maxEntryNodeIndex = getClosestSafeEntryPlaybackPathNodeIndex(
		pathState.currentPath,
		rootPart.Position,
		pathState.entryRejectedNodeIndexes
	)
	if not nodeIndex then
		return false
	end
	pathState.playbackNodeIndex = nodeIndex
	pathState.entrySafeNodeChosen = true
	pathState.entryResyncTargetPosition = nil
	pushDebugRateLimited(
		"path_entry_safe_node",
		string.format(
			"entry path target -> node %d/%d (%.1f studs)",
			nodeIndex,
			tonumber(maxEntryNodeIndex) or nodeIndex,
			tonumber(nodeDistance) or -1
		),
		2
	)
	pushPathDebugRateLimited(
		"entry_choose",
		string.format(
			"chosen=%d maxSafe=%d rejected=%d root=%s node=%s",
			nodeIndex,
			tonumber(maxEntryNodeIndex) or nodeIndex,
			countPathDebugRejectedEntryNodes(),
			formatPathDebugVector3(rootPart.Position),
			formatPathDebugVector3(getPathNodePosition(pathState.currentPath.nodes[nodeIndex]))
		),
		1.5
	)
	return true
end
function rejectCurrentSafePathEntryNode(character, reason)
	if not (pathState.entryPathingPending == true and pathState.currentPath) then
		return false
	end
	local currentNodeIndex = normalizePathNodeIndex(pathState.playbackNodeIndex, #(pathState.currentPath.nodes or {}))
	if not currentNodeIndex then
		return false
	end
	pathState.entryRejectedNodeIndexes = type(pathState.entryRejectedNodeIndexes) == "table" and pathState.entryRejectedNodeIndexes or {}
	pathState.entryRejectedNodeIndexes[currentNodeIndex] = true
	pathState.entrySafeNodeChosen = false
	pathState.entryResyncTargetPosition = nil
	pathState.entryPathPoints = nil
	clearPathVisualization()
	local pickedNext = chooseSafePathEntryNode(character)
	if pickedNext then
		pushDebugRateLimited(
			"path_entry_reject_node",
			"entry path rejected node " .. tostring(currentNodeIndex) .. " (" .. tostring(reason or "blocked") .. "), trying node " .. tostring(pathState.playbackNodeIndex),
			1.5
		)
		pushPathDebugRateLimited(
			"entry_reject",
			"rejected=" .. tostring(currentNodeIndex) .. " reason=" .. tostring(reason or "blocked") .. " next=" .. tostring(pathState.playbackNodeIndex) .. " rejectedCount=" .. tostring(countPathDebugRejectedEntryNodes()),
			1
		)
		return true
	end
	pathState.entryRejectedNodeIndexes[currentNodeIndex] = nil
	pathState.entrySafeNodeChosen = true
	pathState.playbackNodeIndex = currentNodeIndex
	pushDebugRateLimited(
		"path_entry_reject_exhausted",
		"entry path had no alternate safe node after node " .. tostring(currentNodeIndex),
		2
	)
	pushPathDebugRateLimited(
		"entry_reject_exhausted",
		"node=" .. tostring(currentNodeIndex) .. " reason=" .. tostring(reason or "blocked") .. " root=" .. getPathDebugRootPositionText(character),
		1
	)
	return false
end
function runPathPlaybackStep(character, humanoid, pickaxe, activeToken)
	if not pathState.playbackActive and not beginPathPlayback() then
		return false
	end
	if humanoid and humanoid.Health <= 0 then
		setInteractKeyHeld(false)
		clearMovementKeys()
		task.wait(0.15)
		return true
	end
	local currentPath = pathState.currentPath
	if not currentPath or #currentPath.nodes == 0 then
		pathState.playbackActive = false
		setStatus("Selected path has no nodes", Color3.fromRGB(255, 190, 120))
		return false
	end
	if pathState.entryPathingPending == true and pathState.entrySafeNodeChosen ~= true then
		chooseSafePathEntryNode(character)
	end
	local entryJoinDistance = isCFrameMovementMode(movementMode)
		and getCFrameEntryJoinDistance()
		or (isUndergroundMovementMode(movementMode) and getUndergroundPathReachDistance())
		or WAYPOINT_REACH_DISTANCE
	local playbackReachDistance = isCFrameMovementMode(movementMode)
		and getCFramePathReachDistance()
		or (isUndergroundMovementMode(movementMode) and getUndergroundPathReachDistance())
		or math.max(1.8, WAYPOINT_REACH_DISTANCE * 0.6)
	local function getCurrentNodeDistance(position)
		local rootPart = getRootPart(character)
		if not rootPart or not position then
			return math.huge
		end
		if isCFrameMovementMode(movementMode) then
			local flyPathOffset = movementMode == "cframefly" and getCFrameFlyOffset() or 0
			return getCFramePathPlaybackDistance(character, rootPart, position, flyPathOffset, playbackReachDistance)
		end
		if isUndergroundMovementMode(movementMode) then
			return getUndergroundPathPlaybackDistance(rootPart, position, playbackReachDistance)
		end
		return (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(position.X, 0, position.Z)).Magnitude
	end
	local sellerPart, sellerPrompt, sellNodeIndex = getPathSellTarget(currentPath, false)
	local pathPickupOptions = {maxDistance = PICKUP_RANGE + 0.75, arriveRange = PICKUP_RANGE, requireAlreadyInReach = true,}
	local processedNodes = 0
	while processedNodes < #currentPath.nodes do
		local currentNode = getCurrentPathPlaybackNode()
		if not currentNode then
			pathState.playbackActive = false
			return false
		end
		local currentNodeIndex = pathState.playbackNodeIndex
		local currentNodePosition = getPathNodePosition(currentNode)
		if not currentNodePosition then
			advancePathPlaybackNode()
			processedNodes += 1
			continue
		end
		local currentOreTarget, resolvedOre = getPlayablePathOreForNode(currentPath, currentNodeIndex, currentNodePosition)
		local sellReady = isPathPlaybackSellReady()
		if sellReady then
			pathState.playbackSellPending = true
		end
		local isSellNode = sellNodeIndex and currentNodeIndex == sellNodeIndex
		if isSellNode and currentNodeIndex == #currentPath.nodes then
			pathState.playbackSellPending = true
		end
		local activeSellerPart = nil
		local activeSellerPrompt = nil
		local movementTargetPosition = currentNodePosition
		local requiredDistance = pathState.entryPathingPending and entryJoinDistance or playbackReachDistance
		if isSellNode then
			currentTargetOre = nil
			clearMovementKeys()
			setInteractKeyHeld(false)
			if pickaxe and pickaxe:IsA("Tool") and pickaxe.Parent == character then
				pcall(function()
					pickaxe:Deactivate()
				end)
			end
		end
		if isSellNode and pathState.playbackSellPending then
			activeSellerPart, activeSellerPrompt = findNearestAutoSellTarget(character, false)
			if not activeSellerPart then
				sellerPart, sellerPrompt, sellNodeIndex = getPathSellTarget(currentPath, true)
				activeSellerPart = sellerPart
				activeSellerPrompt = sellerPrompt
			end
		end
		local shouldSellHere = isSellNode and pathState.playbackSellPending and getCurrentNodeDistance(currentNodePosition) <= requiredDistance
		currentTargetOre = nil
		local entryResyncActive = pathState.entryPathingPending and typeof(pathState.entryResyncTargetPosition) == "Vector3"
		if entryResyncActive then
			movementTargetPosition = pathState.entryResyncTargetPosition
		end
		if entryResyncActive or getCurrentNodeDistance(movementTargetPosition) > requiredDistance then
			if processPathPlayerAvoidance(character, movementTargetPosition, activeToken, nil, humanoid, pickaxe) then
				return true
			end
			if not (isSellNode and pathState.playbackSellPending) and tryAutoPickup(character, humanoid, activeToken, pathPickupOptions) then
				return true
			end
			if isSellNode and pathState.playbackSellPending then
				setStatus("Moving to sell node", Color3.fromRGB(232, 184, 96))
			else
				setStatus("Following path " .. tostring(pathState.playbackPathName), Color3.fromRGB(120, 190, 255))
			end
			if not pathState.entryPathingPending then
				clearPathVisualization()
			end
			if pathState.entryPathingPending then
				pushPathDebugRateLimited(
					"entry_node_state",
					"node=" .. tostring(currentNodeIndex)
						.. "/" .. tostring(#currentPath.nodes)
						.. " resync=" .. tostring(entryResyncActive)
						.. " disconnected=" .. tostring(isPathNodeDisconnected(currentPath, currentNodeIndex))
						.. " ore=" .. tostring(currentOreTarget and currentOreTarget.groupName or "none")
						.. " sell=" .. tostring(isSellNode)
						.. " dist=" .. string.format("%.1f", getCurrentNodeDistance(movementTargetPosition))
						.. " range=" .. string.format("%.2f", tonumber(requiredDistance) or 0)
						.. " target=" .. formatPathDebugVector3(movementTargetPosition),
					1.2
				)
				local reachedTarget, moveReason = moveCharacterNearPosition(character, humanoid, movementTargetPosition, requiredDistance, activeToken)
				if not reachedTarget then
					pushPathDebugRateLimited(
						"entry_node_fail",
						"node=" .. tostring(currentNodeIndex)
							.. " reason=" .. tostring(moveReason or "none")
							.. " dist=" .. string.format("%.1f", getCurrentNodeDistance(movementTargetPosition))
							.. " root=" .. getPathDebugRootPositionText(character)
							.. " target=" .. formatPathDebugVector3(movementTargetPosition),
						0.8
					)
					if moveReason == "rubberband" then
						if not entryResyncActive and rejectCurrentSafePathEntryNode(character, "rubberband") then
							return true
						end
						handlePathPlaybackRubberBand(character, movementTargetPosition)
						return true
					end
					if not entryResyncActive and rejectCurrentSafePathEntryNode(character, moveReason or "blocked") then
						return true
					end
					if getCurrentNodeDistance(movementTargetPosition) > requiredDistance then
						return false
					end
				end
				if typeof(pathState.entryResyncTargetPosition) == "Vector3" then
					pathState.entryResyncTargetPosition = nil
					return true
				end
				pathState.entryPathingPending = false
				pathState.entrySafeNodeChosen = false
				pathState.entryRejectedNodeIndexes = nil
				pathState.entryPathPoints = nil
				clearPathVisualization()
			else
				local movedToNode, moveReason = moveTowardsRecordedPathNode(character, humanoid, movementTargetPosition, activeToken)
				if not movedToNode and moveReason == "rubberband" then
					handlePathPlaybackRubberBand(character, movementTargetPosition)
					return true
				end
				if not movedToNode then
					pushPathDebugRateLimited(
						"playback_node_fail",
						"node=" .. tostring(currentNodeIndex)
							.. " reason=" .. tostring(moveReason or "none")
							.. " dist=" .. string.format("%.1f", getCurrentNodeDistance(movementTargetPosition))
							.. " root=" .. getPathDebugRootPositionText(character)
							.. " target=" .. formatPathDebugVector3(movementTargetPosition),
						1
					)
				end
				return movedToNode
			end
		else
			pathState.entryPathingPending = false
			pathState.entrySafeNodeChosen = false
			pathState.entryRejectedNodeIndexes = nil
			pathState.entryPathPoints = nil
			pathState.entryResyncTargetPosition = nil
			clearPathVisualization()
			if shouldSellHere then
				if not activeSellerPart then
					sellerPart, sellerPrompt, sellNodeIndex = getPathSellTarget(currentPath, true)
					activeSellerPart = sellerPart
					activeSellerPrompt = sellerPrompt
				end
				if activeSellerPart then
					setStatus("Selling on path", Color3.fromRGB(232, 184, 96))
					clearMovementKeys()
					setInteractKeyHeld(false)
					if trySellLootNearTarget(activeSellerPart, activeSellerPrompt, character) then
						pathState.playbackSellPending = false
						if tryAdvanceToNextPathSequence("path-sequence") then
							return true
						end
						if tryServerHopAfterPathSell() then
							return true
						end
						advancePathPlaybackNode()
						return true
					end
					pushDebugRateLimited("path_sell_retry", "path sell: seller found but sell did not complete, retrying", 2)
					setStatus("Waiting for sell to complete", Color3.fromRGB(232, 184, 96))
					task.wait(0.25)
					return true
				else
					pushDebugRateLimited("path_sell_target_missing", "path sell node has no matched seller target", 3)
					setStatus("Waiting for sell target", Color3.fromRGB(255, 190, 120))
					task.wait(0.25)
					return true
				end
			end
			if isSellNode then
				if pathState.playbackSellPending then
					setStatus("Holding at sell node", Color3.fromRGB(232, 184, 96))
					task.wait(0.15)
					return true
				end
				advancePathPlaybackNode()
				processedNodes += 1
				continue
			end
			if currentOreTarget and resolvedOre then
				local avoidanceHandled, avoidReason = processPathPlayerAvoidance(
					character,
					currentNodePosition,
					activeToken,
					nil,
					humanoid,
					pickaxe
				)
				if avoidanceHandled then
					if avoidReason == "advance" then
						advancePathPlaybackNode()
					end
					return true
				end
				if waitForPathBearPreventionSafetyAtOre(character, activeToken) then
					return true
				end
				currentTargetOre = resolvedOre
				if tryAutoPickup(character, humanoid, activeToken, pathPickupOptions) then
					return true
				end
				setStatus(
					"Mining marked " .. getOreLabel(currentOreTarget.groupName) .. " (" .. formatOreHealthText(resolvedOre) .. ")",
					Color3.fromRGB(140, 220, 140)
				)
				local equipped = equipPickaxe(character, humanoid, pickaxe)
				if not equipped then
					setStatus("Equipping pickaxe", Color3.fromRGB(255, 190, 120))
					task.wait(0.08)
					return true
				end
				pickaxe = getEquippedPickaxe(character) or getStoredPickaxe(character) or pickaxe
				if pickaxe then
					cachedPickaxe = pickaxe
				end
				local mined, mineReason, mineWait = swingPickaxe(character, pickaxe, resolvedOre)
