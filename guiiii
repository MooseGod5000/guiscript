	local undergroundGoalPosition = undergroundPathMode and getUndergroundGoalPosition(targetPosition, character) or nil
	local arrivalTargetPosition = cframeGoalPosition or undergroundGoalPosition or targetPosition
	local arrivalDelta = arrivalTargetPosition - rootPart.Position
	local flatDelta = Vector3.new(arrivalDelta.X, 0, arrivalDelta.Z)
	local flatDistance = flatDelta.Magnitude
	local verticalDistance = math.abs(arrivalDelta.Y)
	local pathVerticalReachDistance = cframePathMode
		and getCFramePathVerticalReachDistance(pathReachDistance)
		or (undergroundPathMode and getUndergroundVerticalReachDistance(pathReachDistance))
		or math.huge
	if flatDistance <= pathReachDistance and verticalDistance <= pathVerticalReachDistance then
		clearMovementKeys()
		setLastMoveCommand(Vector3.zero, "PathArrived")
