    if type(isItemTypeLocked) == "function" then
        local okLocked, locked = pcall(isItemTypeLocked, playerData, itemType)
        if okLocked and locked then
            return false
        elseif not okLocked then
            return nil
        end
    end
    local isDefaultItem = rawget(itemData, "IsDefaultItem") or itemData.IsDefaultItem
    if not isDefaultItem then
        local itemId = rawget(itemData, "Id") or itemData.Id
        local loadoutContains = rawget(playerData, "LoadoutContains") or playerData.LoadoutContains
        if type(loadoutContains) ~= "function" then
            return nil
        end
        local okContains, contains = pcall(loadoutContains, playerData, itemId)
        if not okContains then
            return nil
        end
        if not contains then
            return false
        end
    end
    local defaultItems = rawget(self, "DefaultItems") or self.DefaultItems
    if isTable(defaultItems) then
        if itemData == defaultItems.SuperJailPickaxe and not self.SuperJailed then
            return false
        end
        local charState = rawget(self, "State") or self.State
        if itemData == defaultItems.Harmonica and not (isTable(charState) and charState.FortJailed) then
            return false
        end
    end
    return true
