function applyStoredStateToRuntime()
    if type(playerState) == "table" then
        syncPlayerStateBooleans()
        playerState.speedChangerValue = math.clamp(math.floor((tonumber(S.speedChangerValue) or PLAYER_SPEED_CHANGER_DEFAULT) + 0.5), PLAYER_SPEED_CHANGER_MIN, PLAYER_SPEED_CHANGER_MAX)
    end
    _G.__AutomineOnlyNoRecoilEnabled = S.noRecoilEnabled == true
    normalizeRuntimeBooleanSettings()
    S.playerEspMethods = clonePlayerEspMethods(S.playerEspMethods)
    S.npcEspMethods = cloneEspMethods(S.npcEspMethods)
    S.animalEspMethods = cloneEspMethods(S.animalEspMethods)
    S.specialEntityEspMethods = cloneEspMethods(S.specialEntityEspMethods)
    S.animalEspTypes = cloneAnimalEspTypes(S.animalEspTypes)
    S.specialEntityEspTypes = cloneSpecialEntityEspTypes(S.specialEntityEspTypes)
    if S.legendaryAnimalEspEnabled == true then
        S.specialEntityEspEnabled = true
        S.specialEntityEspTypes["Legendary animal"] = true
    end
    S.silentAimTargetPriority = cloneGunTargetPriority(S.silentAimTargetPriority)
    if type(S.keybinds) ~= "table" then
        S.keybinds = {}
    end
    if S.silentAimBodyTarget ~= "Torso" then
        S.silentAimBodyTarget = "Head"
    end
    if not table.find(GUN_AIM_MODE_ORDER, tostring(S.silentAimMode or "")) then
        S.silentAimMode = "FOV"
    end
    S.silentAimVisibilityCheck = S.silentAimVisibilityCheck == true
    if not table.find(GUN_FOV_SHAPE_ORDER, tostring(S.gunFovShape or "")) then
        S.gunFovShape = "Circle"
    end
    if not table.find(GUN_FOV_SHAPE_ORDER, tostring(S.tomahawkFovShape or "")) then
        S.tomahawkFovShape = "Circle"
    end
    S.lassoFastChargePercent = math.clamp(math.floor((tonumber(S.lassoFastChargePercent) or DEFAULTS.lassoFastChargePercent) + 0.5), 1, 100)
    S.speedChangerValue = math.clamp(math.floor((tonumber(S.speedChangerValue) or PLAYER_SPEED_CHANGER_DEFAULT) + 0.5), PLAYER_SPEED_CHANGER_MIN, PLAYER_SPEED_CHANGER_MAX)
    S.silentAimAccuracy = math.clamp(math.floor((tonumber(S.silentAimAccuracy) or DEFAULTS.silentAimAccuracy) + 0.5), 1, 100)
    if S.silentAimAccuracy == 50 then
        S.silentAimAccuracy = DEFAULTS.silentAimAccuracy
    end
    S.silentAimDistanceLimit = math.clamp(math.floor((tonumber(S.silentAimDistanceLimit) or 1000) + 0.5), 10, 20000)
    S.horseFlingTargetPart = normalizeHorseFlingTargetPart(S.horseFlingTargetPart)
    S.horseFlingPowerPercent = math.clamp(math.floor((tonumber(S.horseFlingPowerPercent) or DEFAULTS.horseFlingPowerPercent) + 0.5), 1, 100)
    if S.tpProjectileEnabled then
        S.fastProjectileEnabled = false
    end
    S.meleeAuraRange = math.clamp(math.floor((tonumber(S.meleeAuraRange) or DEFAULTS.meleeAuraRange) + 0.5), 1, 50)
    S.meleeTargetPriority = cloneGunTargetPriority(S.meleeTargetPriority)
    S.meleeBubbleTransparency = math.clamp(math.floor((tonumber(S.meleeBubbleTransparency) or DEFAULTS.meleeBubbleTransparency) + 0.5), 1, 100)
    S.meleeBubbleColor = cloneMeleeBubbleColor(S.meleeBubbleColor)
    if not table.find(MELEE_SWING_MODE_OPTIONS, tostring(S.meleeSwingMode or "")) then
        S.meleeSwingMode = S.meleeSilentSwingsEnabled == false and "Real swing" or "Silent swing"
