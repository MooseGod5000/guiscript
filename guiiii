    maxPlayers = Settings.Max_Players,
    minPlayers = Settings.Min_Players,
    oreQuality = analysis_server_ore_quality(runtime),
    inventoryQuality = analysis_inventory_quality(runtime),
  }
end

function ServerQuality.shouldHop(runtime, snapshot)
  snapshot = snapshot or ServerQuality.collect(runtime)
  if Settings.Join_Smallest then
    analysis_note('Join Smallest recovered near Min Players/Path Thickness/Path Name controls.')
  end
  if Settings.Check_Server_Quality and analysis_below_threshold(snapshot.oreQuality, Settings.Threshold) then
    return true, 'ore quality below threshold'
  end
  if Settings.Check_Entire_Server and analysis_inventory_low_value(snapshot.inventoryQuality) then
    return true, 'inventory/server quality check failed'
  end
  if Settings.Max_Players and snapshot.players > Settings.Max_Players then
    return true, 'too many players'
  end
  return false, 'server accepted'
end

function ServerQuality.planHop(runtime, reason)
  analysis_note('Teleport/server-hop execution is represented as evidence only; no live teleport call is emitted.')
  return analysis_server_hop_plan({
    reason = reason,
    joinSmallest = Settings.Join_Smallest,
    minPlayers = Settings.Min_Players,
    maxPlayers = Settings.Max_Players,
  })
end

function ServerQuality.beforeAutoMine(runtime)
  local snapshot = ServerQuality.collect(runtime)
  local hop, reason = ServerQuality.shouldHop(runtime, snapshot)
  if hop then
    return ServerQuality.planHop(runtime, reason)
  end
  return snapshot
end

