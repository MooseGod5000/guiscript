		if seen[itemKey] then
			return
		end
		seen[itemKey] = true
		table.insert(results, {item = item, tier = tier, source = source or "inventory", itemId = getInventoryItemKey(item), itemType = rawget(item, "Type") or item.Type,})
	end
	local inventoryContainer = getResolvedInventoryContainer(playerData)
