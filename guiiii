      local function checkPlayer(player)
          if player == _Players.LocalPlayer then return end
          task.spawn(function()
              local rank = 0
              local roleName = "Unknown"
              pcall(function()
                  rank = player:GetRankInGroup(_FOB_ADMIN_GROUP_ID)
