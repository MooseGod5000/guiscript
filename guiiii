local SectionTitleAliases = {
	["(unlabeled newSection L1207)"] = "Stats",
}

local function normalizeSectionTitle(sectionTitle)
	return SectionTitleAliases[sectionTitle] or sectionTitle
end

local function splitPipeLine(line)
	local parts = {}
	for part in string.gmatch(line, "([^|]+)") do
		table.insert(parts, part)
		if #parts >= 7 then
			break
		end
	end
	return parts
end

local function buildRecoveredPages()
	local pageMap = {}
	local sectionMap = {}
	for _, pageDef in ipairs(PageOrder) do
		local page = { id = pageDef.id, title = pageDef.title, sections = {} }
		pageMap[pageDef.id] = page
	end
	for line in string.gmatch(RecoveredSchemaRaw, "[^\r\n]+") do
		local parts = splitPipeLine(line)
		local pageTitle, sectionTitle, kind, key, label, confidence, sourceLine =
			parts[1], parts[2], parts[3], parts[4], parts[5], parts[6], tonumber(parts[7])
		sectionTitle = normalizeSectionTitle(sectionTitle)
		local page = pageMap[pageTitle]
		if page then
			local sectionKey = pageTitle .. "\0" .. sectionTitle
			local section = sectionMap[sectionKey]
			if not section then
				section = { title = sectionTitle, controls = {} }
				sectionMap[sectionKey] = section
				table.insert(page.sections, section)
			end
			table.insert(section.controls, {
				kind = kind,
				key = key ~= "" and key or nil,
				label = label,
				confidence = confidence,
				line = sourceLine,
			})
		end
	end
	for line in string.gmatch(RecoveredDisplayTextRaw, "[^\r\n]+") do
		local parts = splitPipeLine(line)
		local pageTitle, sectionTitle, displayKind, label, confidence, sourceLine =
			parts[1], normalizeSectionTitle(parts[2]), parts[3], parts[4], parts[5], tonumber(parts[6])
		local page = pageMap[pageTitle]
		if page then
			local sectionKey = pageTitle .. "\0" .. sectionTitle
			local section = sectionMap[sectionKey]
			if not section then
				section = { title = sectionTitle, controls = {} }
				sectionMap[sectionKey] = section
				table.insert(page.sections, section)
			end
			table.insert(section.controls, {
				kind = "label",
				displayKind = displayKind,
				label = label,
				confidence = confidence,
				line = sourceLine,
			})
		end
	end
	for _, page in pairs(pageMap) do
		table.sort(page.sections, function(a, b)
			local aLine = a.controls[1] and a.controls[1].line or math.huge
			local bLine = b.controls[1] and b.controls[1].line or math.huge
			return aLine < bLine
		end)
		for _, section in ipairs(page.sections) do
			table.sort(section.controls, function(a, b)
				return (a.line or math.huge) < (b.line or math.huge)
			end)
		end
	end
	local pages = {}
	for _, pageDef in ipairs(PageOrder) do
		table.insert(pages, pageMap[pageDef.id])
	end
	return pages
end

local RecoveredPages = buildRecoveredPages()

local function storageKeyForSpec(spec)
	if not spec.key then
		return nil
	end
	local current = Settings[spec.key]
	if spec.kind == "toggle" and current ~= nil and type(current) ~= "boolean" then
		return spec.key .. "_Toggle"
	end
	if spec.kind == "number" and current ~= nil and type(current) ~= "number" then
		return spec.key .. "_Value"
	end
	if (spec.kind == "text" or spec.kind == "keybind" or spec.kind == "dropdown" or spec.kind == "chipset")
		and current ~= nil
		and type(current) ~= "string"
	then
		return spec.key .. "_Text"
	end
	if spec.kind == "color" then
		if current ~= nil and type(current) ~= "string" then
			return spec.key .. "_Color"
		end
		return spec.key
	end
	return spec.key
end

local function defaultForSpec(spec)
	if spec.kind == "toggle" then
		return false
	end
	if spec.kind == "number" then
		return 0
	end
	if spec.kind == "color" then
		return "25,255,25"
	end
	return ""
end

for _, page in ipairs(RecoveredPages) do
	for _, section in ipairs(page.sections) do
		for _, spec in ipairs(section.controls) do
			spec.storageKey = storageKeyForSpec(spec)
			if spec.storageKey and Settings[spec.storageKey] == nil then
				Settings[spec.storageKey] = defaultForSpec(spec)
			end
		end
	end
end

