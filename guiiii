                               local targetPos = npcData.part.Position - Vector3.new(0, 5, 0)
                               if S.npcFarmMethod == "Tween" then
                                   -- Tween smoothly to the NPC
                                   local startCF = npcHoldCF or root.CFrame
                                   local dist = (startCF.Position - targetPos).Magnitude
                                   local tweenTime = math.clamp(dist / S.npcTweenSpeed, 0.3, 6)
                                   npcTweening = true
                                   local elapsed = 0
                                   local startPos = startCF.Position
                                   while elapsed < tweenTime and S.autofarmNpcEnabled and currentNpcTarget and isTargetAlive(currentNpcTarget) do
                                       elapsed = elapsed + task.wait()
                                       local alpha = math.min(elapsed / tweenTime, 1)
                                       local tweenedPos = startPos:Lerp(targetPos, alpha)
                                       npcHoldCF = CFrame.new(tweenedPos) * CFrame.Angles(math.pi / 2, 0, 0)
                                   end
                                   npcTweening = false
                               else
                                   -- Teleport instantly
                                   npcHoldCF = CFrame.new(targetPos) * CFrame.Angles(math.pi / 2, 0, 0)
                               end
                               -- Now the hold connection will auto-follow the NPC
                           end
                       end
                   end
               else
                   -- Player died: fully reset everything so it starts fresh on respawn
                   if npcSetupDone or currentNpcTarget or npcHoldCF then
                       cleanupNpcFarm()
                       npcSetupDone = false
                       npcTweening = false
                       if S.autoInvisNpcEnabled and S._invisEnabled then disableInvis() end
                   end
               end
           else
               cleanupNpcFarm()
               npcSetupDone = false
           end
           task.wait(0.3)
       end
   end)
   -- ======= EGG AUTOFARM MAIN LOOP ======= --
   -- Restructured to match NPC autofarm pattern: persistent hold connection,
   -- continuous tweening between targets, no re-dupe/invis unless player dies.
   task.spawn(function()
       local eggCurrentTarget = nil
       local eggSetupDone = false
       local eggHoldConn = nil -- persistent RenderStepped that holds character flat
       local eggHoldCF = nil -- the CFrame to hold (updated as we move/follow)
       local eggTweening = false -- true while actively tweening to a target
       local eggMode = nil -- "egg" or "general"
       local eggVoteDebounce = false
       -- Helper: check if we are on the Chocolate Kingdom map
       local function isChocolateKingdomMap()
           local config = workspace:FindFirstChild("Configuration")
           if not config then return false end
           local mapName = config:FindFirstChild("MapName")
           if not mapName then return false end
           return mapName.Value == "Chocolate Kingdom"
       end
       -- Helper: vote for Chocolate Kingdom
       local function voteChocolateKingdom()
           pcall(function()
               if _TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                   local channel = _TextChatService.TextChannels:FindFirstChild("RBXGeneral")
                   if channel then channel:SendAsync(":mapvote chocolate kingdom") end
               else
                   local legacyEvents = _ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
                   if legacyEvents and legacyEvents:FindFirstChild("SayMessageRequest") then
                       legacyEvents.SayMessageRequest:FireServer(":mapvote chocolate kingdom", "All")
                   end
               end
           end)
       end
       -- Helper: find the closest egg target (eggs + easter NPCs)
       -- Priority: Eggs (Blue/Pink/Yellow/Green) are preferred targets.
       -- Non-priority easter NPCs are only picked if they are closer than the closest egg.
       local function findEggTarget()
           local char = _Players.LocalPlayer.Character
           local root = char and char:FindFirstChild("HumanoidRootPart")
           if not root then return nil, nil end
           local unbreakable = workspace:FindFirstChild("Unbreakable")
           if not unbreakable then return nil, nil end
           -- Track closest priority egg and closest non-priority NPC separately
           local bestEgg = nil
           local bestEggPart = nil
           local bestEggDist = math.huge
           local bestNpc = nil
           local bestNpcPart = nil
           local bestNpcDist = math.huge
           -- Check priority eggs in Undead folder
           local undead = unbreakable:FindFirstChild("Undead")
           if undead then
               for _, eggName in ipairs({"Blue Egg", "Pink Egg", "Yellow Egg", "Green Egg"}) do
                   local egg = undead:FindFirstChild(eggName)
                   if egg and egg:IsA("Model") then
                       local hum = egg:FindFirstChildOfClass("Humanoid")
                       if hum and hum.Health > 0 then
                           local part = egg.PrimaryPart
                           if not part then
                               for _, pn in ipairs({"HumanoidRootPart", "Torso", "LowerTorso", "UpperTorso", "Head"}) do
                                   local f = egg:FindFirstChild(pn)
                                   if f and f:IsA("BasePart") then part = f break end
                               end
                           end
                           if part then
                               local dist = (root.Position - part.Position).Magnitude
                               if dist < bestEggDist then
                                   bestEggDist = dist
                                   bestEgg = egg
                                   bestEggPart = part
                               end
                           end
                       end
                   end
               end
           end
           -- Check non-priority easter NPCs in Characters folders (Human, Orc, Undead)
           local chars = unbreakable:FindFirstChild("Characters")
           if chars then
               for _, teamName in ipairs({"Human", "Orc", "Undead"}) do
                   local teamFolder = chars:FindFirstChild(teamName)
                   if teamFolder then
                       for _, npcName in ipairs({"Carrot Menace", "Bunny", "Easter Guardian"}) do
                           local npc = teamFolder:FindFirstChild(npcName)
                           if npc and npc:IsA("Model") then
                               local hum = npc:FindFirstChildOfClass("Humanoid")
                               if hum and hum.Health > 0 then
                                   local part = npc.PrimaryPart
                                   if not part then
                                       for _, pn in ipairs({"HumanoidRootPart", "Torso", "LowerTorso", "UpperTorso", "Head"}) do
                                           local f = npc:FindFirstChild(pn)
                                           if f and f:IsA("BasePart") then part = f break end
                                       end
                                   end
                                   if part then
                                       local dist = (root.Position - part.Position).Magnitude
                                       if dist < bestNpcDist then
                                           bestNpcDist = dist
                                           bestNpc = npc
                                           bestNpcPart = part
                                       end
                                   end
                               end
                           end
                       end
                   end
               end
           end
           -- Priority logic: prefer eggs, but pick non-priority NPC if it's closer
           if bestEgg then
               if bestNpc and bestNpcDist < bestEggDist then
                   return bestNpc, bestNpcPart
               end
               return bestEgg, bestEggPart
           end
           -- No eggs alive, fall back to closest NPC
           return bestNpc, bestNpcPart
       end
       -- Helper: find and return the part for the egg target (for follow updates)
       local function getTargetPart(target)
           if not target or not target.Parent then return nil end
           local hum = target:FindFirstChildOfClass("Humanoid")
           if not hum or hum.Health <= 0 then return nil end
           local part = target.PrimaryPart
           if not part then
               for _, pn in ipairs({"HumanoidRootPart", "Torso", "LowerTorso", "UpperTorso", "Head"}) do
                   local f = target:FindFirstChild(pn)
                   if f and f:IsA("BasePart") then part = f break end
               end
           end
           return part
       end
       -- Full cleanup: disconnects hold, resets all state
       local function cleanupEggFarm()
           if eggHoldConn then eggHoldConn:Disconnect() eggHoldConn = nil end
           eggHoldCF = nil
           eggTweening = false
           S.eggIsFollowing = false
           eggCurrentTarget = nil
           eggMode = nil
       end
       -- Shared setup: runs dupe + invis once, then returns
       local function doEggSetup()
           task.wait(1) -- wait for character to fully load
           local dupeFinished = true
           local invisFinished = true
           if S.eggAutoReorderEnabled and S.eggAutofarmEnabled then
               dupeFinished = false
               task.spawn(function()
                   spawnNotification("AutoDuping weapons...")
                   performReorder(S.eggAutoReorderAmount, function() return S.eggAutofarmEnabled end)
                   task.wait(1.5)
                   dupeFinished = true
               end)
           end
           if S.eggAutoInvisEnabled and S.eggAutofarmEnabled then
               invisFinished = false
               task.spawn(function()
                   if S._invisThread and not S._invisEnabled then
                       local clearWait = tick()
                       while S._invisThread and tick() - clearWait < 5 do
                           task.wait(0.2)
                       end
                   end
                   if not S._invisEnabled then
                       spawnNotification("Enabling Invis, please wait...")
                       enableInvis()
                   end
