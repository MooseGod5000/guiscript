function processGunProjectileRemote(remoteName, packedArgs)
    if remoteName ~= "InitProjectiles" then
        return packedArgs
    end
    if not (S.silentAimEnabled or S.fastProjectileEnabled or S.noSpreadEnabled) then
        return packedArgs
    end

    local gunItem, sharedData = getCurrentGunSharedData(false)
    if not sharedData then
        gunItem, sharedData = getCurrentGunSharedData(true)
    end

    local targetInfo = nil
    gunFeatureState.lastProjectileTravelTime = nil
    if S.silentAimEnabled then
        local hitRoll = math.random(1, 100)
        local hitChance = math.clamp(tonumber(S.silentAimAccuracy) or 50, 1, 100)
        if hitRoll <= hitChance then
            targetInfo = getSilentAimTargetInfo()
        end
        if not targetInfo and not (S.fastProjectileEnabled or S.noSpreadEnabled) then
            return packedArgs
        end
    end

    local appliedSilentAim = false
    local trackedFastProjectileEntry = nil
    for index = 1, packedArgs.n do
        if isTable(packedArgs[index]) then
            local projectileEntries = collectProjectileEntries(packedArgs[index], 0, {}, {})
            for _, projectileEntry in ipairs(projectileEntries) do
                local projectileType = getCurrentProjectileType(projectileEntry)
                local silentAimChanged = false

                if targetInfo then
                    silentAimChanged = applySilentAimToProjectileEntry(projectileEntry, targetInfo, projectileType, sharedData)
                    appliedSilentAim = appliedSilentAim or silentAimChanged
                end

                if S.fastProjectileEnabled then
                    applyFastProjectileToEntry(projectileEntry, targetInfo)
                    if not trackedFastProjectileEntry and targetInfo and silentAimChanged then
                        trackedFastProjectileEntry = projectileEntry
                    end
                end

                if S.noSpreadEnabled and not silentAimChanged then
                    applyNoSpreadToProjectileEntry(projectileEntry, projectileType, sharedData)
                end
            end
        end
    end

    if S.fastProjectileEnabled and targetInfo and appliedSilentAim and trackedFastProjectileEntry and packedArgs[3] ~= nil then
        scheduleFastProjectileFinalEvent(targetInfo, trackedFastProjectileEntry, packedArgs[3])
    end

    if targetInfo and appliedSilentAim then
        gunFeatureState.currentTargetInfo = targetInfo
    elseif not hasGunAimVisualsEnabled() then
        gunFeatureState.currentTargetInfo = nil
    end

    return packedArgs
end

function hideGunAimDrawings()
    local drawings = {
        gunFeatureState.fovCircle,
        gunFeatureState.fovSquare,
        gunFeatureState.snapline,
        gunFeatureState.lassoSnapline,
    }
    for _, drawingObject in ipairs(drawings) do
        if drawingObject then
            drawingObject.Visible = false
        end
    end
    for _, line in ipairs(gunFeatureState.fovPolygonLines or {}) do
        if line then
            line.Visible = false
        end
    end
end

function clearGunAimDrawings()
    hideGunAimDrawings()

    if gunFeatureState.renderConnection then
        gunFeatureState.renderConnection:Disconnect()
        gunFeatureState.renderConnection = nil
    end

    local drawings = {
        "fovCircle",
        "fovSquare",
        "snapline",
        "lassoSnapline",
    }
    for _, key in ipairs(drawings) do
        local drawingObject = gunFeatureState[key]
        if drawingObject then
            pcall(function()
                drawingObject:Remove()
            end)
        end
        gunFeatureState[key] = nil
    end

    if type(gunFeatureState.fovPolygonLines) == "table" then
        for _, line in ipairs(gunFeatureState.fovPolygonLines) do
            if line then
                pcall(function()
                    line:Remove()
                end)
            end
        end
    end
    gunFeatureState.fovPolygonLines = {}
    gunFeatureState.currentTargetInfo = nil
    gunFeatureState.currentLassoTargetInfo = nil
end

function ensureGunAimDrawings()
    if type(Drawing) ~= "table" or type(Drawing.new) ~= "function" then
        if not gunFeatureState.warnedAimUnavailable then
            gunFeatureState.warnedAimUnavailable = true
            spawnNotification("Drawing API unavailable. Aim visuals could not start.", "warning", true)
        end
        return false
    end

    if not gunFeatureState.fovCircle then
        gunFeatureState.fovCircle = Drawing.new("Circle")
        gunFeatureState.fovCircle.Filled = false
        gunFeatureState.fovCircle.Thickness = 1.6
        gunFeatureState.fovCircle.Color = Color3.new(1, 1, 1)
        gunFeatureState.fovCircle.Visible = false
    end

    if not gunFeatureState.fovSquare then
        gunFeatureState.fovSquare = Drawing.new("Square")
        gunFeatureState.fovSquare.Filled = false
        gunFeatureState.fovSquare.Thickness = 1.6
        gunFeatureState.fovSquare.Color = Color3.new(1, 1, 1)
        gunFeatureState.fovSquare.Visible = false
    end

    if not gunFeatureState.snapline then
        gunFeatureState.snapline = Drawing.new("Line")
        gunFeatureState.snapline.Thickness = 1.5
        gunFeatureState.snapline.Color = Color3.new(1, 1, 1)
        gunFeatureState.snapline.Visible = false
    end

    if not gunFeatureState.lassoSnapline then
        gunFeatureState.lassoSnapline = Drawing.new("Line")
        gunFeatureState.lassoSnapline.Thickness = 1.5
        gunFeatureState.lassoSnapline.Color = Color3.new(1, 1, 1)
        gunFeatureState.lassoSnapline.Visible = false
    end

    if type(gunFeatureState.fovPolygonLines) ~= "table" then
        gunFeatureState.fovPolygonLines = {}
    end
    while #gunFeatureState.fovPolygonLines < 6 do
        local polygonLine = Drawing.new("Line")
        polygonLine.Thickness = 1.6
        polygonLine.Color = Color3.new(1, 1, 1)
        polygonLine.Visible = false
        table.insert(gunFeatureState.fovPolygonLines, polygonLine)
    end

    return true
end

function getGunFovPolygonSides(shapeName)
    local shape = tostring(shapeName or "Circle")
    if shape == "Triangle" then
        return 3
    end
    if shape == "Hexagon" then
        return 6
    end
    return 0
end

function updateGunAimVisuals()
    if not hasGunAimVisualsEnabled() then
        hideGunAimDrawings()
        gunFeatureState.currentTargetInfo = nil
        gunFeatureState.currentLassoTargetInfo = nil
        return
    end
    if not ensureGunAimDrawings() then
        return
    end

    local cursor = getGunAimCursorPosition()
    local radius = math.clamp(tonumber(S.gunFovRadius) or 200, 10, 2000)
    local shapeName = tostring(S.gunFovShape or "Circle")
    local targetInfo = S.silentAimEnabled and getSilentAimTargetInfo() or nil
    local lassoTargetInfo = (S.lassoSilentAimEnabled and S.lassoSnaplineEnabled) and getLassoSilentAimTargetInfo() or nil
    gunFeatureState.currentTargetInfo = targetInfo
    gunFeatureState.currentLassoTargetInfo = lassoTargetInfo

    hideGunAimDrawings()

    if S.gunFovEnabled then
        if shapeName == "Square" and gunFeatureState.fovSquare then
            gunFeatureState.fovSquare.Position = Vector2.new(cursor.X - radius, cursor.Y - radius)
            gunFeatureState.fovSquare.Size = Vector2.new(radius * 2, radius * 2)
            gunFeatureState.fovSquare.Color = Color3.new(1, 1, 1)
            gunFeatureState.fovSquare.Visible = true
        else
            local polygonSides = getGunFovPolygonSides(shapeName)
            if polygonSides > 0 then
                local startAngle = -math.pi * 0.5
                local points = {}
                for index = 1, polygonSides do
                    local angle = startAngle + ((index - 1) * (math.pi * 2 / polygonSides))
                    points[index] = Vector2.new(
                        cursor.X + math.cos(angle) * radius,
                        cursor.Y + math.sin(angle) * radius
                    )
                end
                for index, line in ipairs(gunFeatureState.fovPolygonLines) do
                    if line and index <= polygonSides then
                        local nextIndex = (index % polygonSides) + 1
                        line.From = points[index]
                        line.To = points[nextIndex]
                        line.Color = Color3.new(1, 1, 1)
                        line.Visible = true
                    elseif line then
                        line.Visible = false
                    end
                end
            elseif gunFeatureState.fovCircle then
                gunFeatureState.fovCircle.Position = cursor
                gunFeatureState.fovCircle.Radius = radius
                gunFeatureState.fovCircle.Color = Color3.new(1, 1, 1)
                gunFeatureState.fovCircle.NumSides = 64
                gunFeatureState.fovCircle.Visible = true
            end
        end
    end

    if S.gunSnaplineEnabled and targetInfo and gunFeatureState.snapline then
        gunFeatureState.snapline.From = cursor
        gunFeatureState.snapline.To = targetInfo.screenPosition
        gunFeatureState.snapline.Color = Color3.new(1, 1, 1)
        gunFeatureState.snapline.Visible = true
    end

    if S.lassoSilentAimEnabled and S.lassoSnaplineEnabled and lassoTargetInfo and gunFeatureState.lassoSnapline then
        gunFeatureState.lassoSnapline.From = cursor
        gunFeatureState.lassoSnapline.To = lassoTargetInfo.screenPosition
        gunFeatureState.lassoSnapline.Color = Color3.new(1, 1, 1)
        gunFeatureState.lassoSnapline.Visible = true
    end
end

function ensureGunAimRenderLoop()
    if not hasGunAimVisualsEnabled() then
        clearGunAimDrawings()
        return
    end
    if gunFeatureState.renderConnection then
        return
    end

    gunFeatureState.renderConnection = _RunService.RenderStepped:Connect(function()
        if destroyed or not isSessionActive() or not hasGunAimVisualsEnabled() then
            clearGunAimDrawings()
            return
        end
        updateGunAimVisuals()
    end)
end

function restoreEquipWhileSwimmingHooks()
    local owner = playerState.hookedSwimOwner
    if isTable(owner) then
        if playerState.originalSwimCanSwitchToItem and owner.CanSwitchToItem == playerState.swimCanSwitchWrapper then
            owner.CanSwitchToItem = playerState.originalSwimCanSwitchToItem
        end
        if playerState.originalSwimUpdate and owner.Update == playerState.swimUpdateWrapper then
            owner.Update = playerState.originalSwimUpdate
        end
        pcall(function()
            local human = rawget(owner, "Human") or owner.Human
            if human and type(human.SetStateEnabled) == "function" then
                human:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
            end
        end)
    end

    local sharedUtils = playerState.hookedWaterSharedUtils
    if isTable(sharedUtils)
        and playerState.originalWaterIsInWater
        and sharedUtils.IsInWater == playerState.waterIsInWaterWrapper then
        sharedUtils.IsInWater = playerState.originalWaterIsInWater
    end

    playerState.hookedSwimOwner = nil
    playerState.originalSwimCanSwitchToItem = nil
    playerState.swimCanSwitchWrapper = nil
    playerState.originalSwimUpdate = nil
    playerState.swimUpdateWrapper = nil
    playerState.hookedWaterSharedUtils = nil
    playerState.originalWaterIsInWater = nil
    playerState.waterIsInWaterWrapper = nil
    playerState.waterLogicSwimmingDisabledOwner = nil
end

function hasWaterFeatureHooksEnabled()
    return playerState.equipWhileSwimmingEnabled
        or playerState.infiniteOxygenEnabled
        or playerState.disableWaterLogicEnabled
end

function resolveSharedUtilsModule(forceRefresh)
    local globalModule = getAutoMineGlobalModule(forceRefresh)
    if not isTable(globalModule) then
        return nil
    end

    local sharedUtils = rawget(globalModule, "SharedUtils") or globalModule.SharedUtils
    if isTable(sharedUtils) and type(rawget(sharedUtils, "IsInWater") or sharedUtils.IsInWater) == "function" then
        return sharedUtils
    end

    if type(globalModule.LoadModule) == "function" then
        local okLoad, loadedSharedUtils = pcall(function()
            return globalModule:LoadModule("SharedUtils")
        end)
        if okLoad and isTable(loadedSharedUtils) and type(rawget(loadedSharedUtils, "IsInWater") or loadedSharedUtils.IsInWater) == "function" then
            globalModule.SharedUtils = loadedSharedUtils
            return loadedSharedUtils
        end
    end

    return nil
end

function setInfiniteOxygenState(owner)
    if not (playerState.infiniteOxygenEnabled or playerState.disableWaterLogicEnabled) then
        return
    end

    local oxygenValue = 100
    if isTable(owner) and isTable(owner.State) then
        pcall(function()
            rawset(owner.State, "Underwater", oxygenValue)
        end)
    end

    local replicatedState = resolveGlobalReplicatedState(false) or resolveGlobalReplicatedState(true)
    if isTable(replicatedState) then
        if type(replicatedState.LocalSetState) == "function" then
            pcall(function()
                replicatedState:LocalSetState("Underwater", oxygenValue)
            end)
        end
        local state = rawget(replicatedState, "State") or replicatedState.State
        if isTable(state) then
            pcall(function()
                rawset(state, "Underwater", oxygenValue)
            end)
        end
    end
end

function applyDisableWaterLogicState(owner)
    if not (playerState.disableWaterLogicEnabled and isTable(owner)) then
        return
    end

    owner.Swimming = false
    local swimForce = rawget(owner, "SwimForce") or owner.SwimForce
    if swimForce then
        pcall(function()
            swimForce.Enabled = false
        end)
        pcall(function()
            swimForce:Destroy()
        end)
        owner.SwimForce = nil
    end
    local swimAtt = rawget(owner, "SwimAtt") or owner.SwimAtt
    if swimAtt then
        pcall(function()
            swimAtt:Destroy()
        end)
        owner.SwimAtt = nil
    end

    local human = rawget(owner, "Human") or owner.Human
    if human then
        pcall(function()
            human:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
        end)
        playerState.waterLogicSwimmingDisabledOwner = owner
        pcall(function()
            if human:GetState() == Enum.HumanoidStateType.Swimming then
                human:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
    end
end

function restoreDisableWaterLogicState(owner)
    local targetOwner = isTable(owner) and owner or playerState.waterLogicSwimmingDisabledOwner
    if not isTable(targetOwner) then
        playerState.waterLogicSwimmingDisabledOwner = nil
        return
    end

    local human = rawget(targetOwner, "Human") or targetOwner.Human
    if human and type(human.SetStateEnabled) == "function" then
        pcall(function()
            human:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
        end)
    end
    if targetOwner == playerState.waterLogicSwimmingDisabledOwner then
        playerState.waterLogicSwimmingDisabledOwner = nil
    end
end

function ensureWaterSharedUtilsHook()
    if not playerState.disableWaterLogicEnabled then
        local sharedUtils = playerState.hookedWaterSharedUtils
        if isTable(sharedUtils)
            and playerState.originalWaterIsInWater
            and sharedUtils.IsInWater == playerState.waterIsInWaterWrapper then
            sharedUtils.IsInWater = playerState.originalWaterIsInWater
        end
        playerState.hookedWaterSharedUtils = nil
        playerState.originalWaterIsInWater = nil
        playerState.waterIsInWaterWrapper = nil
        return
    end

    local sharedUtils = resolveSharedUtilsModule(false) or resolveSharedUtilsModule(true)
    if not isTable(sharedUtils) then
        return
    end

    local isInWater = rawget(sharedUtils, "IsInWater") or sharedUtils.IsInWater
    if type(isInWater) ~= "function" then
        return
    end
    if sharedUtils ~= playerState.hookedWaterSharedUtils or isInWater ~= playerState.waterIsInWaterWrapper then
        local previous = playerState.hookedWaterSharedUtils
        if isTable(previous)
            and playerState.originalWaterIsInWater
            and previous.IsInWater == playerState.waterIsInWaterWrapper then
            previous.IsInWater = playerState.originalWaterIsInWater
        end
        playerState.hookedWaterSharedUtils = sharedUtils
        playerState.originalWaterIsInWater = isInWater
        playerState.waterIsInWaterWrapper = function(...)
            if playerState.disableWaterLogicEnabled then
                return false
            end
            return playerState.originalWaterIsInWater(...)
        end
        sharedUtils.IsInWater = playerState.waterIsInWaterWrapper
    end
end

function ensureEquipWhileSwimmingHooks()
    if not hasWaterFeatureHooksEnabled() then
        return
    end

    local owner = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
    if not isTable(owner) then
        return
    end
    if owner ~= playerState.hookedSwimOwner then
        restoreEquipWhileSwimmingHooks()
        playerState.hookedSwimOwner = owner
    end

    local canSwitch = rawget(owner, "CanSwitchToItem") or owner.CanSwitchToItem
    if type(canSwitch) == "function" and canSwitch ~= playerState.swimCanSwitchWrapper then
        playerState.originalSwimCanSwitchToItem = canSwitch
        playerState.swimCanSwitchWrapper = function(self, ...)
            if (playerState.equipWhileSwimmingEnabled or playerState.disableWaterLogicEnabled) and type(self) == "table" then
                self.Swimming = false
            end
            return playerState.originalSwimCanSwitchToItem(self, ...)
        end
        owner.CanSwitchToItem = playerState.swimCanSwitchWrapper
    end

    local updateFn = rawget(owner, "Update") or owner.Update
    if type(updateFn) == "function" and updateFn ~= playerState.swimUpdateWrapper then
        playerState.originalSwimUpdate = updateFn
        playerState.swimUpdateWrapper = function(self, ...)
            if hasWaterFeatureHooksEnabled() and type(self) == "table" then
                if playerState.equipWhileSwimmingEnabled or playerState.disableWaterLogicEnabled then
                    self.Swimming = false
                end
                setInfiniteOxygenState(self)
                applyDisableWaterLogicState(self)
                if not playerState.disableWaterLogicEnabled then
                    restoreDisableWaterLogicState(self)
                end
            end
            local results = table.pack(playerState.originalSwimUpdate(self, ...))
            if hasWaterFeatureHooksEnabled() and type(self) == "table" then
                if playerState.equipWhileSwimmingEnabled or playerState.disableWaterLogicEnabled then
                    self.Swimming = false
                end
                setInfiniteOxygenState(self)
                applyDisableWaterLogicState(self)
                if not playerState.disableWaterLogicEnabled then
                    restoreDisableWaterLogicState(self)
                end
            end
            return table.unpack(results, 1, results.n)
        end
        owner.Update = playerState.swimUpdateWrapper
    end

    setInfiniteOxygenState(owner)
    applyDisableWaterLogicState(owner)
    if not playerState.disableWaterLogicEnabled then
        restoreDisableWaterLogicState(owner)
    end
    ensureWaterSharedUtilsHook()
end

function setNoRecoilGuardState(isEnabled)
