function placeableMiscLoadModule(moduleName, forceRefresh)
	if type(getWestwareGlobalModule) ~= "function" then
		return nil
	end
	local globalModule = getWestwareGlobalModule(forceRefresh)
	if not isTable(globalModule) then
		return nil
	end
	local cached = rawget(globalModule, moduleName) or globalModule[moduleName]
	if isTable(cached) then
		return cached
	end
	if type(globalModule.LoadModule) == "function" then
		local okLoad, loaded = pcall(function()
			return globalModule:LoadModule(moduleName)
		end)
		if okLoad and isTable(loaded) then
			globalModule[moduleName] = loaded
			return loaded
		end
	end
	return nil
end
function placeableMiscResolvePlaceModule(forceRefresh)
	local placeModule = placeableMiscLoadModule("PlaceItem", forceRefresh)
	if isTable(placeModule)
		and type(placeModule.StartPlacingItem) == "function"
		and type(placeModule.AttemptToPlace) == "function" then
		PLACEABLE_ITEM_MISC.placeModule = placeModule
		return placeModule
	end
	return nil
end
function placeableMiscResolvePlaceableClass(forceRefresh)
	local placeableClass = placeableMiscLoadModule("PlaceableItemType", forceRefresh)
	if isTable(placeableClass) and type(placeableClass.PlaceItem) == "function" then
		PLACEABLE_ITEM_MISC.placeableClass = placeableClass
		return placeableClass
	end
	return nil
end
function placeableMiscResolveSharedUtils(forceRefresh)
	local sharedUtils = placeableMiscLoadModule("SharedUtils", forceRefresh)
	if isTable(sharedUtils) and type(sharedUtils.CanPlaceItem) == "function" then
		PLACEABLE_ITEM_MISC.sharedUtils = sharedUtils
		return sharedUtils
	end
	if type(resolveSharedUtilsModule) == "function" then
		sharedUtils = resolveSharedUtilsModule(forceRefresh)
		if isTable(sharedUtils) and type(sharedUtils.CanPlaceItem) == "function" then
			PLACEABLE_ITEM_MISC.sharedUtils = sharedUtils
			return sharedUtils
		end
	end
	return nil
end
function placeableMiscGetPlayerCharacter(forceRefresh)
	local globalModule = type(getWestwareGlobalModule) == "function" and getWestwareGlobalModule(forceRefresh) or nil
	if isTable(globalModule) then
		local playerCharacter = rawget(globalModule, "PlayerCharacter") or globalModule.PlayerCharacter
		if isTable(playerCharacter) then
			return playerCharacter
