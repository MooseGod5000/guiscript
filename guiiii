function stepTwwSpectateZoomSpring(spec, dt)
    local minDistance = 3
    local maxDistance = 24
    local goal = math.clamp(tonumber(S[spec.targetDistanceKey]) or tonumber(S[spec.distanceKey]) or 8, minDistance, maxDistance)
    local currentDistance = math.clamp(tonumber(S[spec.distanceKey]) or goal, minDistance, maxDistance)
    local currentVelocity = tonumber(S[spec.zoomVelocityKey]) or 0
    local stepDt = math.max(tonumber(dt) or 0, 1 / 240)
    local omega = 4.5 * 2 * math.pi
    local distanceDelta = goal - currentDistance
    local omegaDt = omega * stepDt
    local decay = math.exp(-omegaDt)
    local nextDistance = goal + (currentVelocity * stepDt - distanceDelta * (omegaDt + 1)) * decay
    local nextVelocity = ((distanceDelta * omega - currentVelocity) * omegaDt + currentVelocity) * decay
    if nextDistance < minDistance then
        nextDistance = minDistance
        nextVelocity = 0
    elseif nextDistance > maxDistance then
        nextDistance = maxDistance
        nextVelocity = 0
    end
    S[spec.distanceKey] = nextDistance
    S[spec.zoomVelocityKey] = nextVelocity
    return nextDistance
end
function resolveTwwSpectatePopper(spec, camera, desiredCFrame, focusPosition, targetCharacter)
    if not (camera and desiredCFrame and typeof(focusPosition) == "Vector3") then
        return desiredCFrame
    end
    local desiredDistance = (desiredCFrame.Position - focusPosition).Magnitude
    local cutoff = 0
    pcall(function()
        camera.CFrame = desiredCFrame
        camera.Focus = CFrame.new(focusPosition)
        cutoff = tonumber(camera:GetLargestCutoffDistance(buildTwwSpectateIgnoreList(targetCharacter))) or 0
    end)
    if math.abs(desiredDistance - (tonumber(S[spec.lastZoomLevelKey]) or 0)) > 0.001 then
        S[spec.lastPopAmountKey] = 0
    end
    local lastPopAmount = tonumber(S[spec.lastPopAmountKey]) or 0
    if cutoff < lastPopAmount then
        cutoff = lastPopAmount
    end
    if cutoff > 0 then
        desiredCFrame = desiredCFrame + desiredCFrame.LookVector * cutoff
        S[spec.lastPopAmountKey] = math.max(cutoff - 0.3, 0)
    else
        S[spec.lastPopAmountKey] = 0
    end
    S[spec.lastZoomLevelKey] = desiredDistance
    return desiredCFrame
end
