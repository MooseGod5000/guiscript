            registry[camModule] = nil
        else
            if gunFeatureState.originalCamAddRecoil and camModule.AddRecoil == gunFeatureState.camAddRecoilWrapper then
                camModule.AddRecoil = gunFeatureState.originalCamAddRecoil
            end
            if gunFeatureState.originalCamVibrate and camModule.Vibrate == gunFeatureState.camVibrateWrapper then
                camModule.Vibrate = gunFeatureState.originalCamVibrate
            end
        end
    end

    gunFeatureState.hookedCamModule = nil
    gunFeatureState.originalCamAddRecoil = nil
    gunFeatureState.camAddRecoilWrapper = nil
    gunFeatureState.originalCamVibrate = nil
    gunFeatureState.camVibrateWrapper = nil
