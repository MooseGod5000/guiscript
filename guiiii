	for index = #MONEY_BAG_MISC.selectedEntries, 1, -1 do
		local entry = MONEY_BAG_MISC.selectedEntries[index]
		if not (entry and entry.part and entry.part.Parent) then
			moneyBagMiscRemoveEntry(entry)
		else
			if now - (tonumber(entry.lastCheckAt) or 0) > 1.25 then
