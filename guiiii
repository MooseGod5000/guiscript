				.. " dist=" .. getPathDebugDistanceText(rootPart.Position, targetPosition)
				.. " range=" .. string.format("%.2f", tonumber(wantedRange) or 0)
				.. " root=" .. formatPathDebugVector3(rootPart.Position)
				.. " target=" .. formatPathDebugVector3(targetPosition)
				.. " rejected=" .. tostring(countPathDebugRejectedEntryNodes()),
			1.5
		)
	end
	local computedPathReachDistance = isCFrameMovementMode(movementMode)
		and getCFrameComputedPathReachDistance(wantedRange)
		or (isUndergroundMovementMode(movementMode) and getUndergroundPathReachDistance())
		or WAYPOINT_REACH_DISTANCE
	local function getComputedPathPointDistance(point)
		local activeRootPart = getRootPart(character)
		if not activeRootPart or typeof(point) ~= "Vector3" then
			return math.huge
		end
		local flatRootPosition = Vector3.new(activeRootPart.Position.X, 0, activeRootPart.Position.Z)
		local flatPointPosition = Vector3.new(point.X, 0, point.Z)
		return (flatRootPosition - flatPointPosition).Magnitude
	end
	local function moveAlongComputedPathPoint(point)
