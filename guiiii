function canClaimPickaxeProgressionMilestone(playerData, miningData, level)
	local skillLevel = getMiningSkillLevel(playerData)
	if skillLevel < level then
		return false
	end

	local milestones = isTable(miningData) and (rawget(miningData, "Milestones") or miningData.Milestones) or nil
	local milestoneData = isTable(milestones) and (rawget(milestones, level) or milestones[level] or milestones[tostring(level)]) or nil
	if not isTable(milestoneData) then
		return false
	end

	local claims = getMiningSkillClaims(playerData)
	local claimData = rawget(claims, tostring(level)) or claims[tostring(level)] or rawget(claims, level) or claims[level]
	local progressionInfo = resolveSharedProgressionInfo(false) or resolveSharedProgressionInfo(true)
	local utils = isTable(progressionInfo) and (rawget(progressionInfo, "Utils") or progressionInfo.Utils) or nil
	local canReclaim = isTable(utils) and (rawget(utils, "CanReclaimMilestone") or utils.CanReclaimMilestone) or nil
	if type(canReclaim) == "function" then
		local okCanClaim, result = pcall(canReclaim, utils, milestoneData, claimData, playerData)
		if okCanClaim then
			return result == true
		end
	end

	return claimData == nil or claimData == false
end

function getHighestClaimablePickaxeProgression(playerData, currentTier)
	local miningData = getMiningProgressionData()
	local best = nil
	for _, milestone in ipairs(PICKAXE_PROGRESSION_MILESTONES) do
		if milestone.tier > (tonumber(currentTier) or 0)
			and canClaimPickaxeProgressionMilestone(playerData, miningData, milestone.level) then
			if not best or milestone.tier > best.tier then
				best = milestone
			end
		end
	end
	return best
end

function firePickaxeProgressionClaim(level)
	local network = playerState.hookedNetwork or resolveGlobalNetwork(false) or resolveGlobalNetwork(true)
	local fireServer = type(playerState.originalNetworkFireServer) == "function" and playerState.originalNetworkFireServer
		or (network and network.FireServer)
	if not network or type(fireServer) ~= "function" then
		return false, "network unavailable"
	end

	local okClaim, err = pcall(fireServer, network, "ClaimSkillReward", "Mining", level)
	if not okClaim then
		return false, err
	end
	return true
end

function waitForOwnedPickaxeTier(targetTier, timeoutSeconds)
	local deadline = os.clock() + math.max(0.25, tonumber(timeoutSeconds) or PICKAXE_PROGRESSION_CLAIM_WAIT_TIMEOUT)
	local latestSummary = nil
	while os.clock() < deadline do
		task.wait(0.15)
		local playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
		local playerItems = resolveSharedPlayerItems(false) or resolveSharedPlayerItems(true)
		latestSummary = getPickaxeProgressionOwnedSummary(playerData, playerItems)
		if latestSummary.bestTier >= targetTier then
			return true, latestSummary
		end
	end
	return false, latestSummary
end

function resetPickaxeProgressionToolCaches()
	cachedDirectToolInfo = nil
	cachedToolInfoOwner = nil
	lastDirectToolInfoScanAt = 0
	lastAuraForceScanAt = 0
end

function pausePickaxeProgressionMining(seconds)
	local now = os.clock()
	pickaxeProgressionEquipSettlingUntil = math.max(
		tonumber(pickaxeProgressionEquipSettlingUntil) or 0,
		now + math.max(0.1, tonumber(seconds) or PICKAXE_PROGRESSION_POST_EQUIP_MINE_DELAY)
	)
	lastPickaxeMineHitAt = now
	lastMineAuraNetworkHitAt = now
	resetPickaxeProgressionToolCaches()
end

function isPickaxeProgressionMiningPaused()
	if pickaxeProgressionClaimInProgress then
		return true, 0.12
	end
	local remaining = (tonumber(pickaxeProgressionEquipSettlingUntil) or 0) - os.clock()
	if remaining > 0 then
		return true, math.min(math.max(remaining, 0.06), 0.25)
	end
	return false, 0
end

function isPlayerCharacterItemSwitching(playerCharacter)
	if not isTable(playerCharacter) then
		return false
	end
	return (rawget(playerCharacter, "IsSwitchingItems") or playerCharacter.IsSwitchingItems) == true
		or (rawget(playerCharacter, "ItemSwitchDisabled") or playerCharacter.ItemSwitchDisabled) == true
		or rawget(playerCharacter, "NextItemToEquip") ~= nil
		or playerCharacter.NextItemToEquip ~= nil
end

function getCurrentPickaxeProgressionTier(character, playerCharacter, playerItems)
	local currentItem = getCurrentEquippedItemData(playerCharacter)
	local tier = getPickaxeTierFromItem(currentItem, playerItems)
	if tier ~= nil then
		return tier
	end

	local visualItem = getVisualEquippedItemData(playerCharacter)
	tier = getPickaxeTierFromItem(visualItem, playerItems)
	if tier ~= nil then
		return tier
	end

	local equippedModel = getEquippedPickaxe(character)
	if equippedModel then
		tier = getPickaxeTierFromText(equippedModel.Name)
		if tier ~= nil then
			return tier
		end
	end

	local storedModel = getStoredPickaxe(character)
	if storedModel then
		tier = getPickaxeTierFromText(storedModel.Name)
		if tier ~= nil then
			return tier
		end
	end

	return nil
end

function waitForPickaxeProgressionEquipSettled(character, targetTier, timeoutSeconds)
	local deadline = os.clock() + math.max(0.2, tonumber(timeoutSeconds) or PICKAXE_PROGRESSION_EQUIP_SETTLE_TIMEOUT)
	local target = tonumber(targetTier)
	while os.clock() < deadline do
		task.wait(0.08)
		local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
		local playerItems = resolveSharedPlayerItems(false) or resolveSharedPlayerItems(true)
		local currentTier = getCurrentPickaxeProgressionTier(character or cachedCharacter, playerCharacter, playerItems)
		if (not target or (currentTier ~= nil and currentTier >= target)) and not isPlayerCharacterItemSwitching(playerCharacter) then
			pausePickaxeProgressionMining(PICKAXE_PROGRESSION_POST_EQUIP_MINE_DELAY)
			return true
		end
	end
	return false
end

function getBestPickaxeProgressionItemEntry(playerData, playerItems)
	local summary = getPickaxeProgressionOwnedSummary(playerData, playerItems)
	local bestEntry = nil
	for _, entry in ipairs(summary.items or {}) do
		if isTable(entry.item) and (not bestEntry or entry.tier > bestEntry.tier) then
			bestEntry = entry
		end
	end
	return bestEntry, summary
end

function isInventoryPickaxeItemStillPresent(playerData, targetItem, targetItemId)
	local inventoryContainer = getResolvedInventoryContainer(playerData)
	local items = isTable(inventoryContainer) and (rawget(inventoryContainer, "Items") or inventoryContainer.Items) or nil
	if not isTable(items) then
		return false
	end

	for _, inventoryItem in pairs(items) do
		local resolvedItem = getResolvedItemData(inventoryItem)
		if resolvedItem == targetItem then
			return true
		end
		if type(targetItemId) == "string" and getInventoryItemKey(resolvedItem) == targetItemId then
			return true
		end
	end

	return false
end

function waitForInventoryPickaxeItemRemoved(targetItem, targetItemId, timeoutSeconds)
	local deadline = os.clock() + math.max(0.1, tonumber(timeoutSeconds) or 0.8)
	while os.clock() < deadline do
		task.wait(0.08)
		local playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
		if not isInventoryPickaxeItemStillPresent(playerData, targetItem, targetItemId) then
			return true
		end
	end
	return false
end

function callPickaxeProgressionOwnerMethod(owner, methodName, targetItem, inventoryContainerId, inventoryItemId)
	if not isTable(owner) then
		return false
	end

	local method = rawget(owner, methodName) or owner[methodName]
	if type(method) ~= "function" then
		return false
	end

	local attempts = {
		{ inventoryContainerId, inventoryItemId },
		{ inventoryItemId },
		{ targetItem },
		{ inventoryContainerId, targetItem },
		{},
	}
	for _, args in ipairs(attempts) do
		local okCall = pcall(function()
			return method(owner, table.unpack(args))
		end)
		if okCall and waitForInventoryPickaxeItemRemoved(targetItem, inventoryItemId, 0.45) then
			return true
		end
	end

	return false
end

function tryDiscardPickaxeProgressionInventoryItem(entry)
	local now = os.clock()
	if (now - (tonumber(pickaxeProgressionLastDiscardAt) or 0)) < PICKAXE_PROGRESSION_DISCARD_COOLDOWN then
		return false
	end

	local targetItem = isTable(entry) and entry.item or nil
	if not isTable(targetItem) then
		return false
	end

	local playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
	local playerItems = resolveSharedPlayerItems(false) or resolveSharedPlayerItems(true)
	local inventoryContainer = getResolvedInventoryContainer(playerData)
	if not (isTable(playerData) and isTable(inventoryContainer)) then
		return false
	end

	local inventoryItemId = getInventoryItemKey(targetItem)
	local inventoryContainerId = rawget(inventoryContainer, "Id") or inventoryContainer.Id
	local sharedItemData = resolveSharedItemData(playerItems, targetItem)
	local actionNames = collectInventoryDiscardActionNames(sharedItemData, false)
	local playerCharacterModule = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	if isPlayerCharacterItemSwitching(playerCharacterModule) then
		pausePickaxeProgressionMining(0.35)
		return false
	end

	local currentTier = getCurrentPickaxeProgressionTier(cachedCharacter, playerCharacterModule, playerItems)
	local entryTier = tonumber(entry.tier)
	if currentTier == nil or entryTier == nil or currentTier <= 0 or currentTier <= entryTier then
		return false
	end

	for _, fallbackName in ipairs({
		"DiscardItem",
		"DiscardInventoryItem",
		"DestroyInventoryItem",
		"RemoveInventoryItem",
		"DeleteInventoryItem",
		"DestroyItem",
		"RemoveItem",
	}) do
		table.insert(actionNames, fallbackName)
	end

	pickaxeProgressionLastDiscardAt = now
	for _, target in ipairs({
		{ owner = targetItem, names = actionNames },
		{ owner = inventoryContainer, names = actionNames },
		{ owner = playerData, names = actionNames },
	}) do
		for _, methodName in ipairs(collectKeywordMethodNames(target.owner, target.names)) do
			if callPickaxeProgressionOwnerMethod(target.owner, methodName, targetItem, inventoryContainerId, inventoryItemId) then
				return true
			end
		end
	end

	return false
end

function equipBestPickaxeProgressionItem(character, humanoid)
	cachedPickaxe = nil
	lastPickaxeEquipRequestAt = 0
	lastPickaxeEquipRequestId = nil
	lastPickaxeLoadoutRequestAt = 0
	lastPickaxeLoadoutRequestId = nil
	pausePickaxeProgressionMining(0.35)
	refreshCachedObjects(true)
	local activeCharacter = character or cachedCharacter
	local activeHumanoid = humanoid or cachedHumanoid
	local playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
	local playerItems = resolveSharedPlayerItems(false) or resolveSharedPlayerItems(true)
	local targetEntry = nil
	targetEntry = getBestPickaxeProgressionItemEntry(playerData, playerItems)
	local targetTier = targetEntry and targetEntry.tier or nil
	local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	if isTable(targetEntry) and isTable(targetEntry.item) and isTable(playerCharacter) then
		local currentTier = getCurrentPickaxeProgressionTier(activeCharacter, playerCharacter, playerItems)
		if not currentTier or not targetTier or currentTier < targetTier then
			local setLoadout = isTable(playerData) and (rawget(playerData, "SetLoadout") or playerData.SetLoadout) or nil
			local slotType = getPickaxeEquipmentType(targetEntry.item, playerItems, playerData, playerCharacter)
			local slotIndex = findPreferredLoadoutSlot(playerData, slotType, getInventoryItemKey(targetEntry.item))
			if type(setLoadout) == "function" and type(slotType) == "string" and slotType ~= "" and slotIndex ~= nil then
				pcall(setLoadout, playerData, slotType, slotIndex, targetEntry.item)
				task.wait(0.12)
			end

			local canSwitchToItem = rawget(playerCharacter, "CanSwitchToItem") or playerCharacter.CanSwitchToItem
			local equipItem = rawget(playerCharacter, "EquipItem") or playerCharacter.EquipItem
			local canSwitch = true
			if type(canSwitchToItem) == "function" then
				local okCanSwitch, result = pcall(canSwitchToItem, playerCharacter, targetEntry.item, true)
				canSwitch = not okCanSwitch or result ~= false
			end
			if canSwitch and type(equipItem) == "function" then
				local okEquip = pcall(equipItem, playerCharacter, targetEntry.item, true, true)
				if okEquip then
					pushDebug("pickaxe progression: requested best pickaxe equip")
					pausePickaxeProgressionMining(PICKAXE_PROGRESSION_POST_EQUIP_MINE_DELAY)
					if waitForPickaxeProgressionEquipSettled(activeCharacter, targetTier, PICKAXE_PROGRESSION_EQUIP_SETTLE_TIMEOUT) then
						cachedPickaxe = getEquippedPickaxe(activeCharacter) or getStoredPickaxe(activeCharacter) or cachedPickaxe
						return true
					end
				end
			end
		end
	end

	local pickaxe = cachedPickaxe or findPickaxe(activeCharacter)
	for _ = 1, 12 do
		if not activeCharacter or not activeHumanoid then
			activeCharacter, activeHumanoid, pickaxe = refreshCachedObjects(true)
		end
		if equipPickaxe(activeCharacter, activeHumanoid, pickaxe) then
			if targetTier and not waitForPickaxeProgressionEquipSettled(activeCharacter, targetTier, PICKAXE_PROGRESSION_EQUIP_SETTLE_TIMEOUT) then
				return false
			end
			cachedPickaxe = getEquippedPickaxe(activeCharacter) or getStoredPickaxe(activeCharacter) or pickaxe
			pausePickaxeProgressionMining(PICKAXE_PROGRESSION_POST_EQUIP_MINE_DELAY)
			return true
		end
		task.wait(0.12)
		pickaxe = findPickaxe(activeCharacter) or pickaxe
	end
	return false
end

function tryPickaxeProgressionUpgrade(character, humanoid, activeToken)
	if not (S.pickaxeProgressionEnabled == true and autoMineEnabled and activeToken == autoMineToken) then
		return false
	end
	if pickaxeProgressionClaimInProgress then
		return true
	end

	local now = os.clock()
	if (now - (tonumber(pickaxeProgressionLastCheckAt) or 0)) < PICKAXE_PROGRESSION_CHECK_INTERVAL then
		return false
	end
	pickaxeProgressionLastCheckAt = now

	local playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
	local playerItems = resolveSharedPlayerItems(false) or resolveSharedPlayerItems(true)
	if not (isTable(playerData) and isTable(playerItems)) then
		pushDebugRateLimited("pickaxe_progression_missing_data", "pickaxe progression: player data unavailable", 3)
		return false
	end

	local ownedSummary = getPickaxeProgressionOwnedSummary(playerData, playerItems)
	local claimable = getHighestClaimablePickaxeProgression(playerData, ownedSummary.bestTier)
	if claimable then
		if pickaxeProgressionLastClaimLevel == claimable.level
			and (now - (tonumber(pickaxeProgressionLastClaimAt) or 0)) < PICKAXE_PROGRESSION_CLAIM_RETRY_DELAY then
			return false
		end

		pickaxeProgressionClaimInProgress = true
		pickaxeProgressionLastClaimAt = now
		pickaxeProgressionLastClaimLevel = claimable.level
		currentTargetOre = nil
		clearMovementKeys()
		setInteractKeyHeld(false)
		pausePickaxeProgressionMining(0.5)
		if character then
			endExperimentalCFrameTravel(character)
			endUndergroundTravel(character)
		end
		setStatus("Claiming Tier " .. tostring(claimable.tier) .. " pickaxe", Color3.fromRGB(120, 190, 255))
		pushDebug(string.format("pickaxe progression: claiming Mining level %d (%s)", claimable.level, claimable.itemType))

		local okClaim, claimErr = firePickaxeProgressionClaim(claimable.level)
		if not okClaim then
			pushDebugRateLimited("pickaxe_progression_claim_failed", "pickaxe progression claim failed: " .. tostring(claimErr), 3)
			pickaxeProgressionClaimInProgress = false
			return false
		end

		local appeared = false
		appeared, ownedSummary = waitForOwnedPickaxeTier(claimable.tier, PICKAXE_PROGRESSION_CLAIM_WAIT_TIMEOUT)
		pickaxeProgressionClaimInProgress = false
		if not appeared then
			pushDebugRateLimited("pickaxe_progression_wait_failed", "pickaxe progression: claimed reward but pickaxe did not appear yet", 3)
			return true
		end
		pausePickaxeProgressionMining(PICKAXE_PROGRESSION_POST_EQUIP_MINE_DELAY)
	end

	playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
	playerItems = resolveSharedPlayerItems(false) or resolveSharedPlayerItems(true)
	ownedSummary = ownedSummary or getPickaxeProgressionOwnedSummary(playerData, playerItems)
	local bestTier = tonumber(ownedSummary.bestTier) or 0
	if bestTier <= 0 then
		return claimable ~= nil
	end

	local lowerEntry = findLowerPickaxeProgressionInventoryItem(playerData, playerItems, bestTier)
	local equippedBest = false
	if claimable or lowerEntry then
		setStatus("Switching to best pickaxe", Color3.fromRGB(120, 190, 255))
		equippedBest = equipBestPickaxeProgressionItem(character, humanoid)
		if not equippedBest then
			setStatus("Waiting for pickaxe switch", Color3.fromRGB(255, 190, 120))
			pausePickaxeProgressionMining(0.35)
			return true
		end
		playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
		playerItems = resolveSharedPlayerItems(false) or resolveSharedPlayerItems(true)
		lowerEntry = findLowerPickaxeProgressionInventoryItem(playerData, playerItems, bestTier)
	end

	if lowerEntry then
		local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
		local currentTier = getCurrentPickaxeProgressionTier(character or cachedCharacter, playerCharacter, playerItems)
		local lowerTier = tonumber(lowerEntry.tier)
		if currentTier == nil or lowerTier == nil or currentTier <= 0 or currentTier <= lowerTier then
			pushDebugRateLimited("pickaxe_progression_discard_guard", "pickaxe progression: keeping old pickaxe until higher tier is equipped", 3)
			return claimable ~= nil or equippedBest
		end

		local lowerLabel = lowerEntry.tier > 0 and ("Tier " .. tostring(lowerEntry.tier) .. " pickaxe") or "base pickaxe"
		setStatus("Discarding old " .. lowerLabel, Color3.fromRGB(255, 190, 120))
		if tryDiscardPickaxeProgressionInventoryItem(lowerEntry) then
			pushDebug("pickaxe progression: discarded old " .. lowerLabel)
		else
			pushDebugRateLimited("pickaxe_progression_discard_failed", "pickaxe progression: old pickaxe discard did not confirm", 3)
		end
		return true
	end

	return claimable ~= nil
end

function milestoneHasMiningPassiveReward(milestoneData)
	if not isTable(milestoneData) then
		return false
	end

	local function containsLuckPerk(container)
		if not isTable(container) then
			return false
		end
		for _, rewardData in pairs(container) do
			if isTable(rewardData) then
				local rewardType = safeLower(rawget(rewardData, "Type") or rewardData.Type)
				if rewardType == "gemluck" or string.find(rewardType, "luck", 1, true) then
					return true
				end
			end
		end
		return false
	end

	return containsLuckPerk(rawget(milestoneData, "Perks") or milestoneData.Perks)
		or containsLuckPerk(rawget(milestoneData, "Passives") or milestoneData.Passives)
		or containsLuckPerk(rawget(milestoneData, "Boosts") or milestoneData.Boosts)
end

function getMiningPassiveRewardLabel(milestoneData)
	local perks = isTable(milestoneData) and (rawget(milestoneData, "Perks") or milestoneData.Perks) or nil
	if isTable(perks) then
		for _, perkData in pairs(perks) do
			if isTable(perkData) then
				local perkType = rawget(perkData, "Type") or perkData.Type
				local perkValue = tonumber(rawget(perkData, "Value") or perkData.Value)
				if type(perkType) == "string" and perkType ~= "" then
					if perkValue then
						return tostring(perkType) .. " +" .. tostring(math.floor((perkValue * 100) + 0.5)) .. "%"
					end
					return tostring(perkType)
				end
			end
		end
	end
	return "Mining passive"
end

function getNextClaimableMiningPassiveProgression(playerData)
	local miningData = getMiningProgressionData()
	local milestones = isTable(miningData) and (rawget(miningData, "Milestones") or miningData.Milestones) or nil
	if not isTable(milestones) then
		return nil
	end

	local best = nil
	for levelKey, milestoneData in pairs(milestones) do
		local level = tonumber(levelKey)
		if level and milestoneHasMiningPassiveReward(milestoneData)
			and canClaimPickaxeProgressionMilestone(playerData, miningData, level) then
			if not best or level < best.level then
				best = {
					level = level,
					label = getMiningPassiveRewardLabel(milestoneData),
				}
			end
		end
	end

	return best
end

function tryMiningPassiveProgressionClaim(character, activeToken)
	if not (S.miningPassiveProgressionEnabled == true and autoMineEnabled and activeToken == autoMineToken) then
		return false
	end
	if pickaxeProgressionClaimInProgress then
		return true
	end

	local now = os.clock()
	if (now - (tonumber(miningPassiveProgressionLastCheckAt) or 0)) < MINING_PASSIVE_PROGRESSION_CHECK_INTERVAL then
		return false
	end
	miningPassiveProgressionLastCheckAt = now

	local playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
	if not isTable(playerData) then
		pushDebugRateLimited("mining_passive_progression_missing_data", "gem luck: player data unavailable", 4)
		return false
	end

	local reward = getNextClaimableMiningPassiveProgression(playerData)
	if not reward then
		return false
	end
	if miningPassiveProgressionLastClaimLevel == reward.level
		and (now - (tonumber(miningPassiveProgressionLastClaimAt) or 0)) < MINING_PASSIVE_PROGRESSION_CLAIM_RETRY_DELAY then
		return false
	end

	pickaxeProgressionClaimInProgress = true
	miningPassiveProgressionLastClaimAt = now
	miningPassiveProgressionLastClaimLevel = reward.level
	pausePickaxeProgressionMining(0.45)
	setStatus("Claiming Gem Luck", Color3.fromRGB(120, 190, 255))
	pushDebug("gem luck: claiming level " .. tostring(reward.level) .. " (" .. tostring(reward.label) .. ")")

	local okClaim, claimErr = firePickaxeProgressionClaim(reward.level)
	task.delay(0.25, function()
		pickaxeProgressionClaimInProgress = false
	end)
	if not okClaim then
		pickaxeProgressionClaimInProgress = false
		pushDebugRateLimited("mining_passive_progression_claim_failed", "gem luck claim failed: " .. tostring(claimErr), 4)
		return false
	end

	return true
end

function getProgressionPathTierLabel(tier)
	tier = math.clamp(math.floor(tonumber(tier) or 0), 0, 9)
	if tier <= 0 then
		return "Basic"
	end
	return "Tier " .. tostring(tier)
end

function getProgressionPathGeneratedName(tier)
	return PROGRESSION_PATH_SLOT_NAME .. " - " .. getProgressionPathTierLabel(tier)
end

function getProgressionPathSource(tier)
	tier = math.clamp(math.floor(tonumber(tier) or 0), 0, 9)
	local source = isTable(PROGRESSION_PATH_LOADSTRINGS) and PROGRESSION_PATH_LOADSTRINGS[tier] or nil
	if type(source) ~= "string" then
		return nil
	end
	source = string.gsub(source, "^%s+", "")
	source = string.gsub(source, "%s+$", "")
	if source == "" then
		return nil
	end
	return source
end

function getCurrentProgressionPathPickaxeTier()
	local playerItems = resolveSharedPlayerItems(false) or resolveSharedPlayerItems(true)
	local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	local character = cachedCharacter or getCustomCharacter()
	local tier = getCurrentPickaxeProgressionTier(character, playerCharacter, playerItems)
	if tier == nil then
		local playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
		local ownedSummary = getPickaxeProgressionOwnedSummary(playerData, playerItems)
		tier = ownedSummary and ownedSummary.bestTier or 0
	end
	return math.clamp(math.floor(tonumber(tier) or 0), 0, 9)
end

function getConfiguredProgressionPathTier(currentTier)
	local startingTier = math.clamp(math.floor(tonumber(currentTier) or 0), 0, 9)
	for tier = startingTier, 0, -1 do
		if getProgressionPathSource(tier) then
			return tier
		end
	end
	return nil
end

function registerProgressionPathData(tier, pathName, pathData)
	if not isTable(pathData) then
		return nil, nil
	end

	local nestedPathData = rawget(pathData, "pathData") or pathData.pathData
		or rawget(pathData, "PathData") or pathData.PathData
		or rawget(pathData, "path") or pathData.path
		or rawget(pathData, "Path") or pathData.Path
		or rawget(pathData, "data") or pathData.data
		or rawget(pathData, "Data") or pathData.Data
	if isTable(nestedPathData) then
		pathData = nestedPathData
	end
	if not isTable(pathData.nodes) then
		return nil, nil
	end

	local resolvedName = pathName
		or rawget(pathData, "pathName") or pathData.pathName
		or rawget(pathData, "PathName") or pathData.PathName
		or rawget(pathData, "name") or pathData.name
		or rawget(pathData, "Name") or pathData.Name
	if type(resolvedName) ~= "string" or resolvedName == "" then
		resolvedName = getProgressionPathGeneratedName(tier)
	end

	local deserializedPath = deserializePathData(pathData)
	if not (isTable(deserializedPath) and isTable(deserializedPath.nodes) and #deserializedPath.nodes > 0) then
		return nil, nil
	end

	pathState.paths[resolvedName] = deserializedPath
	return resolvedName, deserializedPath
end

function registerProgressionPathLoadResult(tier, loadResult)
	if type(loadResult) == "string" and isTable(pathState.paths[loadResult]) then
		return loadResult, pathState.paths[loadResult]
	end
	if not isTable(loadResult) then
		return nil, nil
	end

	local resultName = rawget(loadResult, "pathName") or loadResult.pathName
		or rawget(loadResult, "PathName") or loadResult.PathName
		or rawget(loadResult, "name") or loadResult.name
		or rawget(loadResult, "Name") or loadResult.Name
	local resultData = rawget(loadResult, "pathData") or loadResult.pathData
		or rawget(loadResult, "PathData") or loadResult.PathData
		or rawget(loadResult, "path") or loadResult.path
		or rawget(loadResult, "Path") or loadResult.Path
		or rawget(loadResult, "data") or loadResult.data
		or rawget(loadResult, "Data") or loadResult.Data
		or loadResult
	local pathName, pathData = registerProgressionPathData(tier, resultName, resultData)
	if pathName then
		return pathName, pathData
	end

	local pathList = rawget(loadResult, "paths") or loadResult.paths or rawget(loadResult, "Paths") or loadResult.Paths
	if isTable(pathList) then
		for candidateName, candidateData in pairs(pathList) do
			pathName, pathData = registerProgressionPathData(tier, candidateName, candidateData)
			if pathName then
				return pathName, pathData
			end
		end
	end

	for candidateName, candidateData in pairs(loadResult) do
		if isTable(candidateData) and isTable(candidateData.nodes) then
			pathName, pathData = registerProgressionPathData(tier, candidateName, candidateData)
			if pathName then
				return pathName, pathData
			end
		end
	end

	return nil, nil
end

function loadProgressionPathForTier(tier, options)
	tier = math.clamp(math.floor(tonumber(tier) or 0), 0, 9)
	options = type(options) == "table" and options or {}
	local cached = isTable(progressionPathLoadCache) and progressionPathLoadCache[tier] or nil
	if isTable(cached) and type(cached.pathName) == "string" and isTable(pathState.paths[cached.pathName]) then
		return cached.pathName, pathState.paths[cached.pathName], tier
	end
	if options.loadProgression == false then
		return nil, nil, tier
	end

	local source = getProgressionPathSource(tier)
	if not source then
		return nil, nil, tier
	end

	local beforeNames = {}
	for pathName in pairs(pathState.paths) do
		beforeNames[pathName] = true
	end

	local loaderFactory = type(loadstring) == "function" and loadstring or (type(load) == "function" and load or nil)
	if type(loaderFactory) ~= "function" then
		pushDebugRateLimited("progression_path_no_loadstring", "progression paths: loadstring is unavailable", 5)
		return nil, nil, tier
	end

	local chunk, compileErr = loaderFactory(source)
	if type(chunk) ~= "function" then
		pushDebugRateLimited("progression_path_compile_" .. tostring(tier), "progression path " .. getProgressionPathTierLabel(tier) .. " failed to compile: " .. tostring(compileErr), 5)
		return nil, nil, tier
	end

	local okLoad, loadResult = xpcall(chunk, debug.traceback)
	if not okLoad then
		pushDebugRateLimited("progression_path_load_" .. tostring(tier), "progression path " .. getProgressionPathTierLabel(tier) .. " failed to load: " .. tostring(loadResult), 5)
		return nil, nil, tier
	end

	local pathName, pathData = registerProgressionPathLoadResult(tier, loadResult)
	if not pathName then
		for candidateName, candidatePath in pairs(pathState.paths) do
			if not beforeNames[candidateName] and isTable(candidatePath) and isTable(candidatePath.nodes) and #candidatePath.nodes > 0 then
				pathName = candidateName
				pathData = candidatePath
				break
			end
		end
	end
	if not pathName then
		local generatedName = getProgressionPathGeneratedName(tier)
		if isTable(pathState.paths[generatedName]) then
			pathName = generatedName
			pathData = pathState.paths[generatedName]
		end
	end
	if not pathName then
		pushDebugRateLimited("progression_path_missing_" .. tostring(tier), "progression path " .. getProgressionPathTierLabel(tier) .. " loaded but did not return/create a path", 5)
		return nil, nil, tier
	end

	progressionPathLoadCache[tier] = {
		pathName = pathName,
		loadedAt = os.clock(),
	}
	pushDebugRateLimited("progression_path_loaded_" .. tostring(tier), "progression paths: loaded " .. tostring(pathName) .. " for " .. getProgressionPathTierLabel(tier), 3)
	return pathName, pathData or pathState.paths[pathName], tier
end

function resolveProgressionPathForCurrentPickaxe(options)
	options = type(options) == "table" and options or {}
	enablePickaxeProgressionForProgressionPaths()
	local currentTier = getCurrentProgressionPathPickaxeTier()
	local configuredTier = getConfiguredProgressionPathTier(currentTier)
	if configuredTier == nil then
		if options.notify ~= false then
			notifyUser("Progression Paths", "Paste at least one progression path loadstring first.", 5)
			setStatus("No progression path configured", Color3.fromRGB(255, 190, 120))
		end
		return nil, nil, nil, currentTier
	end

	local pathName, pathData, loadedTier = loadProgressionPathForTier(configuredTier, options)
	if not pathName then
		if options.notify ~= false then
			notifyUser("Progression Paths", "Could not load " .. getProgressionPathTierLabel(configuredTier) .. " path.", 5)
			setStatus("Progression path failed to load", Color3.fromRGB(255, 130, 130))
		end
		return nil, nil, configuredTier, currentTier
	end
	if configuredTier < currentTier then
		pushDebugRateLimited(
			"progression_path_fallback",
			"progression paths: using " .. getProgressionPathTierLabel(configuredTier) .. " path for " .. getProgressionPathTierLabel(currentTier),
			4
		)
	end
	return pathName, pathData, loadedTier, currentTier
end

