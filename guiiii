    _UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard or input.KeyCode == Enum.KeyCode.Unknown then
            return
        end
        if pendingKeybindAction == "markore" then
            if input.KeyCode == Enum.KeyCode.Escape then
                pendingKeybindAction = nil
                refreshPathEditorButtons()
                setPathEditorStatus("Mark key capture cancelled.", UI_COLORS.muted)
                return
            end
            if input.KeyCode == guiToggleKeyCode then
                pendingKeybindAction = nil
                refreshPathEditorButtons()
                setPathEditorStatus("That key is already used by the GUI toggle.", UI_COLORS.warning)
                return
            end
            pathState.markOreKey = input.KeyCode
            pendingKeybindAction = nil
            savePathsToStorage(false)
            pushDebug("mark ore key: " .. formatKeyCodeName(pathState.markOreKey))
            refreshPathEditorButtons()
            return
        end
        if _UserInputService:GetFocusedTextBox() then
            return
        end
        if pathState.editorVisible and input.KeyCode == pathState.markOreKey then
            tryMarkHoveredOre()
            return
        end
        if gameProcessed then
            return
        end
    end)

    _UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or not pathState.editorVisible then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local mouse = localPlayer:GetMouse()
            local target = mouse and mouse.Target
            local nodeIndex = target and target:GetAttribute("PathNodeIndex")
            local axisName = target and target:GetAttribute("PathNodeAxis")
             if nodeIndex then
                 nodeIndex = tonumber(nodeIndex)
                 if pathState.disconnectNodesMode then
                     applyWorkingPathDisconnectSelection(nodeIndex)
                 elseif pathState.sellNodePickMode then
                     applyWorkingPathSellNodeSelection(nodeIndex)
                elseif pathState.deleteMode then
                    pathState.selectedNodeIndex = nil
                    pathState.draggingNodeIndex = nil
                    pathState.draggingNodeAxis = nil
                    pathState.dragLastPointerPosition = nil
                    if pathState.deletePathAhead then
                        truncateWorkingPathFromIndex(nodeIndex)
                        setPathEditorStatus("Deleted nodes from #" .. tostring(nodeIndex) .. " onward.", UI_COLORS.warning)
                    else
                        deleteWorkingPathNodeAtIndex(nodeIndex)
                        setPathEditorStatus("Deleted node #" .. tostring(nodeIndex) .. ".", UI_COLORS.warning)
                    end
                    refreshPathVisuals()
                    refreshPathEditorButtons()
                else
                    pathState.selectedNodeIndex = nodeIndex
                    if not pathState.editNodePlacementEnabled then
                        pathState.draggingNodeIndex = nil
                        pathState.draggingNodeAxis = nil
                        pathState.dragLastPointerPosition = nil
                        refreshPathVisuals()
                        refreshPathEditorButtons()
                        setPathEditorStatus("Turn on Edit node placement to move nodes.", UI_COLORS.warning)
                        return
                    end
                    pathState.selectedNodeIndex = nodeIndex
                    pathState.draggingNodeIndex = nodeIndex
                    pathState.draggingNodeAxis = axisName and tostring(axisName) or "FREE"
                    pathState.dragLastPointerPosition = input.Position
                    refreshPathVisuals()
                    refreshPathEditorButtons()
                    if axisName then
                        setPathEditorStatus("Adjusting node #" .. tostring(nodeIndex) .. " on the " .. tostring(axisName) .. " axis.", UI_COLORS.accent)
                    else
                        setPathEditorStatus("Dragging node #" .. tostring(nodeIndex), UI_COLORS.accent)
                    end
                end
             elseif pathState.disconnectNodesMode then
                 setPathEditorStatus("Disconnect mode is on. Click one of the route nodes.", UI_COLORS.warning)
             elseif pathState.sellNodePickMode then
                 setPathEditorStatus("Sell-node picker is on. Click one of the route nodes.", UI_COLORS.warning)
            elseif pathState.selectedNodeIndex then
                pathState.selectedNodeIndex = nil
                pathState.draggingNodeIndex = nil
                pathState.draggingNodeAxis = nil
                pathState.dragLastPointerPosition = nil
                refreshPathVisuals()
                refreshPathEditorButtons()
                setPathEditorStatus("Node edit cleared.", UI_COLORS.muted)
            end
        end
    end)

    _UserInputService.InputChanged:Connect(function(input)
        if not pathState.editNodePlacementEnabled then
            return
        end
        if pathState.draggingNodeIndex and input.UserInputType == Enum.UserInputType.MouseMovement then
            local nodePosition = getPathNodePosition(pathState.workingPath.nodes[pathState.draggingNodeIndex])
            if nodePosition then
                if pathState.draggingNodeAxis == "FREE" then
                    local movedPosition = getEditorMouseGroundPosition(cachedCharacter or getCustomCharacter())
                    if movedPosition then
                        setPathNodePosition(pathState.workingPath, pathState.draggingNodeIndex, movedPosition)
                    end
                elseif pathState.dragLastPointerPosition then
                    local delta = input.Position - pathState.dragLastPointerPosition
                    local sensitivity = 0.045
                    if pathState.draggingNodeAxis == "X" then
                        setPathNodePosition(pathState.workingPath, pathState.draggingNodeIndex, nodePosition + Vector3.new(delta.X * sensitivity, 0, 0))
                    elseif pathState.draggingNodeAxis == "Y" then
                        setPathNodePosition(pathState.workingPath, pathState.draggingNodeIndex, nodePosition + Vector3.new(0, -delta.Y * sensitivity, 0))
                    elseif pathState.draggingNodeAxis == "Z" then
                        setPathNodePosition(pathState.workingPath, pathState.draggingNodeIndex, nodePosition + Vector3.new(0, 0, -delta.Y * sensitivity))
                    end
                    pathState.dragLastPointerPosition = input.Position
                end
				pathState.sellNodeDirty = true
				recomputeWorkingPathSellNode()
				updatePathEditorActiveNodeVisuals()
				local mineNodeLookup = buildPathMineNodeLookup(pathState.workingPath)
				local disconnectedNodeLookup = {}
				for nodeIndex = 1, #(pathState.workingPath.nodes or {}) do
					if isPathNodeDisconnected(pathState.workingPath, nodeIndex) then
						disconnectedNodeLookup[nodeIndex] = true
					end
				end
				for index, part in pairs(pathUi.editorNodeParts) do
					if part and part.Parent then
						part.Color = getPathNodeVisualColor(index, pathState.selectedNodeIndex, nil, pathState.sellNodeIndex, mineNodeLookup, disconnectedNodeLookup)
					end
				end
            end
        end
    end)

