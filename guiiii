local function getDynamitePlayerOptions()
    local playerNames = {}
    for _, player in ipairs(_Players:GetPlayers()) do
        if player ~= localPlayer then
            table.insert(playerNames, player.Name)
        end
    end
    table.sort(playerNames)
    if #playerNames == 0 then
