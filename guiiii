function getPickaxeTierFromItem(item, playerItems)
	item = getResolvedItemData(item)
	if not isTable(item) then
		return nil
	end
	local textKeys = {
		"Type",
		"Id",
		"Name",
		"DisplayName",
		"ItemType",
		"VariantOf",
		"Model",
		"ModelName",
		"WorldModel",
		"WorldModelName",
		"ViewModel",
		"ViewModelName",
	}
	local function scanSource(source)
		if not isTable(source) then
			return nil
		end
		local hasPickaxeText = false
		for _, key in ipairs(textKeys) do
			local textValue = rawget(source, key) or source[key]
			if type(textValue) == "string" and string.find(safeLower(textValue), "pickaxe", 1, true) then
				hasPickaxeText = true
			end
			local tier = getPickaxeTierFromText(textValue)
			if tier ~= nil then
				return tier
			end
		end
		local explicitTier = tonumber(rawget(source, "PickaxeTier") or source.PickaxeTier)
		if explicitTier then
			return math.clamp(math.floor(explicitTier), 0, 9)
		end
		local genericTier = tonumber(rawget(source, "Tier") or source.Tier)
		if genericTier and hasPickaxeText then
			return math.clamp(math.floor(genericTier), 0, 9)
		end
