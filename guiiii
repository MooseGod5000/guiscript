      onLbl.Parent = textContainer
      -- Sync label positions to match current state (handles defaults & config loads)
      local function syncLabels()
          if getStateFn() then
              offLbl.Position = UDim2.new(-1, 0, 0, 0)
              onLbl.Position = UDim2.new(0, 0, 0, 0)
          else
              offLbl.Position = UDim2.new(0, 0, 0, 0)
              onLbl.Position = UDim2.new(1, 0, 0, 0)
          end
          updateVis(false)
      end
      -- Initialize labels based on current state at creation time
      syncLabels()
      -- Register for bulk sync after config load
      table.insert(_allToggleSyncs, syncLabels)
      -- Register for button picker (Creator Mode)
      if _currentRegistryTab then
          table.insert(_buttonRegistry, {name = name, tab = _currentRegistryTab, type = "toggle", getStateFn = getStateFn, onClickFn = onClickFn})
      end
      row.MouseButton1Click:Connect(function()
          _createParticleBurst(row)
          onClickFn()
          local slideTI = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
          if getStateFn() then
              _TweenService:Create(offLbl, slideTI, {Position = UDim2.new(-1, 0, 0, 0)}):Play()
              _TweenService:Create(onLbl, slideTI, {Position = UDim2.new(0, 0, 0, 0)}):Play()
          else
              _TweenService:Create(offLbl, slideTI, {Position = UDim2.new(0, 0, 0, 0)}):Play()
              _TweenService:Create(onLbl, slideTI, {Position = UDim2.new(1, 0, 0, 0)}):Play()
          end
          updateVis(true)
      end)
      return row, updateVis
