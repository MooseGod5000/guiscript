function Western.main()
  abortIfExecuted()
  local modules = loadModules()
  local runtime = createRuntime(modules)
  loadSavedSettings(runtime)
  PathRecorder.restore(runtime)
  Notifications.configure(runtime)
  Visuals.apply(runtime)
  CharacterAssist.apply(runtime)
  ServerQuality.beforeAutoMine(runtime)
  StateHandlers.runController(runtime)
  local window = buildInterface(modules.kinetic)
  bindInterfaceCallbacks(window, runtime)
  StaffDetection.start(runtime)
  analysis_register_callbacks(Settings, AutoMine, Movement, PathRecorder, ServerQuality, Notifications, Visuals)
end

