function restoreCameraNoclipOcclusionModule()
	local patchedModule = S._cameraNoclipPatchedOcclusionModule
	if isTable(patchedModule)
		and type(S._cameraNoclipOriginalCutoff) == "function"
		and patchedModule.GetLargestCutoffDistance == S._cameraNoclipCutoffWrapper then
		patchedModule.GetLargestCutoffDistance = S._cameraNoclipOriginalCutoff
	end
	S._cameraNoclipPatchedOcclusionModule = nil
	S._cameraNoclipOriginalCutoff = nil
end

function applyCameraNoclipState(forceRefresh)
	local player = LocalPlayer or localPlayer
	if not player then
		return
	end

	if S.cameraNoclipEnabled then
		if S._cameraNoclipPreviousOcclusionMode == nil then
			pcall(function()
				S._cameraNoclipPreviousOcclusionMode = player.DevCameraOcclusionMode
			end)
		end
	else
		restoreCameraNoclipOcclusionModule()
	end

	local desiredMode = S.cameraNoclipEnabled and Enum.DevCameraOcclusionMode.Invisicam
		or (S._cameraNoclipPreviousOcclusionMode or Enum.DevCameraOcclusionMode.Zoom)
	pcall(function()
		player.DevCameraOcclusionMode = desiredMode
	end)
	if not S.cameraNoclipEnabled then
		S._cameraNoclipPreviousOcclusionMode = nil
	end

	local cameras = getLocalPlayerCameraController(forceRefresh)
	if type(cameras) ~= "table" then
		return
	end

	local setOcclusionMode = rawget(cameras, "SetOcclusionMode") or cameras.SetOcclusionMode
	if type(setOcclusionMode) == "function" then
		pcall(setOcclusionMode, cameras, desiredMode)
	end

	local activeOcclusionModule = rawget(cameras, "activeOcclusionModule") or cameras.activeOcclusionModule
	if not isTable(activeOcclusionModule) then
		restoreCameraNoclipOcclusionModule()
		return
	end

	if not S.cameraNoclipEnabled then
		return
	end

	if activeOcclusionModule ~= S._cameraNoclipPatchedOcclusionModule then
		restoreCameraNoclipOcclusionModule()
	end

	local currentCutoff = rawget(activeOcclusionModule, "GetLargestCutoffDistance") or activeOcclusionModule.GetLargestCutoffDistance
	if type(currentCutoff) ~= "function" then
		return
	end

	if type(S._cameraNoclipCutoffWrapper) ~= "function" then
		S._cameraNoclipCutoffWrapper = function()
			return 0
		end
	end

	if currentCutoff ~= S._cameraNoclipCutoffWrapper then
		S._cameraNoclipOriginalCutoff = currentCutoff
		activeOcclusionModule.GetLargestCutoffDistance = S._cameraNoclipCutoffWrapper
		S._cameraNoclipPatchedOcclusionModule = activeOcclusionModule
	end
end

function ensureCameraNoclipLoop()
	if type(S._cameraNoclipConnection) == "RBXScriptConnection" then
		return
	end

	S._cameraNoclipConnection = RunService.RenderStepped:Connect(function()
		if destroyed or not isSessionActive() then
			if type(S._cameraNoclipConnection) == "RBXScriptConnection" then
				S._cameraNoclipConnection:Disconnect()
			end
			S._cameraNoclipConnection = nil
			restoreCameraNoclipOcclusionModule()
			return
		end
		if S.cameraNoclipEnabled then
			applyCameraNoclipState(false)
		end
	end)
end

function setCameraNoclipEnabled(value, skipPersistence)
	local nextValue = value == true
	if S.cameraNoclipEnabled == nextValue then
		return
	end
	S.cameraNoclipEnabled = nextValue
	if nextValue then
		ensureCameraNoclipLoop()
	elseif type(S._cameraNoclipConnection) == "RBXScriptConnection" then
		S._cameraNoclipConnection:Disconnect()
		S._cameraNoclipConnection = nil
	end
	applyCameraNoclipState(true)
	if type(spawnNotification) == "function" then
		spawnNotification("Camera noclip " .. (nextValue and "enabled." or "disabled."), nextValue and "success" or "warning", true)
	end
	if skipPersistence then
		return
	end
	schedulePersist()
end

