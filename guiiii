function notifyUser(title, text, duration)
    local textProvider = type(text) == "function" and text or nil
    local notifyText = textProvider and tostring(textProvider() or "") or tostring(text or "")
    local notifyTitle = tostring(title or "Automine")
    if type(spawnNotification) == "function" then
        local lowered = safeLower(notifyTitle)
        local notifType = "info"
        if string.find(lowered, "warn", 1, true) then
            notifType = "warning"
        elseif string.find(lowered, "error", 1, true) then
            notifType = "error"
        elseif string.find(lowered, "success", 1, true) then
            notifType = "success"
        end
        local updater = nil
        if textProvider then
            updater = function()
                return notifyTitle .. ": " .. tostring(textProvider() or notifyText)
            end
        end
        spawnNotification(notifyTitle .. ": " .. notifyText, notifType, true, duration, updater)
    else
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = notifyTitle,
                Text = notifyText,
                Duration = duration or 4,
            })
        end)
    end
    pushDebug((title and (title .. ": ") or "") .. tostring(text or ""))
end

function notifyRubberBandDetected()
	local now = os.clock()
	if (now - lastRubberBandNoticeAt) < RUBBERBAND_NOTIFY_COOLDOWN then
		return
	end

	lastRubberBandNoticeAt = now
	if type(spawnNotification) == "function" then
		spawnNotification("Rubber band detected.", "warning", true, 3)
	else
		notifyUser("Warning", "Rubber band detected.", 3)
	end
end

function handlePathPlaybackRubberBand(character, targetPosition)
	cancelActiveMoveTween()
	clearMovementKeys()
	setInteractKeyHeld(false)
	if isCFrameMovementMode(movementMode) and type(endExperimentalCFrameTravel) == "function" then
		endExperimentalCFrameTravel(character)
	end
	if isUndergroundMovementMode(movementMode) and type(endUndergroundTravel) == "function" then
		endUndergroundTravel(character)
	end
	local closestNodeIndex = nil
	local closestNodeDistance = nil
	local closestEntryPointIndex = nil
	local closestEntryPointPosition = nil
	local closestEntryPointDistance = nil
	local rootPart = getRootPart(character)
	if rootPart and pathState.currentPath then
		if pathState.entryPathingPending then
			closestNodeIndex, closestNodeDistance = getClosestSafeEntryPlaybackPathNodeIndex(pathState.currentPath, rootPart.Position)
		else
			closestNodeIndex, closestNodeDistance = getClosestPlaybackPathNodeIndex(pathState.currentPath, rootPart.Position)
		end
		if pathState.entryPathingPending and type(pathState.entryPathPoints) == "table" then
			local flatRootPosition = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z)
			for entryPointIndex, entryPointPosition in ipairs(pathState.entryPathPoints) do
				if typeof(entryPointPosition) == "Vector3" then
					local flatEntryPointPosition = Vector3.new(entryPointPosition.X, 0, entryPointPosition.Z)
					local entryPointDistance = (flatRootPosition - flatEntryPointPosition).Magnitude
					if not closestEntryPointDistance or entryPointDistance < closestEntryPointDistance then
						closestEntryPointDistance = entryPointDistance
						closestEntryPointIndex = entryPointIndex
						closestEntryPointPosition = entryPointPosition
					end
				end
			end
		end
		if pathState.entryPathingPending and closestEntryPointPosition then
			pathState.entryResyncTargetPosition = closestEntryPointPosition
			pathState.entryPathingPending = true
		elseif closestNodeIndex then
			pathState.playbackNodeIndex = closestNodeIndex
			pathState.entryResyncTargetPosition = nil
			pathState.entryPathingPending = true
		end
	end
	setStatus("Rubber band detected", Color3.fromRGB(255, 190, 120))
	pushDebugRateLimited(
		"path_rubberband",
		"rubber band detected while pathing to "
			.. (typeof(targetPosition) == "Vector3" and string.format("(%.1f, %.1f, %.1f)", targetPosition.X, targetPosition.Y, targetPosition.Z) or "node"),
		1.25
	)
	if pathState.entryPathingPending and closestEntryPointPosition then
		pushDebugRateLimited(
			"path_rubberband_resync",
			string.format("rubber band resync -> entry node %d (%.1f studs)", closestEntryPointIndex or -1, tonumber(closestEntryPointDistance) or -1),
			1.25
		)
	elseif closestNodeIndex then
		pushDebugRateLimited(
			"path_rubberband_resync",
			string.format("rubber band resync -> node %d (%.1f studs)", closestNodeIndex, tonumber(closestNodeDistance) or -1),
			1.25
		)
	end
	notifyRubberBandDetected()
	task.wait(RUBBERBAND_RETRY_DELAY)
end

function getCallableGlobal(name)
	local direct = rawget(_G, name)
	if type(direct) == "function" then
		return direct
	end

	if type(getgenv) == "function" then
		local ok, environment = pcall(getgenv)
		if ok and type(environment) == "table" and type(environment[name]) == "function" then
			return environment[name]
		end
	end

	return nil
end

function ensurePathStorageSupport(showNotice)
	if pathState.storageChecked then
		if showNotice and not pathState.storageSupported and not pathState.storageNoticeShown then
			notifyUser("Path Storage", "Missing executor file APIs: " .. table.concat(pathState.storageMissing, ", "), 6)
			pathState.storageNoticeShown = true
		end
		return pathState.storageSupported
	end

	local missing = {}
	for _, functionName in ipairs({ "writefile", "readfile", "isfile", "makefolder" }) do
		if not getCallableGlobal(functionName) then
			table.insert(missing, functionName)
		end
	end

	if not getCallableGlobal("listfiles") then
		table.insert(missing, "listfiles")
	end

	pathState.storageChecked = true
	pathState.storageMissing = missing
	pathState.storageSupported = #missing == 0 or (#missing == 1 and missing[1] == "listfiles")

	if showNotice and not pathState.storageSupported and not pathState.storageNoticeShown then
		notifyUser("Path Storage", "Missing executor file APIs: " .. table.concat(pathState.storageMissing, ", "), 6)
		pathState.storageNoticeShown = true
	end

	return pathState.storageSupported
end

function sanitizePathStorageKey(rawValue)
	local cleaned = tostring(rawValue or "local")
	cleaned = string.gsub(cleaned, "[^%w_%-]", "_")
	cleaned = string.gsub(cleaned, "_+", "_")
	return cleaned ~= "" and cleaned or "local"
end

function getPathStorageDeviceKey()
	local deviceKey = nil
	if type(getStorageId) == "function" then
		local ok, value = pcall(getStorageId)
		if ok and value then
			deviceKey = value
		end
	end

	if not deviceKey or tostring(deviceKey) == "" then
		local hwidFunction = getCallableGlobal("gethwid")
		if hwidFunction then
			local ok, value = pcall(hwidFunction)
			if ok and value then
				deviceKey = value
			end
		end
	end

	if not deviceKey then
		deviceKey = tostring(LocalPlayer.UserId)
	end

	return sanitizePathStorageKey(deviceKey)
end

function getPathStorageFilePath()
	local fileName = string.format("%s_%s.json", PATH_STORAGE_FILE_PREFIX, getPathStorageDeviceKey())
	return PATH_STORAGE_FOLDER .. "\\" .. fileName
end

function getLegacyPathStorageFilePath()
	local fileName = string.format("%s_%s.json", PATH_STORAGE_LEGACY_FILE_PREFIX, getPathStorageDeviceKey())
	return PATH_STORAGE_LEGACY_FOLDER .. "\\" .. fileName
end

function getPathStorageFileBaseName(filePath)
	local normalized = string.gsub(tostring(filePath or ""), "\\", "/")
	return string.match(normalized, "([^/]+)$") or normalized
end

function getPathStorageFileStem(filePath)
	local fileName = getPathStorageFileBaseName(filePath)
	return (string.gsub(fileName, "%.[Jj][Ss][Oo][Nn]$", ""))
end

function isPathStorageJsonFile(filePath)
	local fileName = string.lower(getPathStorageFileBaseName(filePath))
	return string.sub(fileName, -5) == ".json"
end

function isPathStorageSettingsFilePath(filePath)
	local fileName = string.lower(getPathStorageFileBaseName(filePath))
	local settingsPrefix = string.lower(PATH_STORAGE_FILE_PREFIX) .. "_"
	return string.sub(fileName, 1, #settingsPrefix) == settingsPrefix
end

function getSharedPathStorageFilePath(pathName)
	return PATH_STORAGE_FOLDER .. "\\" .. sanitizePathStorageKey(pathName) .. PATH_STORAGE_PATH_FILE_EXTENSION
end

function getPathNameFromStorageFilePath(filePath)
	local fileStem = getPathStorageFileStem(filePath)
	return fileStem ~= "" and fileStem or nil
end

function readPathStorageJsonFile(filePath)
	local readfileFunction = getCallableGlobal("readfile")
	if type(readfileFunction) ~= "function" then
		return nil
	end

	local okRead, contents = pcall(readfileFunction, filePath)
	if not okRead or type(contents) ~= "string" or contents == "" then
		return nil
	end

	local okDecode, payload = pcall(function()
		return HttpService:JSONDecode(contents)
	end)
	if not okDecode or type(payload) ~= "table" then
		return nil
	end

	return payload
end

function mergeSerializedPathsIntoStorageState(serializedPaths)
	local mergedCount = 0
	for pathName, pathData in pairs(serializedPaths or {}) do
		if type(pathName) == "string" and pathName ~= "" and type(pathData) == "table" then
			pathState.paths[pathName] = deserializePathData(pathData)
			mergedCount = mergedCount + 1
		end
	end
	return mergedCount
end

function mergeSharedPathStoragePayload(filePath, payload)
	if type(payload) ~= "table" then
		return 0
	end
	if payload.deleted == true then
		return 0
	end

	if type(payload.paths) == "table" then
		return mergeSerializedPathsIntoStorageState(payload.paths)
	end

	local pathName = type(payload.name) == "string" and payload.name or getPathNameFromStorageFilePath(filePath)
	local pathData = nil
	if type(payload.path) == "table" then
		pathData = payload.path
	elseif type(payload.nodes) == "table" or type(payload.ores) == "table" then
		pathData = payload
	end

	if type(pathName) ~= "string" or pathName == "" or type(pathData) ~= "table" then
		return 0
	end

	pathState.paths[pathName] = deserializePathData(pathData)
	return 1
end

function loadSharedPathFilesFromStorage()
	local listfilesFunction = getCallableGlobal("listfiles")
	if type(listfilesFunction) ~= "function" then
		return 0
	end

	local okList, filePaths = pcall(listfilesFunction, PATH_STORAGE_FOLDER)
	if not okList or type(filePaths) ~= "table" then
		return 0
	end

	local loadedCount = 0
	for _, filePath in ipairs(filePaths) do
		if type(filePath) == "string" and isPathStorageJsonFile(filePath) and not isPathStorageSettingsFilePath(filePath) then
			local payload = readPathStorageJsonFile(filePath)
			if payload then
				loadedCount = loadedCount + mergeSharedPathStoragePayload(filePath, payload)
			end
		end
	end
	return loadedCount
end

function writeSharedPathFilesToStorage(serializedPaths)
	local writefileFunction = getCallableGlobal("writefile")
	if type(writefileFunction) ~= "function" then
		return false, "missing writefile"
	end

	for pathName, pathData in pairs(serializedPaths or {}) do
		local payload = {
			version = 1,
			type = PATH_STORAGE_SHARED_FILE_TYPE,
			name = pathName,
			path = pathData,
		}
		local ok, err = pcall(writefileFunction, getSharedPathStorageFilePath(pathName), HttpService:JSONEncode(payload))
		if not ok then
			return false, err
		end
	end

	return true
end

function deleteSharedPathStorageFile(pathName)
	local delfileFunction = getCallableGlobal("delfile")
	if type(delfileFunction) ~= "function" then
		local writefileFunction = getCallableGlobal("writefile")
		if type(writefileFunction) == "function" then
			pcall(writefileFunction, getSharedPathStorageFilePath(pathName), HttpService:JSONEncode({
				version = 1,
				type = PATH_STORAGE_SHARED_FILE_TYPE,
				name = pathName,
				deleted = true,
			}))
		end
		return false
	end

	local filePath = getSharedPathStorageFilePath(pathName)
	local isfileFunction = getCallableGlobal("isfile")
	if type(isfileFunction) == "function" then
		local okExists, exists = pcall(isfileFunction, filePath)
		if okExists and not exists then
			return true
		end
	end

	local ok = pcall(delfileFunction, filePath)
	return ok == true
end

function vectorToData(vector)
	return {
		x = math.floor(vector.X * 100 + 0.5) / 100,
		y = math.floor(vector.Y * 100 + 0.5) / 100,
		z = math.floor(vector.Z * 100 + 0.5) / 100,
	}
end

function vectorFromData(data)
	if type(data) ~= "table" then
		return nil
	end

	return Vector3.new(tonumber(data.x) or 0, tonumber(data.y) or 0, tonumber(data.z) or 0)
end

function normalizePathNodeIndex(index, nodeCount)
	local numericIndex = tonumber(index)
	if not numericIndex then
		return nil
	end

	numericIndex = math.floor(numericIndex)
	if numericIndex < 1 or numericIndex > math.max(tonumber(nodeCount) or 0, 0) then
		return nil
	end

	return numericIndex
end

function getManualPathSellNodeIndex(pathData)
	local nodes = pathData and pathData.nodes or {}
	return normalizePathNodeIndex(pathData and pathData.manualSellNodeIndex, #nodes)
end

function getPathDisconnectAfterNodeIndex(pathData)
	local nodes = pathData and pathData.nodes or {}
	local nodeCount = #nodes
	local disconnectAfterNodeIndex = normalizePathNodeIndex(pathData and pathData.disconnectAfterNodeIndex, nodeCount)
	if disconnectAfterNodeIndex and disconnectAfterNodeIndex < nodeCount then
		return disconnectAfterNodeIndex
	end
	return nil
end

function getPathReconnectNodeIndex(pathData)
	local nodes = pathData and pathData.nodes or {}
	local nodeCount = #nodes
	local disconnectAfterNodeIndex = getPathDisconnectAfterNodeIndex(pathData)
	if not disconnectAfterNodeIndex then
		return nil
	end
	local reconnectNodeIndex = normalizePathNodeIndex(pathData and pathData.reconnectNodeIndex, nodeCount)
	if reconnectNodeIndex and reconnectNodeIndex > (disconnectAfterNodeIndex + 1) then
		return reconnectNodeIndex
	end
	return nil
end

function isPathNodeDisconnected(pathData, nodeIndex)
	local disconnectAfterNodeIndex = getPathDisconnectAfterNodeIndex(pathData)
	if not disconnectAfterNodeIndex then
		return false
	end
	local normalizedNodeIndex = normalizePathNodeIndex(nodeIndex, #(pathData.nodes or {}))
	if not normalizedNodeIndex or normalizedNodeIndex <= disconnectAfterNodeIndex then
		return false
	end
	local reconnectNodeIndex = getPathReconnectNodeIndex(pathData)
	return not reconnectNodeIndex or normalizedNodeIndex < reconnectNodeIndex
end

function getPathSegmentVisualColor(pathData, fromNodeIndex, toNodeIndex)
	local disconnectAfterNodeIndex = getPathDisconnectAfterNodeIndex(pathData)
	if not disconnectAfterNodeIndex then
		return PATH_VISUAL_LINE_COLOR
	end
	local fromIndex = tonumber(fromNodeIndex) or 0
	local toIndex = tonumber(toNodeIndex) or 0
	local reconnectNodeIndex = getPathReconnectNodeIndex(pathData)
	if fromIndex >= disconnectAfterNodeIndex and (not reconnectNodeIndex or toIndex <= reconnectNodeIndex) then
		return PATH_VISUAL_DISCONNECTED_COLOR
	end
	return PATH_VISUAL_LINE_COLOR
end

function sanitizePathDisconnectState(pathData)
	if type(pathData) ~= "table" then
		return false
	end

	local disconnectAfterNodeIndex = getPathDisconnectAfterNodeIndex(pathData)
	if not disconnectAfterNodeIndex then
		pathData.disconnectAfterNodeIndex = nil
		pathData.reconnectNodeIndex = nil
		return false
	end

	pathData.disconnectAfterNodeIndex = disconnectAfterNodeIndex
	pathData.reconnectNodeIndex = getPathReconnectNodeIndex(pathData)
	return true
end

function getPathNodePosition(node)
	if typeof(node) == "Vector3" then
		return node
	end
	if type(node) == "table" then
		if typeof(node.position) == "Vector3" then
			return node.position
		end
		local nestedPosition = vectorFromData(node.position)
		if nestedPosition then
			return nestedPosition
		end
	end
	return nil
end

function getClosestPlaybackPathNodeIndex(pathData, worldPosition)
	if type(pathData) ~= "table" or typeof(worldPosition) ~= "Vector3" then
		return nil, nil
	end

	local nodes = pathData.nodes or {}
	local bestNodeIndex = nil
	local bestDistance = nil
	local flatWorldPosition = Vector3.new(worldPosition.X, 0, worldPosition.Z)
	for nodeIndex, node in ipairs(nodes) do
		local nodePosition = getPathNodePosition(node)
		if nodePosition and not isPathNodeDisconnected(pathData, nodeIndex) then
			local flatNodePosition = Vector3.new(nodePosition.X, 0, nodePosition.Z)
			local distance = (flatWorldPosition - flatNodePosition).Magnitude
			if not bestDistance or distance < bestDistance then
				bestDistance = distance
				bestNodeIndex = nodeIndex
			end
		end
	end

	return bestNodeIndex, bestDistance
end

function getFirstRemainingMineablePathOreNodeIndex(pathData)
	if type(pathData) ~= "table" then
		return nil
	end

	local nodeCount = #(pathData.nodes or {})
	local firstOreNodeIndex = nil
	for _, oreTarget in ipairs(pathData.ores or {}) do
		local oreNodeIndex = normalizePathNodeIndex(oreTarget.nodeIndex, nodeCount)
		if oreNodeIndex and not isPathNodeDisconnected(pathData, oreNodeIndex) then
			local resolvedOre = resolveSavedOreTarget(oreTarget)
			local oreRemaining = resolvedOre and getOreRemainingValue(resolvedOre)
			local remainingValue = nil
			if typeof(oreRemaining) == "Instance" then
				remainingValue = tonumber(oreRemaining.Value)
			else
				remainingValue = tonumber(oreRemaining)
			end
			if resolvedOre and remainingValue and remainingValue > 0 and (not firstOreNodeIndex or oreNodeIndex < firstOreNodeIndex) then
				firstOreNodeIndex = oreNodeIndex
			end
		end
	end

	return firstOreNodeIndex
end

function getFirstRecordedMineablePathOreNodeIndex(pathData)
	if type(pathData) ~= "table" then
		return nil
	end

	local nodeCount = #(pathData.nodes or {})
	local firstOreNodeIndex = nil
	for _, oreTarget in ipairs(pathData.ores or {}) do
		local oreNodeIndex = normalizePathNodeIndex(oreTarget.nodeIndex, nodeCount)
		if oreNodeIndex and not isPathNodeDisconnected(pathData, oreNodeIndex) and (not firstOreNodeIndex or oreNodeIndex < firstOreNodeIndex) then
			firstOreNodeIndex = oreNodeIndex
		end
	end

	return firstOreNodeIndex
end

function getClosestSafeEntryPlaybackPathNodeIndex(pathData, worldPosition, rejectedNodeIndexes)
	if type(pathData) ~= "table" or typeof(worldPosition) ~= "Vector3" then
		return nil, nil, nil
	end

	local nodes = pathData.nodes or {}
	local nodeCount = #nodes
	if nodeCount <= 0 then
		return nil, nil, nil
	end

	local sellNodeIndex = getManualPathSellNodeIndex(pathData) or getPathSellNodeIndex(pathData)
	local maxEntryNodeIndex = getFirstRemainingMineablePathOreNodeIndex(pathData)
		or getFirstRecordedMineablePathOreNodeIndex(pathData)
		or ((sellNodeIndex and sellNodeIndex > 1) and (sellNodeIndex - 1) or nodeCount)
	maxEntryNodeIndex = math.clamp(math.floor(maxEntryNodeIndex), 1, nodeCount)
	local bestNodeIndex = nil
	local bestDistance = nil
	for nodeIndex = 1, maxEntryNodeIndex do
		local nodeRejected = type(rejectedNodeIndexes) == "table" and rejectedNodeIndexes[nodeIndex] == true
			or isPathNodeDisconnected(pathData, nodeIndex)
			or (sellNodeIndex ~= nil and nodeIndex == sellNodeIndex and nodeCount > 1)
		local nodePosition = (not nodeRejected) and getPathNodePosition(nodes[nodeIndex]) or nil
		if nodePosition then
			local distance = (worldPosition - nodePosition).Magnitude
			if not bestDistance or distance < bestDistance then
				bestDistance = distance
				bestNodeIndex = nodeIndex
			end
		end
	end

	if not bestNodeIndex and sellNodeIndex and sellNodeIndex > 1 then
		maxEntryNodeIndex = math.clamp(sellNodeIndex - 1, 1, nodeCount)
		for nodeIndex = 1, maxEntryNodeIndex do
			local nodeRejected = type(rejectedNodeIndexes) == "table" and rejectedNodeIndexes[nodeIndex] == true
				or isPathNodeDisconnected(pathData, nodeIndex)
			local nodePosition = (not nodeRejected) and getPathNodePosition(nodes[nodeIndex]) or nil
			if nodePosition then
				local distance = (worldPosition - nodePosition).Magnitude
				if not bestDistance or distance < bestDistance then
					bestDistance = distance
					bestNodeIndex = nodeIndex
				end
			end
		end
	end

	return bestNodeIndex, bestDistance, maxEntryNodeIndex
end

function setPathNodePosition(pathData, nodeIndex, position)
	if not pathData or not position then
		return false
	end

	local currentNode = pathData.nodes and pathData.nodes[nodeIndex]
	if not currentNode then
		return false
	end

	if typeof(currentNode) == "Vector3" then
		pathData.nodes[nodeIndex] = position
		return true
	end

	if type(currentNode) == "table" then
		currentNode.position = position
		return true
	end

	pathData.nodes[nodeIndex] = position
	return true
end

function serializePathData(pathData)
	local serialized = {
		nodes = {},
		ores = {},
		manualSellNodeIndex = getManualPathSellNodeIndex(pathData),
		disconnectAfterNodeIndex = getPathDisconnectAfterNodeIndex(pathData),
		reconnectNodeIndex = getPathReconnectNodeIndex(pathData),
		spawnName = normalizePathSpawnName(pathData and pathData.spawnName),
	}

	for _, node in ipairs(pathData.nodes or {}) do
		local nodePosition = getPathNodePosition(node)
		if nodePosition then
			table.insert(serialized.nodes, {
				position = vectorToData(nodePosition),
			})
		end
	end

	for _, ore in ipairs(pathData.ores or {}) do
		table.insert(serialized.ores, {
			groupName = ore.groupName,
			position = vectorToData(ore.position),
			nodeIndex = ore.nodeIndex,
		})
	end

	return serialized
end

function deserializePathData(pathData)
	local result = {
		nodes = {},
		ores = {},
		manualSellNodeIndex = nil,
		disconnectAfterNodeIndex = nil,
		reconnectNodeIndex = nil,
		spawnName = normalizePathSpawnName(pathData and pathData.spawnName),
	}

	for _, node in ipairs(pathData and pathData.nodes or {}) do
		local position = getPathNodePosition(node) or vectorFromData(node)
		if position then
			table.insert(result.nodes, {
				position = position,
			})
		end
	end

	for _, ore in ipairs(pathData and pathData.ores or {}) do
		local position = vectorFromData(ore.position)
		if position then
			table.insert(result.ores, {
				groupName = ore.groupName,
				position = position,
				nodeIndex = tonumber(ore.nodeIndex) or 0,
			})
		end
	end

	result.manualSellNodeIndex = normalizePathNodeIndex(pathData and pathData.manualSellNodeIndex, #result.nodes)
	result.disconnectAfterNodeIndex = normalizePathNodeIndex(pathData and pathData.disconnectAfterNodeIndex, #result.nodes)
	result.reconnectNodeIndex = normalizePathNodeIndex(pathData and pathData.reconnectNodeIndex, #result.nodes)
	sanitizePathDisconnectState(result)

	return result
end

function getSavedPathNamesOrdered()
	local names = {}
	for pathName in pairs(pathState.paths) do
		table.insert(names, pathName)
	end
	table.sort(names, function(left, right)
		return string.lower(left) < string.lower(right)
	end)
	return names
end

function savePathsToStorage(showNotice)
