                                  end
                                  task.wait(1)
                              end
                          end
                          npcSetupDone = true
                          -- Initialize hold position at current LIVE position (flat on back)
                          -- Re-read root position to ensure we use post-respawn location
                          local freshChar = _Players.LocalPlayer.Character
                          local freshRoot = freshChar and freshChar:FindFirstChild("HumanoidRootPart")
