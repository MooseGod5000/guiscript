        icon.Position = UDim2.new(0, 24, 0.5, -7)
        icon.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        icon.BorderSizePixel = 0
        icon.Parent = row
        Instance.new("UICorner", icon).CornerRadius = UDim.new(0, 2)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0, 180, 1, 0)
        label.Position = UDim2.new(0, 50, 0, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.new(0.8, 0.8, 0.8)
        label.Text = rowName
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextTruncate = Enum.TextTruncate.AtEnd
        label.Parent = row

        local topLine = Instance.new("Frame")
        topLine.Size = UDim2.new(0, 0, 0, 2)
        topLine.BackgroundColor3 = Color3.new(1, 1, 1)
        topLine.BorderSizePixel = 0
        topLine.Parent = row

        local bottomLine = Instance.new("Frame")
        bottomLine.Size = UDim2.new(0, 0, 0, 2)
        bottomLine.Position = UDim2.new(0, 0, 1, -2)
        bottomLine.BackgroundColor3 = Color3.new(1, 1, 1)
        bottomLine.BorderSizePixel = 0
        bottomLine.Parent = row

        local resetBg = Instance.new("TextButton")
        resetBg.Size = UDim2.new(0, 45, 0, 22)
        resetBg.Position = UDim2.new(1, -55, 0.5, -11)
        resetBg.BackgroundColor3 = Color3.fromRGB(50, 30, 30)
        resetBg.BorderSizePixel = 0
        resetBg.Text = "Reset"
        resetBg.TextColor3 = Color3.fromRGB(255, 120, 120)
        resetBg.Font = Enum.Font.GothamMedium
        resetBg.TextSize = 10
        resetBg.AutoButtonColor = false
        resetBg.ZIndex = 3
        resetBg.Parent = row
        Instance.new("UICorner", resetBg).CornerRadius = UDim.new(0, 4)
        _UTILS._applySoundsToButton(resetBg)

        local keybindBg = Instance.new("Frame")
        keybindBg.Size = UDim2.new(0, 75, 0, 22)
        keybindBg.Position = UDim2.new(1, -140, 0.5, -11)
        keybindBg.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        keybindBg.BorderSizePixel = 1
        keybindBg.BorderColor3 = Color3.fromRGB(60, 60, 60)
        keybindBg.Parent = row
        Instance.new("UICorner", keybindBg).CornerRadius = UDim.new(0, 4)

        local keybindLabel = Instance.new("TextLabel")
        keybindLabel.Size = UDim2.new(1, 0, 1, 0)
        keybindLabel.BackgroundTransparency = 1
        keybindLabel.TextColor3 = Color3.new(1, 1, 1)
        keybindLabel.Text = getKeyDisplayName(S.keybinds[rowKey])
        keybindLabel.Font = Enum.Font.GothamMedium
        keybindLabel.TextSize = 11
        keybindLabel.Parent = keybindBg

        local keybindBtn = Instance.new("TextButton")
        keybindBtn.Size = UDim2.new(1, 0, 1, 0)
        keybindBtn.BackgroundTransparency = 1
        keybindBtn.Text = ""
        keybindBtn.ZIndex = 3
        keybindBtn.Parent = keybindBg
        _UTILS._applySoundsToButton(keybindBtn)

        row.MouseEnter:Connect(function()
            if destroyed then
                return
            end
            _TweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 35)}):Play()
            _TweenService:Create(icon, TweenInfo.new(0.2), {BackgroundColor3 = Color3.new(1, 1, 1)}):Play()
            _TweenService:Create(label, TweenInfo.new(0.2), {TextColor3 = Color3.new(1, 1, 1)}):Play()
            local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            _TweenService:Create(topLine, tweenInfo, {Size = UDim2.new(1, 0, 0, 2)}):Play()
            _TweenService:Create(bottomLine, tweenInfo, {Size = UDim2.new(1, 0, 0, 2)}):Play()
            diamond.Visible = true
        end)

        row.MouseLeave:Connect(function()
            if destroyed then
                return
            end
            _TweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(24, 24, 24)}):Play()
            _TweenService:Create(icon, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 150, 255)}):Play()
            _TweenService:Create(label, TweenInfo.new(0.2), {TextColor3 = Color3.new(0.8, 0.8, 0.8)}):Play()
            local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            _TweenService:Create(topLine, tweenInfo, {Size = UDim2.new(0, 0, 0, 2)}):Play()
            _TweenService:Create(bottomLine, tweenInfo, {Size = UDim2.new(0, 0, 0, 2)}):Play()
            diamond.Visible = false
        end)

        resetBg.MouseEnter:Connect(function()
            _TweenService:Create(resetBg, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 30, 30)}):Play()
        end)

        resetBg.MouseLeave:Connect(function()
            _TweenService:Create(resetBg, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 30, 30)}):Play()
        end)

        local rowData = {
            registryName = rowKey,
            displayName = rowName,
            row = row,
            keybindLabel = keybindLabel,
            keybindBtn = keybindBtn,
            keybindBg = keybindBg,
            resetBtn = resetBg,
            regEntry = regEntry,
        }
        keybindRows[rowKey] = rowData

        keybindBtn.MouseButton1Click:Connect(function()
            if destroyed then
                return
            end
            _UTILS._createParticleBurst(keybindBg)
            if keybindListening and keybindListeningBtn == keybindBtn then
                stopKeybindListening()
                return
            end
            if keybindListening then
                stopKeybindListening()
            end
            keybindListening = true
            beginKeyCapture()
            keybindListeningBtn = keybindBtn
            keybindLabel.Text = ". . ."
            keybindBg.BorderColor3 = Color3.fromRGB(0, 150, 255)
            keybindLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
            spawnNotification("Press Esc or Backspace to cancel.", "info", true)

            keybindListenConn = _UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if destroyed or not keybindListening or gameProcessed then
                    return
                end
                if input.UserInputType ~= Enum.UserInputType.Keyboard then
                    return
                end
                if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                    stopKeybindListening()
                    return
                end
                if input.KeyCode ~= Enum.KeyCode.Unknown then
                    S.keybinds[rowKey] = input.KeyCode
                    keybindLabel.Text = input.KeyCode.Name
                    keybindBg.BorderColor3 = Color3.fromRGB(60, 60, 60)
                    keybindLabel.TextColor3 = Color3.new(1, 1, 1)
                    keybindListening = false
                    endKeyCapture()
                    if keybindListenConn then
                        keybindListenConn:Disconnect()
                        keybindListenConn = nil
                    end
                    keybindListeningBtn = nil
                    schedulePersist()
                    refreshDashboard()
                    spawnNotification(rowName .. " has been keybound to " .. input.KeyCode.Name .. ".", "success", true)
                end
            end)
        end)

        resetBg.MouseButton1Click:Connect(function()
            if destroyed then
                return
            end
            _UTILS._createParticleBurst(resetBg)
            if keybindListening and keybindListeningBtn == keybindBtn then
                stopKeybindListening()
            end
            S.keybinds[rowKey] = nil
            keybindLabel.Text = "none"
            keybindBg.BorderColor3 = Color3.fromRGB(60, 60, 60)
            keybindLabel.TextColor3 = Color3.new(1, 1, 1)
            schedulePersist()
            refreshDashboard()
        end)

        return row
    end

    allKbElements = {}
    keybindTabOrder = {"Home", "AUTOMINE", "WEAPONS", "PLAYER", "VISUALS", "GAME", "SETTINGS"}

    keybindTabOrderIndex = 1
    while keybindTabOrderIndex <= #keybindTabOrder do
        keybindTabName = keybindTabOrder[keybindTabOrderIndex]
        keybindTabEntries = {}
        keybindRegistryIndex = 1
        while keybindRegistryIndex <= #_buttonRegistry do
            keybindRegEntry = _buttonRegistry[keybindRegistryIndex]
            if keybindRegEntry.tab == keybindTabName and keybindRegEntry.type ~= "slider" then
                table.insert(keybindTabEntries, keybindRegEntry)
            end
            keybindRegistryIndex += 1
        end
        if #keybindTabEntries > 0 then
            keybindSectionHeader = createKeybindSectionHeader(keybindTabName)
            table.insert(allKbElements, {element = keybindSectionHeader, names = {}})
            keybindTabEntryIndex = 1
            while keybindTabEntryIndex <= #keybindTabEntries do
                keybindRowRegEntry = keybindTabEntries[keybindTabEntryIndex]
                keybindCreatedRow = createKeybindRow(keybindRowRegEntry)
                table.insert(allKbElements, {element = keybindCreatedRow, names = {keybindRowRegEntry.name:lower()}})
                keybindTabEntryIndex += 1
            end
        end
        keybindTabOrderIndex += 1
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = searchBox.Text:lower()
        if query == "" then
            for _, item in ipairs(allKbElements) do
                item.element.Visible = true
            end
            return
        end
        local currentHeader = nil
        local headerHasMatch = false
        for _, item in ipairs(allKbElements) do
            if #item.names == 0 then
                if currentHeader then
                    currentHeader.Visible = headerHasMatch
                end
                currentHeader = item.element
                headerHasMatch = false
            else
                local matches = false
                for _, name in ipairs(item.names) do
                    if name:find(query, 1, true) then
                        matches = true
                        break
                    end
                end
                item.element.Visible = matches
                if matches then
                    headerHasMatch = true
                end
            end
        end
        if currentHeader then
            currentHeader.Visible = headerHasMatch
        end
    end)

    registerUiSync(_allTextSyncs, function()
        for bindName, rowData in pairs(keybindRows) do
            rowData.keybindLabel.Text = getKeyDisplayName(S.keybinds[bindName])
        end
	end)
end

