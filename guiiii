local Movement = {}

function Movement.chooseMode(state, ore)
  if Settings.Move_Under_Ground or Settings.Hide_In_Ground or Settings.Crouch_Under_Ground then
    return 'underground'
  end
  if Settings.MoveFlyAbove then
    return 'fly_above'
  end
  if Settings.MoveHorse then
    return 'horse'
  end
  return 'fly_or_walk'
end

