local function sliderBoundsForKey(key, value)
	local name = tostring(key or ""):lower()
	if name:find("window_size_x", 1, true) then
		return 300, 1000, 0
	end
	if name:find("window_size_y", 1, true) then
		return 250, 800, 0
	end
	if name:find("window_position", 1, true) then
		return 0, 1600, 0
	end
	if name:find("reflectance", 1, true) or name:find("transparency", 1, true) then
		return 0, 1, 2
	end
	if name:find("offset", 1, true) or name:find("placement", 1, true) then
		return -25, 25, 1
	end
	if name:find("wait", 1, true) or name:find("delay", 1, true) or name:find("elapsed", 1, true) then
		return 0, 60, 2
	end
	if name:find("speed", 1, true) or name:find("health", 1, true) then
		return 0, 100, 0
	end
	if name:find("players", 1, true) then
		return 0, 30, 0
	end
	if name:find("distance", 1, true) or name:find("thickness", 1, true) then
		return 0, 500, 0
	end
	if typeof(value) == "number" and value < 0 then
		return -100, 100, 1
	end
	return 0, 100, 0
end

local function roundSliderValue(value, decimals)
	local multiplier = 10 ^ (decimals or 0)
	return math.floor((value * multiplier) + 0.5) / multiplier
end

local function makeNumberInput(parent, spec)
	local key = spec.storageKey or spec.key
	local row = rowFrame(parent, 33)
	labelText(row, spec.label or "Slider", UDim2.new(1, -10, 0, 16))
	local detector = create("TextButton", {
		Parent = row,
		Position = UDim2.new(0, 5, 0, 17),
		Size = UDim2.new(1, -10, 0, 16),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BorderColor3 = Theme.BorderLight,
		BorderMode = Enum.BorderMode.Inset,
		AutoButtonColor = false,
		Text = "",
	})
	local fill = create("Frame", {
		Parent = detector,
		BackgroundColor3 = Color3.fromRGB(65, 65, 65),
		BorderSizePixel = 0,
		Size = UDim2.new(0, 100, 1, 0),
	})
	local valueLabel = create("TextLabel", {
		Parent = detector,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Font = Enum.Font.Gotham,
		TextColor3 = Theme.Text,
		TextSize = 10,
		TextWrapped = true,
		Text = tostring(Settings[key] or 0),
	})
	local dragging = false
	local hovering = false
	local minValue, maxValue, decimals = sliderBoundsForKey(key, Settings[key])

	local function refresh()
		local value = safeNumber(Settings[key], 0)
		local range = maxValue - minValue
		local percent = range ~= 0 and math.clamp((value - minValue) / range, 0, 1) or 0
		fill.Size = UDim2.new(percent, 0, 1, 0)
		valueLabel.Text = tostring(value)
	end

	local function setFromPosition(x)
		local width = math.max(detector.AbsoluteSize.X, 1)
		local offset = math.clamp(x - detector.AbsolutePosition.X, 0, width)
		local value = minValue + ((offset / width) * (maxValue - minValue))
		Settings[key] = roundSliderValue(value, decimals)
		refresh()
		setStatus(("Set %s = %s"):format(key, tostring(Settings[key])))
	end

	detector.MouseEnter:Connect(function()
		hovering = true
		detector.BorderColor3 = Theme.Accent
		valueLabel.TextColor3 = Theme.Accent
	end)
	detector.MouseLeave:Connect(function()
		hovering = false
		if not dragging then
			detector.BorderColor3 = Theme.BorderLight
			valueLabel.TextColor3 = Theme.Text
		end
	end)
	detector.MouseButton1Down:Connect(function(x)
		dragging = true
		setFromPosition(x)
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			setFromPosition(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			if not hovering then
				detector.BorderColor3 = Theme.BorderLight
				valueLabel.TextColor3 = Theme.Text
			end
		end
	end)
	settingWidgets[key] = {
		refresh = refresh,
	}
	refresh()
	return row
end

