function __westwareConnectPanicKey()
    _UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if destroyed or not isSessionActive() or gameProcessed then
            return
        end
        if isCapturingKey() or _UserInputService:GetFocusedTextBox() then
            return
        end
        if panicKeyCode and input.KeyCode == panicKeyCode then
            destroyed = true
            runtimeEnv._FOB_GUI_ONLY_ROOT = nil
            runtimeEnv._FOB_GUI_ONLY_TOKEN = nil
            pcall(function()
                if type(stopAutoMine) == "function" then
                    stopAutoMine()
                end
            end)
            pcall(function()
                if type(clearRecordedPathVisuals) == "function" then
                    clearRecordedPathVisuals()
                end
            end)
            pcall(function()
                if type(clearPathVisualization) == "function" then
                    clearPathVisualization()
                end
            end)
            pcall(function()
                if type(clearPathBearPreventionVisuals) == "function" then
                    clearPathBearPreventionVisuals()
                end
            end)
            pcall(function()
                if type(disconnectCustomCursorAll) == "function" then
                    customCursorState.enabled = false
                    disconnectCustomCursorAll()
                    _UserInputService.MouseIcon = ""
                end
            end)
            pcall(function()
                if type(restoreDynamiteSpectateCamera) == "function" then
                    restoreDynamiteSpectateCamera()
                end
            end)
            pcall(function()
                if type(restoreMolotovSpectateCamera) == "function" then
                    restoreMolotovSpectateCamera()
                end
            end)
            pcall(function()
                if type(restoreMolotovTeleportHooks) == "function" then
                    restoreMolotovTeleportHooks()
                end
            end)
            for _, gui in ipairs(_extraCleanupGuis) do
                pcall(function()
                    gui:Destroy()
                end)
            end
            pcall(function()
                hubGui:Destroy()
            end)
        end
	end)
end

