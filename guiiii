function getOreRemainingValue(oreDeposit)
	local depositInfo = oreDeposit and oreDeposit:FindFirstChild("DepositInfo")
	local oreRemaining = depositInfo and depositInfo:FindFirstChild("OreRemaining")
	if oreRemaining and oreRemaining:IsA("NumberValue") then
		return oreRemaining
	end

	return nil
end

function getOreHealthValues(oreDeposit)
	local oreRemaining = getOreRemainingValue(oreDeposit)
	if not oreRemaining then
		return nil, nil
	end

	local currentValue = tonumber(oreRemaining.Value)
	if currentValue == nil then
		return nil, nil
	end

	local roundedCurrent = math.max(0, math.floor(currentValue + 0.5))
	local depositInfo = oreDeposit and oreDeposit:FindFirstChild("DepositInfo")
	local maxValue = nil

	if depositInfo then
		for _, childName in ipairs({ "MaxOreRemaining", "MaxHealth", "MaxOreHealth" }) do
			local child = depositInfo:FindFirstChild(childName)
			if child and child:IsA("NumberValue") then
				maxValue = tonumber(child.Value)
				break
			end
		end
	end

	if type(maxValue) == "number" then
		maxValue = math.max(roundedCurrent, math.floor(maxValue + 0.5))
	end

	return roundedCurrent, maxValue
end

function getOreDepositMaxOreCount(groupName, oreDeposit)
	local depositName = tostring(groupName or getOreGroupName(oreDeposit) or "")
	if depositName == "" then
		return nil
	end

	local sharedData = resolveSharedDataModule(false)
	local oreDepositInfo = isTable(sharedData) and (rawget(sharedData, "OreDepositInfo") or sharedData.OreDepositInfo) or nil
	local depositInfo = isTable(oreDepositInfo) and (rawget(oreDepositInfo, depositName) or oreDepositInfo[depositName]) or nil
	local maxOre = isTable(depositInfo) and tonumber(rawget(depositInfo, "Ore") or depositInfo.Ore) or nil
	if not maxOre then
		maxOre = tonumber(FALLBACK_ORE_DEPOSIT_MAX_ORES[depositName])
	end

	if not maxOre and oreDeposit then
		local runtimeDepositInfo = oreDeposit:FindFirstChild("DepositInfo")
		if runtimeDepositInfo then
			for _, childName in ipairs({ "MaxOreRemaining", "MaxOre", "OreMax", "OreCapacity" }) do
				local child = runtimeDepositInfo:FindFirstChild(childName)
				if child and child:IsA("NumberValue") then
					maxOre = tonumber(child.Value)
					break
				end
			end
		end
	end

	if type(maxOre) ~= "number" or maxOre <= 0 then
		return nil
	end
	return math.max(1, math.floor(maxOre + 0.5))
end

function getOreDepositRemainingCount(oreDeposit)
	local oreRemaining = getOreRemainingValue(oreDeposit)
	local remainingValue = oreRemaining and tonumber(oreRemaining.Value) or 0
	return math.max(0, math.floor((remainingValue or 0) + 0.5))
end

function buildPathOrePurityReport(pathData)
	if not isTable(pathData) or type(pathData.ores) ~= "table" or #pathData.ores == 0 then
		return nil
	end

	local totalMax = 0
	local totalRemaining = 0
	local checkedDeposits = 0
	local missingDeposits = 0
	local unresolvedDeposits = 0
	for _, oreTarget in ipairs(pathData.ores) do
		local oreNodeIndex = normalizePathNodeIndex(oreTarget.nodeIndex, #(pathData.nodes or {}))
		if (not oreNodeIndex) or not isPathNodeDisconnected(pathData, oreNodeIndex) then
			local resolvedOre = resolveSavedOreTarget(oreTarget, true)
			local maxOre = getOreDepositMaxOreCount(oreTarget.groupName, resolvedOre)
			if maxOre then
				local remaining = resolvedOre and getOreDepositRemainingCount(resolvedOre) or 0
				remaining = math.clamp(remaining, 0, maxOre)
				totalMax += maxOre
				totalRemaining += remaining
				checkedDeposits += 1
				if remaining < maxOre then
					missingDeposits += 1
				end
			else
				unresolvedDeposits += 1
			end
		end
	end

	if totalMax <= 0 or checkedDeposits <= 0 then
		return nil
	end

	local totalMissing = math.max(0, totalMax - totalRemaining)
	return {
		totalMax = totalMax,
		totalRemaining = totalRemaining,
		totalMissing = totalMissing,
		missingPercent = (totalMissing / totalMax) * 100,
		checkedDeposits = checkedDeposits,
		missingDeposits = missingDeposits,
		unresolvedDeposits = unresolvedDeposits,
	}
end

function formatOreHealthText(oreDeposit, includeLabel)
	local currentValue, maxValue = getOreHealthValues(oreDeposit)
	if currentValue == nil then
		return includeLabel == false and "nil" or "HP: ?"
	end

	local healthText = maxValue and string.format("%d/%d", currentValue, maxValue) or tostring(currentValue)
	if includeLabel == false then
		return healthText
	end

	return "HP: " .. healthText
end

function getOreBasePart(oreDeposit)
	if not oreDeposit then
		return nil
	end

	local rockBase = oreDeposit:FindFirstChild("RockBase")
	if rockBase and rockBase:IsA("BasePart") then
		return rockBase
	end

	local rockOre = oreDeposit:FindFirstChild("RockOre")
	if rockOre and rockOre:IsA("BasePart") then
		return rockOre
	end

	return oreDeposit:FindFirstChildWhichIsA("BasePart", true)
end

function getOreRenderParts(oreDeposit)
	local oreParts = {}
	local seen = {}

	local function tryAdd(part)
		if part and part:IsA("BasePart") and not seen[part] then
			seen[part] = true
			table.insert(oreParts, part)
		end
	end

	tryAdd(oreDeposit and oreDeposit:FindFirstChild("RockBase"))
	tryAdd(oreDeposit and oreDeposit:FindFirstChild("RockOre"))
	tryAdd(getOreBasePart(oreDeposit))

	return oreParts
end

function getOrePosition(oreDeposit)
	local orePart = getOreBasePart(oreDeposit)
	if orePart then
		return orePart.Position
	end

	local ok, pivot = pcall(function()
		return oreDeposit:GetPivot()
	end)

	if ok then
		return pivot.Position
	end

	return nil
end

function isOreAvailable(oreDeposit)
	local oreRemaining = getOreRemainingValue(oreDeposit)
	return oreRemaining and oreRemaining.Value > 0
end

