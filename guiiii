function ensureNoRollCooldownHooks()
	if not playerState.noRollCooldownEnabled then
		return
	end

	local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	if not isTable(playerCharacter) then
		restoreNoRollCooldownHooks()
		return
	end

	local rollFn = rawget(playerCharacter, "Roll") or playerCharacter.Roll
	local stopRollFn = rawget(playerCharacter, "StopRoll") or playerCharacter.StopRoll
	if type(rollFn) ~= "function" and type(stopRollFn) ~= "function" then
		restoreNoRollCooldownHooks()
		return
	end

	local needsInstall = playerState.noRollCooldownOwner ~= playerCharacter
		or (type(rollFn) == "function" and playerCharacter.Roll ~= playerState.noRollCooldownRollWrapper)
		or (type(stopRollFn) == "function" and playerCharacter.StopRoll ~= playerState.noRollCooldownStopRollWrapper)
	if needsInstall then
		restoreNoRollCooldownHooks()
		playerState.noRollCooldownOwner = playerCharacter

		if type(rollFn) == "function" then
			playerState.originalNoRollCooldownRoll = rollFn
			playerState.noRollCooldownRollWrapper = function(self, ...)
				if playerState.noRollCooldownEnabled then
					clearNoRollCooldownState(self)
				end

				local results = table.pack(playerState.originalNoRollCooldownRoll(self, ...))
				return table.unpack(results, 1, results.n)
			end
			playerCharacter.Roll = playerState.noRollCooldownRollWrapper
		end

		if type(stopRollFn) == "function" then
			playerState.originalNoRollCooldownStopRoll = stopRollFn
			playerState.noRollCooldownStopRollWrapper = function(self, ...)
				if playerState.noRollCooldownEnabled and isTable(self) then
					rawset(self, "RollDirection", nil)
					clearNoRollCooldownState(self)
					return nil
				end

				local results = table.pack(playerState.originalNoRollCooldownStopRoll(self, ...))
				return table.unpack(results, 1, results.n)
			end
			playerCharacter.StopRoll = playerState.noRollCooldownStopRollWrapper
		end
	end

	clearNoRollCooldownState(playerCharacter)
end

function clampSpeedChangerValue(value)
	return math.clamp(
		math.floor((tonumber(value) or PLAYER_SPEED_CHANGER_DEFAULT) + 0.5),
		PLAYER_SPEED_CHANGER_MIN,
		PLAYER_SPEED_CHANGER_MAX
	)
end

function getSpeedChangerValue()
	local value = clampSpeedChangerValue(playerState.speedChangerValue or S.speedChangerValue)
	playerState.speedChangerValue = value
	S.speedChangerValue = value
	return value
end

function shouldRunSpeedChanger(character, humanoid, rootPart)
	if not (playerState.speedChangerEnabled and character and humanoid and rootPart) then
		return false
	end
	if humanoid.Health <= 0 then
		return false
	end
	if autoMineEnabled or (type(pathState) == "table" and pathState.playbackActive == true) then
		return false
	end

	local playerCharacter = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	if isTable(playerCharacter) then
		local blockedFlags = {
			"Swimming",
			"Flying",
			"Climbing",
			"UsingBroomstick",
			"Rappeling",
			"Sitting",
			"IsDead",
			"IsTiedUp",
		}
		for _, flagName in ipairs(blockedFlags) do
			if playerCharacter[flagName] == true then
				return false
			end
		end
		local isRolling = rawget(playerCharacter, "IsRolling") or playerCharacter.IsRolling
		if type(isRolling) == "function" then
			local okRolling, rolling = pcall(isRolling, playerCharacter)
			if okRolling and rolling == true then
				return false
			end
		end
		local isRagdolled = rawget(playerCharacter, "IsRagdolled") or playerCharacter.IsRagdolled
		if type(isRagdolled) == "function" then
			local okRagdolled, ragdolled = pcall(isRagdolled, playerCharacter)
			if okRagdolled and ragdolled == true then
				return false
			end
		end
		local isSittingOrRiding = rawget(playerCharacter, "IsSittingOrRiding") or playerCharacter.IsSittingOrRiding
		if type(isSittingOrRiding) == "function" then
			local okSitting, sittingOrRiding = pcall(isSittingOrRiding, playerCharacter)
			if okSitting and sittingOrRiding == true then
				return false
			end
		end
	end

	return true
end

function resetSpeedChangerRuntime()
	playerState.speedChangerLastFlatPosition = nil
	playerState.speedChangerLastMoveDirection = nil
end

function detectSpeedChangerRubberBand(rootPart)
	local lastFlatPosition = playerState.speedChangerLastFlatPosition
	local lastDirection = playerState.speedChangerLastMoveDirection
	if typeof(lastFlatPosition) ~= "Vector3" or typeof(lastDirection) ~= "Vector3" or lastDirection.Magnitude <= 0 then
		return false
	end

	local flatPosition = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z)
	local flatDelta = flatPosition - lastFlatPosition
	if flatDelta.Magnitude < 2.25 then
		return false
	end

	return flatDelta.Unit:Dot(lastDirection.Unit) < -0.35
end

function markSpeedChangerRubberBand()
	local now = os.clock()
	if now - (tonumber(playerState.speedChangerLastRubberBandAt) or 0) < 0.6 then
		return
	end

	playerState.speedChangerLastRubberBandAt = now
	playerState.speedChangerBackoffUntil = now + PLAYER_SPEED_CHANGER_RUBBERBAND_BACKOFF_SECONDS
	playerState.speedChangerBackoffSpeed = math.max(
		PLAYER_SPEED_CHANGER_WALKSPEED_CAP,
		getSpeedChangerValue() * PLAYER_SPEED_CHANGER_RUBBERBAND_BACKOFF_MULTIPLIER
	)
	resetSpeedChangerRuntime()
	pushDebugRateLimited("speed_changer_rubberband", "speed changer backed off after rubber band", 1)
	if type(notifyRubberBandDetected) == "function" then
		notifyRubberBandDetected()
	end
end

function getSpeedChangerEffectiveSpeed()
	local targetSpeed = getSpeedChangerValue()
	local now = os.clock()
	if now < (tonumber(playerState.speedChangerBackoffUntil) or 0) then
		targetSpeed = math.min(targetSpeed, tonumber(playerState.speedChangerBackoffSpeed) or targetSpeed)
	end
	return math.clamp(targetSpeed, PLAYER_SPEED_CHANGER_MIN, PLAYER_SPEED_CHANGER_MAX)
end

function applySpeedChangerPulse(dt)
	local character = getWorldCharacterForPlayer(localPlayer) or (localPlayer and localPlayer.Character)
	local humanoid = getCharacterHumanoid(character)
	local rootPart = getRootPart(character)
	if not shouldRunSpeedChanger(character, humanoid, rootPart) then
		resetSpeedChangerRuntime()
		return
	end

	if detectSpeedChangerRubberBand(rootPart) then
		markSpeedChangerRubberBand()
		return
	end

	local moveDirection = humanoid.MoveDirection
	local flatMoveDirection = moveDirection and Vector3.new(moveDirection.X, 0, moveDirection.Z) or Vector3.zero
	if flatMoveDirection.Magnitude <= MOVE_DIRECTION_DEADZONE then
		resetSpeedChangerRuntime()
		return
	end
	flatMoveDirection = flatMoveDirection.Unit

	local targetSpeed = getSpeedChangerEffectiveSpeed()
	local dtSeconds = math.clamp(tonumber(dt) or (1 / 60), 1 / 240, 1 / 20)
	local velocity = rootPart.AssemblyLinearVelocity or rootPart.Velocity
	local verticalVelocity = velocity.Y
	local currentFlatVelocity = Vector3.new(velocity.X, 0, velocity.Z)
	local targetFlatVelocity = flatMoveDirection * targetSpeed
	local maxDelta = PLAYER_SPEED_CHANGER_ACCEL * dtSeconds
	local deltaVelocity = targetFlatVelocity - currentFlatVelocity
	local nextFlatVelocity = targetFlatVelocity
	if deltaVelocity.Magnitude > maxDelta then
		nextFlatVelocity = currentFlatVelocity + (deltaVelocity.Unit * maxDelta)
	end

	local maxWalkSpeed = math.min(targetSpeed, PLAYER_SPEED_CHANGER_WALKSPEED_CAP)
	if humanoid.WalkSpeed < maxWalkSpeed then
		humanoid.WalkSpeed = maxWalkSpeed
	end

	local nextVelocity = Vector3.new(nextFlatVelocity.X, verticalVelocity, nextFlatVelocity.Z)
	pcall(function()
		rootPart.AssemblyLinearVelocity = nextVelocity
	end)
	pcall(function()
		rootPart.Velocity = nextVelocity
	end)

	playerState.speedChangerLastFlatPosition = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z)
	playerState.speedChangerLastMoveDirection = flatMoveDirection
end

function restoreSpeedChangerHooks()
	if playerState.speedChangerConnection then
		pcall(function()
			playerState.speedChangerConnection:Disconnect()
		end)
