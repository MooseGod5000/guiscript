local StateHandlers = {}

function StateHandlers.record(runtime, stateName)
  runtime.rebuiltState = stateName
  analysis_state_rebuild(stateName, PredicateFlow.states[stateName])
  return runtime
end

function StateHandlers.evaluate(runtime, stateName)
  local spec = PredicateFlow.states[stateName]
  if not spec then
    return stateName
  end
  for _, guard in ipairs(spec.guards or {}) do
    analysis_guard_hint(guard)
  end
  for _, predicate in ipairs(spec.predicates or {}) do
    analysis_predicate_rebuild(predicate.id, stateName, predicate.to, predicate.expression, predicate.exactness)
  end
  return analysis_state_transition_choice(runtime, spec.transitions, spec.predicates)
end

function StateHandlers.runController(runtime)
  analysis_note('proto_279 controller rebuilt as a finite state/predicate map; no operational loop is emitted.')
  runtime.rebuiltStateOrder = PredicateFlow.order
  for _, stateName in ipairs(PredicateFlow.order) do
    StateHandlers.record(runtime, stateName)
    StateHandlers.evaluate(runtime, stateName)
  end
  return runtime
end

