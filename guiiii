function AutoMine.prepare(runtime)
  setStatus(runtime, 'checking prerequisites')
  analysis_phase("startup and prerequisites", "Clear visuals/path state, check pickaxe/character availability, and wait for required entities.")
  analysis_evidence("L0005-L0011", "Read/update ore deposits, path settings, path filters, or ore quality data.", "clearAll | WAIT | Path_Player | Path_Wait_Time")
  analysis_evidence("L0032-L0045", "Report status: Auto Mine | No Pick", "warn | Auto Mine | No Pick | WAIT | Data")
  analysis_evidence("L0067-L0119", "Report status: Auto Mine | Missing Player Character; Auto Mine | Show Path; Auto Mine | Failed to spawn, cycling paths", "warn | Auto Mine | Missing Player Character | a | Hide_In_Ground")
  analysis_evidence("L0265-L0273", "Read/update ore deposits, path settings, path filters, or ore quality data.", "warn | Auto Mine | Clearing Visuals | clearAll | Show_Path")
  HelperSemantics.resolveCharacter(runtime)
  analysis_clear_path_visuals(runtime)
  if not runtime.pickaxe then
    return analysis_stop(runtime, 'No Pick')
  end
  if not runtime.character then
    return analysis_retry_or_stop(runtime, 'Missing Player Character')
  end
  analysis_disable_interfering_states(runtime.character)
  return true
end

function AutoMine.loadPath(runtime)
  setStatus(runtime, 'loading path data')
  analysis_phase("path and ore selection", "Choose path data and candidate ore based on filters, remaining ore, pick tier, and server quality.")
  analysis_evidence("L0005-L0011", "Read/update ore deposits, path settings, path filters, or ore quality data.", "clearAll | WAIT | Path_Player | Path_Wait_Time")
  analysis_evidence("L0138-L0187", "Evaluate server/path ore quality and possibly trigger auto-hop notification or hop behavior.", "SetStateEnabled | Enum | HumanoidStateType | Swimming")
  analysis_evidence("L0199-L0210", "Move the player/horse/fly controller toward ore/path waypoints.", "Crouch_On_Ore | CFrame | LookVector | FindFirstChild")
  analysis_evidence("L0256-L0257", "Evaluate server/path ore quality and possibly trigger auto-hop notification or hop behavior.", "")
  runtime.currentPath = analysis_choose_path(runtime.savedPaths, Settings)
