local pendingPathSettingsPersist = false
function schedulePathSettingsPersist()
	if pendingPathSettingsPersist then
		return
	end
	pendingPathSettingsPersist = true
	task.delay(0.2, function()
		pendingPathSettingsPersist = false
		if type(savePathsToStorage) == "function" then
			pcall(savePathsToStorage, false)
		end
	end)
end

function persistPathSettings(skipPersistence)
	if skipPersistence then
		return false
	end
	schedulePersist()
	schedulePathSettingsPersist()
	return true
end

setPathRecordNodeSpacing = function(value, skipPersistence)
	local nextValue = math.clamp(math.floor(((tonumber(value) or getPathRecordNodeSpacing()) * 10) + 0.5) / 10, 1, 10)
