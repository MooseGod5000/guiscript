function visualizePathPoints(points, targetPosition, opts)
	opts = type(opts) == "table" and opts or {}
	if pathState.playbackActive and opts.allowDuringPlayback ~= true then
		return
	end

	local now = os.clock()
	if opts.allowDuringPlayback ~= true and targetPosition and lastPathVizTarget and (now - lastPathVizAt) < PATH_VIZ_REFRESH_INTERVAL then
		local delta = (targetPosition - lastPathVizTarget).Magnitude
		if delta <= PATH_VIZ_TARGET_EPSILON and math.abs(#points - lastPathVizCount) <= 1 then
			return
		end
	end

	clearPathVisualization()
	lastPathVizAt = now
	lastPathVizTarget = targetPosition
	lastPathVizCount = #points

	if opts.storeEntryPathPoints then
		local entryPoints = {}
		local lastStoredPoint = nil
		for _, point in ipairs(points) do
			if typeof(point) == "Vector3" and (not lastStoredPoint or (point - lastStoredPoint).Magnitude > 0.05) then
				table.insert(entryPoints, point)
				lastStoredPoint = point
			end
		end
		if typeof(targetPosition) == "Vector3" then
			local lastEntryPoint = entryPoints[#entryPoints]
			if typeof(lastEntryPoint) ~= "Vector3" or (lastEntryPoint - targetPosition).Magnitude > 0.05 then
				table.insert(entryPoints, targetPosition)
			end
		end
		pathState.entryPathPoints = entryPoints
	end

	local startColor = opts.startColor or Color3.fromRGB(80, 180, 255)
	local pointColor = opts.pointColor or PATH_VISUAL_NODE_COLOR
	local lineColor = opts.lineColor or PATH_VISUAL_LINE_COLOR
	local targetColor = opts.targetColor or Color3.fromRGB(110, 255, 140)
	local targetSize = opts.targetSize or Vector3.new(0.92, 0.92, 0.92)

	local previousPosition = nil
	for index, point in ipairs(points) do
		local markerColor = index == 1 and startColor or pointColor
		createPathMarker(point, markerColor)
		if previousPosition then
			createPathSegment(previousPosition, point, lineColor)
		end
		previousPosition = point
	end

	if targetPosition then
		createPathMarker(targetPosition, targetColor, targetSize)
		if previousPosition then
			createPathSegment(previousPosition, targetPosition, lineColor)
		end
	end
end

