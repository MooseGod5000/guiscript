    collectBreakWindowCandidatesFromTable(breakableGlass, list, seenInstances, {}, 0)
    for _, instance in ipairs(workspace:GetDescendants()) do
        if instance:IsA("BasePart") and isLikelyWindowGlassPart(instance) and not seenInstances[instance] then
            seenInstances[instance] = true
            table.insert(list, instance)
        end
    end
    return list
end
function getBreakWindowNormal(originPosition, glassPart)
