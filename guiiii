function automineCloneDefaultValue(value)
    if type(value) ~= "table" then
        return value
    end

    local cloned = {}
    for key, child in pairs(value) do
        cloned[key] = automineCloneDefaultValue(child)
    end
    return cloned
end

function automineCreateDefaultState()
    local state = {}
    for key, value in pairs(DEFAULTS) do
        state[key] = automineCloneDefaultValue(value)
    end
    state.keybinds = {
        dynamiteMark = Enum.KeyCode.F,
        molotovMark = Enum.KeyCode.G,
    }
    return state
end

function automineCopyDefaultsIntoState(target)
    for key in pairs(target) do
        target[key] = nil
    end
    local freshState = automineCreateDefaultState()
    for key, value in pairs(freshState) do
        target[key] = value
    end
end

