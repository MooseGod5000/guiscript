function getProjectileTargetPathAlignment(projectile, targetParts, tolerance)
    if type(targetParts) ~= "table" or #targetParts == 0 then
        return false, nil, nil, nil, nil
    end
    local lastPosition, currentPosition = getProjectileLiveSegment(projectile)
    if typeof(lastPosition) == "Vector3" and typeof(currentPosition) == "Vector3" then
        local segment = currentPosition - lastPosition
        if segment.Magnitude > 0.001 then
            local okRay, rayHitPart, rayHitPosition, rayHitNormal = pcall(function()
                local hitPart, position, normal = workspace:FindPartOnRayWithWhitelist(
                    Ray.new(lastPosition, segment),
                    targetParts
                )
                if hitPart then
                    return hitPart, position, normal
                end
                return nil, nil, nil
            end)
            if okRay and typeof(rayHitPosition) == "Vector3" then
                local hitTime = getProjectileSegmentHitTime(projectile, lastPosition, currentPosition, rayHitPosition)
                return true, rayHitPosition, hitTime, rayHitNormal, rayHitPart
            end
        end
    end
    local bestPart, bestPoint, bestDistance
    for _, candidatePart in ipairs(targetParts) do
        if candidatePart and candidatePart:IsA("BasePart") and candidatePart.Parent then
            local closestPoint, distance = getPointSegmentClosestPoint(candidatePart.Position, lastPosition, currentPosition)
            if closestPoint
                and distance <= (tonumber(tolerance) or TP_PROJECTILE_ALIGNMENT_TOLERANCE)
                and isPointInsideFastProjectilePartBounds(candidatePart, closestPoint, 0.1)
                and (not bestDistance or distance < bestDistance) then
                bestPart = candidatePart
                bestPoint = closestPoint
                bestDistance = distance
            end
        end
    end
    if bestPart then
        local hitTime = getProjectileSegmentHitTime(projectile, lastPosition, currentPosition, bestPoint)
        local hitNormal = typeof(projectile and projectile.Velocity) == "Vector3" and projectile.Velocity.Magnitude > 0.001
            and -projectile.Velocity.Unit
