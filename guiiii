function applySerializedKeybinds(data)
    if type(data.guiToggleKey) == "string" then
        local code = keyNameToCode(data.guiToggleKey)
        if code then
            guiToggleKeyCode = code
            guiToggleKeyName = data.guiToggleKey
        end
    end
    if type(data.panicKey) == "string" then
        local code = keyNameToCode(data.panicKey)
        if code then
            panicKeyCode = code
            panicKeyName = data.panicKey
        else
            panicKeyCode = nil
            panicKeyName = "none"
        end
    end
    S.keybinds = {}
    if type(data.keybinds) == "table" then
        for bindKey, keyName in pairs(data.keybinds) do
            if type(bindKey) == "string" and type(keyName) == "string" then
                local code = keyNameToCode(keyName)
                if code then
                    S.keybinds[bindKey] = code
                end
            end
        end
    end
end
function serializeState()
    syncRuntimeAutomineSettingsToState()
    local payload = {
        guiToggleKey = guiToggleKeyName,
        panicKey = panicKeyName,
        keybinds = {},
    }
    for _, spec in ipairs(SETTING_SPECS) do
        payload[spec.key] = serializeSpecValue(spec)
    end
    for bindKey, keyCode in pairs(S.keybinds) do
        if keyCode and typeof(keyCode) == "EnumItem" then
            payload.keybinds[bindKey] = keyCode.Name
        end
    end
    return payload
end
function applySerializedState(data)
    if type(data) ~= "table" then
        return false
    end
    for _, spec in ipairs(SETTING_SPECS) do
        local value = data[spec.key]
        if value ~= nil then
            if type(spec.apply) == "function" then
                spec.apply(value, data)
            else
                applyTypedSetting(spec, value)
            end
        end
    end
    applySerializedKeybinds(data)
    -- Sync runtime automine variables with S table
    autoPickupEnabled = S.autoPickupEnabled
    autoPickupWhitelistEnabled = S.autoPickupWhitelistEnabled
    selectedOreNames = cloneBooleanMap(S.selectedOreNames)
    selectedPickupNames = cloneBooleanMap(S.selectedPickupNames)
    autoSellEnabled = S.autoSellEnabled
    autoSellThreshold = S.autoSellThreshold
    serverHopEnabled = S.serverHopEnabled
    mineAuraEnabled = S.mineAuraEnabled
    S.pickaxeProgressionEnabled = S.pickaxeProgressionEnabled == true
    return true
end
