    for _, priorityName in ipairs(getMeleeAuraPriorityOrder()) do
        local targets = targetsByPriority[priorityName]
        if type(targets) == "table" then
            table.sort(targets, function(left, right)
                local leftDistance = left and left.position and (left.position - originPosition).Magnitude or math.huge
                local rightDistance = right and right.position and (right.position - originPosition).Magnitude or math.huge
                return leftDistance < rightDistance
            end)
            for _, targetInfo in ipairs(targets) do
                local targetPart = targetInfo and targetInfo.part
                if targetPart and targetPart.Parent then
                    local targetPosition = targetPart.Position
                    local distance = (targetPosition - originPosition).Magnitude
                    if distance <= range then
                        targetInfo.position = targetPosition
