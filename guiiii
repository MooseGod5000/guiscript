function getNoRecoilHookRegistry()
    local registry = rawget(_G, "__AutoMineNoRecoilHookRegistry")
    if type(registry) ~= "table" then
        registry = {}
        _G.__AutoMineNoRecoilHookRegistry = registry
    end
    return registry
end

function shouldBypassNoRecoilGuard()
    if type(debug) ~= "table" or type(debug.getconstants) ~= "function" then
        return false
    end

    local okConstants, constants = pcall(function()
        return debug.getconstants(2)
    end)
    return okConstants and type(constants) == "table" and table.find(constants, "StackSize") ~= nil
end

function makeNoRecoilGuardedWrapper(originalFn)
    return function(...)
        if shouldBypassNoRecoilGuard() then
            return originalFn(...)
        end
        if rawget(_G, "__AutoMineNoRecoilEnabled") == true then
            return nil
        end
        return originalFn(...)
    end
end

