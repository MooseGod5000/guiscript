local function displayWidth(text, padding, textSize)
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(tostring(text), textSize or 12, Enum.Font.Gotham, Vector2.new(math.huge, math.huge))
	end)
	if ok and bounds then
		return math.max(1, math.ceil(bounds.X + (padding or 12)))
	end
	return math.max(56, (#tostring(text) * 7) + (padding or 12))
end

