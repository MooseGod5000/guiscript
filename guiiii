		return cframeCharacterTowards(
			character,
			targetPosition,
			activeToken,
			getDirectPathTravelTimeout(character, targetPosition, 0.45),
			pathReachDistance,
			getCFrameMovementOptions({flatPathFollow = true, useUndergroundOffset = false,})
		)
	end
