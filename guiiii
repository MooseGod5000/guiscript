	local flingTargetRoot = findHorseFlingTargetRoot(scanPosition)
	local controlPosition, playerBaseCFrame = updateHorseFlingFakeControl(ridingAnimal, character, rootPart, horseRoot, dt)
	if typeof(controlPosition) ~= "Vector3" then
		return false
	end
	local hasFlingTarget = flingTargetRoot ~= nil
	local targetCFrame = nil
	if hasFlingTarget then
		local safetyCheck = (controlPosition - flingTargetRoot.Position).Magnitude
		if safetyCheck <= HORSE_FLING_TARGET_RANGE then
			local predictedPosition = getPredictedHorseFlingTargetPosition(flingTargetRoot, dt) or flingTargetRoot.Position
			targetCFrame = CFrame.new(predictedPosition)
				* CFrame.new(0, 0, HORSE_FLING_TARGET_DISTANCE)
				* CFrame.Angles(0, tick() * HORSE_FLING_TARGET_SPIN_SPEED, 0)
		else
