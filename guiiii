			pathState.workingPath.disconnectAfterNodeIndex = normalizedNodeIndex
			pathState.workingPath.reconnectNodeIndex = nil
			setPathEditorStatus("Disconnected after node #" .. tostring(normalizedNodeIndex) .. ".", UI_COLORS.warning)
		elseif normalizedNodeIndex > disconnectAfterNodeIndex then
