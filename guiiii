function ensureUndergroundPlatformHook()
	local clientPlatforms = resolveClientPlatformsModule(false) or resolveClientPlatformsModule(true)
	if not isTable(clientPlatforms) then
		return nil
	end

	if clientPlatforms ~= playerState.hookedUndergroundPlatformOwner then
		restoreUndergroundPlatformHook()
		playerState.hookedUndergroundPlatformOwner = clientPlatforms
	end

	local updateAnchorables = rawget(clientPlatforms, "UpdateAnchorables") or clientPlatforms.UpdateAnchorables
	if type(updateAnchorables) == "function" and updateAnchorables ~= playerState.undergroundUpdateAnchorablesWrapper then
		playerState.originalUndergroundUpdateAnchorables = updateAnchorables
		playerState.undergroundUpdateAnchorablesWrapper = function(self, ...)
			local result = playerState.originalUndergroundUpdateAnchorables(self, ...)
			local undergroundState = getUndergroundTravelState()
			if undergroundState and undergroundState.active and typeof(undergroundState.character) == "Instance" then
				local preservedPlatform = undergroundState.preservedPlatform or undergroundState.initialPlatform
				if preservedPlatform and type(rawget(self, "AddAnchorableRagdoll") or self.AddAnchorableRagdoll) == "function" then
					pcall(function()
						self:AddAnchorableRagdoll(undergroundState.character, preservedPlatform)
					end)
					local repChar = undergroundState.repChar or resolveLocalRepChar(false) or resolveLocalRepChar(true)
					if isTable(repChar) then
						undergroundState.repChar = repChar
						pcall(function()
							repChar.CurrentPlatform = preservedPlatform
							repChar.FloorPlatform = preservedPlatform
							repChar.LastFloorPlatform = preservedPlatform
							repChar.LastWasGrounded = true
						end)
					end
				end
			end
			return result
		end
		clientPlatforms.UpdateAnchorables = playerState.undergroundUpdateAnchorablesWrapper
	end

	return clientPlatforms
end

