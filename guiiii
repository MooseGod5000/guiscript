end

function restoreMolotovTeleportHooks()
    local hooks = type(S._molotovTeleportHooks) == "table" and S._molotovTeleportHooks or nil
    if not hooks then
        return
    end

    if hooks.utils and type(hooks.originalGetMouseHit) == "function" and hooks.utils.GetMouseHit == hooks.mouseHitWrapper then
        hooks.utils.GetMouseHit = hooks.originalGetMouseHit
    end
    hooks.utils = nil
    hooks.originalGetMouseHit = nil
    hooks.mouseHitWrapper = nil

    local itemHooks = type(hooks.itemHooks) == "table" and hooks.itemHooks or {}
    for item, hook in pairs(itemHooks) do
        if isTable(item) and type(hook) == "table" then
            if type(hook.originalNetworkActivate) == "function" and item.NetworkActivate == hook.networkActivateWrapper then
                item.NetworkActivate = hook.originalNetworkActivate
            end
            if type(hook.originalThrow) == "function" and item.Throw == hook.throwWrapper then
                item.Throw = hook.originalThrow
            end
        end
    end
    hooks.itemHooks = setmetatable({}, {__mode = "k"})
end

function ensureMolotovTeleportHooks()
    if not S.molotovTpEnabled then
        restoreMolotovTeleportHooks()
        return
    end

    local hooks = S._molotovTeleportHooks
    if type(hooks) ~= "table" then
        hooks = {
            itemHooks = setmetatable({}, {__mode = "k"}),
        }
        S._molotovTeleportHooks = hooks
    elseif type(hooks.itemHooks) ~= "table" then
        hooks.itemHooks = setmetatable({}, {__mode = "k"})
    end

    local utils = resolveMolotovUtils(false) or resolveMolotovUtils(true)
    if utils and utils.GetMouseHit ~= hooks.mouseHitWrapper then
        if hooks.utils and type(hooks.originalGetMouseHit) == "function" and hooks.utils.GetMouseHit == hooks.mouseHitWrapper then
            hooks.utils.GetMouseHit = hooks.originalGetMouseHit
        end
        hooks.utils = utils
        hooks.originalGetMouseHit = utils.GetMouseHit
        local originalGetMouseHit = hooks.originalGetMouseHit
        hooks.mouseHitWrapper = function(...)
            if S.molotovTpEnabled and isMolotovItemTool(getCurrentEquippedMolotovItem(false)) then
                local destCFrame, targetFound = getTwwMolotovTargetCFrame()
                if targetFound and destCFrame then
                    return destCFrame.Position, nil
                end
            end
            return originalGetMouseHit(...)
        end
        utils.GetMouseHit = hooks.mouseHitWrapper
    end

    local molotovItem = getCurrentEquippedMolotovItem(false) or getCurrentEquippedMolotovItem(true)
    if not isTable(molotovItem) then
        return
    end

    local itemHook = hooks.itemHooks[molotovItem]
    if type(itemHook) ~= "table" then
        itemHook = {}
        hooks.itemHooks[molotovItem] = itemHook
    end

    local networkActivate = rawget(molotovItem, "NetworkActivate") or molotovItem.NetworkActivate
    if type(networkActivate) == "function" and networkActivate ~= itemHook.networkActivateWrapper then
        itemHook.originalNetworkActivate = networkActivate
        itemHook.networkActivateWrapper = function(self, ...)
            local packedArgs = table.pack(...)
            local isThrow = tostring(packedArgs[1] or "") == "ThrowMolotov"
            if isThrow then
                noteMolotovThrowWindow()
            end
            local results = table.pack(itemHook.originalNetworkActivate(self, table.unpack(packedArgs, 1, packedArgs.n)))
            if isThrow then
                task.defer(function()
                    applyMolotovTeleportPulse(true)
                end)
            end
            return table.unpack(results, 1, results.n)
        end
        molotovItem.NetworkActivate = itemHook.networkActivateWrapper
    end

    local throw = rawget(molotovItem, "Throw") or molotovItem.Throw
    if type(throw) == "function" and throw ~= itemHook.throwWrapper then
        itemHook.originalThrow = throw
        itemHook.throwWrapper = function(self, ...)
            noteMolotovThrowWindow()
            local results = table.pack(itemHook.originalThrow(self, ...))
            task.defer(function()
                applyMolotovTeleportPulse(true)
            end)
            return table.unpack(results, 1, results.n)
        end
        molotovItem.Throw = itemHook.throwWrapper
    end
end

function isPlayerEspMethodEnabled(methodName)
