function setAnimatedSizedVisible(guiObject, visible, expandedHeight, instant, applyInteractiveState)
	if not guiObject then
		return
	end
	local guiState = S._rowTweenState[guiObject]
	if not guiState then
		guiState = {}
		S._rowTweenState[guiObject] = guiState
	end
	local targetHeight = tonumber(expandedHeight) or 38
	local targetSize = visible and UDim2.new(1, 0, 0, targetHeight) or UDim2.new(1, 0, 0, 0)
	guiObject.ClipsDescendants = true
	if applyInteractiveState then
		applyInteractiveState(guiObject, visible == true)
	end
	guiState.targetVisible = visible == true
	guiState.targetHeight = targetHeight
	if guiState.tween then
		pcall(function()
			guiState.tween:Cancel()
		end)
		guiState.tween = nil
	end
	if instant then
		guiObject.Visible = visible == true
		guiObject.Size = targetSize
		return
	end
	if visible then
		if not guiObject.Visible then
			guiObject.Visible = true
			guiObject.Size = UDim2.new(1, 0, 0, 0)
		end
	elseif not guiObject.Visible then
		guiObject.Size = targetSize
		return
	end
	local tween = playUiTween(guiObject, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = targetSize})
	guiState.tween = tween
	tween.Completed:Connect(function()
		if S._rowTweenState[guiObject] ~= guiState or guiState.tween ~= tween then
			return
		end
		guiState.tween = nil
		if guiState.targetVisible then
			guiObject.Visible = true
			guiObject.Size = UDim2.new(1, 0, 0, guiState.targetHeight or targetHeight)
		else
			guiObject.Visible = false
			guiObject.Size = UDim2.new(1, 0, 0, 0)
		end
	end)
end
