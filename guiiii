function setDiscordAutomineWebhookUrl(value, skipPersistence)
	local nextValue = string.match(tostring(value or ""), "^%s*(.-)%s*$") or ""
	if getDiscordAutomineWebhookUrl() == nextValue then
		return
	end
	S.discordAutomineWebhookUrl = nextValue
	if isDiscordAutomineWebhookUrlValid(nextValue) and type(syncAutomineWebhookTotalForCurrentUrl) == "function" then
		syncAutomineWebhookTotalForCurrentUrl(nextValue)
	end
	if isDiscordAutomineWebhookUrlValid(nextValue) and type(syncAutomineWebhookAccountTotalForCurrentUrl) == "function" then
		syncAutomineWebhookAccountTotalForCurrentUrl(nextValue)
	end
	if not isDiscordAutomineWebhookUrlValid(nextValue) and S.discordAutomineWebhookTrackingEnabled then
		S.discordAutomineWebhookTrackingEnabled = false
		if type(spawnNotification) == "function" then
			spawnNotification("Webhook tracking turned off because the webhook is no longer valid.", "warning", true)
		end
	end
	if skipPersistence then
		return
	end
	schedulePersist()
end

function setDiscordAutomineWebhookTrackingEnabled(value, skipPersistence)
	local nextValue = value == true
	if nextValue and not isDiscordAutomineWebhookUrlValid() then
		notifyUser("Webhook", "Enter a valid Discord webhook first.", 4)
		S.discordAutomineWebhookTrackingEnabled = false
		return false
	end
	if S.discordAutomineWebhookTrackingEnabled == nextValue then
		return true
	end
	S.discordAutomineWebhookTrackingEnabled = nextValue
	if nextValue and type(syncAutomineWebhookTotalForCurrentUrl) == "function" then
		syncAutomineWebhookTotalForCurrentUrl()
	end
	if nextValue and type(syncAutomineWebhookAccountTotalForCurrentUrl) == "function" then
		syncAutomineWebhookAccountTotalForCurrentUrl()
	end
	if skipPersistence then
		return true
	end
	schedulePersist()
	return true
end

function toggleDiscordAutomineWebhookTrackOption(optionName)
	local optionKey = tostring(optionName or "")
	if optionKey == "" then
		return
	end
	local nextOptions = cloneAutomineWebhookOptions(S.discordAutomineWebhookOptions)
	if nextOptions[optionKey] == nil then
		return
	end
	nextOptions[optionKey] = not nextOptions[optionKey]
	local hasEnabledOption = false
	for _, knownOptionName in ipairs(AUTOMINE_WEBHOOK_TRACK_OPTION_ORDER) do
		if nextOptions[knownOptionName] == true then
			hasEnabledOption = true
			break
		end
	end
	if not hasEnabledOption then
		nextOptions["Track earnings"] = true
	end
	S.discordAutomineWebhookOptions = nextOptions
	schedulePersist()
end

function formatAutomineWebhookElapsed(seconds)
	local totalSeconds = math.max(0, math.floor((tonumber(seconds) or 0) + 0.5))
	local hours = math.floor(totalSeconds / 3600)
	local minutes = math.floor((totalSeconds % 3600) / 60)
	local remainingSeconds = totalSeconds % 60
	if hours > 0 then
		return string.format("%dh %02dm %02ds", hours, minutes, remainingSeconds)
	end
	return string.format("%dm %02ds", minutes, remainingSeconds)
end

function formatAutomineWebhookHourlyRate(amount, elapsedSeconds)
	local seconds = math.max(1, tonumber(elapsedSeconds) or 0)
	local hourlyAmount = math.max(0, tonumber(amount) or 0) * 3600 / seconds
	return "$" .. formatMoneyAmount(math.floor(hourlyAmount + 0.5)) .. "/hr"
end

function getAutomineWebhookTotalsFilePath()
	local fileName = "__automine_webhook_totals.json"
	if storageFolderApisAvailable then
		return CONFIG_SYSTEM.FOLDER .. "/" .. fileName
