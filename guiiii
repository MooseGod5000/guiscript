			return cframeCharacterTowards(
				character,
				point,
				activeToken,
				getDirectPathTravelTimeout(character, point, 0.45),
				computedPathReachDistance,
				getCFrameMovementOptions({flatPathFollow = true, useUndergroundOffset = false,})
			)
		end
		if isUndergroundMovementMode(movementMode) then
			return undergroundCharacterTowards(
				character,
				point,
				activeToken,
				getDirectPathTravelTimeout(character, point, 0.45),
				computedPathReachDistance,
				{
					flatPathFollow = true,
				}
			)
		end
		return moveTowardsPosition(character, humanoid, point, activeToken, MOVE_TIMEOUT)
	end
	local function processEntryPathAvoidance(point)
		if not (pathState.playbackActive == true and pathState.entryPathingPending == true and typeof(point) == "Vector3") then
			return false
		end
