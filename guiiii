function getInventorySlotCounts()
	local scrollingFrame = getInventorySlotsFrame()
	if not scrollingFrame then
		return 0, 0
	end

	local filledSlots = 0
	local totalSlots = 0

	for _, child in ipairs(scrollingFrame:GetDescendants()) do
		local container = child:FindFirstChild("Container")
		local viewportFrame = container and container:FindFirstChild("ViewportFrame")
		if viewportFrame and child.Name == "SlotTemplate" then
			totalSlots += 1
			if getViewportFrameItemName(viewportFrame) then
				filledSlots += 1
			end
		end
	end

	return filledSlots, totalSlots
end

function getOrderedInventorySlotFrames()
	local scrollingFrame = getInventorySlotsFrame()
	if not scrollingFrame then
		return {}
	end

	local slotFrames = {}
	for _, descendant in ipairs(scrollingFrame:GetDescendants()) do
		local container = descendant:FindFirstChild("Container")
		local viewportFrame = container and container:FindFirstChild("ViewportFrame")
		if viewportFrame and descendant.Name == "SlotTemplate" then
			table.insert(slotFrames, descendant)
		end
	end

	table.sort(slotFrames, function(left, right)
		local leftOrder = tonumber(left.LayoutOrder) or 0
		local rightOrder = tonumber(right.LayoutOrder) or 0
		if leftOrder ~= rightOrder then
			return leftOrder < rightOrder
		end
		return tostring(left:GetFullName()) < tostring(right:GetFullName())
	end)

	return slotFrames
end

function normalizeInventoryItemLookupName(rawName)
	if type(rawName) ~= "string" or rawName == "" then
		return nil
	end

	local normalized = safeLower(rawName):gsub("[^%w]", "")
	if normalized == "" then
		return nil
	end

	return normalized
end

function resolveSharedPlayerItemRecordByName(rawName, forceRefresh)
	local normalized = normalizeInventoryItemLookupName(rawName)
	if not normalized then
		return nil, nil
	end

	local playerItems = resolveSharedPlayerItems(forceRefresh)
	if not isTable(playerItems) then
		return nil, nil
	end

	for itemType, sharedItemData in pairs(playerItems) do
		if isTable(sharedItemData) then
			local nameCandidates = {
				itemType,
				rawget(sharedItemData, "Display") or sharedItemData.Display,
				rawget(sharedItemData, "Name") or sharedItemData.Name,
			}
			for _, candidateName in ipairs(nameCandidates) do
				if type(candidateName) == "string" and normalized == safeLower(candidateName):gsub("[^%w]", "") then
					return itemType, sharedItemData
				end
			end
		end
	end

	return nil, nil
end

function getSharedInventoryDiscardFlags(sharedItemData)
	if not isTable(sharedItemData) then
		return false, false
	end

	local isLoot = (rawget(sharedItemData, "IsLoot") or sharedItemData.IsLoot) == true
	local droppable = rawget(sharedItemData, "Droppable")
	if droppable == nil then
		droppable = sharedItemData.Droppable
	end
	local canBeDiscarded = rawget(sharedItemData, "CanBeDiscarded")
	if canBeDiscarded == nil then
		canBeDiscarded = sharedItemData.CanBeDiscarded
	end

	local hasDiscardAction = false
	local validActions = rawget(sharedItemData, "ValidActions") or sharedItemData.ValidActions
	if isTable(validActions) then
		for key, value in pairs(validActions) do
			local actionName = nil
			if type(key) == "string" and value then
				actionName = key
			elseif type(value) == "string" then
				actionName = value
			end
			local normalizedAction = actionName and safeLower(actionName) or nil
			if normalizedAction and (string.find(normalizedAction, "drop", 1, true) or string.find(normalizedAction, "throw", 1, true) or string.find(normalizedAction, "discard", 1, true)) then
				hasDiscardAction = true
				break
			end
		end
	end

	return droppable == true or canBeDiscarded == true or hasDiscardAction, isLoot
end

function isOreInventoryType(itemType)
	return type(itemType) == "string" and INVENTORY_ORE_LABELS[itemType] ~= nil
end

function getInventoryOreLabel(itemType)
	return INVENTORY_ORE_LABELS[itemType] or tostring(itemType or "Unknown")
end

function getInventoryDiscardDisplayName(discardState)
	if not isTable(discardState) then
		return "item"
	end

	local itemType = rawget(discardState, "itemType") or discardState.itemType
	local sharedItemData = rawget(discardState, "sharedItemData") or discardState.sharedItemData
	local displayName = isTable(sharedItemData) and (rawget(sharedItemData, "Display") or sharedItemData.Display) or nil
	if type(displayName) == "string" and displayName ~= "" then
		return displayName
	end

	if isOreInventoryType(itemType) then
		return getInventoryOreLabel(itemType)
	end

	local visualName = rawget(discardState, "visualName") or discardState.visualName
	if type(visualName) == "string" and visualName ~= "" then
		return visualName
	end

	return tostring(itemType or "item")
end

function getOrderedInventoryItems(inventoryContainer)
	local items = isTable(inventoryContainer) and (rawget(inventoryContainer, "Items") or inventoryContainer.Items) or nil
	if not isTable(items) then
		return {}
	end

	local orderedItems = {}
	for key, inventoryItem in pairs(items) do
		if isTable(inventoryItem) then
			table.insert(orderedItems, {
				key = key,
				numericKey = tonumber(key),
				item = inventoryItem,
			})
		end
	end

	table.sort(orderedItems, function(left, right)
		if left.numericKey and right.numericKey and left.numericKey ~= right.numericKey then
			return left.numericKey < right.numericKey
		end
		if left.numericKey ~= nil and right.numericKey == nil then
			return true
		end
		if right.numericKey ~= nil and left.numericKey == nil then
			return false
		end
		return tostring(left.key) < tostring(right.key)
	end)

	return orderedItems
end

function getLastInventorySlotOreState(forceRefresh)
	local playerData = resolvePlayerDataModule(forceRefresh)
	local playerItems = resolveSharedPlayerItems(forceRefresh)
	local inventoryContainer = getResolvedInventoryContainer(playerData)
	if not (isTable(playerData) and isTable(playerItems) and isTable(inventoryContainer)) then
		return nil, "inventory container unavailable"
	end

	local orderedItems = getOrderedInventoryItems(inventoryContainer)
	local filledSlots = #orderedItems
	local totalSlots = tonumber(rawget(inventoryContainer, "Size") or inventoryContainer.Size) or 0
	if totalSlots <= 0 then
		return nil, "inventory size unavailable"
	end
	if filledSlots < totalSlots then
		return nil, string.format("waiting for last slot (%d/%d)", filledSlots, totalSlots)
	end

	local candidateEntry = orderedItems[#orderedItems]
	local inventoryItem = nil
	if isTable(candidateEntry) then
		inventoryItem = candidateEntry.item
	end

	local itemType = isTable(inventoryItem) and (rawget(inventoryItem, "Type") or inventoryItem.Type) or nil
	if not isOreInventoryType(itemType) then
		return nil, "last slot item not ore: " .. tostring(itemType or "nil")
	end

	local sharedItemData = rawget(playerItems, itemType) or playerItems[itemType]
	local isDiscardable, isLoot = getSharedInventoryDiscardFlags(sharedItemData)
	if not isTable(inventoryItem) or not isDiscardable or isLoot ~= true then
		return nil, "last slot ore blocked: " .. tostring(itemType)
	end

	local itemId = isTable(inventoryItem) and (rawget(inventoryItem, "Id") or inventoryItem.Id) or nil
	local visualName = nil
	local slotFrames = getOrderedInventorySlotFrames()
	local lastSlot = slotFrames[#slotFrames]
	if lastSlot then
		local container = lastSlot:FindFirstChild("Container")
		local viewportFrame = container and container:FindFirstChild("ViewportFrame")
		visualName = getViewportFrameItemName(viewportFrame)
	end

	return {
		slotFrame = lastSlot,
		visualName = visualName,
		itemType = itemType,
		itemId = itemId,
		inventoryItem = inventoryItem,
		sharedItemData = sharedItemData,
		isLoot = isLoot,
		filledSlots = filledSlots,
		totalSlots = totalSlots,
	}, nil
end

function hasRemainingPathOresToMine(currentPath, nodeIndex)
	if not isTable(currentPath) then
		return false
	end

	local currentNodeIndex = math.max(1, tonumber(nodeIndex) or 1)
	for _, oreTarget in ipairs(currentPath.ores or {}) do
		local oreNodeIndex = tonumber(oreTarget.nodeIndex) or 0
		if oreNodeIndex >= currentNodeIndex and not isPathNodeDisconnected(currentPath, oreNodeIndex) then
			local resolvedOre = resolveSavedOreTarget(oreTarget)
			local oreRemaining = getOreRemainingValue(resolvedOre)
			if resolvedOre and oreRemaining and (tonumber(oreRemaining.Value) or 0) > 0 then
				return true
			end
		end
	end

	return false
end

function shouldPreserveLastSlotOreForSell(discardState)
	if activeFarmMode ~= "path" or not pathState.playbackActive or not pathState.playbackSellPending then
		return false
	end

	if isTable(discardState) and (rawget(discardState, "isLoot") or discardState.isLoot) ~= true then
		return false
	end

	local currentPath = pathState.currentPath
	if not isTable(currentPath) then
		return false
	end

	if hasRemainingPathOresToMine(currentPath, pathState.playbackNodeIndex) then
		return false
	end

	return isPathPlaybackSellReady()
end

function waitForLastSlotOreDiscard(beforeSummary, discardedState, timeoutSeconds)
	local deadline = os.clock() + math.max(0.1, tonumber(timeoutSeconds) or AUTO_LAST_SLOT_ORE_DISCARD_CONFIRM_TIMEOUT)
	while os.clock() < deadline do
		task.wait(0.05)

		local afterSummary = getSellableLootSummary(false) or getSellableLootSummary(true)
		if isTable(beforeSummary) and isTable(afterSummary) and wasSellableLootReduced(beforeSummary, afterSummary) then
			return true
		end

		local latestState = getLastInventorySlotOreState(false) or getLastInventorySlotOreState(true)
		if not latestState then
			return true
		end
		if latestState.itemType ~= discardedState.itemType then
			return true
		end
		if type(discardedState.itemId) == "string"
			and type(latestState.itemId) == "string"
			and latestState.itemId ~= discardedState.itemId then
			return true
		end
	end

	return false
end

function collectInventoryDiscardActionNames(sharedItemData, includeFallbacks)
	local actionNames = {}
	local seen = {}
	local function isDiscardOnlyActionName(value)
		local normalizedValue = safeLower(value)
		if normalizedValue == "" then
			return false
		end
		if string.find(normalizedValue, "drop", 1, true) or string.find(normalizedValue, "throw", 1, true) then
			return false
		end
		return string.find(normalizedValue, "discard", 1, true)
			or string.find(normalizedValue, "destroy", 1, true)
			or string.find(normalizedValue, "remove", 1, true)
			or string.find(normalizedValue, "delete", 1, true)
	end

	local function pushActionName(value)
		if type(value) ~= "string" or value == "" or seen[value] or not isDiscardOnlyActionName(value) then
			return
		end
		seen[value] = true
		table.insert(actionNames, value)
	end

	local validActions = isTable(sharedItemData) and (rawget(sharedItemData, "ValidActions") or sharedItemData.ValidActions) or nil
	if isTable(validActions) then
		for key, value in pairs(validActions) do
			if type(key) == "string" and value then
				pushActionName(key)
			elseif type(value) == "string" then
				pushActionName(value)
			end
		end
	end

	if includeFallbacks ~= false then
		pushActionName("DiscardItem")
		pushActionName("DiscardInventoryItem")
		pushActionName("DestroyInventoryItem")
		pushActionName("RemoveInventoryItem")
		pushActionName("DeleteInventoryItem")
		pushActionName("DestroyItem")
		pushActionName("RemoveItem")
	end
	return actionNames
end

function collectKeywordMethodNames(owner, baseNames)
	local methodNames = {}
	local seen = {}
	local function pushMethodName(name)
		if type(name) ~= "string" or name == "" or seen[name] then
			return
		end
		seen[name] = true
		table.insert(methodNames, name)
	end

	for _, name in ipairs(baseNames or {}) do
		pushMethodName(name)
	end

	if not isTable(owner) then
		return methodNames
	end

	for key, value in pairs(owner) do
		if type(key) == "string" and type(value) == "function" then
			local normalizedKey = safeLower(key)
			if string.find(normalizedKey, "discard", 1, true)
				or string.find(normalizedKey, "destroy", 1, true)
				or string.find(normalizedKey, "remove", 1, true)
				or string.find(normalizedKey, "delete", 1, true) then
				pushMethodName(key)
			end
		end
	end

	return methodNames
end

function getPlayerCharacterItemObject(playerCharacter, itemType)
	if not isTable(playerCharacter) or type(itemType) ~= "string" or itemType == "" then
		return nil
	end

	local getItem = rawget(playerCharacter, "GetItem") or playerCharacter.GetItem
	if type(getItem) ~= "function" then
		return nil
	end

	local okItem, itemObject = pcall(getItem, playerCharacter, itemType)
	if okItem and isTable(itemObject) then
		return itemObject
	end

	return nil
end

function tryDiscardInventoryItemViaKnownActions(discardState, playerData, inventoryContainer, inventoryItem, beforeSummary)
	if not (isTable(discardState) and isTable(playerData) and isTable(inventoryContainer) and isTable(inventoryItem)) then
		return false, "discard state unavailable"
	end

	local itemType = rawget(discardState, "itemType") or discardState.itemType
	local sharedItemData = rawget(discardState, "sharedItemData") or discardState.sharedItemData
	local inventoryItemId = rawget(inventoryItem, "Id") or inventoryItem.Id
	local inventoryContainerId = rawget(inventoryContainer, "Id") or inventoryContainer.Id
	local playerCharacterModule = resolvePlayerCharacterModule(false) or resolvePlayerCharacterModule(true)
	local playerItemObject = getPlayerCharacterItemObject(playerCharacterModule, itemType)
	local actionNames = collectInventoryDiscardActionNames(sharedItemData)
	local triedMethods = {}
	local lastFailure = nil

	local function confirmDiscard()
		return waitForLastSlotOreDiscard(beforeSummary, discardState, AUTO_LAST_SLOT_ORE_DISCARD_CONFIRM_TIMEOUT)
	end

	local function tryMethodCall(owner, methodName, ...)
		if not isTable(owner) then
			return false
		end

		local method = rawget(owner, methodName) or owner[methodName]
		if type(method) ~= "function" or triedMethods[method] then
			return false
		end
		triedMethods[method] = true

		local packedArgs = table.pack(...)
		local okCall, callResult = pcall(function()
			return method(owner, table.unpack(packedArgs, 1, packedArgs.n))
		end)
		if okCall then
			if confirmDiscard() then
				return true
			end
			return false
		end

		lastFailure = tostring(callResult)
		return false
	end

	local function tryNetworkActivate(actionName, ...)
		if not isTable(playerItemObject) then
			return false
		end

		local packedArgs = table.pack(...)
		local okCall, sent = pcall(function()
			return callToolNetworkActivate(playerItemObject, actionName, table.unpack(packedArgs, 1, packedArgs.n))
		end)
		if okCall and sent and confirmDiscard() then
			return true
		end
		if not okCall then
			lastFailure = tostring(sent)
		end
		return false
	end

	for _, actionName in ipairs(actionNames) do
		if tryNetworkActivate(actionName, inventoryItemId) then
			return true, "item.NetworkActivate(" .. tostring(actionName) .. ", itemId)"
		end
		if tryNetworkActivate(actionName, inventoryContainerId, inventoryItemId) then
			return true, "item.NetworkActivate(" .. tostring(actionName) .. ", containerId, itemId)"
		end
		if tryNetworkActivate(actionName, inventoryItem) then
			return true, "item.NetworkActivate(" .. tostring(actionName) .. ", item)"
		end
		if tryNetworkActivate(actionName) then
			return true, "item.NetworkActivate(" .. tostring(actionName) .. ")"
		end
	end

	for _, target in ipairs({
		{ label = "item", owner = playerItemObject },
		{ label = "inventoryItem", owner = inventoryItem },
		{ label = "inventoryContainer", owner = inventoryContainer },
		{ label = "playerData", owner = playerData },
	}) do
		local methodNames = collectKeywordMethodNames(target.owner, actionNames)
		for _, methodName in ipairs(methodNames) do
			if tryMethodCall(target.owner, methodName, inventoryItem) then
				return true, target.label .. "." .. tostring(methodName) .. "(item)"
			end
			if tryMethodCall(target.owner, methodName, inventoryItemId) then
				return true, target.label .. "." .. tostring(methodName) .. "(itemId)"
			end
			if tryMethodCall(target.owner, methodName, inventoryContainerId, inventoryItemId) then
				return true, target.label .. "." .. tostring(methodName) .. "(containerId, itemId)"
			end
			if tryMethodCall(target.owner, methodName, itemType) then
				return true, target.label .. "." .. tostring(methodName) .. "(itemType)"
			end
			if tryMethodCall(target.owner, methodName) then
				return true, target.label .. "." .. tostring(methodName) .. "()"
			end
		end
	end

	return false, lastFailure or "no discard action succeeded"
end

function tryAutoDiscardLastSlotOre(character, activeToken, options)
	if not autoMineEnabled or activeToken ~= autoMineToken then
		return false
	end

	local discardOptions = type(options) == "table" and options or nil
	local bypassScanInterval = discardOptions and discardOptions.bypassScanInterval == true
	local allowPreservedSellDiscard = discardOptions and discardOptions.allowPreservedSellDiscard == true
	local now = os.clock()
	if not bypassScanInterval and (now - lastAutoDiscardScanAt) < AUTO_LAST_SLOT_ORE_DISCARD_SCAN_INTERVAL then
		return false
	end
	if not bypassScanInterval then
		lastAutoDiscardScanAt = now
	end

	local discardState, discardReason = getLastInventorySlotOreState(false)
	if not discardState then
		discardState, discardReason = getLastInventorySlotOreState(true)
	end
	if not discardState then
		pushDebugRateLimited("last_slot_discard_probe", "last-slot discard: " .. tostring(discardReason or "not ready"), 2)
		return false
	end
	local preserveForSell = shouldPreserveLastSlotOreForSell(discardState)
	if preserveForSell and not allowPreservedSellDiscard then
		pushDebugRateLimited(
			"last_slot_discard_preserve",
			"last-slot discard: keeping final " .. tostring(getInventoryDiscardDisplayName(discardState)) .. " for sell",
			2
		)
		return false
	elseif preserveForSell then
		pushDebugRateLimited(
			"last_slot_discard_pickup_room",
			"last-slot discard: making room for " .. tostring((discardOptions and discardOptions.reasonText) or "dropped ore"),
			1.5
		)
	end

	local itemType = discardState.itemType
	local discardKey = tostring(itemType) .. ":" .. tostring(discardState.itemId or discardState.visualName or "slot")
	if lastAutoDiscardItemKey == discardKey and (now - lastAutoDiscardAttemptAt) < AUTO_LAST_SLOT_ORE_DISCARD_COOLDOWN then
		return false
	end

	local playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
	local inventoryContainer = getResolvedInventoryContainer(playerData)
	local inventoryItem = discardState.inventoryItem
	if not isTable(playerData) or not isTable(inventoryContainer) or not isTable(inventoryItem) then
		return false
	end

	local inventoryItemId = rawget(inventoryItem, "Id") or inventoryItem.Id
	local inventoryContainerId = rawget(inventoryContainer, "Id") or inventoryContainer.Id
	if type(inventoryItemId) ~= "string" or inventoryItemId == "" then
		return false
	end

	lastAutoDiscardAttemptAt = now
	lastAutoDiscardItemKey = discardKey

	local lootSummaryBefore = getSellableLootSummary(false) or getSellableLootSummary(true)
	local discardLabel = getInventoryDiscardDisplayName(discardState)
	pushDebugRateLimited(
		"last_slot_discard_attempt",
		string.format(
			"last-slot discard attempt: %s (%d/%d)",
			tostring(discardLabel),
			tonumber(discardState.filledSlots) or 0,
			tonumber(discardState.totalSlots) or 0
		),
		1.5
	)

	setStatus("Discarding " .. discardLabel, Color3.fromRGB(255, 190, 120))
	clearMovementKeys()
	setInteractKeyHeld(false)
	endExperimentalCFrameTravel(character)

	local discardOk, discardSource = tryDiscardInventoryItemViaKnownActions(
		discardState,
		playerData,
		inventoryContainer,
		inventoryItem,
		lootSummaryBefore
	)
	if discardOk then
		pushDebug("discarded last-slot ore via " .. tostring(discardSource))
		return true
	end

	pushDebugRateLimited("last_slot_discard_action_failed", "last-slot discard action failed: " .. tostring(discardSource), 2)
	pushDebugRateLimited("last_slot_discard_failed", "last-slot discard failed for " .. tostring(discardLabel), 2)
	return false
end

function getPickupInventorySlotCounts()
	local filledSlots, totalSlots = getInventorySlotCounts()
	if totalSlots <= 0 then
		local playerData = resolvePlayerDataModule(false) or resolvePlayerDataModule(true)
		local inventoryContainer = getResolvedInventoryContainer(playerData)
		local items = isTable(inventoryContainer) and (rawget(inventoryContainer, "Items") or inventoryContainer.Items) or nil
		local dataTotalSlots = isTable(inventoryContainer) and tonumber(rawget(inventoryContainer, "Size") or inventoryContainer.Size) or 0
		if isTable(items) and dataTotalSlots > 0 then
			local dataFilledSlots = 0
			for _, inventoryItem in pairs(items) do
				if isTable(inventoryItem) then
					dataFilledSlots += 1
				end
			end
			filledSlots = dataFilledSlots
			totalSlots = dataTotalSlots
		end
	end

	lastInventoryFilledSlots = filledSlots
	lastInventoryTotalSlots = totalSlots
	return filledSlots, totalSlots
end

function tryMakeRoomForDroppedPickup(character, activeToken, dropLabel)
	local filledSlots, totalSlots = getPickupInventorySlotCounts()
	local discardState, discardReason = getLastInventorySlotOreState(false)
	if not discardState then
		discardState, discardReason = getLastInventorySlotOreState(true)
	end

	if not discardState then
		local reasonText = tostring(discardReason or "not ready")
		if totalSlots > 0 and filledSlots >= totalSlots and not string.find(reasonText, "waiting for last slot", 1, true) then
			pushDebugRateLimited(
				"pickup_full_no_discard_slot",
				"pickup blocked by full bag; last-slot discard not ready for " .. tostring(dropLabel or "drop") .. ": " .. reasonText,
				1.5
			)
			return true, false
		end
		if totalSlots > 0 and filledSlots >= totalSlots then
			pushDebugRateLimited("pickup_slot_count_mismatch", "pickup count mismatch; last-slot state says " .. reasonText, 1.5)
		end
		return false, false
	end

	filledSlots = tonumber(discardState.filledSlots) or filledSlots
	totalSlots = tonumber(discardState.totalSlots) or totalSlots
	lastInventoryFilledSlots = filledSlots
	lastInventoryTotalSlots = totalSlots

	pushDebugRateLimited(
		"pickup_full_make_room",
		string.format("pickup blocked by full bag; discarding for %s (%d/%d)", tostring(dropLabel or "drop"), filledSlots, totalSlots),
		1.5
	)

	local discarded = tryAutoDiscardLastSlotOre(character, activeToken, {
		allowPreservedSellDiscard = true,
		bypassScanInterval = true,
		reasonText = "dropped " .. tostring(dropLabel or "ore"),
	})
	return true, discarded == true
end

function getInventoryItemStackAmount(inventoryItem)
	if not isTable(inventoryItem) then
		return 1
	end

	local amount = tonumber(
		rawget(inventoryItem, "Amount")
			or inventoryItem.Amount
			or rawget(inventoryItem, "Count")
			or inventoryItem.Count
			or rawget(inventoryItem, "Quantity")
			or inventoryItem.Quantity
			or rawget(inventoryItem, "StackSize")
			or inventoryItem.StackSize
			or 1
	)
	if not amount or amount < 1 then
		return 1
	end

	return amount
end

function resolveSharedPlayerItemSellMetadata(forceRefresh)
	local cache = rawget(_G, "__AutoMineSharedPlayerItemSellMetadata")
	if isTable(cache) then
		return cache
	end

	local sharedData = resolveSharedDataModule(forceRefresh)
	if not isTable(sharedData) then
		return nil
	end

	local playerItemsRoot = rawget(sharedData, "PlayerItems") or sharedData.PlayerItems
	if not isTable(playerItemsRoot) then
		return nil
	end

	local metadata = {}
	for _, categoryData in pairs(playerItemsRoot) do
		if isTable(categoryData) then
			local items = rawget(categoryData, "Items") or categoryData.Items
			local categoryIsLoot = (rawget(categoryData, "IsLoot") or categoryData.IsLoot) == true
			local categoryVipValueMultiplier = tonumber(rawget(categoryData, "VIPValueMultiplier") or categoryData.VIPValueMultiplier) or 0
			if isTable(items) then
				for itemType, itemData in pairs(items) do
					if type(itemType) == "string" and isTable(itemData) then
						metadata[itemType] = {
							isLoot = ((rawget(itemData, "IsLoot") or itemData.IsLoot) == true) or categoryIsLoot,
							value = tonumber(rawget(itemData, "Value") or itemData.Value) or 0,
							stackSellSize = tonumber(rawget(itemData, "StackSellSize") or itemData.StackSellSize) or 1,
							vipValueMultiplier = tonumber(rawget(itemData, "VIPValueMultiplier") or itemData.VIPValueMultiplier) or categoryVipValueMultiplier,
							display = rawget(itemData, "Display") or itemData.Display or itemType,
						}
					end
				end
			end
		end
	end

	_G.__AutoMineSharedPlayerItemSellMetadata = metadata
	return metadata
end

function playerHasVipSellBonus(forceRefresh)
	local replicatedState = resolveGlobalReplicatedState(forceRefresh)
	if not isTable(replicatedState) then
		return false
	end

	local state = rawget(replicatedState, "State") or replicatedState.State
	if not isTable(state) then
		return false
	end

	if (rawget(state, "VIP") or state.VIP) == true or (rawget(state, "IsVIP") or state.IsVIP) == true then
		return true
	end

	local ownedGamePasses = rawget(state, "OwnedGamePasses") or state.OwnedGamePasses
	if isTable(ownedGamePasses) then
		for key, value in pairs(ownedGamePasses) do
			if value then
				local loweredKey = safeLower(key)
				if loweredKey == "vip" or string.find(loweredKey, "vip", 1, true) then
					return true
				end
			end
		end
	end

	return false
end

function formatMoneyAmount(value)
	local rounded = math.max(0, math.floor((tonumber(value) or 0) + 0.5))
	local text = tostring(rounded)
	local sign = ""
	if string.sub(text, 1, 1) == "-" then
		sign = "-"
		text = string.sub(text, 2)
	end

	while true do
		local formatted, substitutions = string.gsub(text, "^(-?%d+)(%d%d%d)", "%1,%2")
		text = formatted
		if substitutions == 0 then
			break
		end
	end

	return sign .. text
end

function getSellableLootSummary(forceRefresh)
	local filledSlots, totalSlots = getInventorySlotCounts()
	local playerData = resolvePlayerDataModule(forceRefresh)
	local playerItems = resolveSharedPlayerItems(forceRefresh)
	if not isTable(playerData) or not isTable(playerItems) then
		return nil
	end

	local inventoryContainer = getResolvedInventoryContainer(playerData)
	if not isTable(inventoryContainer) then
		return nil
	end

	local items = rawget(inventoryContainer, "Items") or inventoryContainer.Items
	if not isTable(items) then
		return nil
	end

	local sellMetadata = resolveSharedPlayerItemSellMetadata(forceRefresh)
	local hasVipSellBonus = playerHasVipSellBonus(forceRefresh)
	local lootEntryCount = 0
	local lootUnitCount = 0
	local lootValueTotal = 0
	for _, inventoryItem in pairs(items) do
		if isTable(inventoryItem) then
			local itemType = rawget(inventoryItem, "Type") or inventoryItem.Type
			local sharedItemData = type(itemType) == "string" and (rawget(playerItems, itemType) or playerItems[itemType]) or nil
			local itemSellMetadata = type(itemType) == "string" and isTable(sellMetadata) and (rawget(sellMetadata, itemType) or sellMetadata[itemType]) or nil
			local isLoot = (isTable(sharedItemData) and ((rawget(sharedItemData, "IsLoot") or sharedItemData.IsLoot) == true))
				or (isTable(itemSellMetadata) and ((rawget(itemSellMetadata, "isLoot") or itemSellMetadata.isLoot) == true))
			if isLoot then
				lootEntryCount += 1
				local stackAmount = getInventoryItemStackAmount(inventoryItem)
				lootUnitCount += stackAmount

				local baseValue = tonumber(
					(isTable(sharedItemData) and (rawget(sharedItemData, "Value") or sharedItemData.Value))
						or (isTable(itemSellMetadata) and (rawget(itemSellMetadata, "value") or itemSellMetadata.value))
						or 0
				) or 0
				local stackSellSize = tonumber(
					(isTable(sharedItemData) and (rawget(sharedItemData, "StackSellSize") or sharedItemData.StackSellSize))
						or (isTable(itemSellMetadata) and (rawget(itemSellMetadata, "stackSellSize") or itemSellMetadata.stackSellSize))
						or 1
				) or 1
				if stackSellSize < 1 then
					stackSellSize = 1
				end

				local itemValueTotal = baseValue * (stackAmount / stackSellSize)
				local vipValueMultiplier = tonumber(
					(isTable(itemSellMetadata) and (rawget(itemSellMetadata, "vipValueMultiplier") or itemSellMetadata.vipValueMultiplier))
						or (isTable(sharedItemData) and (rawget(sharedItemData, "VIPValueMultiplier") or sharedItemData.VIPValueMultiplier))
						or 0
				) or 0
				if hasVipSellBonus and vipValueMultiplier > 0 then
					itemValueTotal = itemValueTotal * (1 + vipValueMultiplier)
				end
				lootValueTotal += itemValueTotal
			end
		end
	end

	return {
		hasLoot = lootEntryCount > 0,
		lootEntryCount = lootEntryCount,
		lootUnitCount = lootUnitCount,
		lootValueTotal = lootValueTotal,
		filledSlots = filledSlots,
		totalSlots = totalSlots,
	}
end

function wasSellableLootReduced(beforeSummary, afterSummary)
	if not (isTable(beforeSummary) and isTable(afterSummary)) then
		return false
	end

	local beforeEntryCount = tonumber(rawget(beforeSummary, "lootEntryCount") or beforeSummary.lootEntryCount) or 0
	local afterEntryCount = tonumber(rawget(afterSummary, "lootEntryCount") or afterSummary.lootEntryCount) or 0
	if afterEntryCount < beforeEntryCount then
		return true
	end

	local beforeUnitCount = tonumber(rawget(beforeSummary, "lootUnitCount") or beforeSummary.lootUnitCount) or beforeEntryCount
	local afterUnitCount = tonumber(rawget(afterSummary, "lootUnitCount") or afterSummary.lootUnitCount) or afterEntryCount
	if afterUnitCount < beforeUnitCount then
		return true
	end

	local beforeValueTotal = tonumber(rawget(beforeSummary, "lootValueTotal") or beforeSummary.lootValueTotal) or beforeUnitCount
	local afterValueTotal = tonumber(rawget(afterSummary, "lootValueTotal") or afterSummary.lootValueTotal) or afterUnitCount
	if afterValueTotal < beforeValueTotal then
		return true
	end

	local beforeHasLoot = rawget(beforeSummary, "hasLoot")
	if beforeHasLoot == nil then
		beforeHasLoot = beforeSummary.hasLoot
	end
	local afterHasLoot = rawget(afterSummary, "hasLoot")
	if afterHasLoot == nil then
		afterHasLoot = afterSummary.hasLoot
	end

	return beforeHasLoot == true and afterHasLoot == false
end

function getSoldLootValue(beforeSummary, afterSummary)
	if not isTable(beforeSummary) then
		return 0
	end

	local beforeValueTotal = tonumber(rawget(beforeSummary, "lootValueTotal") or beforeSummary.lootValueTotal) or 0
	local afterValueTotal = tonumber((isTable(afterSummary) and (rawget(afterSummary, "lootValueTotal") or afterSummary.lootValueTotal)) or 0) or 0
	return math.max(0, beforeValueTotal - afterValueTotal)
end

function setAutoSellThreshold(value, totalSlotsHint)
	local totalSlots = totalSlotsHint or lastInventoryTotalSlots or 0
	if totalSlots > 0 then
		autoSellThreshold = math.clamp(math.floor((value or 1) + 0.5), 1, totalSlots)
	else
		autoSellThreshold = math.max(1, math.floor((value or 1) + 0.5))
	end
	S.autoSellThreshold = math.clamp(math.floor((autoSellThreshold or 0) + 0.5), 0, 100)
end

function updateAutoSellThresholdFromPointer(pointerX)
	if not autoSellSliderHitbox then
		return
	end

	local _, totalSlots = getInventorySlotCounts()
	if totalSlots > 0 then
		lastInventoryTotalSlots = totalSlots
	end
	totalSlots = math.max(totalSlots or lastInventoryTotalSlots or 0, 1)
	local absolutePosition = autoSellSliderHitbox.AbsolutePosition
	local absoluteSize = autoSellSliderHitbox.AbsoluteSize
	local width = math.max(absoluteSize.X, 1)
	local ratio = math.clamp((pointerX - absolutePosition.X) / width, 0, 1)
	local threshold = math.floor((ratio * math.max(totalSlots - 1, 0)) + 1.5)
	setAutoSellThreshold(threshold, totalSlots)
end

function resolveAutoSellThreshold()
	local filledSlots, totalSlots = getInventorySlotCounts()
	lastInventoryFilledSlots = filledSlots
	lastInventoryTotalSlots = totalSlots

	if totalSlots > 0 then
		if autoSellThreshold <= 0 then
			autoSellThreshold = totalSlots
		else
			setAutoSellThreshold(autoSellThreshold, totalSlots)
		end
	end

	return filledSlots, totalSlots, autoSellThreshold
end

function isAutoSellThresholdReached()
	local filledSlots, totalSlots, threshold = resolveAutoSellThreshold()
	if not autoSellEnabled or totalSlots <= 0 or threshold <= 0 then
		return false, filledSlots, totalSlots, threshold
	end

	return filledSlots >= threshold, filledSlots, totalSlots, threshold
end

function isTable(value)
	return type(value) == "table"
end

function pushUniqueTable(list, seen, value)
	if isTable(value) and not seen[value] then
		seen[value] = true
		table.insert(list, value)
	end
end

function getEnvironmentTables()
	local list = {}
	local seen = {}

	if type(getgenv) == "function" then
		local ok, genv = pcall(getgenv)
		if ok then
			pushUniqueTable(list, seen, genv)
		end
	end

	if type(getrenv) == "function" then
		local ok, renv = pcall(getrenv)
		if ok then
			pushUniqueTable(list, seen, renv)
		end
	end

	pushUniqueTable(list, seen, _G)

	local okShared, sharedTable = pcall(function()
		return shared
	end)
	if okShared then
		pushUniqueTable(list, seen, sharedTable)
	end

	return list
end

function hasGetEquippedItem(owner)
	return isTable(owner) and type(owner.GetEquippedItem) == "function"
end

function looksLikeToolInfo(toolInfo)
	if not isTable(toolInfo) then
		return false
	end

	local networkActivate = rawget(toolInfo, "NetworkActivate") or toolInfo.NetworkActivate
	return type(networkActivate) == "function"
end

function tryGetToolInfoFromOwner(owner)
	if not hasGetEquippedItem(owner) then
		return nil
	end

	local ok, toolInfo = pcall(function()
		return owner:GetEquippedItem()
	end)

	if ok and looksLikeToolInfo(toolInfo) then
		return toolInfo
	end

	return nil
end

function pushUniqueOwner(list, seen, owner)
	if hasGetEquippedItem(owner) and not seen[owner] then
		seen[owner] = true
		table.insert(list, owner)
	end
end

function collectOwnerCandidates(root, owners, ownerSeen, recurseSeen, depth)
	if depth <= 0 or not isTable(root) or recurseSeen[root] then
		return
	end

	recurseSeen[root] = true
	pushUniqueOwner(owners, ownerSeen, root)

	local directKeys = {
		"plrCharacter",
		"PlrCharacter",
		"character",
		"Character",
		"playerCharacter",
		"PlayerCharacter",
		"RepCharHandler",
		"repCharHandler",
		"Modules",
		"modules",
		"mainModule",
		"MainModule",
	}

	for _, key in ipairs(directKeys) do
		local value = rawget(root, key) or root[key]
		if hasGetEquippedItem(value) then
			pushUniqueOwner(owners, ownerSeen, value)
		elseif isTable(value) then
			collectOwnerCandidates(value, owners, ownerSeen, recurseSeen, depth - 1)
		end
	end
end

function collectGcOwnerCandidates(owners, ownerSeen)
	if type(getgc) ~= "function" then
		return
	end

	local ok, gcObjects = pcall(getgc, true)
	if not ok or type(gcObjects) ~= "table" then
		return
	end

	local deadline = os.clock() + TOOLINFO_GC_SCAN_BUDGET
	for _, object in ipairs(gcObjects) do
		if os.clock() > deadline then
			break
		end

		if isTable(object) then
			pushUniqueOwner(owners, ownerSeen, object)
			local plrCharacter = rawget(object, "plrCharacter") or object.plrCharacter
			pushUniqueOwner(owners, ownerSeen, plrCharacter)
		end
	end
end

function resolveToolInfoOwner(forceRefresh)
	if cachedToolInfoOwner and hasGetEquippedItem(cachedToolInfoOwner) then
		local cachedToolInfo = tryGetToolInfoFromOwner(cachedToolInfoOwner)
		if cachedToolInfo then
			return cachedToolInfoOwner, cachedToolInfo
		end
		cachedToolInfoOwner = nil
	end

	local now = os.clock()
	if not forceRefresh and (now - lastToolInfoOwnerScanAt) < RESCAN_INTERVAL then
		return nil
	end
	lastToolInfoOwnerScanAt = now

	local owners = {}
	local ownerSeen = {}
	local recurseSeen = {}

	local modulesTable = resolveGameModules(forceRefresh)
	if hasPlrCharacterModule(modulesTable) then
		pushUniqueOwner(owners, ownerSeen, modulesTable.plrCharacter)
	end

	resolveGlobalNetwork(forceRefresh)
	local globalModule = rawget(_G, "__AutoMineGlobalModule")
	if isTable(globalModule) then
		pushUniqueOwner(owners, ownerSeen, rawget(globalModule, "PlayerCharacter") or globalModule.PlayerCharacter)
		pushUniqueOwner(owners, ownerSeen, rawget(globalModule, "playerCharacter") or globalModule.playerCharacter)
		pushUniqueOwner(owners, ownerSeen, rawget(globalModule, "RepCharHandler") or globalModule.RepCharHandler)
		pushUniqueOwner(owners, ownerSeen, rawget(globalModule, "repCharHandler") or globalModule.repCharHandler)
	end

	if isTable(cachedMainModule) then
		collectOwnerCandidates(cachedMainModule, owners, ownerSeen, recurseSeen, 3)
	end

	for _, root in ipairs(getEnvironmentTables()) do
		collectOwnerCandidates(root, owners, ownerSeen, recurseSeen, 3)
	end

	collectGcOwnerCandidates(owners, ownerSeen)

	for _, owner in ipairs(owners) do
		local toolInfo = tryGetToolInfoFromOwner(owner)
		if toolInfo then
			cachedToolInfoOwner = owner
			return owner, toolInfo
		end
	end

	return nil
end

hasPlrCharacterModule = function(modulesTable)
	if not isTable(modulesTable) then
		return false
	end

	local plrCharacter = rawget(modulesTable, "plrCharacter") or modulesTable.plrCharacter
	return isTable(plrCharacter) and type(plrCharacter.GetEquippedItem) == "function"
end

function looksLikePlayerCharacterModule(candidate)
    if not isTable(candidate) then
        return false
    end

    return type(rawget(candidate, "GetEquippedItem") or candidate.GetEquippedItem) == "function"
        or type(rawget(candidate, "CanSwitchToItem") or candidate.CanSwitchToItem) == "function"
        or type(rawget(candidate, "CanGetUp") or candidate.CanGetUp) == "function"
        or type(rawget(candidate, "ToggleSelfRagdoll") or candidate.ToggleSelfRagdoll) == "function"
        or type(rawget(candidate, "Ragdoll") or candidate.Ragdoll) == "function"
        or rawget(candidate, "BreakFreePerc") ~= nil
end

function looksLikePlayerDataModule(candidate)
	if not isTable(candidate) then
		return false
	end

	local setLoadout = rawget(candidate, "SetLoadout") or candidate.SetLoadout
	local getLoadout = rawget(candidate, "GetLoadout") or candidate.GetLoadout
	local getContainer = rawget(candidate, "GetContainer") or candidate.GetContainer
	local inventoryContainer = rawget(candidate, "InventoryContainer") or candidate.InventoryContainer
	return type(setLoadout) == "function"
		or (type(getLoadout) == "function" and (type(getContainer) == "function" or isTable(inventoryContainer)))
end

function extractSyncedTime(source)
	if not isTable(source) then
		return nil
	end

	local syncedTime = rawget(source, "SyncedTime") or source.SyncedTime
	if isTable(syncedTime) and type(syncedTime.GetTime) == "function" then
		return syncedTime
	end

	return nil
end

resolveGameModules = function(forceRefresh)
	if cachedGameModules and hasPlrCharacterModule(cachedGameModules) then
		return cachedGameModules
	end
	if not isAutomineGameModuleAccessReady() then
		return nil
	end

	local now = os.clock()
	if not forceRefresh and (now - lastModuleScanAt) < RESCAN_INTERVAL then
		return nil
	end

	lastModuleScanAt = now

	for _, root in ipairs(getEnvironmentTables()) do
		local directMain = rawget(root, "mainModule") or root.mainModule
		local directMainAlt = rawget(root, "MainModule") or root.MainModule

		local candidates = {
			rawget(root, "Modules") or root.Modules,
			rawget(root, "modules") or root.modules,
			directMain and (rawget(directMain, "Modules") or directMain.Modules),
			directMainAlt and (rawget(directMainAlt, "Modules") or directMainAlt.Modules),
			root,
		}

		for _, candidate in ipairs(candidates) do
			if hasPlrCharacterModule(candidate) then
				cachedGameModules = candidate
				cachedMainModule = rawget(candidate, "mainModule")
					or candidate.mainModule
					or rawget(candidate, "MainModule")
					or candidate.MainModule
					or directMain
					or directMainAlt
				return cachedGameModules
			end
		end
	end

	return nil
end

function resolveSyncedTime(forceRefresh)
	if cachedSyncedTime and type(cachedSyncedTime.GetTime) == "function" then
		return cachedSyncedTime
	end
	if not isAutomineGameModuleAccessReady() then
		return nil
	end

	local modulesTable = resolveGameModules(forceRefresh)
	if modulesTable then
		local moduleMain = rawget(modulesTable, "mainModule")
			or modulesTable.mainModule
			or rawget(modulesTable, "MainModule")
			or modulesTable.MainModule
		if moduleMain then
			cachedMainModule = moduleMain
		end
	end

	local mainSynced = extractSyncedTime(cachedMainModule)
	if mainSynced then
		cachedSyncedTime = mainSynced
		return cachedSyncedTime
	end

	for _, root in ipairs(getEnvironmentTables()) do
		local synced = extractSyncedTime(root)
			or extractSyncedTime(rawget(root, "mainModule") or root.mainModule)
			or extractSyncedTime(rawget(root, "MainModule") or root.MainModule)
		if synced then
			cachedSyncedTime = synced
			return cachedSyncedTime
		end
	end

	local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
	local globalModuleScript = sharedModules and sharedModules:FindFirstChild("Global")
	if globalModuleScript and globalModuleScript:IsA("ModuleScript") then
		local okRequire, globalModule = pcall(require, globalModuleScript)
		if okRequire and isTable(globalModule) then
			local synced = extractSyncedTime(globalModule)
			if not synced and type(globalModule.LoadModule) == "function" then
				local okLoad, syncedModule = pcall(function()
					return globalModule:LoadModule("SyncedTime")
				end)
				if okLoad and isTable(syncedModule) and type(syncedModule.GetTime) == "function" then
					synced = syncedModule
				end
			end
			if synced then
				cachedSyncedTime = synced
				return cachedSyncedTime
			end
		end
	end

	return nil
end

function getSyncedNetworkTime()
	local syncedTime = resolveSyncedTime(false)
	if syncedTime and type(syncedTime.GetTime) == "function" then
		local ok, value = pcall(function()
			return syncedTime:GetTime()
		end)
		if ok and type(value) == "number" then
			return value
		end
	end

	return 0
end

function isStoredPickaxeName(name)
	if type(name) ~= "string" or name == "" then
		return false
	end

	local lowered = safeLower(tostring(name)):gsub("\\", "/")
	return string.find(lowered, "loadoutitem/", 1, true) ~= nil
		and string.find(lowered, "pickaxe", 1, true) ~= nil
end

function isEquippedPickaxeName(name)
	if type(name) ~= "string" or name == "" then
		return false
	end

	local lowered = safeLower(tostring(name)):gsub("\\", "/")
	return string.find(lowered, "loadoutitem/", 1, true) == nil
		and string.find(lowered, "pickaxe", 1, true) ~= nil
end

function matchesPickaxeName(instance)
	local name = typeof(instance) == "Instance" and instance.Name or instance
	if type(name) ~= "string" or name == "" then
		return false
	end

	return string.find(safeLower(tostring(name)):gsub("\\", "/"), "pickaxe", 1, true) ~= nil
end

function stripStoredPickaxePrefix(name)
	if type(name) ~= "string" or name == "" then
		return nil
	end

	local normalized = tostring(name):gsub("\\", "/")
	local lowered = safeLower(normalized)
	local prefix = "loadoutitem/"
	if string.sub(lowered, 1, #prefix) == prefix then
		return string.sub(normalized, #prefix + 1)
	end

	return normalized
end

function appendPickaxeNameHint(hints, seen, value)
	if type(value) ~= "string" or value == "" then
		return
	end

	local normalized = tostring(value):gsub("\\", "/")
	if not matchesPickaxeName(normalized) then
		return
	end

	local function addHint(name)
		if type(name) == "string" and name ~= "" and not seen[name] then
			seen[name] = true
			table.insert(hints, name)
		end
	end

	local baseName = stripStoredPickaxePrefix(normalized) or normalized
	local strippedItemName = type(baseName) == "string" and string.gsub(baseName, "Item$", "") or baseName
	addHint(baseName)
	addHint("LoadoutItem/" .. baseName)
	if strippedItemName ~= baseName then
		addHint(strippedItemName)
		addHint("LoadoutItem/" .. strippedItemName)
	end
	if string.sub(baseName, -4) ~= "Item" then
		addHint(baseName .. "Item")
	end
	if type(strippedItemName) == "string" and strippedItemName ~= "" and string.sub(strippedItemName, -4) ~= "Item" then
		addHint(strippedItemName .. "Item")
	end
end

function collectPickaxeNameHints(...)
	local hints = {}
	local seen = {}
	local visitedTables = {}

	local function scanValue(value)
		if value == nil then
			return
		end

		if type(value) == "string" then
			appendPickaxeNameHint(hints, seen, value)
			return
		end

		if typeof(value) == "Instance" then
			appendPickaxeNameHint(hints, seen, value.Name)
			return
		end

		if not isTable(value) or visitedTables[value] then
			return
		end

		visitedTables[value] = true
		for _, key in ipairs({
			"Type",
			"Id",
			"Name",
			"DisplayName",
			"ItemType",
			"VariantOf",
			"Model",
			"ModelName",
			"WorldModel",
			"WorldModelName",
			"ViewModel",
			"ViewModelName",
		}) do
			scanValue(rawget(value, key) or value[key])
		end

		scanValue(rawget(value, "ItemData") or value.ItemData)
	end

	for index = 1, select("#", ...) do
		scanValue(select(index, ...))
	end

	return hints
end

function getBestCharacterPickaxeModel(character, nameMatcher)
	if not character then
		return nil
	end

	local bestPickaxe = nil
	local bestScore = 0
	for _, child in ipairs(character:GetChildren()) do
		if (child:IsA("Model") or child:IsA("Tool")) and (nameMatcher == nil or nameMatcher(child.Name)) then
			local score = getPickaxeTextScore(child.Name)
			if score > bestScore then
				bestScore = score
				bestPickaxe = child
			end
		end
	end

	return bestPickaxe
end

function getBackpackPickaxeTool(player)
	player = player or localPlayer or LocalPlayer
	if not player then
		return nil
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return nil
	end

	local bestTool = nil
	local bestScore = 0
	for _, child in ipairs(backpack:GetChildren()) do
		if child:IsA("Tool") and matchesPickaxeName(child.Name) then
			local score = getPickaxeTextScore(child.Name)
			if score > bestScore then
				bestScore = score
				bestTool = child
			end
		end
	end

	return bestTool
end

