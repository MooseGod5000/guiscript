local function isAutomineGameModuleAccessReady()
    if not LOAD_AFTER_GAME_LOADING_SCREEN then
        return true
    end
    if destroyed then
        return false
    end

    local globalModule = getAutomineGlobalModuleForReadiness()
    if globalModule then
        if globalModule.IsInitializing == true then
            return false
        end
        if globalModule.IsInitialized == true then
            return true
        end
    end

    if isAutomineLoadingGateDone() then
        return true
    end

    return game:IsLoaded() and (not globalModule or globalModule.IsInitializing ~= true)
end

local function waitForAutomineGameModuleAccess(timeoutSeconds)
    local deadline = os.clock() + (tonumber(timeoutSeconds) or 120)
    while not destroyed and os.clock() < deadline do
        if isAutomineGameModuleAccessReady() then
            return true
        end
        task.wait(0.25)
    end
    return isAutomineGameModuleAccessReady()
end

local function runAfterAutomineGameModuleAccess(callback, timeoutSeconds)
    task.spawn(function()
        if waitForAutomineGameModuleAccess(timeoutSeconds) and not destroyed then
            local ok, err = xpcall(callback, debug.traceback)
            if not ok and type(pushDebug) == "function" then
                pushDebug(err)
            end
        elseif type(pushDebug) == "function" then
            pushDebug("game module access gate timed out")
        end
    end)
end

