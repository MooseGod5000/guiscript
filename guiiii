-- Player ESP loop (highlights + usernames above heads, updates on join/die)
task.spawn(function()
   local function getPlayerTeamName(player)
       local charName = player.Name
       local unbreakable = workspace:FindFirstChild("Unbreakable")
       local characters = unbreakable and unbreakable:FindFirstChild("Characters")
       if not characters then return "lobby" end
       local orcTeam = characters:FindFirstChild("Orc")
       local humanTeam = characters:FindFirstChild("Human")
       if orcTeam and orcTeam:FindFirstChild(charName) then return "orc" end
       if humanTeam and humanTeam:FindFirstChild(charName) then return "human" end
       return "lobby"
   end
   local function getHighlightColor(player, teamName)
       -- Staff get golden highlight
       local staffData = S._staffCache[player.UserId]
       if staffData then
           return Color3.fromRGB(255, 200, 50) -- golden
       end
       -- Team colors
       if teamName == "orc" then
           -- Try to get actual team color
           local color = Color3.fromRGB(196, 40, 28) -- fallback red
           pcall(function()
               if player.Team then color = player.TeamColor.Color end
           end)
           return color
       elseif teamName == "human" then
           local color = Color3.fromRGB(13, 105, 172) -- fallback blue
           pcall(function()
               if player.Team then color = player.TeamColor.Color end
           end)
           return color
       end
       return Color3.new(1, 1, 1) -- lobby = white
   end
   local function applyPlayerEsp(player)
       if player == _Players.LocalPlayer then return end
       local char = player.Character
       if not char then return end
       local head = char:FindFirstChild("Head")
       if not head then return end
       -- Skip if already has ESP that's still valid
       local existing = S.activePlayerEsp[player]
       if existing and existing.highlight and existing.highlight.Parent and existing.billboard and existing.billboard.Parent then
           -- Update team color and label in case team changed
           local teamName = getPlayerTeamName(player)
           local color = getHighlightColor(player, teamName)
           existing.highlight.FillColor = color
           existing.highlight.OutlineColor = color
           -- Update name label
           local staffData = S._staffCache[player.UserId]
           if staffData then
               existing.nameLabel.Text = player.Name .. "\n[" .. staffData.roleName .. "]"
               existing.nameLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
           else
               existing.nameLabel.Text = player.Name
               existing.nameLabel.TextColor3 = color
           end
           existing.teamName = teamName
           return
       end
       -- Clean up old ESP if partial
       if existing then
           pcall(function() if existing.highlight then existing.highlight:Destroy() end end)
           pcall(function() if existing.billboard then existing.billboard:Destroy() end end)
       end
       local teamName = getPlayerTeamName(player)
       local color = getHighlightColor(player, teamName)
       local staffData = S._staffCache[player.UserId]
       -- Create Highlight
       local highlight = Instance.new("Highlight")
       highlight.Name = "PlayerESP_Highlight"
       highlight.FillColor = color
       highlight.FillTransparency = 0.5
       highlight.OutlineColor = color
       highlight.OutlineTransparency = 0
       highlight.Adornee = char
       highlight.Parent = char
       -- Create BillboardGui for name (and rank for staff)
       local bill = Instance.new("BillboardGui")
       bill.Name = "PlayerESP_Billboard"
       bill.Size = UDim2.new(0, 200, 0, 50)
       bill.StudsOffset = Vector3.new(0, 3, 0)
       bill.AlwaysOnTop = true
       bill.Parent = head
       local nameLabel = Instance.new("TextLabel")
       nameLabel.Size = UDim2.new(1, 0, 1, 0)
       nameLabel.BackgroundTransparency = 1
       nameLabel.Font = Enum.Font.GothamBold
       nameLabel.TextSize = 14
       nameLabel.TextStrokeTransparency = 0.3
       nameLabel.Parent = bill
       if staffData then
           nameLabel.Text = player.Name .. "\n[" .. staffData.roleName .. "]"
           nameLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
       else
           nameLabel.Text = player.Name
           nameLabel.TextColor3 = color
       end
       S.activePlayerEsp[player] = {
           highlight = highlight,
           billboard = bill,
           nameLabel = nameLabel,
           teamName = teamName,
       }
   end
   while true do
       if S.playerEspEnabled then
           -- Apply ESP to all players
           for _, player in pairs(_Players:GetPlayers()) do
               pcall(function() applyPlayerEsp(player) end)
           end
           -- Cleanup ESP for players who left or whose character died/despawned
           for player, espData in pairs(S.activePlayerEsp) do
               local valid = false
               pcall(function()
                   if player and player.Parent and player.Character and player.Character:FindFirstChild("Head") then
                       valid = true
                   end
               end)
               if not valid then
                   pcall(function() if espData.highlight then espData.highlight:Destroy() end end)
                   pcall(function() if espData.billboard then espData.billboard:Destroy() end end)
                   S.activePlayerEsp[player] = nil
               end
           end
       end
       task.wait(1)
   end
end)
