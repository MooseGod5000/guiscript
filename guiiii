function placeableMiscClampAirDistance(value)
	return math.clamp(tonumber(value) or PLACEABLE_AIR_DISTANCE_DEFAULT, PLACEABLE_AIR_DISTANCE_MIN, PLACEABLE_AIR_DISTANCE_MAX)
