    end
    local throw = rawget(molotovItem, "Throw") or molotovItem.Throw
    if type(throw) == "function" and throw ~= itemHook.throwWrapper then
        itemHook.originalThrow = throw
        itemHook.throwWrapper = function(self, ...)
