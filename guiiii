local function shortestColumn(columnHeights)
	local index = 1
	local height = columnHeights[1] or 0
	for i = 2, #columnHeights do
		if columnHeights[i] < height then
			index = i
			height = columnHeights[i]
		end
	end
	return index
end

local function renderPage(pageId)
	currentPageId = pageId
	local page = findPage(pageId)
	clearChildren(UI.PageHost)
	UI.Title.Text = "WEST X - Auto Mine"
	refreshPageButtons()

	local availableWidth = math.max(160, Settings.Window_Size_X - 10)
	local gap = 6
	local targetColumnWidth = 160
	local columnCount = math.floor((availableWidth + gap) / (targetColumnWidth + gap))
	columnCount = math.clamp(columnCount, 1, 3)
	local columnWidth = math.floor((availableWidth - ((columnCount - 1) * gap)) / columnCount)
	local columns = {}
	local columnHeights = {}
	for i = 1, columnCount do
		local column = create("Frame", {
			Parent = UI.PageHost,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new(0, (i - 1) * (columnWidth + gap), 0, 0),
			Size = UDim2.new(0, columnWidth, 0, 1),
		})
		create("UIListLayout", {
			Parent = column,
			Padding = UDim.new(0, gap),
			SortOrder = Enum.SortOrder.LayoutOrder,
		})
		columns[i] = column
		columnHeights[i] = 0
	end
	for _, section in ipairs(page.sections) do
		if #section.controls > 0 then
			local index = shortestColumn(columnHeights)
			createSectionCard(columns[index], section)
			columnHeights[index] += sectionHeight(section) + gap
		end
	end
	local maxHeight = 0
	for _, height in ipairs(columnHeights) do
		maxHeight = math.max(maxHeight, height)
	end
	UI.PageHost.CanvasSize = UDim2.new(0, (columnWidth * columnCount) + (gap * (columnCount - 1)), 0, maxHeight + 12)
end

local function makeDraggable(frame, handle)
	local dragging = false
	local dragStart
	local startPos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)

	handle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

