        button.MouseButton1Click:Connect(function()
            local pickupId = button:GetAttribute("PickupId")
            if type(pickupId) ~= "string" or pickupId == "" then
                return
            end
            if selectedPickupNames[pickupId] then
                selectedPickupNames[pickupId] = nil
            else
                selectedPickupNames[pickupId] = true
            end
            S.selectedPickupNames = cloneBooleanMap(selectedPickupNames)
            schedulePersist()
