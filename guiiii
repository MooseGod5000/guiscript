function isHorseOrbitAnimalCandidate(ridingAnimal)
	if not isTable(ridingAnimal) or ridingAnimal.Active == false then
		return false
	end
	if ridingAnimal.Ragdolled or ridingAnimal.IsWakingUp then
		return false
	end

	local animalType = tostring(rawget(ridingAnimal, "AnimalType") or ridingAnimal.AnimalType or "")
	local horseBreed = rawget(ridingAnimal, "HorseBreed") or ridingAnimal.HorseBreed
	if animalType ~= "Horse" and animalType ~= "SkeletonHorse" and horseBreed == nil then
		return false
	end

	local character = rawget(ridingAnimal, "character") or ridingAnimal.character
	if typeof(character) == "Instance" then
		if character.Name == "WagonHorse" or character.Name == "HorseWagon" then
			return false
		end
	end

	return true
end

function isHorseOrbitLocalPlayerReference(value)
	if not localPlayer or value == nil then
		return false
	end

	if value == localPlayer then
		return true
	end

	if typeof(value) == "Instance" then
		return value.Name == localPlayer.Name
	end

	if type(value) == "number" then
		return value == localPlayer.UserId
	end

	local text = tostring(value)
	return text == localPlayer.Name or text == tostring(localPlayer.UserId)
end

function horseOrbitInstanceHasLocalPlayerAttribute(instance, attributeNames)
	if typeof(instance) ~= "Instance" or type(attributeNames) ~= "table" then
		return false
	end

	for _, attributeName in ipairs(attributeNames) do
		if isHorseOrbitLocalPlayerReference(instance:GetAttribute(attributeName)) then
			return true
		end
	end

	return false
end

function getHorseOrbitInstanceValue(instance)
	if typeof(instance) ~= "Instance" then
		return nil
	end

	local ok, value = pcall(function()
		return instance.Value
	end)
	return ok and value or nil
end

function isHorseOrbitOwnedAnimal(ridingAnimal)
	if not isHorseOrbitAnimalCandidate(ridingAnimal) then
		return false
	end

	local owner = rawget(ridingAnimal, "Owner") or ridingAnimal.Owner
	local rider = rawget(ridingAnimal, "Rider") or ridingAnimal.Rider
	if isHorseOrbitLocalPlayerReference(owner) or isHorseOrbitLocalPlayerReference(rider) then
		return true
	end

	local ownerId = rawget(ridingAnimal, "OwnerUserId") or ridingAnimal.OwnerUserId
		or rawget(ridingAnimal, "OwnerId") or ridingAnimal.OwnerId
		or rawget(ridingAnimal, "OwnerName") or ridingAnimal.OwnerName
	local riderId = rawget(ridingAnimal, "RiderUserId") or ridingAnimal.RiderUserId
		or rawget(ridingAnimal, "RiderId") or ridingAnimal.RiderId
		or rawget(ridingAnimal, "RiderName") or ridingAnimal.RiderName
	if isHorseOrbitLocalPlayerReference(ownerId) or isHorseOrbitLocalPlayerReference(riderId) then
		return true
	end

	local character = rawget(ridingAnimal, "character") or ridingAnimal.character
	if typeof(character) == "Instance" then
		local ownerValue = character:FindFirstChild("Owner")
		if ownerValue and isHorseOrbitLocalPlayerReference(getHorseOrbitInstanceValue(ownerValue)) then
			return true
		end
		local riderValue = character:FindFirstChild("Rider")
		if riderValue and isHorseOrbitLocalPlayerReference(getHorseOrbitInstanceValue(riderValue)) then
			return true
		end
		if horseOrbitInstanceHasLocalPlayerAttribute(character, {
			"Owner",
			"OwnerUserId",
			"OwnerId",
			"OwnerName",
			"Rider",
			"RiderUserId",
			"RiderId",
			"RiderName",
			"Player",
			"PlayerName",
			"UserId",
		}) then
			return true
		end
	end

	local replicatedState = resolveGlobalReplicatedState(false) or resolveGlobalReplicatedState(true)
	local state = isTable(replicatedState) and (rawget(replicatedState, "State") or replicatedState.State) or nil
	local calledAnimal = isTable(state) and (rawget(state, "CalledAnimal") or state.CalledAnimal) or nil
	if calledAnimal ~= nil then
		if calledAnimal == ridingAnimal or calledAnimal == character then
			return true
		end
		local id = rawget(ridingAnimal, "ID") or ridingAnimal.ID
		if id ~= nil and calledAnimal == id then
			return true
		end
		if typeof(character) == "Instance" then
			local attributeId = character:GetAttribute("ID")
			if attributeId ~= nil and calledAnimal == attributeId then
				return true
			end
		end
	end

	return false
end

function isHorseOrbitServerMounted(ridingAnimal)
	if not isHorseOrbitAnimalCandidate(ridingAnimal) then
		return false
	end

	local rider = rawget(ridingAnimal, "Rider") or ridingAnimal.Rider
	if isHorseOrbitLocalPlayerReference(rider) then
		return true
	end

	local character = rawget(ridingAnimal, "character") or ridingAnimal.character
	if typeof(character) == "Instance" then
		local riderValue = character:FindFirstChild("Rider")
		if riderValue and isHorseOrbitLocalPlayerReference(getHorseOrbitInstanceValue(riderValue)) then
			return true
		end
	end

	local wildLife = resolveHorseOrbitWildLife(false)
	return isTable(wildLife) and (rawget(wildLife, "RidingAnimal") or wildLife.RidingAnimal) == ridingAnimal
end

function resolveHorseOrbitCandidateAnimal(forceRefresh)
	local ridingAnimal = resolveRidingAnimal(forceRefresh)
	if isHorseOrbitOwnedAnimal(ridingAnimal) then
		return ridingAnimal
	end

	local wildLife = resolveHorseOrbitWildLife(forceRefresh)
	if not isTable(wildLife) then
		return nil
	end

	local wildLifeObjects
	local getWildLife = rawget(wildLife, "GetWildLife") or wildLife.GetWildLife
	if type(getWildLife) == "function" then
		local okWildLife, result = pcall(getWildLife, wildLife)
		if okWildLife and isTable(result) then
			wildLifeObjects = result
		end
	end

	if isTable(wildLifeObjects) then
		for _, wildLifeObject in pairs(wildLifeObjects) do
			if isHorseOrbitOwnedAnimal(wildLifeObject) then
				return wildLifeObject
			end
		end
	end

	return nil
end

function installHorseOrbitUnmountHook(ridingAnimal)
	if not isTable(ridingAnimal) then
		return false
	end
	if type(playerState.horseOrbitUnmountHooks) ~= "table" then
		playerState.horseOrbitUnmountHooks = {}
	end

	local hooks = playerState.horseOrbitUnmountHooks
	if hooks[ridingAnimal] then
		return true
	end

	local originalUnMount = rawget(ridingAnimal, "UnMount") or ridingAnimal.UnMount
	if type(originalUnMount) ~= "function" then
		return false
	end

	local hook = {
		originalUnMount = originalUnMount,
	}
	hook.unMountWrapper = function(self, ...)
		return hook.originalUnMount(self, ...)
	end

	pcall(function()
		ridingAnimal.UnMount = hook.unMountWrapper
	end)
	hooks[ridingAnimal] = hook
	return true
end

function restoreHorseOrbitUnmountHooks()
	local hooks = playerState.horseOrbitUnmountHooks
	if type(hooks) == "table" then
		for ridingAnimal, hook in pairs(hooks) do
			if isTable(ridingAnimal) and isTable(hook) then
				pcall(function()
					if ridingAnimal.UnMount == hook.unMountWrapper then
						ridingAnimal.UnMount = hook.originalUnMount
					end
				end)
			end
		end
	end
	playerState.horseOrbitUnmountHooks = {}
end

function requestHorseOrbitMount(ridingAnimal, skipLocalMount)
	if not isHorseOrbitAnimalCandidate(ridingAnimal) then
		return false
	end

	local now = os.clock()
	if now - (tonumber(playerState.horseOrbitLastMountAttemptAt) or 0) < HORSE_ORBIT_MOUNT_RETRY_SECONDS then
		return false
	end
	playerState.horseOrbitLastMountAttemptAt = now

	clearHorseRagdollState(ridingAnimal)
	installHorseAntiRagdollHook(ridingAnimal)
	installHorseOrbitUnmountHook(ridingAnimal)

	local character = rawget(ridingAnimal, "character") or ridingAnimal.character
	local network = resolveGlobalNetwork(false) or resolveGlobalNetwork(true)
	if network and type(network.FireServer) == "function" and typeof(character) == "Instance" then
		pcall(function()
			network:FireServer("MountAnimal", character)
		end)
	end

	if isHorseOrbitServerMounted(ridingAnimal) and not skipLocalMount and type(ridingAnimal.Mount) == "function" then
		pcall(function()
			ridingAnimal:Mount()
		end)
	end

	local wildLife = resolveHorseOrbitWildLife(false) or resolveHorseOrbitWildLife(true)
	if isHorseOrbitServerMounted(ridingAnimal) and isTable(wildLife) then
		pcall(function()
			wildLife.RidingAnimal = ridingAnimal
		end)
	end

	return true
end

function ensureHorseOrbitMounted()
	local ridingAnimal = resolveRidingAnimal(false)
	if isHorseOrbitOwnedAnimal(ridingAnimal) then
		installHorseOrbitUnmountHook(ridingAnimal)
		requestHorseOrbitMount(ridingAnimal, true)
		return ridingAnimal
	end

	local candidate = resolveHorseOrbitCandidateAnimal(false) or resolveHorseOrbitCandidateAnimal(true)
	if not candidate then
		return nil
	end

	requestHorseOrbitMount(candidate)
	return resolveRidingAnimal(false) or candidate
end

function getHorseOrbitRoot(ridingAnimal)
	if not isTable(ridingAnimal) then
		return nil
	end

	local hrp = rawget(ridingAnimal, "hrp") or ridingAnimal.hrp
	if typeof(hrp) == "Instance" and hrp:IsA("BasePart") then
		return hrp
	end

	local character = rawget(ridingAnimal, "character") or ridingAnimal.character
	if typeof(character) == "Instance" then
		local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
		if typeof(root) == "Instance" and root:IsA("BasePart") then
			return root
		end
	end

	return nil
end

function getHorseOrbitTargetY(targetPosition, ridingAnimal, character, horseRoot)
	local fallbackY = horseRoot and horseRoot.Position.Y or targetPosition.Y
	local okParams, raycastParams = pcall(RaycastParams.new)
	if not okParams or not raycastParams then
		return fallbackY
	end

	local filter = {}
	if typeof(character) == "Instance" then
		table.insert(filter, character)
	end
	local animalCharacter = isTable(ridingAnimal) and (rawget(ridingAnimal, "character") or ridingAnimal.character) or nil
	if typeof(animalCharacter) == "Instance" then
		table.insert(filter, animalCharacter)
	end
	local ignore = workspace:FindFirstChild("Ignore")
	if ignore then
		table.insert(filter, ignore)
	end

	raycastParams.FilterDescendantsInstances = filter
	pcall(function()
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	end)
	pcall(function()
		raycastParams.RespectCanCollide = true
	end)

	local origin = Vector3.new(targetPosition.X, fallbackY + HORSE_ORBIT_GROUND_RAY_HEIGHT, targetPosition.Z)
	local result = workspace:Raycast(origin, Vector3.new(0, -HORSE_ORBIT_GROUND_RAY_DEPTH, 0), raycastParams)
	if result then
		local hoverHeight = HORSE_ORBIT_MIN_HOVER_HEIGHT
		if horseRoot then
			hoverHeight = math.max(hoverHeight, horseRoot.Size.Y * 0.5)
		end
		return result.Position.Y + hoverHeight
	end

	return fallbackY
end

function setHorseOrbitHorseCollisionEnabled(ridingAnimal, isEnabled)
	local character = isTable(ridingAnimal) and (rawget(ridingAnimal, "character") or ridingAnimal.character) or nil
	local horseRoot = getHorseOrbitRoot(ridingAnimal)
	if isEnabled then
		local savedParts = playerState.horseOrbitHorseCollisionParts
		if type(savedParts) == "table" then
			for part, canCollide in pairs(savedParts) do
				if typeof(part) == "Instance" and part:IsA("BasePart") then
					pcall(function()
						part.CanCollide = canCollide == true
					end)
				end
			end
		end
		playerState.horseOrbitHorseCollisionParts = nil
		return true
	end

	if typeof(character) ~= "Instance" and not horseRoot then
		return false
	end

	local savedParts = playerState.horseOrbitHorseCollisionParts
	if type(savedParts) ~= "table" then
		savedParts = {}
		playerState.horseOrbitHorseCollisionParts = savedParts
	end

	local function disablePartCollision(part)
		if typeof(part) == "Instance" and part:IsA("BasePart") then
			if savedParts[part] == nil then
				savedParts[part] = part.CanCollide
			end
			pcall(function()
				part.CanCollide = false
			end)
		end
	end

	if typeof(character) == "Instance" then
		for _, descendant in ipairs(character:GetDescendants()) do
			disablePartCollision(descendant)
		end
	end
	disablePartCollision(horseRoot)
	return true
end

function isHorseFlingLocalCharacter(character)
	if typeof(character) ~= "Instance" or not localPlayer then
		return false
	end

	if character == getWorldCharacterForPlayer(localPlayer) or character == localPlayer.Character then
		return true
	end

	local name = tostring(character.Name or "")
	return name == localPlayer.Name or name == tostring(localPlayer.UserId)
end

function getHorseFlingRootFromCharacter(character)
	if typeof(character) ~= "Instance" or not character:IsA("Model") or isHorseFlingLocalCharacter(character) then
		return nil
	end

	local humanoid = getCharacterHumanoid(character)
	if humanoid and humanoid.Health <= 0 then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart or getRootPart(character)
end

function findHorseFlingTargetRoot(originRoot)
	if not originRoot then
		return nil
	end

	local range = tonumber(HORSE_FLING_TARGET_RANGE) or 15
	local bestRoot = nil
	local bestCharacter = nil
	local bestPlayer = nil
	local bestDistance = range
	local seenCharacters = {}

	local function considerCharacter(character)
		if typeof(character) ~= "Instance" or seenCharacters[character] then
			return
		end
		seenCharacters[character] = true

		local targetRoot = getHorseFlingRootFromCharacter(character)
		if not targetRoot then
			return
		end

		local distance = (originRoot.Position - targetRoot.Position).Magnitude
		if distance <= bestDistance then
			bestDistance = distance
			bestRoot = targetRoot
			bestCharacter = character
			bestPlayer = _Players:FindFirstChild(tostring(character.Name or ""))
		end
	end

	local playersFolder = getTwwEntityPlayersFolder()
	if playersFolder then
		for _, character in ipairs(playersFolder:GetChildren()) do
			considerCharacter(character)
		end
	end

	for _, player in ipairs(_Players:GetPlayers()) do
		if player ~= localPlayer then
			considerCharacter(getWorldCharacterForPlayer(player) or player.Character)
		end
	end

	return bestRoot, bestDistance, bestCharacter, bestPlayer
end

function resolveHorseFlingRepCharHandler(forceRefresh)
	local globalModule = getAutoMineGlobalModule(forceRefresh)
	if isTable(globalModule) then
		for _, key in ipairs({ "RepCharHandler", "repCharHandler" }) do
			local candidate = rawget(globalModule, key) or globalModule[key]
			if isTable(candidate) and type(rawget(candidate, "GetRepChar") or candidate.GetRepChar) == "function" then
				return candidate
			end
		end
		if type(globalModule.LoadModule) == "function" then
			local okLoad, loaded = pcall(function()
				return globalModule:LoadModule("RepCharHandler")
			end)
			if okLoad and isTable(loaded) and type(rawget(loaded, "GetRepChar") or loaded.GetRepChar) == "function" then
				globalModule.RepCharHandler = loaded
				return loaded
			end
		end
	end

	local modulesTable = resolveGameModules(forceRefresh)
	if isTable(modulesTable) then
		for _, key in ipairs({ "RepCharHandler", "repCharHandler" }) do
			local candidate = rawget(modulesTable, key) or modulesTable[key]
			if isTable(candidate) and type(rawget(candidate, "GetRepChar") or candidate.GetRepChar) == "function" then
				return candidate
			end
		end
	end

	return nil
end

function resolveHorseFlingTargetReference(targetRoot, targetCharacter, targetPlayer)
	local network = resolveGlobalNetwork(false) or resolveGlobalNetwork(true)
	if not network or type(network.GetReference) ~= "function" then
		return nil
	end

	local handler = resolveHorseFlingRepCharHandler(false) or resolveHorseFlingRepCharHandler(true)
	local getRepChar = isTable(handler) and (rawget(handler, "GetRepChar") or handler.GetRepChar) or nil
	local candidates = {}
	local function addCandidate(candidate)
		if candidate ~= nil then
			table.insert(candidates, candidate)
		end
	end
	addCandidate(targetPlayer)
	addCandidate(targetCharacter)
	if targetRoot then
		addCandidate(targetRoot.Parent)
		if targetRoot.Parent then
			addCandidate(targetRoot.Parent.Parent)
		end
	end

	for _, candidate in ipairs(candidates) do
		local repChar = nil
		if type(getRepChar) == "function" and candidate ~= nil then
			local okRep, result = pcall(getRepChar, handler, candidate)
			if okRep and isTable(result) then
				repChar = result
			end
		end
		if repChar ~= nil then
			local reference = nil
			pcall(function()
				reference = network:GetReference(repChar, "Character")
			end)
			if reference ~= nil then
				return reference
			end
		end
	end

	for _, candidate in ipairs({ targetCharacter, targetRoot }) do
		if candidate ~= nil then
			local reference = nil
			pcall(function()
				reference = network:GetReference(candidate, candidate == targetRoot and "CharacterPart" or "Character")
			end)
			if reference ~= nil then
				return reference
			end
		end
	end

	return nil
end

function fireHorseFlingRagdollRemote(ridingAnimal, horseRoot, targetRoot, targetCharacter, targetPlayer)
	if not (isTable(ridingAnimal) and horseRoot and targetRoot) then
		return false
	end

	local now = os.clock()
	if now - (tonumber(playerState.horseFlingLastRemoteAt) or 0) < HORSE_FLING_REMOTE_INTERVAL then
		return false
	end
	playerState.horseFlingLastRemoteAt = now

	local network = resolveGlobalNetwork(false) or resolveGlobalNetwork(true)
	if not network or type(network.FireServer) ~= "function" then
		return false
	end

	local targetReference = resolveHorseFlingTargetReference(targetRoot, targetCharacter, targetPlayer)
	if targetReference == nil then
		pushDebugRateLimited("horse_fling_no_target_ref", "horse fling: target reference unavailable", 4)
		return false
	end

	local direction = (targetRoot.Position - horseRoot.Position) * Vector3.new(1, 0, 1)
	if direction.Magnitude > 0.001 then
		direction = direction.Unit
	else
		direction = Vector3.new(horseRoot.CFrame.LookVector.X, 0, horseRoot.CFrame.LookVector.Z)
		if direction.Magnitude > 0.001 then
			direction = direction.Unit
		else
			direction = Vector3.new(0, 0, -1)
		end
	end

	local okFire = pcall(function()
		network:FireServer("HorseRagdollPlayer", targetReference, direction)
	end)
	return okFire
end

function detachHorseOrbitSeat(rootPart)
	if not rootPart then
		return
	end

	local seatJoint = rootPart:FindFirstChild("Animal_To_Player")
	if not seatJoint then
		return
	end

	if playerState.horseOrbitSeatJoint ~= seatJoint then
		playerState.horseOrbitSeatJoint = seatJoint
		local okPart1, part1 = pcall(function()
			return seatJoint.Part1
		end)
		playerState.horseOrbitSeatPart1 = okPart1 and part1 or nil
		local okEnabled, enabled = pcall(function()
			return seatJoint.Enabled
		end)
		playerState.horseOrbitSeatWasEnabled = okEnabled and enabled or nil
	end

	pcall(function()
		seatJoint.Part1 = nil
	end)
	pcall(function()
		seatJoint.Enabled = false
	end)
end

function setHorseOrbitCharacterMassless(character, isMassless)
	if typeof(character) ~= "Instance" then
		return
	end

	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then
			pcall(function()
				descendant.Massless = isMassless
			end)
		end
	end
end

function applyHorseOrbitFreePlayerState(character, rootPart, humanoid)
	detachHorseOrbitSeat(rootPart)

	if rootPart then
		pcall(function()
			rootPart.CollisionGroup = "PlayerCharacters"
		end)
	end
	if humanoid then
		pcall(function()
			humanoid.PlatformStand = false
			humanoid.Sit = false
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end)
		if humanoid.WalkSpeed < 16 then
			humanoid.WalkSpeed = 16
		end
		local controls = getLocalPlayerControls()
		if controls and type(controls.GetMoveVector) == "function" then
			local okMove, moveVector = pcall(controls.GetMoveVector, controls)
			if okMove and typeof(moveVector) == "Vector3" then
				pcall(function()
					humanoid:Move(moveVector, true)
				end)
			end
		end
	end

	setHorseOrbitCharacterMassless(character, false)
end

function restoreHorseOrbitPlayerAttachment(shouldRestoreMountedState)
	local character = getWorldCharacterForPlayer(localPlayer) or (localPlayer and localPlayer.Character)
	local rootPart = getRootPart(character)
	local humanoid = getCharacterHumanoid(character)
	local canRestoreMountedAttachment = shouldRestoreMountedState
		and playerState.horseOrbitSeatJoint ~= nil
		and playerState.horseOrbitSeatPart1 ~= nil

	if canRestoreMountedAttachment then
		local seatJoint = playerState.horseOrbitSeatJoint
		if seatJoint then
			pcall(function()
				if playerState.horseOrbitSeatPart1 then
					seatJoint.Part1 = playerState.horseOrbitSeatPart1
				end
			end)
			pcall(function()
				seatJoint.Enabled = playerState.horseOrbitSeatWasEnabled ~= false
			end)
		end
		if rootPart then
			pcall(function()
				rootPart.CollisionGroup = "SeatedPlayers"
			end)
		end
		if humanoid then
			pcall(function()
				humanoid:ChangeState(Enum.HumanoidStateType.Physics)
			end)
		end
		setHorseOrbitCharacterMassless(character, true)
	else
		if rootPart then
			detachHorseOrbitSeat(rootPart)
			pcall(function()
				rootPart.CollisionGroup = "PlayerCharacters"
			end)
		end
		if humanoid then
			pcall(function()
				humanoid.PlatformStand = false
				humanoid.Sit = false
				humanoid:ChangeState(Enum.HumanoidStateType.Running)
			end)
		end
		setHorseOrbitCharacterMassless(character, false)
	end

	playerState.horseOrbitSeatJoint = nil
	playerState.horseOrbitSeatPart1 = nil
	playerState.horseOrbitSeatWasEnabled = nil
	return canRestoreMountedAttachment
end

function applyHorseOrbitAnimalMotion(ridingAnimal, character, rootPart, dt)
	local horseRoot = getHorseOrbitRoot(ridingAnimal)
	if not horseRoot or not rootPart then
		return false
	end

	if playerState.horseOrbitLastAnimal ~= ridingAnimal then
		local delta = horseRoot.Position - rootPart.Position
		local flatDelta = Vector3.new(delta.X, 0, delta.Z)
		if flatDelta.Magnitude > 0.1 then
			playerState.horseOrbitAngle = math.atan2(flatDelta.Z, flatDelta.X)
		else
			playerState.horseOrbitAngle = 0
		end
		playerState.horseOrbitLastAnimal = ridingAnimal
	end

	if not isHorseOrbitServerMounted(ridingAnimal) then
		requestHorseOrbitMount(ridingAnimal, true)
		setHorseOrbitHorseCollisionEnabled(ridingAnimal, false)
		return false
	end

	local flingTargetRoot, _, flingTargetCharacter, flingTargetPlayer = findHorseFlingTargetRoot(rootPart)
	local hasFlingTarget = flingTargetRoot ~= nil
	if not hasFlingTarget then
		installHorseAntiRagdollHook(ridingAnimal)
		clearHorseRagdollState(ridingAnimal)
		setHorseOrbitHorseCollisionEnabled(ridingAnimal, false)
		pcall(function()
			horseRoot.AssemblyAngularVelocity = Vector3.new()
		end)
		return true
	end

	local direction = flingTargetRoot.Position - horseRoot.Position
	local lookDirection = Vector3.new(direction.X, 0, direction.Z)
	if lookDirection.Magnitude <= 0.001 then
		lookDirection = Vector3.new(0, 0, -1)
	end
	lookDirection = lookDirection.Unit
	local targetCFrame = CFrame.new(flingTargetRoot.Position)
		* CFrame.new(0, 0, HORSE_FLING_TARGET_DISTANCE)
		* CFrame.Angles(0, os.clock() * HORSE_FLING_TARGET_SPIN_SPEED, 0)
	local pushVelocity = (lookDirection * HORSE_FLING_PUSH_SPEED) + Vector3.new(0, 1, 0)
	fireHorseFlingRagdollRemote(ridingAnimal, horseRoot, flingTargetRoot, flingTargetCharacter, flingTargetPlayer)

	pcall(function()
		ridingAnimal.Movement = Vector3.new(0, 0, -1)
		ridingAnimal.Walking = false
		ridingAnimal.InputReleased = nil
		ridingAnimal.WalkSpeedGoal = HORSE_FLING_PUSH_SPEED
		ridingAnimal.WalkSpeed = math.max(tonumber(ridingAnimal.SprintingSpeed) or HORSE_FLING_PUSH_SPEED, HORSE_FLING_PUSH_SPEED)
		ridingAnimal.Moving = true
		ridingAnimal.Sprinting = true
		ridingAnimal.Swimming = false
		ridingAnimal.Falling = false
		ridingAnimal.lastgrounded = true
		ridingAnimal.DirectionVector = lookDirection
	end)
	if type(ridingAnimal.SetDirectionVector) == "function" then
		pcall(function()
			ridingAnimal:SetDirectionVector(lookDirection)
		end)
	end
	if type(ridingAnimal.SetMovementState) == "function" then
		pcall(function()
			ridingAnimal:SetMovementState("Sprinting")
		end)
	end
	if type(ridingAnimal.SetMovementAnimationSpeed) == "function" then
		pcall(function()
			ridingAnimal:SetMovementAnimationSpeed(1.5)
		end)
	end
	installHorseAntiRagdollHook(ridingAnimal)
	clearHorseRagdollState(ridingAnimal)
	setHorseOrbitHorseCollisionEnabled(ridingAnimal, false)

	pcall(function()
		horseRoot.CFrame = targetCFrame
	end)
	pcall(function()
		horseRoot.AssemblyLinearVelocity = pushVelocity
	end)
	pcall(function()
		horseRoot.Velocity = pushVelocity
	end)
	pcall(function()
		horseRoot.AssemblyAngularVelocity = hasFlingTarget and Vector3.new(0, HORSE_FLING_SPIN_POWER, 0) or Vector3.new()
	end)
	if hasFlingTarget then
		pcall(function()
			if (horseRoot.Position - flingTargetRoot.Position).Magnitude <= (HORSE_FLING_TARGET_DISTANCE + 6) then
				flingTargetRoot.AssemblyLinearVelocity = Vector3.new(0, HORSE_FLING_TARGET_LIFT_POWER, 0)
			end
		end)
	end

	local bodyGyro = rawget(ridingAnimal, "bg") or ridingAnimal.bg
	if bodyGyro then
		pcall(function()
			bodyGyro.MaxTorque = ridingAnimal.bgtorque or Vector3.new(10000, 10000, 10000)
			bodyGyro.CFrame = targetCFrame
		end)
	end
	local bodyVelocity = rawget(ridingAnimal, "bv") or ridingAnimal.bv
	if bodyVelocity then
		pcall(function()
			bodyVelocity.MaxForce = ridingAnimal.bvforce or Vector3.new(50000, 0, 50000)
			bodyVelocity.Velocity = pushVelocity
		end)
	end

	pcall(function()
		ridingAnimal.LastRootCFrame = targetCFrame
		ridingAnimal.ApplyServerCFrameIfCFrameIs = nil
	end)
	return true
end

function applyHorseOrbitPulse(dt)
	local ridingAnimal = ensureHorseOrbitMounted()
	if not ridingAnimal then
		pushDebugRateLimited("horse_fling_waiting_for_horse", "horse fling: waiting for your horse", 4)
		return false
	end

	local character = getWorldCharacterForPlayer(localPlayer) or (localPlayer and localPlayer.Character)
	local rootPart = getRootPart(character)
	local humanoid = getCharacterHumanoid(character)
	if not rootPart then
		return false
	end

	playerState.horseOrbitWasActive = true
	if not isHorseOrbitServerMounted(ridingAnimal) then
		requestHorseOrbitMount(ridingAnimal, true)
		pushDebugRateLimited("horse_fling_waiting_for_mount", "horse fling: waiting for server mount", 4)
		return false
	end
	return applyHorseOrbitAnimalMotion(ridingAnimal, character, rootPart, dt)
end

function restoreHorseOrbitHooks()
	local connection = playerState.horseOrbitConnection
	if connection then
		pcall(function()
			connection:Disconnect()
		end)
	end
	playerState.horseOrbitConnection = nil

	local hasUnmountHooks = type(playerState.horseOrbitUnmountHooks) == "table" and next(playerState.horseOrbitUnmountHooks) ~= nil
	local hadActiveOrbit = playerState.horseOrbitWasActive
		or playerState.horseOrbitSeatJoint ~= nil
		or playerState.horseOrbitLastAnimal ~= nil
		or playerState.horseOrbitHorseCollisionParts ~= nil
		or hasUnmountHooks
	if not hadActiveOrbit then
		return
	end

	local ridingAnimal = resolveRidingAnimal(false)
	local shouldRestoreMountedState = isTable(ridingAnimal)
	local restoredMountedAttachment = restoreHorseOrbitPlayerAttachment(shouldRestoreMountedState)

	if isTable(ridingAnimal) then
		pcall(function()
			ridingAnimal.Movement = restoredMountedAttachment and Vector3.new() or nil
			ridingAnimal.WalkSpeedGoal = 0
			ridingAnimal.WalkSpeed = 0
			ridingAnimal.bv.MaxForce = ridingAnimal.bvforce or Vector3.new(50000, 0, 50000)
			ridingAnimal.bv.Velocity = Vector3.new()
			ridingAnimal.bg.MaxTorque = ridingAnimal.bgtorque or Vector3.new(10000, 10000, 10000)
		end)
