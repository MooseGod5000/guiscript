function placeableMiscGetAimRay()
	local camera = workspace.CurrentCamera
	local mouse = localPlayer and localPlayer:GetMouse()
	if mouse then
		local okRay, ray = pcall(function()
			return mouse.UnitRay
		end)
		if okRay and typeof(ray) == "Ray" and ray.Direction.Magnitude > 0.001 then
			return ray.Origin, ray.Direction.Unit
		end
	end
	if camera then
		local okMouse, mouseLocation = pcall(function()
			return _UserInputService:GetMouseLocation()
		end)
		if okMouse and typeof(mouseLocation) == "Vector2" then
			local ray = camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y)
			if ray.Direction.Magnitude > 0.001 then
				return ray.Origin, ray.Direction.Unit
			end
		end
		return camera.CFrame.Position, camera.CFrame.LookVector.Unit
	end
	local root = placeableMiscGetCharacterRoot()
	if root then
		return root.Position, root.CFrame.LookVector.Unit
	end
	return nil, nil
end
function placeableMiscGetMousePosition()
	local origin, direction = placeableMiscGetAimRay()
	if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
		PLACEABLE_ITEM_MISC.airDistance = placeableMiscClampAirDistance(PLACEABLE_ITEM_MISC.airDistance)
		return origin + (direction * PLACEABLE_ITEM_MISC.airDistance)
	end
	return nil
end
