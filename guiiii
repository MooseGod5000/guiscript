function vfxAuraGetCharacterRoot()
	local globalModule = getAutoMineGlobalModule(false) or getAutoMineGlobalModule(true)
	local playerCharacter = vfxAuraTableValue(globalModule, "PlayerCharacter")
	if isTable(playerCharacter) then
		local character = vfxAuraTableValue(playerCharacter, "Character")
		if typeof(character) == "Instance" then
			local preferredPart = vfxAuraGetPreferredCharacterPart(character)
			if preferredPart then
				return preferredPart
			end
		end
		local root = vfxAuraTableValue(playerCharacter, "RootPart")
		if typeof(root) == "Instance" and root:IsA("BasePart") and root:IsDescendantOf(workspace) then
			return root
		end
	end
	local entities = workspace:FindFirstChild("WORKSPACE_Entities")
	local playersFolder = entities and entities:FindFirstChild("Players")
	local customCharacter = playersFolder and localPlayer and playersFolder:FindFirstChild(localPlayer.Name) or nil
	if typeof(customCharacter) == "Instance" then
		local preferredPart = vfxAuraGetPreferredCharacterPart(customCharacter)
		if preferredPart then
			return preferredPart
		end
	end
	local character = (type(getWorldCharacterForPlayer) == "function" and getWorldCharacterForPlayer(localPlayer))
		or (type(getCustomCharacter) == "function" and getCustomCharacter())
		or (localPlayer and localPlayer.Character)
	local preferredPart = vfxAuraGetPreferredCharacterPart(character)
	if preferredPart then
		return preferredPart
	end
	local root = type(getRootPart) == "function" and getRootPart(character) or nil
	if typeof(root) == "Instance" and root:IsA("BasePart") and root:IsDescendantOf(workspace) then
		return root
	end
	return nil
end
function vfxAuraEmitImpactSet(root)
	local vfx = vfxAuraResolveVfxModule(false) or vfxAuraResolveVfxModule(true)
	if not isTable(vfx) or typeof(root) ~= "Instance" or not root:IsA("BasePart") then
		return false
	end
	local position = root.Position
	local basis = root.CFrame
	local forward = basis.LookVector
	if forward.Magnitude <= 0.001 then
		forward = Vector3.new(0, 0, -1)
	end
	forward = forward.Unit
	local right = basis.RightVector.Magnitude > 0.001 and basis.RightVector.Unit or Vector3.new(1, 0, 0)
	local offsets = {
		Vector3.zero,
		right * 1.35,
		-right * 1.35,
		forward * 1.25,
		-forward * 1.25,
	}
	local emitted = false
	local function tryCall(methodName, ...)
		local method = rawget(vfx, methodName) or vfx[methodName]
		if type(method) ~= "function" then
			return false
		end
		local okCall = pcall(method, ...)
		emitted = emitted or okCall
		return okCall
	end
	tryCall("CreateWaterSplash", CFrame.new(position + offsets[1]), 1)
	tryCall("CreateMudSplash", CFrame.new(position + offsets[2]))
	tryCall("CreateFleshImpact", position + offsets[3], forward, true)
	tryCall("CreateSnowImpact", position + offsets[4], forward, true)
	tryCall("CreateShrapnelImpact", position + offsets[5], 0, true)
	return emitted
end
function vfxAuraHeartbeat()
	if destroyed or not isSessionActive() or not S.vfxAuraEnabled then
		restoreVfxAuraHooks()
		return
	end
	local now = os.clock()
	if now - (tonumber(VFX_AURA_MISC.lastEmitAt) or 0) < VFX_AURA_INTERVAL then
		return
	end
	VFX_AURA_MISC.lastEmitAt = now
	local root = vfxAuraGetCharacterRoot()
	if not root then
		if now - (tonumber(VFX_AURA_MISC.lastStatusAt) or 0) > 4 then
			VFX_AURA_MISC.lastStatusAt = now
			pushDebug("vfx aura: waiting for character root")
		end
		return
	end
	if not vfxAuraEmitImpactSet(root) and now - (tonumber(VFX_AURA_MISC.lastStatusAt) or 0) > 4 then
		VFX_AURA_MISC.lastStatusAt = now
		pushDebug("vfx aura: VFX module unavailable")
	end
end
