	end

	local serializedPathSlots = {}
	for slotIndex = 1, MAX_PATH_PLAYBACK_SLOTS do
		serializedPathSlots[slotIndex] = getPathSlotSelection(slotIndex, true)
	end

	local payload = {
		version = 5,
		sharedPathFolder = PATH_STORAGE_FOLDER,
		settings = {
			selectedPathName = pathState.selectedPathName,
			pathSlots = serializedPathSlots,
			pathSectionCount = pathState.pathSectionCount,
			focusedPathSlotIndex = pathState.focusedPathSlotIndex,
			sequenceStartSlotIndex = pathState.sequenceStartSlotIndex,
			alwaysPlayEnabled = pathState.alwaysPlayEnabled,
			farmPathsEnabled = pathState.farmPathsEnabled == true,
			staffHopEnabled = pathState.staffHopEnabled == true,
			smartStaffDetectionEnabled = pathState.smartStaffDetectionEnabled == true,
			playerAvoiderEnabled = pathState.playerAvoiderEnabled == true,
			playerAvoiderDistance = getPathPlayerAvoiderDistance(),
			playerAvoiderShowCorridor = pathState.playerAvoiderShowCorridor == true,
			playerAvoiderMethod = getPathPlayerAvoiderMethod(),
			playerAvoiderMethods = getPathPlayerAvoiderMethods(),
			playerAvoiderAction = getPathPlayerAvoiderAction(),
			playerAvoiderRadius = getPathPlayerAvoiderRadius(),
			playerAvoiderShowRadius = pathState.playerAvoiderShowRadius ~= false,
			bearPreventionEnabled = pathState.bearPreventionEnabled == true,
			hopOnDeathEnabled = pathState.hopOnDeathEnabled == true,
			hopTimePassEnabled = pathState.hopTimePassEnabled == true,
			hopTimePassMinutes = getPathHopTimePassMinutes(),
			orePurityHopEnabled = isPathOrePurityHopEnabled(),
			orePurityHopPercent = getPathOrePurityHopPercent(),
			stayGroundedEnabled = isPathStayGroundedEnabled(),
			playLoopEnabled = false,
			resumePathPlaybackPending = pathState.resumePathPlaybackPending == true,
			markOreKey = pathState.markOreKey and pathState.markOreKey.Name or DEFAULT_AUTOFARM_KEY.Name,
			recordNodeSpacing = getPathRecordNodeSpacing(),
			recordYOffset = getPathRecordYOffset(),
			movementMode = normalizeMovementMode(movementMode),
			tweenMoveSpeed = clampTweenSpeed(tweenMoveSpeed),
			cframeFlyOffset = getCFrameFlyOffset(),
			cframeFlyAngle = getCFrameFlyAngle(),
			undergroundDepthOffset = getUndergroundDepthOffset(),
			undergroundAngle = getUndergroundAngle(),
			undergroundRollFramePercent = getUndergroundRollFramePercent(),
			undergroundRollMode = getUndergroundRollMode(),
			undergroundRollTrack = getUndergroundRollTrack(),
			serverHopEnabled = serverHopEnabled == true,
		},
		paths = serializedPaths,
	}

	local makefolderFunction = getCallableGlobal("makefolder")
	local writefileFunction = getCallableGlobal("writefile")
	pcall(makefolderFunction, PATH_STORAGE_FOLDER)
	local ok = false
	local err = nil
	ok, err = pcall(writefileFunction, getPathStorageFilePath(), HttpService:JSONEncode(payload))

	if not ok then
		notifyUser("Path Storage", "Failed to save paths: " .. tostring(err), 5)
		return false
	end

	local okShared, sharedErr = writeSharedPathFilesToStorage(serializedPaths)
	if not okShared then
		notifyUser("Path Storage", "Saved path settings, but failed to save share files: " .. tostring(sharedErr), 5)
		return false
	end

	return true
end

function loadPathsFromStorage()
	if not ensurePathStorageSupport(false) then
		return false
	end

	local makefolderFunction = getCallableGlobal("makefolder")
	local isfileFunction = getCallableGlobal("isfile")
	local filePath = getPathStorageFilePath()
	if type(makefolderFunction) == "function" then
		pcall(makefolderFunction, PATH_STORAGE_FOLDER)
	end

	local payload = nil
	local loadedFromLegacyStorage = false
	local hadUnreadablePrimaryStorage = false
	if type(isfileFunction) == "function" then
		local okExists, exists = pcall(isfileFunction, filePath)
		if okExists and exists then
			payload = readPathStorageJsonFile(filePath)
			hadUnreadablePrimaryStorage = payload == nil
		end
	end

	if not payload and type(isfileFunction) == "function" then
		local legacyFilePath = getLegacyPathStorageFilePath()
		local okLegacyExists, legacyExists = pcall(isfileFunction, legacyFilePath)
		if okLegacyExists and legacyExists then
			payload = readPathStorageJsonFile(legacyFilePath)
			loadedFromLegacyStorage = payload ~= nil
		end
	end

	pathState.paths = {}
	local loadedPathCount = 0
	if type(payload) == "table" then
		loadedPathCount = loadedPathCount + mergeSerializedPathsIntoStorageState(payload.paths)
	end
	loadedPathCount = loadedPathCount + loadSharedPathFilesFromStorage()

	if loadedPathCount <= 0 and type(payload) ~= "table" then
		if hadUnreadablePrimaryStorage then
			notifyUser("Path Storage", "Saved path data could not be read.", 5)
		end
		return false
	end

	local settings = type(payload) == "table" and payload.settings or {}
	local preferRuntimeConfigAutomineSettings = type(CONFIG_SYSTEM) == "table" and CONFIG_SYSTEM.runtimeConfigLoaded == true
