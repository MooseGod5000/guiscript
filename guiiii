	local right = basis.RightVector.Magnitude > 0.001 and basis.RightVector.Unit or Vector3.new(1, 0, 0)
	local offsets = {
		Vector3.zero,
		right * 1.35,
		-right * 1.35,
		forward * 1.25,
		-forward * 1.25,
	}
	local emitted = false
	local function tryCall(methodName, ...)
		local method = rawget(vfx, methodName) or vfx[methodName]
		if type(method) ~= "function" then
			return false
		end
		local okCall = pcall(method, ...)
		emitted = emitted or okCall
		return okCall
	end
	tryCall("CreateWaterSplash", CFrame.new(position + offsets[1]), 1)
	tryCall("CreateMudSplash", CFrame.new(position + offsets[2]))
	tryCall("CreateFleshImpact", position + offsets[3], forward, true)
	tryCall("CreateSnowImpact", position + offsets[4], forward, true)
	tryCall("CreateShrapnelImpact", position + offsets[5], 0, true)
	return emitted
end
function vfxAuraHeartbeat()
	if destroyed or not isSessionActive() or not S.vfxAuraEnabled then
		restoreVfxAuraHooks()
		return
	end
	local now = os.clock()
	if now - (tonumber(VFX_AURA_MISC.lastEmitAt) or 0) < VFX_AURA_INTERVAL then
		return
	end
	VFX_AURA_MISC.lastEmitAt = now
	local root = vfxAuraGetCharacterRoot()
	if not root then
		if now - (tonumber(VFX_AURA_MISC.lastStatusAt) or 0) > 4 then
			VFX_AURA_MISC.lastStatusAt = now
			pushDebug("vfx aura: waiting for character root")
		end
		return
	end
	if not vfxAuraEmitImpactSet(root) and now - (tonumber(VFX_AURA_MISC.lastStatusAt) or 0) > 4 then
		VFX_AURA_MISC.lastStatusAt = now
		pushDebug("vfx aura: VFX module unavailable")
	end
end
function restoreVfxAuraHooks()
	local connection = VFX_AURA_MISC.connection
	if connection then
		pcall(function()
			connection:Disconnect()
		end)
	end
	VFX_AURA_MISC.connection = nil
	VFX_AURA_MISC.lastEmitAt = 0
end
function ensureVfxAuraHooks()
	if not S.vfxAuraEnabled then
		restoreVfxAuraHooks()
		return
	end
	if VFX_AURA_MISC.connection then
		return
	end
	VFX_AURA_MISC.lastEmitAt = 0
	VFX_AURA_MISC.connection = _RunService.Heartbeat:Connect(vfxAuraHeartbeat)
end
function setVfxAuraEnabled(enabled)
	local nextValue = enabled == true
	if S.vfxAuraEnabled == nextValue then
		return false, nextValue
	end
	S.vfxAuraEnabled = nextValue
	if nextValue then
		ensureVfxAuraHooks()
	else
		restoreVfxAuraHooks()
	end
	schedulePersist()
	pushDebug("vfx aura: " .. (nextValue and "on" or "off"))
	return true, nextValue
end
