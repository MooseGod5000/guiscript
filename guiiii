    local hook = gunFeatureState.noBulletLossHooks[gunItem]
    if type(hook) ~= "table" then
        hook = {}
        gunFeatureState.noBulletLossHooks[gunItem] = hook
    end

    local isDryFire = rawget(gunItem, "IsDryFire") or gunItem.IsDryFire
    if type(isDryFire) == "function" and isDryFire ~= hook.isDryFireWrapper then
        hook.originalIsDryFire = isDryFire
        hook.isDryFireWrapper = function(self, ...)
            if S.noBulletLossEnabled then
                refillGunAmmoAndChambers(self)
            end
            local result = hook.originalIsDryFire(self, ...)
            if S.noBulletLossEnabled then
                refillGunAmmoAndChambers(self)
                return false
            end
            return result
        end
        gunItem.IsDryFire = hook.isDryFireWrapper
    end

    local fire = rawget(gunItem, "Fire") or gunItem.Fire
    if type(fire) == "function" and fire ~= hook.fireWrapper then
        hook.originalFire = fire
        hook.fireWrapper = function(self, ...)
            if S.noBulletLossEnabled then
                refillGunAmmoAndChambers(self)
            end
            local results = table.pack(hook.originalFire(self, ...))
            if S.noBulletLossEnabled then
                refillGunAmmoAndChambers(self)
            end
            return table.unpack(results, 1, results.n)
        end
        gunItem.Fire = hook.fireWrapper
    end

    local canShoot = rawget(gunItem, "CanShoot") or gunItem.CanShoot
    if type(canShoot) == "function" and canShoot ~= hook.canShootWrapper then
        hook.originalCanShoot = canShoot
        hook.canShootWrapper = function(self, ...)
            if S.noBulletLossEnabled then
                refillGunAmmoAndChambers(self)
            end
            local canShootResult, reason = hook.originalCanShoot(self, ...)
            if S.noBulletLossEnabled and reason == "NoAmmo" then
                return true
            end
            return canShootResult, reason
        end
        gunItem.CanShoot = hook.canShootWrapper
    end

    local networkActivate = rawget(gunItem, "NetworkActivate") or gunItem.NetworkActivate
    if type(networkActivate) == "function" and networkActivate ~= hook.networkActivateWrapper then
        hook.originalNetworkActivate = networkActivate
        hook.networkActivateWrapper = function(self, actionName, ...)
            if S.noBulletLossEnabled and tostring(actionName or "") == "Shoot" then
                refillGunAmmoAndChambers(self)
            end
            local results = table.pack(hook.originalNetworkActivate(self, actionName, ...))
            if S.noBulletLossEnabled and tostring(actionName or "") == "Shoot" then
                refillGunAmmoAndChambers(self)
            end
            return table.unpack(results, 1, results.n)
        end
        gunItem.NetworkActivate = hook.networkActivateWrapper
    end

    local shoot = rawget(gunItem, "Shoot") or gunItem.Shoot
    if type(shoot) == "function" and shoot ~= hook.shootWrapper then
        hook.originalShoot = shoot
        hook.shootWrapper = function(self, ...)
            if S.noBulletLossEnabled then
                refillGunAmmoAndChambers(self)
            end
            local results = table.pack(hook.originalShoot(self, ...))
            if S.noBulletLossEnabled then
                refillGunAmmoAndChambers(self)
            end
            return table.unpack(results, 1, results.n)
        end
        gunItem.Shoot = hook.shootWrapper
    end

    local shootRequest = rawget(gunItem, "ShootRequest") or gunItem.ShootRequest
    if type(shootRequest) == "function" and shootRequest ~= hook.shootRequestWrapper then
        hook.originalShootRequest = shootRequest
        hook.shootRequestWrapper = function(self, ...)
            if S.noBulletLossEnabled then
                refillGunAmmoAndChambers(self)
            end
            local results = table.pack(hook.originalShootRequest(self, ...))
            if S.noBulletLossEnabled then
                refillGunAmmoAndChambers(self)
            end
            return table.unpack(results, 1, results.n)
        end
        gunItem.ShootRequest = hook.shootRequestWrapper
    end

    local update = rawget(gunItem, "Update") or gunItem.Update
    if type(update) == "function" and update ~= hook.updateWrapper then
        hook.originalUpdate = update
        hook.updateWrapper = function(self, ...)
            if S.noBulletLossEnabled and (self.IsFanButtonDown or self.IsFanning) then
                refillGunAmmoAndChambers(self)
            end
            local results = table.pack(hook.originalUpdate(self, ...))
            if S.noBulletLossEnabled and (self.IsFanButtonDown or self.IsFanning) then
                refillGunAmmoAndChambers(self)
            end
            return table.unpack(results, 1, results.n)
        end
        gunItem.Update = hook.updateWrapper
    end
end

