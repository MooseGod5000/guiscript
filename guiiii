function getPathBearAngerValue(animal)
	if typeof(animal) ~= "Instance" then
		return nil
	end

	local anger = animal:FindFirstChild("Anger")
	if anger and anger:IsA("NumberValue") then
		return anger
	end
	return nil
end

function getPathBearTypeText(animal)
	if typeof(animal) ~= "Instance" then
		return ""
	end

	local rigType = animal:FindFirstChild("RigType")
	if rigType then
		local okValue, value = pcall(function()
			return rigType.Value
		end)
		if okValue and type(value) == "string" then
			return value
		end
	end

	local typeAttribute = animal:GetAttribute("RigType") or animal:GetAttribute("AnimalType") or animal:GetAttribute("Type")
	if type(typeAttribute) == "string" then
		return typeAttribute
	end
	return animal.Name
end

function isPathBearAnimal(animal)
	if not getPathBearAngerValue(animal) then
		return false
	end

	local typeText = safeLower(getPathBearTypeText(animal))
	local nameText = safeLower(typeof(animal) == "Instance" and animal.Name or "")
	return string.find(typeText, "bear", 1, true) ~= nil or string.find(nameText, "bear", 1, true) ~= nil
end

function getPathBearPositionPart(animal)
	if typeof(animal) ~= "Instance" then
		return nil, nil
	end

	local collisionModel = animal:FindFirstChild("CollisionModel")
	local part = animal:FindFirstChild("HumanoidRootPart")
	if not part and animal:IsA("Model") then
		part = animal.PrimaryPart
	end
	if not part and collisionModel then
		part = collisionModel:FindFirstChild("Center")
	end
	if not part then
		part = animal:FindFirstChild("Body")
	end
	if part and not part:IsA("BasePart") then
		part = part:FindFirstChildWhichIsA("BasePart", true)
	end
	if not part then
		part = animal:FindFirstChildWhichIsA("BasePart", true)
	end

	local serverCFrame = animal:GetAttribute("ServerCFrame")
	local position = typeof(serverCFrame) == "CFrame" and serverCFrame.Position or nil
	if not position and part and part:IsA("BasePart") then
		position = part.Position
	end

	return part, position
end

function formatPathBearAnger(value)
	local numericValue = tonumber(value) or 0
	if math.abs(numericValue - math.floor(numericValue + 0.5)) < 0.05 then
		return tostring(math.floor(numericValue + 0.5))
	end
	return string.format("%.1f", numericValue)
end

function updatePathBearPreventionVisual(animal, part, anger, distance)
	if type(pathState) ~= "table" or typeof(animal) ~= "Instance" then
		return
	end

	if type(pathState.bearPreventionVisuals) ~= "table" then
		pathState.bearPreventionVisuals = {}
	end

	local folder = getPathBearPreventionVisualizerFolder(true)
	local visuals = pathState.bearPreventionVisuals[animal]
	if type(visuals) ~= "table" or not visuals.highlight or not visuals.highlight.Parent then
		destroyPathBearPreventionVisualEntry(visuals)
		visuals = {}

		local highlight = Instance.new("Highlight")
		highlight.Name = "FobBearPrevention"
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.55
		highlight.OutlineTransparency = 0
		highlight.Adornee = animal
		highlight.Parent = folder
		visuals.highlight = highlight

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "FobBearPreventionBillboard"
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 10000
		billboard.Size = UDim2.new(0, 92, 0, 30)
		billboard.StudsOffset = Vector3.new(0, 4.8, 0)
		billboard.Parent = folder
		visuals.billboard = billboard

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextStrokeTransparency = 0.05
		label.TextStrokeColor3 = Color3.fromRGB(10, 10, 10)
		label.Parent = billboard
		visuals.label = label

		pathState.bearPreventionVisuals[animal] = visuals
	end

	local isDangerous = (tonumber(anger) or 0) > (BEAR_PREVENTION_DANGER_ANGER or 91)
	local isWarming = (tonumber(anger) or 0) >= (BEAR_PREVENTION_SAFE_ANGER or 40.5)
	local fillColor = isDangerous and Color3.fromRGB(255, 66, 66)
		or (isWarming and Color3.fromRGB(255, 166, 64) or Color3.fromRGB(60, 190, 255))
	local outlineColor = isDangerous and Color3.fromRGB(255, 230, 230)
		or (isWarming and Color3.fromRGB(255, 232, 170) or Color3.fromRGB(190, 235, 255))

	if visuals.highlight then
		visuals.highlight.Adornee = animal
		visuals.highlight.FillColor = fillColor
		visuals.highlight.OutlineColor = outlineColor
		visuals.highlight.Parent = folder
	end
	if visuals.billboard then
		visuals.billboard.Adornee = part
		visuals.billboard.Parent = folder
	end
	if visuals.label then
		visuals.label.Text = "Anger: " .. formatPathBearAnger(anger)
		visuals.label.TextColor3 = fillColor
	end
	visuals.distance = distance
end

function prunePathBearPreventionVisuals(activeBears)
	if type(pathState) ~= "table" or type(pathState.bearPreventionVisuals) ~= "table" then
		return
	end

	for animal, visuals in pairs(pathState.bearPreventionVisuals) do
		if not activeBears[animal] then
			destroyPathBearPreventionVisualEntry(visuals)
			pathState.bearPreventionVisuals[animal] = nil
		end
	end
end

function updatePathBearPreventionScan(character, forceRefresh)
	if not (type(pathState) == "table" and isPathBearPreventionEnabled()) then
		clearPathBearPreventionVisuals()
		return nil
	end

	local now = os.clock()
	if not forceRefresh and pathState.bearPreventionLastResult and (now - (tonumber(pathState.bearPreventionLastScanAt) or 0)) < (BEAR_PREVENTION_SCAN_INTERVAL or 0.15) then
		return pathState.bearPreventionLastResult
	end
	pathState.bearPreventionLastScanAt = now

	local activeCharacter = character or cachedCharacter or (type(getCustomCharacter) == "function" and getCustomCharacter()) or (localPlayer and localPlayer.Character)
	local rootPart = activeCharacter and getRootPart(activeCharacter)
	if not rootPart then
		prunePathBearPreventionVisuals({})
		pathState.bearPreventionLastResult = nil
		return nil
	end

	local animalsFolder = getPathAnimalsFolder()
	if not animalsFolder then
		prunePathBearPreventionVisuals({})
		pathState.bearPreventionLastResult = nil
		return nil
	end

	local radius = tonumber(BEAR_PREVENTION_RADIUS) or 50
	local dangerThreshold = tonumber(BEAR_PREVENTION_DANGER_ANGER) or 91
	local safeThreshold = tonumber(BEAR_PREVENTION_SAFE_ANGER) or 40.5
	local activeBears = {}
	local bears = {}
	local dangerousBear = nil
	local unsafeBear = nil
	local highestAnger = 0

	for _, animal in ipairs(animalsFolder:GetChildren()) do
		if isPathBearAnimal(animal) then
			local angerValue = getPathBearAngerValue(animal)
			local part, position = getPathBearPositionPart(animal)
			if angerValue and position then
				local distance = (rootPart.Position - position).Magnitude
				if distance <= radius then
					local anger = tonumber(angerValue.Value) or 0
					local entry = {
						animal = animal,
						part = part,
						angerValue = angerValue,
						anger = anger,
						distance = distance,
					}
					activeBears[animal] = true
					table.insert(bears, entry)
					updatePathBearPreventionVisual(animal, part, anger, distance)
					if anger > highestAnger then
						highestAnger = anger
					end
					if anger > dangerThreshold and (not dangerousBear or anger > dangerousBear.anger or (anger == dangerousBear.anger and distance < dangerousBear.distance)) then
						dangerousBear = entry
					end
					if anger >= safeThreshold and (not unsafeBear or anger > unsafeBear.anger or (anger == unsafeBear.anger and distance < unsafeBear.distance)) then
						unsafeBear = entry
					end
				end
			end
		end
	end

	prunePathBearPreventionVisuals(activeBears)
	table.sort(bears, function(left, right)
		if left.anger ~= right.anger then
			return left.anger > right.anger
		end
		return left.distance < right.distance
	end)

	local result = {
		bears = bears,
		dangerousBear = dangerousBear,
		unsafeBear = unsafeBear,
		highestAnger = highestAnger,
	}
	pathState.bearPreventionLastResult = result
	return result
end

function holdPathBearPreventionPosition(character)
	clearMovementKeys()
	cancelActiveMoveTween()
	setInteractKeyHeld(false)

	local rootPart = character and getRootPart(character)
	if rootPart and isCFrameMovementMode(movementMode) then
		return applyExperimentalCFrameGoal(character, rootPart.CFrame)
	end
	if rootPart and isUndergroundMovementMode(movementMode) then
		setUndergroundRootVelocity(rootPart, Vector3.zero)
		ensureControlledUndergroundState(character, lastMoveCommand)
		return true
	end

	local humanoid = character and getHumanoid(character)
	if humanoid then
		pcall(function()
			humanoid.Jump = false
			humanoid:Move(Vector3.zero)
		end)
	end
	return false
end

function getPathBearEntryLabel(entry)
	local animal = type(entry) == "table" and entry.animal or nil
	local typeText = animal and getPathBearTypeText(animal) or "Bear"
	local anger = type(entry) == "table" and entry.anger or 0
	return tostring(typeText ~= "" and typeText or "Bear") .. " (" .. formatPathBearAnger(anger) .. ")"
