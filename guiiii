function teleportThrownLassoToTarget(lassoItem, targetInfo)
    if not (S.lassoTeleportEnabled and isTable(lassoItem) and targetInfo) then
        return
    end

    local targetPart = targetInfo.part
    if not (targetPart and targetPart:IsA("BasePart") and targetPart:IsDescendantOf(workspace)) then
        return
    end

    local lassoCircle = rawget(lassoItem, "LassoCircle") or lassoItem.LassoCircle
    if not (lassoCircle and lassoCircle:IsA("BasePart") and lassoCircle:IsDescendantOf(workspace)) then
        return
    end

    local targetPosition = targetPart.Position
    local lookDirection = lassoCircle.Position - targetPosition
    if lookDirection.Magnitude < 0.001 then
        lookDirection = Vector3.new(0, 0, -1)
    end

    local targetCFrame = CFrame.new(targetPosition, targetPosition + lookDirection.Unit)
    local network = resolveGlobalNetwork(false) or resolveGlobalNetwork(true)

    pcall(function()
        lassoCircle.CFrame = targetCFrame
        lassoCircle.Velocity = Vector3.zero
        lassoCircle.AssemblyLinearVelocity = Vector3.zero
        lassoCircle.AssemblyAngularVelocity = Vector3.zero
    end)

    local bodyForce = lassoCircle:FindFirstChild("BodyForce")
    if bodyForce then
        pcall(function()
            bodyForce.Force = Vector3.zero
        end)
    end

    local bodyGyro = lassoCircle:FindFirstChild("BodyGyro")
    if bodyGyro then
        pcall(function()
            bodyGyro.CFrame = targetCFrame * CFrame.Angles(0, -1.5707963267948966, 0)
        end)
    end

    if network and type(network.FireServer) == "function" then
        pcall(network.FireServer, network, "UpdateThrownLasso", targetCFrame)
    end

    task.delay(0.03, function()
        if network and type(network.FireServer) == "function" then
            pcall(network.FireServer, network, "UpdateThrownLasso", targetCFrame)
        end
        if not (S.lassoTeleportEnabled and isTable(lassoItem)) then
            return
        end
        if not (targetPart and targetPart:IsA("BasePart") and targetPart:IsDescendantOf(workspace)) then
            return
        end
        if not (lassoItem.IsEquipped and lassoItem.IsThrowingLasso) then
            return
        end
        local onHit = rawget(lassoItem, "OnHit") or lassoItem.OnHit
        if type(onHit) == "function" then
            pcall(onHit, lassoItem, targetPart)
        end
    end)
end

function resolveObjectActionTypesModule(forceRefresh)
    local cached = rawget(_G, "__AutoMineObjectActionTypes")
    if not forceRefresh and isTable(cached) then
        return cached
    end

    local globalModule = getAutoMineGlobalModule(forceRefresh)
    if isTable(globalModule) and type(globalModule.LoadModule) == "function" then
        local okLoad, loadedModule = pcall(function()
            return globalModule:LoadModule("ObjectActionTypes")
        end)
        if okLoad and isTable(loadedModule) then
            _G.__AutoMineObjectActionTypes = loadedModule
            return loadedModule
        end
    end

    local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
    local dataFolder = sharedModules and sharedModules:FindFirstChild("Data")
    local moduleScript = dataFolder and dataFolder:FindFirstChild("ObjectActionTypes")
    if moduleScript and moduleScript:IsA("ModuleScript") then
        local okRequire, requiredModule = pcall(require, moduleScript)
        if okRequire and isTable(requiredModule) then
            _G.__AutoMineObjectActionTypes = requiredModule
            return requiredModule
        end
    end

    return nil
end

function resolvePlayerActionTypesModule(forceRefresh)
    local cached = rawget(_G, "__AutoMinePlayerActionTypes")
    if not forceRefresh and isTable(cached) then
        return cached
    end

    local globalModule = getAutoMineGlobalModule(forceRefresh)
    if isTable(globalModule) and type(globalModule.LoadModule) == "function" then
        local okLoad, loadedModule = pcall(function()
            return globalModule:LoadModule("PlayerActionTypes")
        end)
        if okLoad and isTable(loadedModule) then
            _G.__AutoMinePlayerActionTypes = loadedModule
            return loadedModule
        end
    end

    local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
    local dataFolder = sharedModules and sharedModules:FindFirstChild("Data")
    local modulesFolder = ReplicatedStorage:FindFirstChild("Modules")
    local uiFolder = modulesFolder and modulesFolder:FindFirstChild("UI")

