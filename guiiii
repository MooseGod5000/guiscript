function getToggledOrderedOptionMap(source, optionName, optionOrder, defaultName, cloneFn)
    local optionKey = tostring(optionName or "")
    if optionKey == "" then
        return nil
    end
    local nextMap = cloneFn(source)
    if nextMap[optionKey] == nil then
        return nil
    end
    local nextValue = not nextMap[optionKey]
    if nextValue == false then
        for _, otherOption in ipairs(optionOrder) do
            if otherOption ~= optionKey and nextMap[otherOption] == true then
                nextMap[optionKey] = false
                return nextMap
            end
        end
        nextValue = true
