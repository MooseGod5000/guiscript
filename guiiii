           while S.eggAutofarmEnabled and (not dupeFinished or not invisFinished) do
               task.wait(0.2)
           end
       end
       -- Single persistent RenderStepped connection (like NPC autofarm)
       -- Holds character at eggHoldCF, auto-follows current target when not tweening
       local function ensureEggHoldConnection()
           if eggHoldConn then return end
           eggHoldConn = _RunService.RenderStepped:Connect(function()
               if not S.eggAutofarmEnabled or not eggHoldCF then return end
               local c = _Players.LocalPlayer.Character
