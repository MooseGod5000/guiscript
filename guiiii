function decodeHttpResponse(response)
	if type(response) == "string" then
		return true, 200, response
	end
	if type(response) ~= "table" then
		return false, nil, nil
	end
	local statusCode = tonumber(response.StatusCode or response.Status or response.status)
	local success = response.Success
	if success == nil then
		success = response.success
	end
	if success == nil then
		success = statusCode and statusCode >= 200 and statusCode < 300
	end
	return success == true, statusCode, response.Body or response.body
end
function isServerHopRateLimitError(err) return string.find(tostring(err or ""), "429", 1, true) ~= nil end
function getServerHopRateLimitRemaining() return math.max(0, (tonumber(serverHopRateLimitedUntil) or 0) - os.clock()) end
function setServerHopRateLimitCooldown()
	local cooldown = math.max(5, tonumber(SERVER_HOP_RATE_LIMIT_COOLDOWN) or 45)
	serverHopRateLimitedUntil = math.max(tonumber(serverHopRateLimitedUntil) or 0, os.clock() + cooldown)
	return getServerHopRateLimitRemaining()
