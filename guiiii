           Instance.new("UICorner", subHeader).CornerRadius = UDim.new(0, 4)
           table.insert(allKbElements, {element = subHeader, names = {}})

           for _, regEntry in ipairs(subEntries) do
               local row = createKeybindRow(regEntry, elementsList)
               table.insert(allKbElements, {element = row, names = {regEntry.name:lower()}})
           end
       end
   end

   -- Any remaining autofarm entries that didn't match a sub-section
   for _, regEntry in ipairs(allAutofarmEntries) do
       if not placedAutofarm[regEntry.name] then
           local row = createKeybindRow(regEntry, elementsList)
           table.insert(allKbElements, {element = row, names = {regEntry.name:lower()}})
           placedAutofarm[regEntry.name] = true
       end
   end

   -- SETTINGS tab entries (non-slider, non-special)
   local settingsEntries = {}
   for _, regEntry in ipairs(_buttonRegistry) do
       if regEntry.tab == "SETTINGS" and regEntry.type ~= "slider" then
           table.insert(settingsEntries, regEntry)
       end
   end
   if #settingsEntries > 0 then
       local header = createKeybindSectionHeader("SETTINGS", elementsList)
       table.insert(allKbElements, {element = header, names = {}})
       for _, regEntry in ipairs(settingsEntries) do
           local row = createKeybindRow(regEntry, elementsList)
           table.insert(allKbElements, {element = row, names = {regEntry.name:lower()}})
       end
   end

   -- Search filtering
   kbSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
       local query = kbSearchBox.Text:lower()
       if query == "" then
           -- Show all
           for _, item in ipairs(allKbElements) do
               item.element.Visible = true
           end
           return
       end
       -- Hide headers by default, show only matching rows
       -- Also show a header if any row in its section matches
       local currentHeader = nil
       local headerHasMatch = false
       for _, item in ipairs(allKbElements) do
           if #item.names == 0 then
               -- This is a header/sub-header
               -- First, finalize previous header visibility
               if currentHeader then
                   currentHeader.Visible = headerHasMatch
               end
               currentHeader = item.element
               headerHasMatch = false
           else
               -- This is a keybind row
               local matches = false
               for _, n in ipairs(item.names) do
                   if n:find(query, 1, true) then
                       matches = true
                       break
                   end
               end
               item.element.Visible = matches
               if matches then headerHasMatch = true end
           end
       end
       -- Finalize last header
       if currentHeader then
           currentHeader.Visible = headerHasMatch
       end
   end)

   -- Sync keybind labels when config is loaded
   table.insert(_allToggleSyncs, function()
       for name, rowData in pairs(_keybindRows) do
           rowData.keybindLabel.Text = getKeyDisplayName(S.keybinds[name])
       end
   end)
end
