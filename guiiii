local function colorFromSetting(value, fallback)
	local r, g, b = tostring(value or ""):match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
	if r and g and b then
		return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
	end
	return fallback or Theme.Accent
end

local function colorToSetting(color)
	return ("%d,%d,%d"):format(
		math.clamp(math.floor((color.R * 255) + 0.5), 0, 255),
		math.clamp(math.floor((color.G * 255) + 0.5), 0, 255),
		math.clamp(math.floor((color.B * 255) + 0.5), 0, 255)
	)
end

