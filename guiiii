function refillGunAmmoAndChambers(gunItem)
    if not isTable(gunItem) then
        return false
    end

    local changed = false
    local maxAmmo = tonumber(rawget(gunItem, "MaxAmmo") or gunItem.MaxAmmo)
    if maxAmmo and maxAmmo > 0 then
        local ammo = tonumber(rawget(gunItem, "Ammo") or gunItem.Ammo)
        if ammo == nil or ammo < maxAmmo then
            gunItem.Ammo = maxAmmo
            changed = true
        end
    end

    local chamberData = getGunChamberData(gunItem)
    if chamberData then
        local bullets = chamberData.bullets
        local count = tonumber(chamberData.count) or #bullets
        if count and count > 0 then
            if type(chamberData.index) ~= "number" or chamberData.index < 1 or chamberData.index > count then
                chamberData.index = 1
                changed = true
            end
            for index = 1, count do
                if bullets[index] ~= "unused" then
                    bullets[index] = "unused"
                    changed = true
                end
            end
            if chamberData.spin then
                chamberData.spin = false
                changed = true
            end
        end
    end

    if changed and type(gunItem.UpdateState) == "function" then
        pcall(gunItem.UpdateState, gunItem)
    end

    return changed
end

