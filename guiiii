	task.spawn(function()
		if cooldownRemaining > 0 then
			setServerHopStatus("Low-server lookup cooling down (" .. tostring(math.ceil(cooldownRemaining)) .. "s)", Color3.fromRGB(255, 190, 120))
			pushDebugRateLimited("server_hop_cooldown", "server hop waiting for low-server lookup cooldown", 5)
			while serverHopTaskQueued and not serverHopInProgress and getServerHopRateLimitRemaining() > 0 do
				task.wait(math.min(1, getServerHopRateLimitRemaining()))
