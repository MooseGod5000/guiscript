               for _, gui in pairs(_CoreGui:GetChildren()) do
                   if not existingCoreGuis[gui] and isAmareGui(gui) then pcall(function() gui:Destroy() end) end
               end
           end)
       end
       -- Sweep multiple times over 10 seconds to catch slow-loading GUIs
       for _sweepIdx = 1, 10 do
           task.wait(1)
           sweepAmareGuis()
       end
