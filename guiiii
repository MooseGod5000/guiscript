-- ======= GUI TOGGLE (configurable keybind) ======= --
do
   local isToggling = false
   _UserInputService.InputBegan:Connect(function(input, gameProcessed)
       if gameProcessed then return end
       if input.KeyCode == guiToggleKeyCode then
           if isToggling then return end
           isToggling = true
           if hubWrapper.Visible then
               for _, ddGui in pairs(_allDropdownGuis) do ddGui.Enabled = false end
               _TweenService:Create(hubWrapper, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 380)}):Play()
               task.delay(0.5, function() hubWrapper.Visible = false isToggling = false end)
           else
               hubWrapper.Size = UDim2.new(0, 0, 0, 380)
               hubWrapper.Visible = true
               _TweenService:Create(hubWrapper, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 600, 0, 380)}):Play()
               task.delay(0.8, function() isToggling = false end)
           end
       end
   end)
end
-- ======= SHOW HUB ======= --
local function showHub()
   hubWrapper.Size = UDim2.new(0, 0, 0, 380)
   hubWrapper.Visible = true
   _TweenService:Create(hubWrapper, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 600, 0, 380)}):Play()
    switchTab("Search")
   task.spawn(function()
       task.wait(0.2)
       _animateTabTitle(tabTitle1, "Search")
   end)
end
if isStandalone then
   showHub()
   spawnNotification()
else
   local loginEvent = loadingGui:FindFirstChild("LoginSuccess")
   if loginEvent then
       loginEvent.Event:Connect(function()
           showHub()
           spawnNotification()
       end)
   end
end
