function createPathPlayerAvoiderCorridorSegment(fromPosition, toPosition, segmentWidth, color)
	local delta = toPosition - fromPosition
	local distance = delta.Magnitude
	if distance <= 0.05 then
		return nil
	end

	local segment = Instance.new("Part")
	segment.Name = "AvoiderCorridor"
	segment.Anchored = true
	segment.CanCollide = false
	segment.CanQuery = false
	segment.CanTouch = false
	segment.Material = Enum.Material.Neon
	segment.Color = color
	segment.Transparency = 0.78
	segment.Size = Vector3.new(math.max(1.2, tonumber(segmentWidth) or 1), 0.18, distance)
	segment.CFrame = CFrame.lookAt(
		fromPosition + Vector3.new(0, VISUALIZER_HEIGHT, 0),
		toPosition + Vector3.new(0, VISUALIZER_HEIGHT, 0)
	) * CFrame.new(0, 0, -distance * 0.5)
	segment.Parent = getPathPlayerAvoiderVisualizerFolder()
	return segment
end

function createPathPlayerAvoiderRadiusSegment(fromPosition, toPosition, color, segmentIndex)
	local delta = toPosition - fromPosition
	local distance = delta.Magnitude
	if distance <= 0.05 then
		return nil
	end

	local folder = getPathPlayerAvoiderVisualizerFolder()
	local segmentName = type(segmentIndex) == "number" and ("AvoiderRadius_" .. tostring(segmentIndex)) or "AvoiderRadius"
	local segment = type(segmentIndex) == "number" and folder:FindFirstChild(segmentName) or nil
	if not (segment and segment:IsA("Part")) then
		segment = Instance.new("Part")
		segment.Name = segmentName
		segment.Anchored = true
		segment.CanCollide = false
		segment.CanQuery = false
		segment.CanTouch = false
		segment.Material = Enum.Material.Neon
		segment.Parent = folder
	end

	segment.Color = color
	segment.Transparency = 0.2
	segment.Size = Vector3.new(0.26, 0.16, distance)
	segment.CFrame = CFrame.lookAt(
		fromPosition + Vector3.new(0, VISUALIZER_HEIGHT, 0),
		toPosition + Vector3.new(0, VISUALIZER_HEIGHT, 0)
	) * CFrame.new(0, 0, -distance * 0.5)
	segment.Parent = folder
	return segment
end

function trimPathPlayerAvoiderRadiusSegments(usedCount)
	local folder = findPathPlayerAvoiderVisualizerFolder()
	if not folder then
		return
	end

	for _, child in ipairs(folder:GetChildren()) do
		if child and child:IsA("Part") then
			local segmentIndex = string.match(child.Name, "^AvoiderRadius_(%d+)$")
			if segmentIndex and tonumber(segmentIndex) and tonumber(segmentIndex) > (tonumber(usedCount) or 0) then
				child:Destroy()
			end
		end
	end
end

function samplePathPlayerAvoiderRadiusVisualizationPoint(rootPosition, originFloorPosition, radius, angle, character)
	local samplePosition = rootPosition + Vector3.new(
		math.cos(angle) * radius,
		0,
		math.sin(angle) * radius
	)
	local alignedPosition = getGroundAlignedPathPosition(samplePosition, character)
	if alignedPosition then
		return alignedPosition
	end
	if typeof(originFloorPosition) == "Vector3" then
		return Vector3.new(samplePosition.X, originFloorPosition.Y, samplePosition.Z)
	end
	return samplePosition
end

function updatePathPlayerAvoiderRadiusVisualization(rootPosition, character, blocker)
	if not (isPathPlayerAvoiderEnabled() and isPathPlayerAvoiderRadiusActive() and isPathPlayerAvoiderShowRadiusEnabled() and pathState.playbackActive) then
		clearPathPlayerAvoiderCorridorVisualization()
		return
	end
	if typeof(rootPosition) ~= "Vector3" then
		clearPathPlayerAvoiderCorridorVisualization()
		return
	end

	local radius = getPathPlayerAvoiderRadius()
	local segmentCount = math.clamp(math.floor((radius * 0.35) + 16 + 0.5), 18, 40)
	local now = os.clock()
	local localCharacter = character or getCustomCharacter() or cachedCharacter
	local originFloorPosition = getGroundAlignedPathPosition(rootPosition, localCharacter) or rootPosition
	local signature = table.concat({
		"radius",
		math.floor(originFloorPosition.X * 2 + 0.5),
		math.floor(originFloorPosition.Y * 2 + 0.5),
		math.floor(originFloorPosition.Z * 2 + 0.5),
		radius,
		segmentCount,
		blocker and "1" or "0",
	}, ":")
	if signature == lastPlayerAvoiderVizSignature and (now - lastPlayerAvoiderVizAt) < PATH_PLAYER_AVOIDER_VIZ_REFRESH_INTERVAL then
		return
	end

	lastPlayerAvoiderVizAt = now
	lastPlayerAvoiderVizSignature = signature

	local ringColor = blocker and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(245, 245, 245)
	local folder = getPathPlayerAvoiderVisualizerFolder()
	local firstPoint = nil
	local previousPoint = nil
	local usedSegments = 0
	for index = 0, segmentCount - 1 do
		local angle = (index / segmentCount) * math.pi * 2
		local nextPoint = samplePathPlayerAvoiderRadiusVisualizationPoint(rootPosition, originFloorPosition, radius, angle, localCharacter)
		if previousPoint and nextPoint then
			usedSegments += 1
			createPathPlayerAvoiderRadiusSegment(previousPoint, nextPoint, ringColor, usedSegments)
		end
		if not firstPoint then
			firstPoint = nextPoint
		end
		previousPoint = nextPoint
	end
	if previousPoint and firstPoint then
		usedSegments += 1
		createPathPlayerAvoiderRadiusSegment(previousPoint, firstPoint, ringColor, usedSegments)
	end
	trimPathPlayerAvoiderRadiusSegments(usedSegments)

	local marker = folder:FindFirstChild("AvoiderOrigin")
	if not (marker and marker:IsA("Part")) then
		marker = Instance.new("Part")
		marker.Name = "AvoiderOrigin"
		marker.Shape = Enum.PartType.Ball
		marker.Size = Vector3.new(0.42, 0.42, 0.42)
		marker.Anchored = true
		marker.CanCollide = false
		marker.CanQuery = false
		marker.CanTouch = false
		marker.Material = Enum.Material.Neon
		marker.Parent = folder
	end
	marker.Color = ringColor
	marker.Transparency = 0.22
	marker.Position = originFloorPosition + Vector3.new(0, VISUALIZER_HEIGHT, 0)
	marker.Parent = folder
end

function updatePathPlayerAvoiderCorridorVisualization(rootPosition, segments, blocker)
	if not (isPathPlayerAvoiderEnabled() and isPathPlayerAvoiderCorridorActive() and isPathPlayerAvoiderShowCorridorEnabled() and pathState.playbackActive) then
		clearPathPlayerAvoiderCorridorVisualization()
		return
	end
	if typeof(rootPosition) ~= "Vector3" or type(segments) ~= "table" or #segments == 0 then
		clearPathPlayerAvoiderCorridorVisualization()
		return
	end

	local firstSegment = segments[1]
	local lastSegment = segments[#segments]
	if not firstSegment or not lastSegment then
		clearPathPlayerAvoiderCorridorVisualization()
		return
	end

	local now = os.clock()
	local signature = table.concat({
		math.floor(rootPosition.X * 2 + 0.5),
		math.floor(rootPosition.Y * 2 + 0.5),
		math.floor(rootPosition.Z * 2 + 0.5),
		#segments,
		math.floor(firstSegment.finish.X * 2 + 0.5),
		math.floor(firstSegment.finish.Z * 2 + 0.5),
		math.floor(lastSegment.finish.X * 2 + 0.5),
		math.floor(lastSegment.finish.Z * 2 + 0.5),
		blocker and "1" or "0",
	}, ":")
	if signature == lastPlayerAvoiderVizSignature and (now - lastPlayerAvoiderVizAt) < PATH_PLAYER_AVOIDER_VIZ_REFRESH_INTERVAL then
		return
	end

	clearPathPlayerAvoiderCorridorVisualization()
	lastPlayerAvoiderVizAt = now
	lastPlayerAvoiderVizSignature = signature

	local corridorColor = blocker and Color3.fromRGB(255, 116, 72) or Color3.fromRGB(255, 166, 64)
	local segmentWidth = PATH_PLAYER_AVOIDER_CORRIDOR_RADIUS * 2
	for _, segment in ipairs(segments) do
		createPathPlayerAvoiderCorridorSegment(segment.start, segment.finish, segmentWidth, corridorColor)
	end

	local marker = Instance.new("Part")
	marker.Name = "AvoiderOrigin"
	marker.Shape = Enum.PartType.Ball
	marker.Size = Vector3.new(0.55, 0.55, 0.55)
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker.Material = Enum.Material.Neon
	marker.Color = corridorColor
	marker.Transparency = 0.4
	marker.Position = rootPosition + Vector3.new(0, VISUALIZER_HEIGHT, 0)
	marker.Parent = getPathPlayerAvoiderVisualizerFolder()
end

