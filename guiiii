local function clearChildren(container)
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function findPage(pageId)
	for _, page in ipairs(RecoveredPages) do
		if page.id == pageId then
			return page
		end
	end
	return RecoveredPages[1]
end

local function renderControl(parent, spec)
	if spec.kind == "label" then
		makeDisplayLabel(parent, spec)
	elseif spec.kind == "toggle" then
		makeToggle(parent, spec)
	elseif spec.kind == "button" then
		makeButtonControl(parent, spec)
	elseif spec.kind == "number" then
		makeNumberInput(parent, spec)
	elseif spec.kind == "color" then
		makeColorInput(parent, spec)
	elseif spec.kind == "chipset" or spec.kind == "playerchipset" then
		makeChipsetInput(parent, spec)
	elseif spec.kind == "dropdown" then
		makeDropdownInput(parent, spec)
	else
		makeTextInput(parent, spec)
	end
end

local function refreshPageButtons()
	for pageId, info in pairs(UI.PageButtons or {}) do
