    if math.abs(desiredDistance - (tonumber(S[spec.lastZoomLevelKey]) or 0)) > 0.001 then
        S[spec.lastPopAmountKey] = 0
    end
    local lastPopAmount = tonumber(S[spec.lastPopAmountKey]) or 0
    if cutoff < lastPopAmount then
        cutoff = lastPopAmount
    end
    if cutoff > 0 then
        desiredCFrame = desiredCFrame + desiredCFrame.LookVector * cutoff
        S[spec.lastPopAmountKey] = math.max(cutoff - 0.3, 0)
